msgstr "Esta estrutura precisa ser enchida com {amount} {element} para funcionar."

#. STRINGS.BUILDINGS.PREFABS.MEDICALCOT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MEDICALCOT.DESC"
msgid "Duplicants use triage cots to recover from physical injuries and receive aid from peers."
msgstr ""
"Duplicantes usam macas de triagem para se recuperar de lesões e receber cuidado médico de outros."

#. STRINGS.BUILDINGS.PREFABS.MEDICALCOT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MEDICALCOT.EFFECT"
msgid ""
"Accelerates <link=\"HEALTH\">Health</link> restoration and the healing of physical injuries.\n"
"\n"
"Revives incapacitated Duplicants."
msgstr ""
"Acelera a recuperação de <link=\"HEALTH\">Saúde</link> e a cura de lesões físicas.\n"
"\n"
"Revive Duplicantes incapacitados."

#. STRINGS.BUILDINGS.PREFABS.MEDICALCOT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MEDICALCOT.NAME"
msgid "<link=\"MEDICALCOT\">Triage Cot</link>"
msgstr "<link=\"MEDICALCOT\">Maca de Triagem</link>"

#. STRINGS.BUILDINGS.PREFABS.MEGABRAINTANK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MEGABRAINTANK.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.MEGABRAINTANK.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MEGABRAINTANK.EFFECT"
msgid ""
"An organic multi-cortex repository and processing system fuelled by <link=\"OXYGEN\">Oxygen</"
"link>.\n"
"\n"
"Analyzes <link=\"DREAMJOURNAL\">Dream Journals</link> produced by Duplicants wearing "
"<link=\"SLEEPCLINICPAJAMAS\">Pajamas</link>.\n"
"\n"
"Provides a sustainable boost to Duplicant skills and abilities throughout the colony."
msgstr ""
"Um repositório orgânico multi-córtex com um sistema de processamento alimentado por "
"<link=\"OXYGEN\">Oxigênio</link>.\n"
"\n"
"Analisa os <link=\"DREAMJOURNAL\">Diários de Sonho</link> produzidos por Duplicantes vestindo "
"<link=\"SLEEPCLINICPAJAMAS\">Pijamas</link>.\n"
"\n"
"Fornece um bônus sustentável para as habilidades e atributos dos Duplicantes em toda a colônia."

#. STRINGS.BUILDINGS.PREFABS.MEGABRAINTANK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MEGABRAINTANK.NAME"
msgid "<link=\"MEGABRAINTANK\">Somnium Synthesizer</link>"
msgstr "<link=\"MEGABRAINTANK\">Sintetizador Somnium</link>"

#. STRINGS.BUILDINGS.PREFABS.MERCURYCEILINGLIGHT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MERCURYCEILINGLIGHT.DESC"
msgid "Mercury ceiling lights take a while to reach full brightness, but once they do...zowie!"
msgstr ""
"As luzes de teto de mercúrio demoram um pouco para atingir o brilho total, mas quando atingem..."
"nossa!"

#. STRINGS.BUILDINGS.PREFABS.MERCURYCEILINGLIGHT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MERCURYCEILINGLIGHT.EFFECT"
msgid ""
"Uses <link=\"MERCURY\">Mercury</link> and <link=\"POWER\">Power</link> to produce "
"<link=\"LIGHT\">Light</link>.\n"
"\n"
"Light reduces Duplicant stress and is required to grow certain plants."
msgstr ""
"Usa <link=\"MERCURY\">Mercúrio</link> e <link=\"POWER\">Energia</link> para produzir "
"<link=\"LIGHT\">Luz</link>.\n"
"\n"
"A luz reduz o estresse do Duplicante e é necessária para o cultivo de certas plantas."

#. STRINGS.BUILDINGS.PREFABS.MERCURYCEILINGLIGHT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MERCURYCEILINGLIGHT.NAME"
msgid "<link=\"MERCURYCEILINGLIGHT\">Mercury Ceiling Light</link>"
msgstr "<link=\"CEILINGLIGHT\">Lâmpada de Teto de Mercúrio</link>"

#. STRINGS.BUILDINGS.PREFABS.MESHTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MESHTILE.DESC"
msgid "Mesh tile can be used to make Duplicant pathways in areas where liquid flows."
msgstr ""
"Blocos de malha podem ser usados para Duplicantes andarem em áreas onde o líquido precisa fluir."

#. STRINGS.BUILDINGS.PREFABS.MESHTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MESHTILE.EFFECT"
msgid ""
"Used to build the walls and floors of rooms.\n"
"\n"
"Does not obstruct <link=\"ELEMENTSLIQUID\">Liquid</link> or <link=\"ELEMENTSGAS\">Gas</link> flow."
msgstr ""
"Usado para construir as paredes e pisos de quartos.\n"
"\n"
"Não obstrui o fluxo de <link=\"ELEMENTSLIQUID\">Líquidos</link> ou de <link=\"ELEMENTSGAS\">Gases</"
"link>."

#. STRINGS.BUILDINGS.PREFABS.MESHTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MESHTILE.NAME"
msgid "<link=\"MESHTILE\">Mesh Tile</link>"
msgstr "<link=\"MESHTILE\">Bloco de Malha</link>"

#. STRINGS.BUILDINGS.PREFABS.METALREFINERY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALREFINERY.DESC"
msgid "Refined metals are necessary to build advanced electronics and technologies."
msgstr "Metais refinados são necessários para construir tecnologias e eletrônicos avançados."

#. STRINGS.BUILDINGS.PREFABS.METALREFINERY.EFFECT
#| msgctxt "STRINGS.BUILDINGS.PREFABS.METALREFINERY.EFFECT"
#| msgid ""
#| "Produces <link=\"REFINEDMETAL\">Refined Metals</link> from raw <link=\"RAWMETAL\">Metal Ore</"
#| "link>.\n"
#| "\n"
#| "Significantly <link=\"HEAT\">Heats</link> and outputs the <link=\"ELEMENTSLIQUID\">Liquid</link> "
#| "piped into it.\n"
#| "\n"
#| "Duplicants will not fabricate items unless recipes are queued."
msgctxt "STRINGS.BUILDINGS.PREFABS.METALREFINERY.EFFECT"
msgid ""
"Produces <link=\"REFINEDMETAL\">Refined Metals</link> from raw <link=\"METAL\">Metal Ore</link>.\n"
"\n"
"Significantly <link=\"HEAT\">Heats</link> and outputs the <link=\"ELEMENTSLIQUID\">Liquid</link> "
"piped into it.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"Produz <link=\"REFINEDMETAL\">Metais Refinados</link> a partir de <link=\"METAL\">Minério de Metal</"
"link>.\n"
"\n"
"<link=\"HEAT\">Aquece</link> significativamente e libera os <link=\"ELEMENTSLIQUID\">Líquidos</"
"link> bombeados nela.\n"
"\n"
"Duplicantes não fabricarão itens a menos que receitas sejam pedidas."

#. STRINGS.BUILDINGS.PREFABS.METALREFINERY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALREFINERY.NAME"
msgid "<link=\"METALREFINERY\">Metal Refinery</link>"
msgstr "<link=\"METALREFINERY\">Refinaria de Metais</link>"

#. STRINGS.BUILDINGS.PREFABS.METALREFINERY.RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.METALREFINERY.RECIPE_DESCRIPTION"
msgid "Extracts pure {0} from {1}."
msgstr "Extrai {0} puro a partir de {1}."

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.AVERAGEQUALITYNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.AVERAGEQUALITYNAME"
msgid "Mediocre Metal Sculpture"
msgstr "Escultura de Metal Medíocre"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.DESC"
msgid "Duplicants who have learned art skills can produce more decorative sculptures."
msgstr "Duplicantes que aprenderam habilidades de arte podem produzir esculturas mais decorativas."

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.EFFECT"
msgid ""
"Majorly increases <link=\"DECOR\">Decor</link>, contributing to <link=\"MORALE\">Morale</link>.\n"
"\n"
"Must be sculpted by a Duplicant."
msgstr ""
"Aumenta a <link=\"DECOR\">Decoração</link>, contribuindo para o <link=\"MORALE\">Moral</link>.\n"
"\n"
"Precisa ser esculpida por um Duplicante."

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.EXCELLENTQUALITYNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.EXCELLENTQUALITYNAME"
msgid "Genius Metal Sculpture"
msgstr "Escultura de Metal Genial"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_1.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_1.DESC"
msgid "It's quite lovely, until someone stubs their toe on it in the dark."
msgstr "É muito bonita, até alguém bater o dedinho do pé nela, no escuro."

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_1.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_1.NAME"
msgid "<link=\"SCULPTUREMETALAMAZING1\">Insatiable Appetite</link>"
msgstr "<link=\"SCULPTUREMETALAMAZING1\">Apetite Insaciável</link>"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_2.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_2.DESC"
msgid "Not quite expressionist, but undeniably expressive."
msgstr "Não exatamente expressionista, mas inegavelmente expressiva."

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_2.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_2.NAME"
msgid "<link=\"SCULPTUREMETALAMAZING2\">Agape</link>"
msgstr "<link=\"SCULPTUREMETALAMAZING2\">Ágape</link>"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_3.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_3.DESC"
msgid "It emits no light, but it sure does brighten up a room."
msgstr "Não emite nenhuma luz, mas com certeza deixa um quarto radiante."

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_3.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_3.NAME"
msgid "<link=\"SCULPTUREMETALAMAZING3\">Friendly Flier</link>"
msgstr "<link=\"SCULPTUREMETALAMAZING3\">Voador Amigo</link>"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_4.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_4.DESC"
msgid "A masterful likeness of the mischievous critter that Duplicants love to love."
msgstr "Uma semelhança grandiosa da criatura travessa que os Duplicantes amam amar."

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_4.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_4.NAME"
msgid "<link=\"SCULPTUREMETALAMAZING4\">Whatta Pip</link>"
msgstr "<link=\"SCULPTUREMETALAMAZING4\">Que Bela Esquilosa</link>"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_5.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_5.DESC"
msgid "What if the entire head is one big bump?"
msgstr "E se a cabeça inteira fosse um só caroço grandão?"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_5.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_5.NAME"
msgid "<link=\"SCULPTUREMETALAMAZING5\">Phrenologist's Dream</link>"
msgstr "<link=\"SCULPTUREMETALAMAZING5\">Sonho de um Frenologista</link>"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_CRAP_1.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_CRAP_1.DESC"
msgid "Actually, it's a very good likeness."
msgstr "Na verdade, é até bem semelhante."

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_CRAP_1.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_CRAP_1.NAME"
msgid "<link=\"SCULPTUREMETALCRAP1\">Unnatural Beauty</link>"
msgstr "<link=\"SCULPTUREMETALCRAP1\">Beleza Surreal</link>"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_GOOD_1.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_GOOD_1.DESC"
msgid "The Morb's eye is mounted on a swivel that activates at random intervals."
msgstr "O olho do Morb é montado em um suporte que se ativa em intervalos aleatórios."

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_GOOD_1.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_GOOD_1.NAME"
msgid "<link=\"SCULPTUREMETALGOOD1\">Beautiful Biohazard</link>"
msgstr "<link=\"SCULPTUREMETALGOOD1\">Belo Risco Biológico</link>"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.NAME"
msgid "<link=\"METALSCULPTURE\">Metal Block</link>"
msgstr "<link=\"METALSCULPTURE\">Bloco de Metal</link>"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.POORQUALITYNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.POORQUALITYNAME"
msgid "\"Abstract\" Metal Sculpture"
msgstr "Escultura de Metal \"Abstrata\""

#. STRINGS.BUILDINGS.PREFABS.METALTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALTILE.DESC"
msgid "Heat travels much more quickly through metal tile than other types of flooring."
msgstr "Calor viaja muito mais rápido em blocos de metal do que em outros tipos de blocos."

#. STRINGS.BUILDINGS.PREFABS.METALTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.METALTILE.EFFECT"
msgid ""
"Used to build the walls and floors of rooms.\n"
"\n"
"Significantly increases Duplicant runspeed."
msgstr ""
"Pode ser usado para construir pisos e paredes de salas.\n"
"\n"
"Aumenta consideravelmente a velocidade dos Duplicantes."

#. STRINGS.BUILDINGS.PREFABS.METALTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALTILE.NAME"
msgid "<link=\"METALTILE\">Metal Tile</link>"
msgstr "<link=\"METALTILE\">Bloco de Metal</link>"

#. STRINGS.BUILDINGS.PREFABS.METHANEGENERATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METHANEGENERATOR.DESC"
msgid "Natural gas generators leak polluted water and are best built above a waste reservoir."
msgstr ""
"Geradores de gás natural vazam água poluída e recomenda-se construí-los acima de um reservatório de "
"resíduos."

#. STRINGS.BUILDINGS.PREFABS.METHANEGENERATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.METHANEGENERATOR.EFFECT"
msgid ""
"Converts <link=\"METHANE\">Natural Gas</link> into electrical <link=\"POWER\">Power</link>.\n"
"\n"
"Produces <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> and <link=\"DIRTYWATER\">Polluted Water</"
"link>."
msgstr ""
"Converte <link=\"METHANE\">Gás Natural</link> em <link=\"POWER\">Energia</link> elétrica.\n"
"\n"
"Produz <link=\"CARBONDIOXIDE\">Dióxido de Carbono</link> e <link=\"DIRTYWATER\">Água Poluída</link>."

#. STRINGS.BUILDINGS.PREFABS.METHANEGENERATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METHANEGENERATOR.NAME"
msgid "<link=\"METHANEGENERATOR\">Natural Gas Generator</link>"
msgstr "<link=\"METHANEGENERATOR\">Gerador à Gás Natural</link>"

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.DESC"
msgid "Musher recipes will keep Duplicants fed, but may impact health and morale over time."
msgstr ""
"As receitas do Misturador manterão os Duplicantes alimentados, mas podem impactar a saúde e a moral "
"ao longo do tempo."

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.EFFECT"
msgid ""
"Produces low quality <link=\"FOOD\">Food</link> using common ingredients.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"Produz <link=\"FOOD\">Alimento</link> de baixa qualidade usando ingredientes comuns.\n"
"\n"
"Duplicantes não irão fabricar enquanto receitas não forem colocadas na fila."

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.BLUE_BABYTEARS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.BLUE_BABYTEARS.DESC"
msgid "Prioritizes nutritional value over flavor."
msgstr "Prioriza o valor nutricional ao invés do sabor."

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.BLUE_BABYTEARS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.BLUE_BABYTEARS.NAME"
msgid "<link=\"MICROBEMUSHER\">Weepy Blue Microbe Musher</link>"
msgstr "<link=\"MICROBEMUSHER\">Misturador de Micróbios Azul Chorão</link>"

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.DEFAULT_MICROBEMUSHER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.DEFAULT_MICROBEMUSHER.DESC"
msgid "Musher recipes will keep Duplicants fed, but may impact health and morale over time."
msgstr ""
"As receitas do Misturador manterão os Duplicantes alimentados, mas podem impactar a saúde e a moral "
"ao longo do tempo."

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.DEFAULT_MICROBEMUSHER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.DEFAULT_MICROBEMUSHER.NAME"
msgid "<link=\"MICROBEMUSHER\">Microbe Musher</link>"
msgstr "<link=\"MICROBEMUSHER\">Misturador de Micróbios</link>"

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.GREEN_MUSH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.GREEN_MUSH.DESC"
msgid "Edible colloids for dinner <i>again</i>?"
msgstr "Colóides comestíveis para o jantar <i>de novo</i>?"

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.GREEN_MUSH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.GREEN_MUSH.NAME"
msgid "<link=\"MICROBEMUSHER\">Mush Green Microbe Musher</link>"
msgstr "<link=\"MICROBEMUSHER\">Misturador de Micróbios Verde Lama</link>"

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.PURPLE_BRAINFAT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.PURPLE_BRAINFAT.DESC"
msgid "A colorful distraction from the actual quality of the food."
msgstr "Uma distração colorida da qualidade real do alimento."

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.PURPLE_BRAINFAT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.PURPLE_BRAINFAT.NAME"
msgid "<link=\"MICROBEMUSHER\">Faint Purple Microbe Musher</link>"
msgstr "<link=\"MICROBEMUSHER\">Misturador de Micróbios Roxo-Pálido</link>"

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.RED_ROSE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.RED_ROSE.DESC"
msgid "Hunger strikes are not an option, but color-coordination is."
msgstr "As greves de fome não são uma opção, mas a coordenação de cores é."

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.RED_ROSE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.RED_ROSE.NAME"
msgid "<link=\"MICROBEMUSHER\">Puce Pink Microbe Musher</link>"
msgstr "<link=\"MICROBEMUSHER\">Misturador de Micróbios Rosa-Púrpura</link>"

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.YELLOW_TARTAR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.YELLOW_TARTAR.DESC"
msgid "Makes meals that are memorable for all the wrong reasons."
msgstr "Faz refeições que são memoráveis pelas razões erradas."

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.YELLOW_TARTAR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.YELLOW_TARTAR.NAME"
msgid "<link=\"MICROBEMUSHER\">Ick Yellow Microbe Musher</link>"
msgstr "<link=\"MICROBEMUSHER\">Misturador de Micróbios Amarelo</link>"

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.NAME"
msgid "<link=\"MICROBEMUSHER\">Microbe Musher</link>"
msgstr "<link=\"MICROBEMUSHER\">Misturador de Micróbios</link>"

#. STRINGS.BUILDINGS.PREFABS.MILKFATSEPARATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKFATSEPARATOR.DESC"
msgid "Duplicants can slather up with brackwax to increase their travel speed in transit tubes."
msgstr ""
"Duplicantes podem se lambuzar com Muunteiga para aumentar sua velocidade de viagem nos tubos de "
"transporte."

#. STRINGS.BUILDINGS.PREFABS.MILKFATSEPARATOR.EFFECT
#| msgctxt "STRINGS.BUILDINGS.PREFABS.MILKFATSEPARATOR.EFFECT"
#| msgid ""
#| "Refines <link=\"MILK\">Brackene</link> into <link=\"BRINE\">Brine</link> and "
#| "<link=\"MILKFAT\">Brackwax</link>, and emits <link=\"CARBONDIOXIDE\">Carbon Dioxide</link>."
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKFATSEPARATOR.EFFECT"
msgid ""
"Refines <link=\"MILK\">Brackene</link> into <link=\"BRINE\">Brine</link> and "
"<link=\"MILKFAT\">Brackwax</link>, and <link=\"FISHMILK\">Ovolene</link> into "
"<link=\"CAVIAR\">Caviar</link> and <link=\"MUCUS\">Mucin</link>."
msgstr ""
"Refina <link=\"MILK\">Leite Muu</link> em <link=\"BRINE\">Salmoura</link> e "
"<link=\"MILKFAT\">Manteiga Muu</link>, e <link=\"FISHMILK\">Ovolene</link> em "
"<link=\"CAVIAR\">Caviar</link> e <link=\"MUCUS\">Muco</link>."

#. STRINGS.BUILDINGS.PREFABS.MILKFATSEPARATOR.NAME
#| msgctxt "STRINGS.BUILDINGS.PREFABS.MILKFATSEPARATOR.NAME"
#| msgid "<link=\"MILKFATSEPARATOR\">Brackwax Gleaner</link>"
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKFATSEPARATOR.NAME"
msgid "<link=\"MILKFATSEPARATOR\">Gleaner</link>"
msgstr "<link=\"MILKFATSEPARATOR\">Batedeira</link>"

#. STRINGS.BUILDINGS.PREFABS.MILKFEEDER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKFEEDER.DESC"
msgid "Providing beverages to critters makes them feel taken care of."
msgstr "Fornecer refrescos às criaturas as faz sentir bem cuidadas."

#. STRINGS.BUILDINGS.PREFABS.MILKFEEDER.EFFECT
#| msgctxt "STRINGS.BUILDINGS.PREFABS.MILKFEEDER.EFFECT"
#| msgid ""
#| "Dispenses <link=\"MILK\">Brackene</link> to a wide variety of <link=\"CREATURES\">Critters</"
#| "link>.\n"
#| "\n"
#| "Accessing the fountain significantly improves <link=\"CREATURES\">Critters</link>' moods."
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKFEEDER.EFFECT"
msgid ""
"Dispenses <link=\"MILK\">Brackene</link> or <link=\"INK\">Squid Ink</link> to a wide variety of "
"<link=\"CREATURES\">Critters</link>.\n"
"\n"
"Accessing the fountain significantly improves <link=\"CREATURES\">Critters</link>' moods."
msgstr ""
"Libera <link=\"MILK\">Leite Muu</link> ou <link=\"INK\">Tinta de Lula</link> para uma grande "
"variedade de <link=\"CREATURES\">Criaturas</link>.\n"
"\n"
"Acessar a fonte melhora significativamente o humor das <link=\"CREATURES\">Criaturas</link>."

#. STRINGS.BUILDINGS.PREFABS.MILKFEEDER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKFEEDER.NAME"
msgid "<link=\"MILKFEEDER\">Critter Fountain</link>"
msgstr "<link=\"MILKFEEDER\">Fonte para Criaturas</link>"

#. STRINGS.BUILDINGS.PREFABS.MILKINGSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKINGSTATION.DESC"
msgid "Brackene can be used at the Critter Fountain to improve critters' moods."
msgstr "Leite Muu pode ser usado na Fonte de Criaturas para melhorar o humor delas."

#. STRINGS.BUILDINGS.PREFABS.MILKINGSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKINGSTATION.EFFECT"
msgid ""
"Allows Duplicants with the <link=\"RANCHING2\">Critter Ranching II</link> skill to milk "
"<link=\"MOOSPECIES\">Moos</link> for  <link=\"MILK\">Brackene</link> or  "
"<link=\"REFINEDLIPID\">Biodiesel</link>."
msgstr ""
"Permite que os Duplicantes com a habilidade <link=\"RANCHING2\">Pecuária II</link> ordenhem "
"<link=\"MOOSPECIES\">Muus Gasosos</link> para obter <link=\"MILK\">Leite Muu</link> ou "
"<link=\"REFINEDLIPID\">Biodiesel</link>."

#. STRINGS.BUILDINGS.PREFABS.MILKINGSTATION.NAME
