msgid "The original scratch-and-sniff version was immediately recalled."
msgstr "A versão original de 'esfregar e cheirar' foi imediatamente cancelada."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TROPICAL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TROPICAL.NAME"
msgid "<link=\"EXTERIORWALL\">Sporechid Print</link>"
msgstr "<link=\"EXTERIORWALL\">Estampa de Orquíesporo</link>"

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.WATERMELON.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.WATERMELON.DESC"
msgid "Far more practical than gluing real fruit on a wall."
msgstr "Bem mais prático que colar uma fruta de verdade na parede."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.WATERMELON.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.WATERMELON.NAME"
msgid "<link=\"EXTERIORWALL\">Juicy Watermelon</link>"
msgstr "<link=\"EXTERIORWALL\">Melancia Suculenta</link>"

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.NAME"
msgid "<link=\"EXTERIORWALL\">Drywall</link>"
msgstr "<link=\"EXTERIORWALL\">Parede de Gesso</link>"

#. STRINGS.BUILDINGS.PREFABS.FABRICATEDWOODMAKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FABRICATEDWOODMAKER.DESC"
msgid "Flattened plant bits are a useful wood substitute."
msgstr "Pedaços de planta amassados são um bom substituto para madeira."

#. STRINGS.BUILDINGS.PREFABS.FABRICATEDWOODMAKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FABRICATEDWOODMAKER.EFFECT"
msgid ""
"Combines a Binder liquid and <link=\"PLANTFIBER\">Plant Husk</link> to create "
"<link=\"FABRICATEDWOOD\">Plywood</link>."
msgstr ""
"Combina um líquido aglutinante e <link=\"PLANTFIBER\">Casca de Planta</link> para criar "
"<link=\"FABRICATEDWOOD\">Compensado</link>."

#. STRINGS.BUILDINGS.PREFABS.FABRICATEDWOODMAKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FABRICATEDWOODMAKER.NAME"
msgid "<link=\"FABRICATEDWOODMAKER\">Plywood Press</link>"
msgstr "<link=\"FABRICATEDWOODMAKER\">Prensa de Compensado</link>"

#. STRINGS.BUILDINGS.PREFABS.FABRICATEDWOODMAKER.RECIPE_DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FABRICATEDWOODMAKER.RECIPE_DESC"
msgid "Combines {0} and {1} to create {2}."
msgstr "Combina {0} e {1} para criar {2}."

#. STRINGS.BUILDINGS.PREFABS.FACILITYBACKWALLWINDOW.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FACILITYBACKWALLWINDOW.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.FACILITYBACKWALLWINDOW.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FACILITYBACKWALLWINDOW.EFFECT"
msgid "A tall, thin window."
msgstr "Uma janela alta e fina."

#. STRINGS.BUILDINGS.PREFABS.FACILITYBACKWALLWINDOW.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FACILITYBACKWALLWINDOW.NAME"
msgid "Window"
msgstr "Janela"

#. STRINGS.BUILDINGS.PREFABS.FARMSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FARMSTATION.DESC"
msgid "This station only has an effect on crops grown within the same room."
msgstr "Esta estação só afeta plantas que estão crescendo na mesma sala que ela."

#. STRINGS.BUILDINGS.PREFABS.FARMSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FARMSTATION.EFFECT"
msgid ""
"Produces <link=\"FARMSTATIONTOOLS\">Micronutrient Fertilizer</link> to increase "
"<link=\"PLANTS\">Plant</link> growth rates.\n"
"\n"
"Assigned Duplicants must possess the <link=\"FARMING2\">Crop Tending</link> trait.\n"
"\n"
"This building is a necessary component of the Greenhouse room."
msgstr ""
"Produz <link=\"FARMSTATIONTOOLS\">Fertilizante de Micronutrientes</link> para aumentar as taxas de "
"crescimento das <link=\"PLANTS\">Plantas</link>.\n"
"\n"
"Duplicantes designados precisam possuir o traço <link=\"FARMING2\">Cuidado de Plantas</link>.\n"
"\n"
"Esta estrutura é um componente necessário da sala de Estufa."

#. STRINGS.BUILDINGS.PREFABS.FARMSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FARMSTATION.NAME"
msgid "<link=\"FARMSTATION\">Farm Station</link>"
msgstr "<link=\"FARMSTATION\">Estação de Agricultura</link>"

#. STRINGS.BUILDINGS.PREFABS.FARMTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FARMTILE.DESC"
msgid "Duplicants can deliver fertilizer and liquids to farm tiles, accelerating plant growth."
msgstr ""
"Duplicantes podem entregar fertilizante e líquidos para blocos de horta, acelerando o crescimento "
"da planta."

#. STRINGS.BUILDINGS.PREFABS.FARMTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FARMTILE.EFFECT"
msgid ""
"Grows one <link=\"PLANTS\">Plant</link> from a <link=\"PLANTS\">Seed</link>.\n"
"\n"
"Can be used as floor tile and rotated before construction."
msgstr ""
"Germina uma <link=\"PLANTS\">Planta</link> a partir de uma <link=\"PLANTS\">Semente</link>.\n"
"\n"
"Pode ser usada como bloco e rotacionada antes da construção."

#. STRINGS.BUILDINGS.PREFABS.FARMTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FARMTILE.NAME"
msgid "<link=\"FARMTILE\">Farm Tile</link>"
msgstr "<link=\"FARMTILE\">Bloco de Horta</link>"

#. STRINGS.BUILDINGS.PREFABS.FERTILIZERMAKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FERTILIZERMAKER.DESC"
msgid "Fertilizer synthesizers convert polluted dirt into fertilizer for domestic plants."
msgstr ""
"Sintetizadores de Fertilizante convertem terra poluída em fertilizante para plantas domésticas."

#. STRINGS.BUILDINGS.PREFABS.FERTILIZERMAKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FERTILIZERMAKER.EFFECT"
msgid ""
"Uses <link=\"DIRTYWATER\">Polluted Water</link> and <link=\"PHOSPHORITE\">Phosphorite</link> to "
"produce <link=\"FERTILIZER\">Fertilizer</link>."
msgstr ""
"Usa <link=\"DIRTYWATER\">Água Poluída</link> e <link=\"PHOSPHORITE\">Fosforito</link> para produzir "
"<link=\"FERTILIZER\">Fertilizante</link>."

#. STRINGS.BUILDINGS.PREFABS.FERTILIZERMAKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FERTILIZERMAKER.NAME"
msgid "<link=\"FERTILIZERMAKER\">Fertilizer Synthesizer</link>"
msgstr "<link=\"FERTILIZERMAKER\">Sintetizador de Fertilizante</link>"

#. STRINGS.BUILDINGS.PREFABS.FIREPOLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FIREPOLE.DESC"
msgid "Build these in addition to ladders for efficient upward and downward movement."
msgstr "Construa estes junto as escadas para movimentos eficientes de subida e descida."

#. STRINGS.BUILDINGS.PREFABS.FIREPOLE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FIREPOLE.EFFECT"
msgid ""
"Allows rapid Duplicant descent.\n"
"\n"
"Significantly slows upward climbing."
msgstr ""
"Permite rápida descida dos Duplicantes.\n"
"\n"
"Reduz significativamente a velocidade de subida."

#. STRINGS.BUILDINGS.PREFABS.FIREPOLE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FIREPOLE.NAME"
msgid "<link=\"FIREPOLE\">Fire Pole</link>"
msgstr "<link=\"FIREPOLE\">Poste de Bombeiro</link>"

#. STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.DESC"
msgid "A fish release must be built in liquid to prevent released fish from suffocating."
msgstr ""
"Um ponto de soltura de peixes precisa ser construído sobre líquido para prevenir que os peixes "
"soltos se sufoquem."

#. STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.EFFECT
#| msgctxt "STRINGS.BUILDINGS.PREFABS.CREATUREDELIVERYPOINT.EFFECT"
#| msgid ""
#| "Releases trapped <link=\"CREATURES\">Critters</link> back into the world.\n"
#| "\n"
#| "Can be used multiple times."
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.EFFECT"
msgid ""
"Releases trapped aquatic critters back into the world.\n"
"\n"
"Can be used multiple times."
msgstr ""
"Solta criaturas aquáticas presas de volta ao mundo.\n"
"\n"
"Pode ser usado múltiplas vezes."

#. STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.LOGIC_INPUT.DESC
#| msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERDROPOFF.LOGIC_INPUT.DESC"
#| msgid "Enable/Disable"
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.LOGIC_INPUT.DESC"
msgid "Enable/Disable"
msgstr "Ativar/Desativar"

#. STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.LOGIC_INPUT.LOGIC_PORT_ACTIVE
#| msgctxt "STRINGS.UI.LOGIC_PORTS.CONTROL_OPERATIONAL_ACTIVE"
#| msgid "<b><style=\"logic_on\">Green Signal</style></b>: Enable building"
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.LOGIC_INPUT.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Enable fish release"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Ativa a soltura de peixes"

#. STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.LOGIC_INPUT.LOGIC_PORT_INACTIVE
#| msgctxt "STRINGS.UI.LOGIC_PORTS.CONTROL_OPERATIONAL_INACTIVE"
#| msgid "<b><style=\"logic_off\">Red Signal</style></b>: Disable building"
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.LOGIC_INPUT.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Disable fish release"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Desativa a soltura de peixes"

#. STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.NAME"
msgid "<link=\"FISHDELIVERYPOINT\">Fish Release</link>"
msgstr "<link=\"FISHDELIVERYPOINT\">Ponto de Soltura de Peixes</link>"

#. STRINGS.BUILDINGS.PREFABS.FISHFEEDER.DESC
#| msgctxt "STRINGS.BUILDINGS.PREFABS.FISHFEEDER.DESC"
#| msgid "Build this feeder above a body of water to feed the fish within."
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHFEEDER.DESC"
msgid "Build this feeder above a body of water to feed and tame the fish within."
msgstr "Construa esse alimentador acima da água para alimentar e domesticar os peixes abaixo."

#. STRINGS.BUILDINGS.PREFABS.FISHFEEDER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHFEEDER.EFFECT"
msgid ""
"Automatically dispenses stored <link=\"CREATURES\">Critter</link> food into the area below.\n"
"\n"
"Dispenses continuously as food is consumed."
msgstr ""
"Libera automaticamente alimento armazenado para as <link=\"CREATURES\">Criaturas</link> na área "
"abaixo.\n"
"\n"
"Libera continuamente enquanto o alimento é consumido."

#. STRINGS.BUILDINGS.PREFABS.FISHFEEDER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHFEEDER.NAME"
msgid "<link=\"FISHFEEDER\">Fish Feeder</link>"
msgstr "<link=\"CREATUREFEEDER\">Alimentador de Peixes</link>"

#. STRINGS.BUILDINGS.PREFABS.FISHPICKUP.DESC
#| msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERPICKUP.DESC"
#| msgid "Duplicants will automatically wrangle excess critters."
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHPICKUP.DESC"
msgid "Duplicants will automatically wrangle excess fish from the pool below."
msgstr "Os Duplicantes capturarão automaticamente o excesso de peixes do tanque abaixo."

#. STRINGS.BUILDINGS.PREFABS.FISHPICKUP.EFFECT
#| msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERPICKUP.EFFECT"
#| msgid ""
#| "Ensures the prompt relocation of <link=\"CREATURES\">Critters</link> that exceed the maximum "
#| "amount set.\n"
#| "\n"
#| "Monitoring and pick-up are limited to the specified species."
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHPICKUP.EFFECT"
msgid ""
"Ensures the prompt capture of aquatic <link=\"CREATURES\">Critters</link> that exceed the maximum "
"amount set.\n"
"\n"
"Monitoring and pick-up are limited to the specified species.\n"
"\n"
"Must be built above a <link=\"ELEMENTSLIQUID\">Liquid</link> pool."
msgstr ""
"Garante a captura de <link=\"CREATURES\">Criaturas</link> aquáticas que excederem o máximo "
"definido.\n"
"\n"
"Monitoramento e captura são limitados à espécie especificada.\n"
"\n"
"Deve ser construído acima de uma piscina com <link=\"ELEMENTSLIQUID\">Líquidos</link>."

#. STRINGS.BUILDINGS.PREFABS.FISHPICKUP.LOGIC_INPUT.DESC
#| msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERDROPOFF.LOGIC_INPUT.DESC"
#| msgid "Enable/Disable"
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHPICKUP.LOGIC_INPUT.DESC"
msgid "Enable/Disable"
msgstr "Ativar/Desativar"

#. STRINGS.BUILDINGS.PREFABS.FISHPICKUP.LOGIC_INPUT.LOGIC_PORT_ACTIVE
#| msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERPICKUP.LOGIC_INPUT.LOGIC_PORT_ACTIVE"
#| msgid "<b><style=\"logic_on\">Green Signal</style></b>: Wrangle excess critters"
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHPICKUP.LOGIC_INPUT.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Wrangle excess fish"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Capturar peixes em excesso"

#. STRINGS.BUILDINGS.PREFABS.FISHPICKUP.LOGIC_INPUT.LOGIC_PORT_INACTIVE
#| msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERPICKUP.LOGIC_INPUT.LOGIC_PORT_INACTIVE"
#| msgid "<b><style=\"logic_off\">Red Signal</style></b>: Ignore excess critters"
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHPICKUP.LOGIC_INPUT.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Ignore excess fish"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Ignorar peixes em excesso"

#. STRINGS.BUILDINGS.PREFABS.FISHPICKUP.NAME
#| msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERPICKUP.NAME"
#| msgid "<link=\"CRITTERPICKUP\">Critter Pick-Up</link>"
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHPICKUP.NAME"
msgid "<link=\"FISHPICKUP\">Fish Pick-Up</link>"
msgstr "<link=\"FISHPICKUP\">Captura de Peixes</link>"

#. STRINGS.BUILDINGS.PREFABS.FISHTRAP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHTRAP.DESC"
msgid "Trapped fish will automatically be bagged for transport."
msgstr "Peixes capturados serão automaticamente ensacados para o transporte."

#. STRINGS.BUILDINGS.PREFABS.FISHTRAP.EFFECT
#| msgctxt "STRINGS.BUILDINGS.PREFABS.FISHTRAP.EFFECT"
#| msgid ""
#| "Attracts and traps swimming <link=\"PACU\">Pacu</link>.\n"
#| "\n"
#| "Single use."
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHTRAP.EFFECT"
msgid ""
"Attracts and traps aquatic <link=\"CREATURES\">Critters</link>.\n"
"\n"
"Single use."
msgstr ""
"Atrai e captura <link=\"CREATURES\">Criaturas</link> aquáticas.\n"
"\n"
"Uso único."

#. STRINGS.BUILDINGS.PREFABS.FISHTRAP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHTRAP.NAME"
msgid "<link=\"FISHTRAP\">Fish Trap</link>"
msgstr "<link=\"FISHTRAP\">Armadilha de Peixes</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.DESC"
msgid "Any building's light emitting radius can be viewed in the light overlay."
msgstr "O raio de luz emitido por qualquer estrutura pode ser visualizado no painel luz."

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.EFFECT"
msgid ""
"Provides <link=\"LIGHT\">Light</link> when <link=\"POWER\">Powered</link>.\n"
"\n"
"Increases Duplicant workspeed within light radius."
msgstr ""
"Fornece <link=\"LIGHT\">Luz</link> quando <link=\"POWER\">Energizada</link>.\n"
"\n"
"Aumenta a velocidade de trabalho dos Duplicantes dentro do raio de luz."

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.BRISTLEBLOSSOM.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.BRISTLEBLOSSOM.DESC"
msgid "It's a bit prickly, but it casts a festive glow."
msgstr "É um pouco espinhosa, mas emite um brilho festivo."

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.BRISTLEBLOSSOM.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.BRISTLEBLOSSOM.NAME"
msgid "<link=\"FLOORLAMP\">Holiday Lamp</link>"
msgstr "<link=\"FLOORLAMP\">Luminária Festiva</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.DEFAULT_FLOORLAMP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.DEFAULT_FLOORLAMP.DESC"
msgid "Any building's light emitting radius can be viewed in the light overlay."
msgstr "O raio de emissão de luz de qualquer edifício pode ser visualizado no painel de luz."

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.DEFAULT_FLOORLAMP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.DEFAULT_FLOORLAMP.NAME"
msgid "<link=\"FLOORLAMP\">Lamp</link>"
msgstr "<link=\"FLOORLAMP\">Luminária</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.LEG.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.LEG.DESC"
msgid "This lamp blazes forth in unparalleled glory."
msgstr "Esta lâmpada brilha em glória incomparável."

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.LEG.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.LEG.NAME"
msgid "<link=\"FLOORLAMP\">Fragile Leg Lamp</link>"
msgstr "<link=\"FLOORLAMP\">Luminária Perna Frágil</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.NAME"
msgid "<link=\"FLOORLAMP\">Lamp</link>"
msgstr "<link=\"FLOORLAMP\">Luminária</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.DESC"
msgid "Weight plates can be used to turn on amenities only when Duplicants pass by."
msgstr "Placas de pressão podem ser usadas para ligar estruturas somente quando Duplicantes passarem."

#. STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> when an object or Duplicant is placed atop "
"of it.\n"
"\n"
"Cannot be triggered by <link=\"ELEMENTSGAS\">Gas</link> or <link=\"ELEMENTSLIQUID\">Liquids</link>."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> quando um objeto ou Duplicante é colocado "
"em cima dela.\n"
"\n"
"Não pode ser ativada por <link=\"ELEMENTSGAS\">Gases</link> ou <link=\"ELEMENTSLIQUID\">Líquidos</"
"link>."

#. STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.LOGIC_PORT_DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.LOGIC_PORT_DESC"
msgid "<link=\"LOGIC\">Active</link>/<link=\"LOGIC\">Inactive</link>"
msgstr "<link=\"LOGIC\">Ativo</link>/<link=\"LOGIC\">Inativo</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.NAME"
msgid "<link=\"FLOORSWITCH\">Weight Plate</link>"
msgstr "<link=\"FLOORSWITCH\">Placa de Pressão</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.DESC"
msgid "Flower pots allow decorative plants to be moved to new locations."
msgstr "Vasos de flores permitem que plantas decorativas sejam movidas para novos locais."

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.EFFECT"
msgid ""
"Houses a single <link=\"PLANTS\">Plant</link> when sown with a <link=\"PLANTS\">Seed</link>.\n"
"\n"
"Increases <link=\"DECOR\">Decor</link> when in use, contributing to <link=\"MORALE\">Morale</link>."
msgstr ""
"Germina uma única <link=\"PLANTS\">Planta</link> quando semeado com uma <link=\"PLANTS\">Semente</"
"link>.\n"
"\n"
"Aumenta a <link=\"DECOR\">Decoração</link> quando em uso, contribuindo para o "
"<link=\"MORALE\">Moral</link>."

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.DEFAULT_FLOWERVASE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.DEFAULT_FLOWERVASE.DESC"
msgid "The original container for plants on the move."
msgstr "O recipiente original para plantas em movimento."

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.DEFAULT_FLOWERVASE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.DEFAULT_FLOWERVASE.NAME"
msgid "<link=\"FLOWERVASE\">Flower Pot</link>"
msgstr "<link=\"FLOWERVASE\">Vaso de Flores</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BOLD.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BOLD.DESC"
msgid "A funky red flower pot for plants on the move."
msgstr "Um vaso de flores vermelho listrado para plantas em movimento."

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BOLD.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BOLD.NAME"
msgid "<link=\"FLOWERVASE\">Bold Retro Flower Pot</link>"
msgstr "<link=\"FLOWERVASE\">Vaso de Flores Retrô Ousado</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BRIGHT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BRIGHT.DESC"
msgid "A funky green flower pot for plants on the move."
msgstr "Um vaso de flores verde listrado para plantas em movimento."

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BRIGHT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BRIGHT.NAME"
msgid "<link=\"FLOWERVASE\">Bright Retro Flower Pot</link>"
msgstr "<link=\"FLOWERVASE\">Vaso de Flores Retrô Radiante</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_DREAMY.DESC
