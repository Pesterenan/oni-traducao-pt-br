#. STRINGS.ELEMENTS.HARDPOLYPROPYLENE.DESC
msgctxt "STRINGS.ELEMENTS.HARDPOLYPROPYLENE.DESC"
msgid ""
"<link=\"HARDPOLYPROPYLENE\">Plastium</link> is an advanced thermoplastic polymer made from "
"<link=\"TEMPCONDUCTORSOLID\">Thermium</link>, <link=\"POLYPROPYLENE\">Plastic</link> and "
"<link=\"MILKFAT\">Brackwax</link>.\n"
"\n"
