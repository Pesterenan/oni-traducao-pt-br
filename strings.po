msgstr "<link=\"ICECAVESFORAGEPLANTPLANTED\">Planta Frutaçaí</link>"

#. STRINGS.CREATURES.SPECIES.ICEFLOWER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEFLOWER.DESC"
msgid ""
"Idyllas are <link=\"DECOR\">Decorative</link> <link=\"PLANTS\">Plants</link> with soft, pompom-"
"shaped blossoms.\n"
"\n"
"Gazing dreamily at them has a positive effect on <link=\"MORALE\">Morale</link>."
msgstr ""
"Idílias são <link=\"PLANTS\">Plantas</link> <link=\"DECOR\">Decorativas</link> com botões suaves, "
"parecidos com pompoms.\n"
"\n"
"Contemplá-las com ar sonhador tem um efeito positivo no <link=\"MORALE\">Moral</link>."

#. STRINGS.CREATURES.SPECIES.ICEFLOWER.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEFLOWER.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "Esta planta melhora a <link=\"DECOR\">Decoração</link> do ambiente."

