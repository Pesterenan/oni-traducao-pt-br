msgid "New Event: Artifact Analyzed"
msgstr "Novo Evento: Artefato Analisado"

#. STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.CREATURE_SPAWN.DESCRIPTION
msgctxt "STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.CREATURE_SPAWN.DESCRIPTION"
msgid "There was a massive influx of destructive critters"
msgstr "Houve um influxo massivo de criaturas destrutivas"

#. STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.CREATURE_SPAWN.NAME
msgctxt "STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.CREATURE_SPAWN.NAME"
msgid "Critter Infestation"
msgstr "Infestação de Criaturas"

#. STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.CRYOFRIEND.BUTTON
msgctxt "STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.CRYOFRIEND.BUTTON"
msgid "{friend} is thawed!"
msgstr "{friend} está descongelado!"

#. STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.CRYOFRIEND.DESCRIPTION
msgctxt "STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.CRYOFRIEND.DESCRIPTION"
msgid ""
"{dupe} has made an amazing discovery! A barely working <link=\"CRYOTANK\">Cryotank 3000</link> has "
"been uncovered containing a {friend} inside in a frozen state.\n"
"\n"
"{dupe} was successful in thawing {friend} and this encounter has filled both Duplicants with a "
"sense of hope, something they will desperately need to keep their <link=\"MORALE\">Morale</link> up "
"when facing the dangers ahead."
msgstr ""
"{dupe} fez uma descoberta incrível! Um <link=\"CRYOTANK\">Criotanque 3000</link> foi descoberto "
"contendo um {friend} em um estado congelado.\n"
"\n"
"{dupe} conseguiu descongelar {friend} e este encontro encheu ambos Duplicantes com um sentimento de "
"esperança, algo que eles irão precisar desesperadamente para manter seu <link=\"MORALE\">Moral</"
"link> alto ao enfrentar os perigos que virão."

#. STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.CRYOFRIEND.NAME
msgctxt "STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.CRYOFRIEND.NAME"
msgid "New Event: A Frozen Friend"
msgstr "Novo Evento: Um Amigo Congelado"

#. STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.ECLIPSE.DESCRIPTION
msgctxt "STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.ECLIPSE.DESCRIPTION"
msgid "A celestial object has obscured the sunlight"
msgstr "Um corpo celeste obstruiu a luz solar"

#. STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.ECLIPSE.NAME
msgctxt "STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.ECLIPSE.NAME"
msgid "Eclipse"
msgstr "Eclipse"

