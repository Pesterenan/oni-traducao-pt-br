msgstr "Cara Triste"

#. STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.FOOD_FIGHT.REJECT_OPTION_NAME
msgctxt "STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.FOOD_FIGHT.REJECT_OPTION_NAME"
msgid "No food fight today"
msgstr "Sem guerra de comida hoje"

