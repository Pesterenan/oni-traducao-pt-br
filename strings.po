msgstr "Toc-Toc"

#. STRINGS.CODEX.STORY_TRAITS.LONELYMINION.KNOCK_KNOCK.TOOLTIP
msgctxt "STRINGS.CODEX.STORY_TRAITS.LONELYMINION.KNOCK_KNOCK.TOOLTIP"
msgid "Approach this building and welcome its occupant"
msgstr "Aproximar dessa estrutura e dar boas vindas ao seu ocupante"

#. STRINGS.CODEX.STORY_TRAITS.LONELYMINION.NAME
msgctxt "STRINGS.CODEX.STORY_TRAITS.LONELYMINION.NAME"
