#. STRINGS.CREATURES.SPECIES.OXYFERN.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OXYFERN.DESC"
msgid ""
"Oxyferns absorb <link=\"CARBONDIOXIDE\">Carbon Dioxide Gas</link> and exude breathable "
"<link=\"OXYGEN\">Oxygen</link>."
msgstr ""
"Oximambaias absorvem <link=\"CARBONDIOXIDE\">Dióxido de Carbono</link> e expiram "
"<link=\"OXYGEN\">Oxigênio</link> respirável."

#. STRINGS.CREATURES.SPECIES.OXYFERN.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.OXYFERN.DOMESTICATEDDESC"
msgid ""
"This plant converts <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> into <link=\"OXYGEN\">Oxygen</"
"link>."
msgstr ""
"Esta planta converte <link=\"CARBONDIOXIDE\">CO<sub>2</sub></link> em <link=\"OXYGEN\">Oxigênio</"
"link>."

