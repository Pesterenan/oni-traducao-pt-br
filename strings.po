#. STRINGS.DUPLICANTS.PERSONALITIES.ABE.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ABE.DESC"
msgid ""
"{0}s are sweet, delicate flowers. They need to be treated gingerly, with great consideration for "
"their feelings."
msgstr ""
"{0}s são flores fofas e delicadas. Eles precisam ser tratados com cuidado e com grande consideração "
"quanto aos seus sentimentos."

#. STRINGS.DUPLICANTS.PERSONALITIES.ABE.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ABE.NAME"
msgid "Abe"
msgstr "Abe"

#. STRINGS.DUPLICANTS.PERSONALITIES.ADA.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ADA.DESC"
msgid "{0}s enjoy writing poetry in their downtime. Dark poetry."
msgstr "{0}s gostam de escrever poesia durante os intervalos. Poesias macabras."

#. STRINGS.DUPLICANTS.PERSONALITIES.ADA.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ADA.NAME"
msgid "Ada"
msgstr "Ada"

#. STRINGS.DUPLICANTS.PERSONALITIES.AMARI.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.AMARI.DESC"
msgid "{0}s likes to keep the peace. Ironically, they're a riot at parties."
msgstr "{0}s gostam de manter a paz. Ironicamente, eles piram em festas."

#. STRINGS.DUPLICANTS.PERSONALITIES.AMARI.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.AMARI.NAME"
msgid "Amari"
msgstr "Amari"

#. STRINGS.DUPLICANTS.PERSONALITIES.ARI.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ARI.DESC"
msgid "{0}s tend to space out from time to time, but they always pay attention when it counts."
msgstr "{0}s tendem a viajar de tempos em tempos, mas sempre prestam atenção quando é necessário."

#. STRINGS.DUPLICANTS.PERSONALITIES.ARI.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ARI.NAME"
msgid "Ari"
msgstr "Ari"

#. STRINGS.DUPLICANTS.PERSONALITIES.ASHKAN.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ASHKAN.DESC"
msgid "{0}s have what can only be described as a \"seriously infectious giggle\"."
msgstr "{0}s têm o que pode ser descrito como uma \"risada perigosamente contagiosa\"."

#. STRINGS.DUPLICANTS.PERSONALITIES.ASHKAN.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ASHKAN.NAME"
msgid "Ashkan"
msgstr "Ashkan"

#. STRINGS.DUPLICANTS.PERSONALITIES.BANHI.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.BANHI.DESC"
msgid "The \"cool loner\" vibes that radiate off a {0} never fail to make the colony swoon."
msgstr "A aura \"reclusa e legal\" vinda de uma {0} nunca falha em fazer a colônia suspirar."

#. STRINGS.DUPLICANTS.PERSONALITIES.BANHI.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.BANHI.NAME"
msgid "Banhi"
msgstr "Banhi"

#. STRINGS.DUPLICANTS.PERSONALITIES.BUBBLES.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.BUBBLES.DESC"
msgid ""
"This {0} is constantly challenging others to fight her, regardless of whether or not she can "
"actually take them."
msgstr ""
"Esta {0} está constantemente desafiando outros para lutar com ela, independentemente se ela aguenta "
"eles ou não."

#. STRINGS.DUPLICANTS.PERSONALITIES.BUBBLES.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.BUBBLES.NAME"
msgid "Bubbles"
msgstr "Bubbles"

#. STRINGS.DUPLICANTS.PERSONALITIES.BURT.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.BURT.DESC"
msgid "This {0} always feels great after a bubble bath and a good long cry."
msgstr "Este {0} sempre sente-se bem após um banho de bolhas e um longo choro."

#. STRINGS.DUPLICANTS.PERSONALITIES.BURT.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.BURT.NAME"
msgid "Burt"
msgstr "Burt"

#. STRINGS.DUPLICANTS.PERSONALITIES.CAMILLE.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.CAMILLE.DESC"
msgid ""
"This {0} loves anything that makes her feel nostalgic, including things that haven't aged well."
msgstr ""
"Esta {0} ama qualquer coisa que a faça se sentir nostálgica, incluindo coisas que não envelheceram "
"bem."

#. STRINGS.DUPLICANTS.PERSONALITIES.CAMILLE.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.CAMILLE.NAME"
msgid "Camille"
msgstr "Camille"

#. STRINGS.DUPLICANTS.PERSONALITIES.CATALINA.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.CATALINA.DESC"
msgid ""
"A {0} is admired by all for her seemingly tireless work ethic. Little do people know, she's dying "
"on the inside."
msgstr ""
"Uma {0} é sempre admirada pela sua ética de trabalho incansável. Poucos sabem que ela está morrendo "
"por dentro."

#. STRINGS.DUPLICANTS.PERSONALITIES.CATALINA.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.CATALINA.NAME"
msgid "Catalina"
msgstr "Catalina"

#. STRINGS.DUPLICANTS.PERSONALITIES.CHIP.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.CHIP.DESC"
msgid "This {0} is extremely good at guessing their friends' passwords."
msgstr "Este {0} é extremamente bom em adivinhar as senhas dos amigos."

#. STRINGS.DUPLICANTS.PERSONALITIES.CHIP.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.CHIP.NAME"
msgid "Chip"
msgstr "Chip"

#. STRINGS.DUPLICANTS.PERSONALITIES.DEVON.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.DEVON.DESC"
msgid ""
"This {0} dreams of owning their own personal computer so they can start a blog full of pictures of "
"toast."
msgstr ""
"Este {0} sonha em ter o seu próprio computador pra ele poder começar um blog com fotos de torradas."

#. STRINGS.DUPLICANTS.PERSONALITIES.DEVON.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.DEVON.NAME"
msgid "Devon"
msgstr "Devon"

#. STRINGS.DUPLICANTS.PERSONALITIES.EDWIREDO.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.EDWIREDO.DESC"
msgid "This {0} once rolled his eye so hard that he powered himself off and on again."
msgstr "Certa vez, este {0} revirou os olhos com tanta força que desligou e ligou novamente."

#. STRINGS.DUPLICANTS.PERSONALITIES.EDWIREDO.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.EDWIREDO.NAME"
msgid "Edwiredo"
msgstr "Edwiredo"

#. STRINGS.DUPLICANTS.PERSONALITIES.ELLIE.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ELLIE.DESC"
msgid "Nothing makes an {0} happier than a big tin of glitter and a pack of unicorn stickers."
msgstr ""
"Nada deixa uma {0} mais feliz do que um latão de glitter e um pacote de figurinhas de unicórnio."

#. STRINGS.DUPLICANTS.PERSONALITIES.ELLIE.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ELLIE.NAME"
msgid "Ellie"
msgstr "Ellie"

#. STRINGS.DUPLICANTS.PERSONALITIES.FRANKIE.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.FRANKIE.DESC"
msgid "There's nothing {0}s are more proud of than their thick, dignified eyebrows."
msgstr "Não existe algo que deixe {0}s mais orgulhosos do que suas longas e grossas sobrancelhas."

#. STRINGS.DUPLICANTS.PERSONALITIES.FRANKIE.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.FRANKIE.NAME"
msgid "Frankie"
msgstr "Frankie"

#. STRINGS.DUPLICANTS.PERSONALITIES.FREYJA.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.FREYJA.DESC"
msgid "This {0} has never stopped anyone from eating yellow snow."
msgstr "Este {0} nunca impediu ninguém de comer neve amarela."

#. STRINGS.DUPLICANTS.PERSONALITIES.FREYJA.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.FREYJA.NAME"
msgid "Freyja"
msgstr "Freyja"

#. STRINGS.DUPLICANTS.PERSONALITIES.GIZMO.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.GIZMO.DESC"
msgid "{0}s love nothing more than a big juicy info dump."
msgstr "{0}s adoram nada mais do que um grande despejo de informações interessantes."

#. STRINGS.DUPLICANTS.PERSONALITIES.GIZMO.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.GIZMO.NAME"
msgid "Gizmo"
msgstr "Gizmo"

#. STRINGS.DUPLICANTS.PERSONALITIES.GOSSMANN.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.GOSSMANN.DESC"
msgid "{0}s are major goofballs who can make anyone laugh."
msgstr "{0}s são as maiores palhaças que conseguem fazer qualquer um rir."

#. STRINGS.DUPLICANTS.PERSONALITIES.GOSSMANN.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.GOSSMANN.NAME"
msgid "Gossmann"
msgstr "Gossmann"

#. STRINGS.DUPLICANTS.PERSONALITIES.HAROLD.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.HAROLD.DESC"
msgid "Get a bunch of {0}s together in a room, and you'll have... a bunch of {0}s together in a room."
msgstr ""
"Pegue um monte de {0}s juntos em uma quarto, e você terá... um monte de {0}s juntos em uma quarto."

#. STRINGS.DUPLICANTS.PERSONALITIES.HAROLD.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.HAROLD.NAME"
msgid "Harold"
msgstr "Harold"

#. STRINGS.DUPLICANTS.PERSONALITIES.HASSAN.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.HASSAN.DESC"
msgid ""
"If someone says something nice to a {0} he'll think about it nonstop for no less than three weeks."
msgstr ""
"Se alguém dizer algo gentil para um {0} ele irá pensar sobre isso por pelo menos três semanas."

#. STRINGS.DUPLICANTS.PERSONALITIES.HASSAN.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.HASSAN.NAME"
msgid "Hassan"
msgstr "Hassan"

#. STRINGS.DUPLICANTS.PERSONALITIES.HIGBY.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.HIGBY.DESC"
msgid "This {0}'s got a song in his heart. Now if only he could remember how it goes."
msgstr "This {0}'s got a song in his heart. Now if only he could remember how it goes."

#. STRINGS.DUPLICANTS.PERSONALITIES.HIGBY.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.HIGBY.NAME"
msgid "Higby"
msgstr "Higby"

#. STRINGS.DUPLICANTS.PERSONALITIES.JEAN.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.JEAN.DESC"
msgid ""
"Just because {0}s are a little slow doesn't mean they can't suffer from soul-crushing existential "
"crises."
msgstr ""
"Só porque {0}s são um pouco lentos não significa que eles não sofram de terríveis crises "
"existenciais."

#. STRINGS.DUPLICANTS.PERSONALITIES.JEAN.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.JEAN.NAME"
msgid "Jean"
msgstr "Jean"

#. STRINGS.DUPLICANTS.PERSONALITIES.JORGE.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.JORGE.DESC"
msgid "{0} loves his new colony, even if their collective body odor makes his eyes water."
msgstr ""
"{0} adora sua nova colônia, mesmo que seu odor corporal coletivo façam seus olhos lacrimejarem."

#. STRINGS.DUPLICANTS.PERSONALITIES.JORGE.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.JORGE.NAME"
msgid "Jorge"
msgstr "Jorge"

#. STRINGS.DUPLICANTS.PERSONALITIES.JOSHUA.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.JOSHUA.DESC"
msgid ""
"{0}s are precious goobers. Other Duplicants are strangely incapable of cursing in a {0}'s presence."
msgstr ""
"{0}s são pessoas puras. Outros duplicantes sentem-se estranhamente incapazes de xingar na presença "
"de um {0}."

#. STRINGS.DUPLICANTS.PERSONALITIES.JOSHUA.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.JOSHUA.NAME"
msgid "Joshua"
msgstr "Joshua"

#. STRINGS.DUPLICANTS.PERSONALITIES.KAI.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.KAI.DESC"
msgid "The secret to a {0}'s perfectly soft hair is marine mineral hair masks."
msgstr ""

#. STRINGS.DUPLICANTS.PERSONALITIES.KAI.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.KAI.NAME"
msgid "Kai"
msgstr ""

#. STRINGS.DUPLICANTS.PERSONALITIES.LEIRA.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.LEIRA.DESC"
msgid "{0}s just want everyone to be happy."
msgstr "{0}s só querem que todo mundo seja feliz."

#. STRINGS.DUPLICANTS.PERSONALITIES.LEIRA.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.LEIRA.NAME"
msgid "Leira"
msgstr "Leira"

#. STRINGS.DUPLICANTS.PERSONALITIES.LIAM.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.LIAM.DESC"
msgid "No matter how much this {0} scrubs, he can never truly feel clean."
msgstr "Não importa o quanto este {0} tente, ele nunca vai sentir-se limpo."

#. STRINGS.DUPLICANTS.PERSONALITIES.LIAM.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.LIAM.NAME"
msgid "Liam"
msgstr "Liam"

#. STRINGS.DUPLICANTS.PERSONALITIES.LINDSAY.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.LINDSAY.DESC"
msgid "A {0} is a charming woman, unless you make the mistake of messing with one of her friends."
msgstr ""
"Uma {0} é uma mulher encantadora, a não ser que você cometa o erro de mexer com um dos seus amigos."

#. STRINGS.DUPLICANTS.PERSONALITIES.LINDSAY.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.LINDSAY.NAME"
msgid "Lindsay"
msgstr "Lindsay"

#. STRINGS.DUPLICANTS.PERSONALITIES.MAE.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MAE.DESC"
msgid "There's nothing a {0} can't do if she sets her mind to it."
msgstr "Não existe nada que uma {0} não consiga fazer se ela se dedicar naquilo."

#. STRINGS.DUPLICANTS.PERSONALITIES.MAE.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MAE.NAME"
msgid "Mae"
msgstr "Mae"

#. STRINGS.DUPLICANTS.PERSONALITIES.MARIE.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MARIE.DESC"
msgid "This {0} is positively glowing! What's her secret? Radioactive isotopes, of course."
msgstr "Esta {0} está irradiando energia positiva! Qual seu segredo? Radioisótopos, é claro."

#. STRINGS.DUPLICANTS.PERSONALITIES.MARIE.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MARIE.NAME"
msgid "Marie"
msgstr "Marie"

#. STRINGS.DUPLICANTS.PERSONALITIES.MAX.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MAX.DESC"
msgid "At any given moment a {0} is viscerally reliving ten different humiliating memories."
msgstr "A qualquer momento, um {0} fica revivendo dez diferentes memórias humilhantes."

#. STRINGS.DUPLICANTS.PERSONALITIES.MAX.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MAX.NAME"
msgid "Max"
msgstr "Max"

#. STRINGS.DUPLICANTS.PERSONALITIES.MAYA.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MAYA.DESC"
msgid "This {0} got her hand crushed in a pneumatic door once. It was the most alive she's ever felt."
msgstr ""
"This {0} got her hand crushed in a pneumatic door once. It was the most alive she's ever felt."

#. STRINGS.DUPLICANTS.PERSONALITIES.MAYA.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MAYA.NAME"
msgid "Maya"
msgstr "Maya"

#. STRINGS.DUPLICANTS.PERSONALITIES.MEEP.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MEEP.DESC"
msgid "{0}s have a face only a two tonne Printing Pod could love."
msgstr "{0}s possuem um rosto que só uma Duplicadora poderia amar."

#. STRINGS.DUPLICANTS.PERSONALITIES.MEEP.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MEEP.NAME"
msgid "Meep"
msgstr "Meep"

#. STRINGS.DUPLICANTS.PERSONALITIES.MIMA.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MIMA.DESC"
msgid "Ol' {0} here can't stand lookin' at people's knees."
msgstr "Esta {0} odeia ter que olhar na altura do joelho dos outros."

#. STRINGS.DUPLICANTS.PERSONALITIES.MIMA.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MIMA.NAME"
msgid "Mi-Ma"
msgstr "Mi-Ma"

#. STRINGS.DUPLICANTS.PERSONALITIES.MINNOW.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MINNOW.DESC"
msgid "{0} always goes with the flow. Unless the flow is going somewhere boring."
msgstr ""

#. STRINGS.DUPLICANTS.PERSONALITIES.MINNOW.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MINNOW.NAME"
msgid "Minnow"
msgstr ""

#. STRINGS.DUPLICANTS.PERSONALITIES.NAILS.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.NAILS.DESC"
msgid "People often expect a Duplicant named \"{0}\" to be tough, but they're all pretty huge wimps."
msgstr ""
"Pessoas sempre esperam que um Duplicante com o nome \"{0}\" fosse durão, mas eles são todos bem "
"fraquinhos."

#. STRINGS.DUPLICANTS.PERSONALITIES.NAILS.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.NAILS.NAME"
msgid "Nails"
msgstr "Nails"

#. STRINGS.DUPLICANTS.PERSONALITIES.NIKOLA.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.NIKOLA.DESC"
msgid ""
"This {0} once claimed he could build a laser so powerful it would rip the colony in half. No one "
"asked him to prove it."
msgstr ""
"Este {0} disse uma vez que poderia construir um laser tão poderoso que cortaria a colônia ao meio. "
"Ninguém teve a coragem de pedir pra ele provar isso."

#. STRINGS.DUPLICANTS.PERSONALITIES.NIKOLA.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.NIKOLA.NAME"
msgid "Nikola"
msgstr "Nikola"

#. STRINGS.DUPLICANTS.PERSONALITIES.NISBET.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.NISBET.DESC"
msgid ""
"This {0} likes to punch people to show her affection. Everyone's too afraid of her to tell her it "
"hurts."
msgstr ""
"Esta {0} gosta de bater nas pessoas para demonstrar afeição. Todos tem medo demais de dizer pra ela "
"que machuca."

#. STRINGS.DUPLICANTS.PERSONALITIES.NISBET.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.NISBET.NAME"
msgid "Nisbet"
msgstr "Nisbet"

#. STRINGS.DUPLICANTS.PERSONALITIES.OTTO.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.OTTO.DESC"
msgid "{0}s always insult people by accident and generally exist in a perpetual state of deep regret."
msgstr "{0}s sempre insultam pessoas por acidente e acabam ficando em um estado de remorso profundo."

#. STRINGS.DUPLICANTS.PERSONALITIES.OTTO.NAME
