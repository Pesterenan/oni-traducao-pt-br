msgstr "Um reservatório colorido mantém os gases bem organizados."

#. STRINGS.BUILDINGS.PREFABS.GASRESERVOIR.FACADES.RED_ROSE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GASRESERVOIR.FACADES.RED_ROSE.NAME"
msgid "<link=\"GASRESERVOIR\">Puce Pink Gas Reservoir</link>"
msgstr "<link=\"GASRESERVOIR\">Reservatório de Gás Rosa-Púrpura</link>"

#. STRINGS.BUILDINGS.PREFABS.GASRESERVOIR.FACADES.YELLOW_TARTAR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GASRESERVOIR.FACADES.YELLOW_TARTAR.DESC"
msgid "A colorful reservoir keeps gases neatly organized."
msgstr "Um reservatório colorido mantém os gases bem organizados."

#. STRINGS.BUILDINGS.PREFABS.GASRESERVOIR.FACADES.YELLOW_TARTAR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GASRESERVOIR.FACADES.YELLOW_TARTAR.NAME"
msgid "<link=\"GASRESERVOIR\">Ick Yellow Gas Reservoir</link>"
msgstr "<link=\"GASRESERVOIR\">Reservatório de Gás Amarelo Eca</link>"

#. STRINGS.BUILDINGS.PREFABS.GASRESERVOIR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GASRESERVOIR.NAME"
msgid "<link=\"GASRESERVOIR\">Gas Reservoir</link>"
msgstr "<link=\"GASRESERVOIR\">Reservatório de Gás</link>"

#. STRINGS.BUILDINGS.PREFABS.GASVALVE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GASVALVE.DESC"
msgid "Valves control the amount of gas that moves through pipes, preventing waste."
msgstr "Válvulas controlam a quantidade de gás que se move pela tubulação, prevenindo desperdícios."

#. STRINGS.BUILDINGS.PREFABS.GASVALVE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GASVALVE.EFFECT"
msgid ""
"Controls the <link=\"ELEMENTSGAS\">Gas</link> volume permitted through <link=\"GASPIPING\">Pipes</"
"link>."
msgstr ""
"Controla o volume de <link=\"ELEMENTSGAS\">Gás</link> permitido pelos <link=\"GASPIPING\">Tubos</"
"link>."

#. STRINGS.BUILDINGS.PREFABS.GASVALVE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GASVALVE.NAME"
msgid "<link=\"GASVALVE\">Gas Valve</link>"
msgstr "<link=\"GASVALVE\">Válvula de Gás</link>"

#. STRINGS.BUILDINGS.PREFABS.GASVENT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GASVENT.DESC"
msgid "Vents are an exit point for gases from ventilation systems."
msgstr "Saídas de gás são um ponto de saída de gases dos sistemas de ventilação."

#. STRINGS.BUILDINGS.PREFABS.GASVENT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GASVENT.EFFECT"
msgid "Releases <link=\"ELEMENTSGAS\">Gas</link> from <link=\"GASPIPING\">Gas Pipes</link>."
msgstr "Libera <link=\"ELEMENTSGAS\">Gás</link> dos <link=\"GASPIPING\">Tubos de Gás</link>."

#. STRINGS.BUILDINGS.PREFABS.GASVENT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GASVENT.NAME"
msgid "<link=\"GASVENT\">Gas Vent</link>"
msgstr "<link=\"GASVENT\">Saída de Gás</link>"

#. STRINGS.BUILDINGS.PREFABS.GASVENTHIGHPRESSURE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GASVENTHIGHPRESSURE.DESC"
msgid "High pressure vents can expel gas into more highly pressurized environments."
msgstr "Saídas de gás de alta pressão podem liberar gás em ambientes altamente pressurizados."

#. STRINGS.BUILDINGS.PREFABS.GASVENTHIGHPRESSURE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GASVENTHIGHPRESSURE.EFFECT"
msgid ""
"Releases <link=\"ELEMENTSGAS\">Gas</link> from <link=\"GASPIPING\">Gas Pipes</link> into high "
"pressure locations."
msgstr ""
"Libera <link=\"ELEMENTSGAS\">Gás</link> dos <link=\"GASPIPING\">Tubos de Gás</link> em locais com "
"alta pressão."

#. STRINGS.BUILDINGS.PREFABS.GASVENTHIGHPRESSURE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GASVENTHIGHPRESSURE.NAME"
msgid "<link=\"GASVENTHIGHPRESSURE\">High Pressure Gas Vent</link>"
msgstr "<link=\"GASVENTHIGHPRESSURE\">Saída de Gás de Alta Pressão</link>"

#. STRINGS.BUILDINGS.PREFABS.GENERATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GENERATOR.DESC"
msgid "Burning coal produces more energy than manual power, but emits heat and exhaust."
msgstr ""
"Geradores de carvão produzem mais energia do que energia manual, porém produzem calor e fumaça."

#. STRINGS.BUILDINGS.PREFABS.GENERATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GENERATOR.EFFECT"
msgid ""
"Converts <link=\"CARBON\">Coal</link> into electrical <link=\"POWER\">Power</link>.\n"
"\n"
"Produces <link=\"CARBONDIOXIDE\">Carbon Dioxide</link>."
msgstr ""
"Converte <link=\"CARBON\">Carvão</link> em <link=\"POWER\">Energia</link> elétrica.\n"
"\n"
"Produz <link=\"CARBONDIOXIDE\">Dióxido de Carbono</link>."

#. STRINGS.BUILDINGS.PREFABS.GENERATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GENERATOR.NAME"
msgid "<link=\"GENERATOR\">Coal Generator</link>"
msgstr "<link=\"GENERATOR\">Gerador à Carvão</link>"

#. STRINGS.BUILDINGS.PREFABS.GENERATOR.OVERPRODUCTION
msgctxt "STRINGS.BUILDINGS.PREFABS.GENERATOR.OVERPRODUCTION"
msgid "{Generator} overproduction"
msgstr "Superprodução em {Generator}"

#. STRINGS.BUILDINGS.PREFABS.GENERICFABRICATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GENERICFABRICATOR.DESC"
msgid "Omniprinters are incapable of printing organic matter."
msgstr "Omni-impressoras são incapazes de imprimir matéria orgânica."

#. STRINGS.BUILDINGS.PREFABS.GENERICFABRICATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GENERICFABRICATOR.EFFECT"
msgid "Converts <link=\"RAWMINERAL\">Raw Mineral</link> into unique materials and objects."
msgstr "Converte <link=\"RAWMINERAL\">Minério Bruto</link> em materiais e objetos únicos."

#. STRINGS.BUILDINGS.PREFABS.GENERICFABRICATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GENERICFABRICATOR.NAME"
msgid "<link=\"GENERICFABRICATOR\">Omniprinter</link>"
msgstr "<link=\"GENERICFABRICATOR\">Omni-impressora</link>"

#. STRINGS.BUILDINGS.PREFABS.GENESHUFFLER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GENESHUFFLER.DESC"
msgid ""
"A massive synthetic brain, suspended in saline solution.\n"
"\n"
"There is a chair attached to the device with room for one person."
msgstr ""
"Um cérebro sintético gigante, suspenso em uma solução salina.\n"
"\n"
"Tem uma cadeira presa ao dispositivo com espaço para uma pessoa."

#. STRINGS.BUILDINGS.PREFABS.GENESHUFFLER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GENESHUFFLER.NAME"
msgid "Neural Vacillator"
msgstr "Vacilador Neural"

#. STRINGS.BUILDINGS.PREFABS.GENETICANALYSISSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GENETICANALYSISSTATION.DESC"
msgid "Would a mutated rose still smell as sweet?"
msgstr "Uma rosa mutante ainda teria um cheiro doce?"

#. STRINGS.BUILDINGS.PREFABS.GENETICANALYSISSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GENETICANALYSISSTATION.EFFECT"
msgid "Identifies new <link=\"PLANTS\">Seed</link> subspecies."
msgstr "Identifica novas subespécies de <link=\"PLANTS\">Sementes</link>."

#. STRINGS.BUILDINGS.PREFABS.GENETICANALYSISSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GENETICANALYSISSTATION.NAME"
msgid "<link=\"GENETICANALYSISSTATION\">Botanical Analyzer</link>"
msgstr "<link=\"GENETICANALYSISSTATION\">Analisador Botânico</link>"

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALCONTROLLER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALCONTROLLER.DESC"
msgid "What comes out depends very much on the initial temperature of what goes in."
msgstr "O que sai depende muito da temperatura inicial do que entra."

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALCONTROLLER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALCONTROLLER.EFFECT"
msgid ""
"Uses <link=\"HEAT\">Heat</link> from the planet's core to dramatically increase the temperature of "
"<link=\"ELEMENTSLIQUID\">Liquid</link> inputs.\n"
"\n"
"Materials will be emitted at connected Geo Vents."
msgstr ""
"Usa o <link=\"HEAT\">Calor</link> do núcleo do planeta para aumentar drasticamente a temperatura "
"dos <link=\"ELEMENTSLIQUID\">Líquidos</link> na entrada.\n"
"\n"
"Os materiais serão emitidos nas Saídas Geotérmicas conectadas."

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALCONTROLLER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALCONTROLLER.NAME"
msgid "<link=\"GEOTHERMALCONTROLLER\">Geothermal Heat Pump</link>"
msgstr "<link=\"GEOTHERMALCONTROLLER\">Bomba de Calor Geotérmica</link>"

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.BLOCKED_DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.BLOCKED_DESC"
msgid ""
"Blocked geo vents can be cleared by pumping in <link=\"ELEMENTSLIQUID\">liquids</link> that are hot "
"enough to melt <link=\"LEAD\">Lead</link>."
msgstr ""
"Saídas Geotérmicas bloqueadas podem ser desobstruídas bombeando <link=\"ELEMENTSLIQUID\">líquidos</"
"link> suficientemente quentes para derreter <link=\"LEAD\">Chumbo</link>."

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.DESC"
msgid "Geo vents must finish their current emission before accepting new materials."
msgstr "Saídas Geotérmicas devem terminar sua emissão atual antes de aceitar novos materiais."

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.EFFECT"
msgid "Emits high-<link=\"HEAT\">temperature</link> materials received from the Geothermal Heat Pump."
msgstr ""
"Emite materiais de alta <link=\"HEAT\">temperatura</link> recebidos da Bomba de Calor Geotérmica."

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.LOGIC_PORT"
msgid "Material Content Monitor"
msgstr "Monitor de Conteúdo Material"

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when geo vent has materials to emit"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> quando a saída geotérmica tem materiais "
"para emitir"

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Caso contrário, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.NAME"
msgid "<link=\"GEOTHERMALVENT\">Geo Vent</link>"
msgstr "<link=\"GEOTHERMALVENT\">Saída Geotérmica</link>"

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.NAME_FMT
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.NAME_FMT"
msgid "<link=\"GEOTHERMALVENT\">Geo Vent C-{ID}</link>"
msgstr "<link=\"GEOTHERMALVENT\">Saída Geotérmica C-{ID}</link>"

#. STRINGS.BUILDINGS.PREFABS.GEOTUNER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTUNER.DESC"
msgid "The targeted geyser receives stored amplification data when it is erupting."
msgstr "O gêiser alvo recebe dados de amplificação armazenados quando está em erupção."

#. STRINGS.BUILDINGS.PREFABS.GEOTUNER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTUNER.EFFECT"
msgid ""
"Increases the <link=\"HEAT\">Temperature</link> and output of an analyzed <link=\"GEYSERS\">Geyser</"
"link>.\n"
"\n"
"Multiple Geotuners can be directed at a single <link=\"GEYSERS\">Geyser</link> anywhere on an "
"asteroid."
msgstr ""
"Aumenta a <link=\"HEAT\">Temperatura</link> e a produção de um <link=\"GEYSERS\">Gêiser</link> "
"analisado.\n"
"\n"
"Vários Calibradores Geológicos podem ser direcionados para um único <link=\"GEYSERS\">Gêiser</link> "
"em qualquer lugar de um asteroide."

#. STRINGS.BUILDINGS.PREFABS.GEOTUNER.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTUNER.LOGIC_PORT"
msgid "Geyser Eruption Monitor"
msgstr "Monitor de Erupção de Gêiser"

#. STRINGS.BUILDINGS.PREFABS.GEOTUNER.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTUNER.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when geyser is erupting"
msgstr "Envia um <b><style=\"logic_on\">Sinal Verde</style></b> quando o gêiser está em erupção"

#. STRINGS.BUILDINGS.PREFABS.GEOTUNER.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTUNER.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.GEOTUNER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTUNER.NAME"
msgid "<link=\"GEOTUNER\">Geotuner</link>"
msgstr "<link=\"GEOTUNER\">Calibrador Geológico</link>"

#. STRINGS.BUILDINGS.PREFABS.GLASSCEILINGLIGHT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSCEILINGLIGHT.DESC"
msgid "It's an attractive way to add overhead lighting in aquatic spaces."
msgstr "É uma forma atraente de adicionar iluminação no teto de espaços aquáticos."

#. STRINGS.BUILDINGS.PREFABS.GLASSCEILINGLIGHT.EFFECT
#| msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.EFFECT"
#| msgid ""
#| "Provides <link=\"LIGHT\">Light</link> when <link=\"POWER\">Powered</link>.\n"
#| "\n"
#| "Increases Duplicant workspeed within light radius."
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSCEILINGLIGHT.EFFECT"
msgid ""
"Provides <link=\"LIGHT\">Light</link> when <link=\"POWER\">Powered</link>.\n"
"\n"
"Increases Duplicant workspeed within light radius."
msgstr ""
"Fornece <link=\"LIGHT\">Luz</link> quando <link=\"POWER\">Energizado</link>.\n"
"\n"
"Aumenta a velocidade de trabalho do Duplicante dentro dos raio de luz."

#. STRINGS.BUILDINGS.PREFABS.GLASSCEILINGLIGHT.NAME
#| msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.BLOSSOM.NAME"
#| msgid "<link=\"CEILINGLIGHT\">Blossom Ceiling Light</link>"
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSCEILINGLIGHT.NAME"
msgid "<link=\"GLASSCEILINGLIGHT\">Glass Jelly Ceiling Light</link>"
msgstr "<link=\"GLASSCEILINGLIGHT\">Luminária de Teto Geleia de Vidro</link>"

#. STRINGS.BUILDINGS.PREFABS.GLASSEXTERIORWALL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSEXTERIORWALL.DESC"
msgid "Glass Backwall adds a touch of elegance while sealing rooms from the vacuum of space."
msgstr ""
"Paredes de Fundo de Vidro dão um toque de elegância ao mesmo tempo que isola salas do vácuo do "
"espaço."

#. STRINGS.BUILDINGS.PREFABS.GLASSEXTERIORWALL.EFFECT
#| msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.EFFECT"
#| msgid ""
#| "Prevents <link=\"ELEMENTSGAS\">Gas</link> and <link=\"ELEMENTSLIQUID\">Liquid</link> loss in "
#| "space.\n"
#| "\n"
#| "Builds an insulating backwall behind buildings."
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSEXTERIORWALL.EFFECT"
msgid ""
"Prevents <link=\"ELEMENTSGAS\">Gas</link> and <link=\"ELEMENTSLIQUID\">Liquid</link> loss in "
"space.\n"
"\n"
"Builds a transparent backwall behind buildings.\n"
"\n"
"Provides higher <link=\"DECOR\">Decor</link> than standard drywall."
msgstr ""
"Impede a perda de <link=\"ELEMENTSGAS\">Gases</link> e <link=\"ELEMENTSLIQUID\">Líquidos</link> no "
"espaço.\n"
"\n"
"Constrói uma parede de fundo transparente atrás das estruturas.\n"
"\n"
"Fornece uma <link=\"DECOR\">Decoração</link> maior do que a parede de gesso comum."

#. STRINGS.BUILDINGS.PREFABS.GLASSEXTERIORWALL.NAME
#| msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.DEFAULT_EXTERIORWALL.NAME"
#| msgid "<link=\"EXTERIORWALL\">Drywall</link>"
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSEXTERIORWALL.NAME"
msgid "<link=\"GLASSEXTERIORWALL\">Glass Backwall</link>"
msgstr "<link=\"GLASSEXTERIORWALL\">Parede de Fundo de Vidro</link>"

#. STRINGS.BUILDINGS.PREFABS.GLASSFORGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSFORGE.DESC"
msgid "Glass can be used to construct window tile."
msgstr "Vidro pode ser usado para construir blocos de janela."

#. STRINGS.BUILDINGS.PREFABS.GLASSFORGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSFORGE.EFFECT"
msgid ""
"Produces <link=\"MOLTENGLASS\">Molten Glass</link> from raw <link=\"SAND\">Sand</link>.\n"
"\n"
"Outputs <link=\"HEAT\">High Temperature</link> <link=\"ELEMENTSLIQUID\">Liquid</link>.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"Produz <link=\"MOLTENGLASS\">Vidro Derretido</link> a partir de <link=\"SAND\">Areia</link>.\n"
"\n"
"Libera <link=\"ELEMENTSLIQUID\">Líquido</link> em <link=\"HEAT\">Alta Temperatura</link>.\n"
"\n"
"Duplicantes não irão fabricar enquanto receitas não forem colocadas na fila."

#. STRINGS.BUILDINGS.PREFABS.GLASSFORGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSFORGE.NAME"
msgid "<link=\"GLASSFORGE\">Glass Forge</link>"
msgstr "<link=\"GLASSFORGE\">Forja de Vidro</link>"

#. STRINGS.BUILDINGS.PREFABS.GLASSFORGE.RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSFORGE.RECIPE_DESCRIPTION"
msgid "Extracts pure {0} from {1}."
msgstr "Extrai {0} puro a partir de {1}."

#. STRINGS.BUILDINGS.PREFABS.GLASSTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSTILE.DESC"
msgid "Window tiles provide a barrier against liquid and gas and are completely transparent."
msgstr "Blocos de janela criam uma barreira contra líquido e gás e são completamente transparentes."

#. STRINGS.BUILDINGS.PREFABS.GLASSTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSTILE.EFFECT"
msgid ""
"Used to build the walls and floors of rooms.\n"
"\n"
"Allows <link=\"LIGHT\">Light</link> and <link=\"DECOR\">Decor</link> to pass through."
msgstr ""
"Usado para construir as paredes e pisos de quartos.\n"
"\n"
"Permite a passagem de <link=\"LIGHT\">Luz</link> e <link=\"DECOR\">Decoração</link>."

#. STRINGS.BUILDINGS.PREFABS.GLASSTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSTILE.NAME"
msgid "<link=\"GLASSTILE\">Window Tile</link>"
msgstr "<link=\"GLASSTILE\">Bloco de Janela</link>"

#. STRINGS.BUILDINGS.PREFABS.GOURMETCOOKINGSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GOURMETCOOKINGSTATION.DESC"
msgid "Luxury meals increase Duplicants' morale and prevent them from becoming stressed."
msgstr "Refeições luxuosas aumentam o moral dos Duplicantes e os previne de ficarem estressados."

#. STRINGS.BUILDINGS.PREFABS.GOURMETCOOKINGSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GOURMETCOOKINGSTATION.EFFECT"
msgid ""
"Cooks a wide variety of quality <link=\"FOOD\">Foods</link>.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"Cozinha uma grande variedade de <link=\"FOOD\">Alimentos</link>.\n"
"\n"
"Duplicantes não irão fabricar enquanto receitas não forem colocadas na fila."

#. STRINGS.BUILDINGS.PREFABS.GOURMETCOOKINGSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GOURMETCOOKINGSTATION.NAME"
msgid "<link=\"GOURMETCOOKINGSTATION\">Gas Range</link>"
msgstr "<link=\"GOURMETCOOKINGSTATION\">Fogão à Gás</link>"

#. STRINGS.BUILDINGS.PREFABS.GRAVE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVE.DESC"
msgid "Burying dead Duplicants reduces health hazards and stress on the colony."
msgstr "Enterrar Duplicantes mortos reduz risco biológico e estresse na colônia."

#. STRINGS.BUILDINGS.PREFABS.GRAVE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVE.EFFECT"
msgid ""
"Provides a final resting place for deceased Duplicants.\n"
"\n"
"Living Duplicants will automatically place an unburied corpse inside."
msgstr ""
"Fornece um local de descanso final para duplicantes falecidos.\n"
"\n"
"Duplicantes vivos irão automaticamente colocar um corpo dentro do memorial."

#. STRINGS.BUILDINGS.PREFABS.GRAVE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVE.NAME"
msgid "<link=\"GRAVE\">Tasteful Memorial</link>"
msgstr "<link=\"GRAVE\">Memorial Elegante</link>"

#. STRINGS.BUILDINGS.PREFABS.GRAVITASBATHROOMSTALL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASBATHROOMSTALL.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.GRAVITASBATHROOMSTALL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASBATHROOMSTALL.EFFECT"
msgid ""
"A private toilet for senior scientists.\n"
"\n"
"It was the site of many great scientific breakthroughs."
msgstr ""
"Uma privada para cientistas seniores.\n"
"\n"
"Era o local de muitas descobertas científicas."

#. STRINGS.BUILDINGS.PREFABS.GRAVITASBATHROOMSTALL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASBATHROOMSTALL.NAME"
msgid "Toilet"
msgstr "Privada"

#. STRINGS.BUILDINGS.PREFABS.GRAVITASCONTAINER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASCONTAINER.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.GRAVITASCONTAINER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASCONTAINER.EFFECT"
msgid ""
"A clothing storage unit.\n"
"\n"
"It contains ultra-soft sleepwear."
msgstr ""
"Uma unidade de armazenamento de vestimentas.\n"
"\n"
"Contém pijamas ultra-macios."

#. STRINGS.BUILDINGS.PREFABS.GRAVITASCONTAINER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASCONTAINER.NAME"
msgid "Pajama Cubby"
msgstr "Armário de Pijamas"

#. STRINGS.BUILDINGS.PREFABS.GRAVITASCREATUREMANIPULATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASCREATUREMANIPULATOR.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.GRAVITASCREATUREMANIPULATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASCREATUREMANIPULATOR.EFFECT"
msgid ""
"An experimental DNA manipulator.\n"
"\n"
"Analyzes <link=\"CREATURES\">Critters</link> to transform base morphs into random variants of their "
"species."
msgstr ""
"Um manipulador de DNA experimental.\n"
"\n"
"Analisa <link=\"CREATURES\">Criaturas</link> para transformar as raças base em variantes aleatórias "
"de sua espécie."

#. STRINGS.BUILDINGS.PREFABS.GRAVITASCREATUREMANIPULATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASCREATUREMANIPULATOR.NAME"
msgid "<link=\"GRAVITASCREATUREMANIPULATOR\">Critter Flux-O-Matic</link>"
msgstr "<link=\"GRAVITASCREATUREMANIPULATOR\">Manipulador Flux-O-Mático</link>"

#. STRINGS.BUILDINGS.PREFABS.GRAVITASDOOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASDOOR.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.GRAVITASDOOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASDOOR.EFFECT"
msgid "An office door to an office that no longer exists."
msgstr "Uma porta de escritório para um escritório que não existe mais."

#. STRINGS.BUILDINGS.PREFABS.GRAVITASDOOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASDOOR.NAME"
msgid "Gravitas Door"
msgstr "Porta Gravitas"

#. STRINGS.BUILDINGS.PREFABS.GRAVITASLABLIGHT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASLABLIGHT.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.GRAVITASLABLIGHT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASLABLIGHT.EFFECT"
msgid "An overhead light therapy lamp designed to soothe the minds."
msgstr "Uma lâmpada suspensa projetada para acalmar as mentes."

#. STRINGS.BUILDINGS.PREFABS.GRAVITASLABLIGHT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASLABLIGHT.NAME"
msgid "LED Light"
msgstr "Lãmpada de LED"

#. STRINGS.BUILDINGS.PREFABS.GRAVITASPEDESTAL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASPEDESTAL.DESC"
msgid "Perception can be drastically changed by a bit of thoughtful presentation."
msgstr "A percepção pode ser drasticamente alterada por uma apresentação bem pensada."

#. STRINGS.BUILDINGS.PREFABS.GRAVITASPEDESTAL.DISPLAYED_ITEM_FMT
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASPEDESTAL.DISPLAYED_ITEM_FMT"
msgid "Displayed {0}"
msgstr "Mostrando {0}"

#. STRINGS.BUILDINGS.PREFABS.GRAVITASPEDESTAL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASPEDESTAL.EFFECT"
msgid ""
"Displays a single object, doubling its <link=\"DECOR\">Decor</link> value.\n"
"\n"
"Objects with negative Decor will gain some positive Decor when displayed."
msgstr ""
"Exibe um único objeto, duplicando seu valor de <link=\"DECOR\">Decoração</link>.\n"
"\n"
"Objetos com Decoração negativa ganharão um pouco de Decoração positiva enquanto em exibição."

#. STRINGS.BUILDINGS.PREFABS.GRAVITASPEDESTAL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASPEDESTAL.NAME"
msgid "<link=\"ITEMPEDESTAL\">Gravitas Pedestal</link>"
msgstr "<link=\"ITEMPEDESTAL\">Pedestal da Gravitas</link>"

#. STRINGS.BUILDINGS.PREFABS.GUNKEMPTIER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GUNKEMPTIER.DESC"
msgid "Bionic Duplicants are much more relaxed after a visit to the gunk extractor."
msgstr ""
"Os Duplicantes Biônicos ficam muito mais relaxados depois de uma visita ao extrator de óleo sujo."

#. STRINGS.BUILDINGS.PREFABS.GUNKEMPTIER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GUNKEMPTIER.EFFECT"
msgid "Cleanses stale <link=\"LIQUIDGUNK\">Gunk</link> build-up from Duplicants' bionic parts."
msgstr "Limpa o acúmulo de <link=\"LIQUIDGUNK\">Óleo Sujo</link> das partes biônicas dos Duplicantes."

#. STRINGS.BUILDINGS.PREFABS.GUNKEMPTIER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GUNKEMPTIER.NAME"
msgid "<link=\"GUNKEMPTIER\">Gunk Extractor</link>"
msgstr "<link=\"GUNKEMPTIER\">Extrator de Óleo Sujo</link>"

#. STRINGS.BUILDINGS.PREFABS.HABITATMODULEMEDIUM.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HABITATMODULEMEDIUM.DESC"
msgid "Allows Duplicants to survive space travel... Hopefully."
msgstr "Permite que os Duplicantes sobrevivam à viagens pelo espaço... Esperamos."

#. STRINGS.BUILDINGS.PREFABS.HABITATMODULEMEDIUM.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HABITATMODULEMEDIUM.EFFECT"
msgid ""
"Functions as a Command Module.\n"
"\n"
"Holds up to 10 Duplicant travellers.\n"
"\n"
"One Command Module may be installed per rocket. \n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr ""
"Funciona como um Módulo de Comando.\n"
"\n"
"Carrega até 10 Duplicantes viajantes.\n"
"\n"
"Somente um Módulo de Comando pode ser instalado por foguete.\n"
"\n"
"Precisa ser construído pela <link=\"LAUNCHPAD\">Plataforma de Foguetes</link>."

#. STRINGS.BUILDINGS.PREFABS.HABITATMODULEMEDIUM.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HABITATMODULEMEDIUM.NAME"
msgid "<link=\"HABITATMODULEMEDIUM\">Spacefarer Module</link>"
msgstr "<link=\"HABITATMODULEMEDIUM\">Módulo Explorador</link>"

#. STRINGS.BUILDINGS.PREFABS.HABITATMODULESMALL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HABITATMODULESMALL.DESC"
msgid "One lucky Duplicant gets the best view from the whole rocket."
msgstr "Um Duplicante sortudo consegue a melhor vista do foguete inteiro."

#. STRINGS.BUILDINGS.PREFABS.HABITATMODULESMALL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HABITATMODULESMALL.EFFECT"
msgid ""
"Functions as a Command Module and a Nosecone.\n"
"\n"
"Holds one Duplicant traveller.\n"
"\n"
"One Command Module may be installed per rocket.\n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>. \n"
"\n"
"Must be built at the top of a rocket."
msgstr ""
"Tem a função de um Módulo de Comando e de um Cone de Nariz.\n"
"\n"
"Carrega um Duplicante viajante.\n"
"\n"
"Somente um Módulo de Comando pode ser instalado por foguete.\n"
"\n"
"Precisa ser construída pela <link=\"LAUNCHPAD\">Plataforma de Foguetes</link>.\n"
"\n"
"Precisa ser construído no topo de um foguete."

#. STRINGS.BUILDINGS.PREFABS.HABITATMODULESMALL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HABITATMODULESMALL.NAME"
msgid "<link=\"HABITATMODULESMALL\">Solo Spacefarer Nosecone</link>"
msgstr "<link=\"HABITATMODULESMALL\">Cone de Nariz Explorador</link>"

#. STRINGS.BUILDINGS.PREFABS.HANDSANITIZER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HANDSANITIZER.DESC"
msgid "Hand sanitizers kill germs more effectively than wash basins."
msgstr "Higienizadores de mãos matam germes de forma mais eficiente do que pias."

#. STRINGS.BUILDINGS.PREFABS.HANDSANITIZER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HANDSANITIZER.EFFECT"
msgid ""
"Removes most <link=\"DISEASE\">Germs</link> from Duplicants.\n"
"\n"
"Germ-covered Duplicants use Hand Sanitizers when passing by in the selected direction."
msgstr ""
"Remove a maior parte dos <link=\"DISEASE\">Germes</link> dos Duplicantes.\n"
"\n"
"Duplicantes cobertos de germes irão utilizar o Higienizador de Mãos quando passar pela direção "
"selecionada."

#. STRINGS.BUILDINGS.PREFABS.HANDSANITIZER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HANDSANITIZER.NAME"
msgid "<link=\"HANDSANITIZER\">Hand Sanitizer</link>"
msgstr "<link=\"HANDSANITIZER\">Higienizador de Mãos</link>"

#. STRINGS.BUILDINGS.PREFABS.HEADQUARTERS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HEADQUARTERS.DESC"
msgid "New Duplicants come out here, but thank goodness, they never go back in."
msgstr "Novos Duplicantes saem por aqui, mas ainda bem que nunca voltam pra dentro."

#. STRINGS.BUILDINGS.PREFABS.HEADQUARTERS.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HEADQUARTERS.EFFECT"
msgid ""
"An exceptionally advanced bioprinter of unknown origin.\n"
"\n"
"It periodically produces new Duplicants or care packages containing resources."
msgstr ""
"Uma impressora biológica excepcionalmente avançada de origem desconhecida.\n"
"\n"
"Ele periodicamente produz novos Duplicantes ou pacotes de suprimentos contendo recursos."

#. STRINGS.BUILDINGS.PREFABS.HEADQUARTERS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HEADQUARTERS.NAME"
msgid "<link=\"HEADQUARTERS\">Printing Pod</link>"
msgstr "<link=\"HEADQUARTERS\">Duplicadora</link>"

#. STRINGS.BUILDINGS.PREFABS.HEADQUARTERSCOMPLETE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HEADQUARTERSCOMPLETE.NAME"
msgid "<link=\"HEADQUARTERS\">Printing Pod</link>"
msgstr "<link=\"HEADQUARTERS\">Duplicadora</link>"

#. STRINGS.BUILDINGS.PREFABS.HEADQUARTERSCOMPLETE.UNIQUE_POPTEXT
msgctxt "STRINGS.BUILDINGS.PREFABS.HEADQUARTERSCOMPLETE.UNIQUE_POPTEXT"
msgid ""
"A clone of the cloning machine? What a novel thought.\n"
"\n"
"Alas, it won't work."
msgstr ""
"Um clone de uma máquina de clonagem? Que ideia original.\n"
"\n"
"Infelizmente, não vai funcionar."

#. STRINGS.BUILDINGS.PREFABS.HEATCOMPRESSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HEATCOMPRESSOR.DESC"
msgid "\"Room temperature\" is relative, really."
msgstr "\"Temperatura ambiente\" é relativa, sério."

#. STRINGS.BUILDINGS.PREFABS.HEATCOMPRESSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HEATCOMPRESSOR.EFFECT"
msgid ""
"Heats or cools <link=\"ELEMENTSLIQUID\">Liquid</link> to match ambient <link=\"HEAT\">Air "
"Temperature</link>."
msgstr ""
"Aquece ou esfria <link=\"ELEMENTSLIQUID\">Líquidos</link> para igualar à <link=\"HEAT\">Temperatura "
"do Ar</link> ambiente."

#. STRINGS.BUILDINGS.PREFABS.HEATCOMPRESSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HEATCOMPRESSOR.NAME"
msgid "<link=\"HEATCOMPRESSOR\">Liquid Heatquilizer</link>"
msgstr "<link=\"HEATCOMPRESSOR\">Equalizador Térmico de Líquidos</link>"

#. STRINGS.BUILDINGS.PREFABS.HEPBATTERY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBATTERY.DESC"
msgid "Particles packed up and ready to go."
msgstr "Partículas embaladas e prontas para a jornada."

#. STRINGS.BUILDINGS.PREFABS.HEPBATTERY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBATTERY.EFFECT"
msgid ""
"Stores Radbolts in a high-energy state, ready for transport.\n"
"\n"
"Requires a <b><style=\"logic_on\">Green Signal</style></b> to release radbolts from storage when "
"the Radbolt threshold is reached.\n"
"\n"
"Radbolts in storage will rapidly decay while this building is disabled."
msgstr ""
"Armazena Rádio-Raios em um estado de alta energia, prontos para transporte.\n"
"\n"
"Requer um <b><style=\"logic_on\">Sinal Verde</style></b> para liberar os Rádio-Raios do "
"armazenamento quando o limite de Rádio-Raios for atingido.\n"
"\n"
"Rádio-Raios no armazenamento irão decair rapidamente enquanto esta estrutura estiver desativada."

#. STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT"
msgid "Do not emit Radbolts"
msgstr "Não emitir Rádio-Raios"

#. STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Emit Radbolts"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Emite Rádio-Raios"

#. STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Do not emit Radbolts"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Não emite Rádio-Raios"

#. STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_STORAGE
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_STORAGE"
msgid "Radbolt Storage"
msgstr "Armazenador de Rádio-Raios"

#. STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_STORAGE_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_STORAGE_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when its Radbolt Storage is full"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> quando o Armazenador de Rádio-Raios estiver "
"cheio"

#. STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_STORAGE_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_STORAGE_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.HEPBATTERY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBATTERY.NAME"
msgid "<link=\"HEPBATTERY\">Radbolt Chamber</link>"
msgstr "<link=\"HEPBATTERY\">Câmara de Rádio-Raios</link>"

#. STRINGS.BUILDINGS.PREFABS.HEPBRIDGETILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBRIDGETILE.DESC"
msgid "Allows Radbolts to pass through walls."
msgstr "Permite que Rádio-Raios passem por paredes."

#. STRINGS.BUILDINGS.PREFABS.HEPBRIDGETILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBRIDGETILE.EFFECT"
msgid ""
"Receives <link=\"RADIATION\">Radbolts</link> from <link=\"HIGHENERGYPARTICLESPAWNER\">Radbolt "
"Generators</link> and directs them through walls. All other materials and elements will be blocked "
"from passage."
msgstr ""
"Recebe <link=\"RADIATION\">Rádio-Raios</link> de <link=\"HIGHENERGYPARTICLESPAWNER\">Geradores de "
"Rádio-Raios</link> e os passa por paredes. Todos os outros materiais elementos serão bloqueados de "
"passar."

#. STRINGS.BUILDINGS.PREFABS.HEPBRIDGETILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBRIDGETILE.NAME"
msgid "<link=\"HEPBRIDGETILE\">Radbolt Joint Plate</link>"
msgstr "<link=\"HEPBRIDGETILE\">Placa de Junção de Rádio-Raios</link>"

#. STRINGS.BUILDINGS.PREFABS.HEPENGINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPENGINE.DESC"
msgid "Radbolt-fueled rockets support few modules, but travel exceptionally far."
msgstr ""
"Foguetes abastecidos com Rádio-Raios suportam poucos módulos, mas conseguem viajar excepcionalmente "
"mais longe."

#. STRINGS.BUILDINGS.PREFABS.HEPENGINE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPENGINE.EFFECT"
msgid ""
"Injects <link=\"RADIATION\">Radbolts</link> into a reaction chamber to propel rockets for long-"
"range space exploration.\n"
"\n"
"Radbolt Engines are faster than <link=\"HYDROGENENGINE\">Hydrogen Engines</link> but with a more "
"restrictive height allowance.\n"
"\n"
"Engine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>. \n"
"\n"
"Once the engine has been built, more rocket modules can be added."
msgstr ""
"Injeta <link=\"RADIATION\">Rádio-Raios</link> dentro de uma câmara de reação para impulsionar "
"foguetes em exploração espacial de longo alcance.\n"
"\n"
"Motores à Rádio-Raios são mais rápidos que <link=\"HYDROGENENGINE\">Motores à Hidrogênio</link> mas "
"com um limite de altura mais restritivo.\n"
"\n"
"O motor de um foguete precisa ser construído pela <link=\"LAUNCHPAD\">Plataforma de Foguetes</"
"link>.\n"
"\n"
"Uma vez que o motor for construído, mais módulos poderão ser adicionados."

#. STRINGS.BUILDINGS.PREFABS.HEPENGINE.LOGIC_PORT_STORAGE
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPENGINE.LOGIC_PORT_STORAGE"
msgid "Radbolt Storage"
msgstr "Armazenador de Rádio-Raios"

#. STRINGS.BUILDINGS.PREFABS.HEPENGINE.LOGIC_PORT_STORAGE_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPENGINE.LOGIC_PORT_STORAGE_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when its Radbolt Storage is full"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> quando o Armazenador de Rádio-Raios estiver "
"cheio"

#. STRINGS.BUILDINGS.PREFABS.HEPENGINE.LOGIC_PORT_STORAGE_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPENGINE.LOGIC_PORT_STORAGE_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.HEPENGINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPENGINE.NAME"
msgid "<link=\"HEPENGINE\">Radbolt Engine</link>"
msgstr "<link=\"HEPENGINE\">Motor à Rádio-Raios</link>"

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.DESC"
msgid "We were all out of mirrors."
msgstr "Ficamos sem nenhum espelho."

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.EFFECT"
msgid ""
"Receives and redirects Radbolts from <link=\"HIGHENERGYPARTICLESPAWNER\">Radbolt Generators</link>."
msgstr ""
"Recebe e redireciona Rádio-Raios de <link=\"HIGHENERGYPARTICLESPAWNER\">Geradores de Rádio-Raios</"
"link>."

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.LOGIC_PORT"
msgid "Ignore incoming Radbolts"
msgstr "Ignorar Rádio-Raios a caminho"

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Allow incoming Radbolts"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Permitir Rádio-Raios a caminho"

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Ignore incoming Radbolts"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Ignorar Rádio-Raios a caminho"

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.NAME"
msgid "<link=\"HIGHENERGYPARTICLEREDIRECTOR\">Radbolt Reflector</link>"
msgstr "<link=\"HIGHENERGYPARTICLEREDIRECTOR\">Refletor de Rádio-Raios</link>"

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.DESC"
msgid "Radbolts are necessary for producing Materials Science research."
msgstr "Rádio-Raios são necessários para produzir Pesquisa Científica de Materiais."

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.EFFECT"
msgid ""
"Attracts nearby <link=\"RADIATION\">Radiation</link> to generate Radbolts.\n"
"\n"
"Emits generated Radbolts in the direction of your choosing when the set Radbolt threshold is "
"reached.\n"
"\n"
"Radbolts collected will gradually decay while this building is disabled."
msgstr ""
"Atrai <link=\"RADIATION\">Radiação</link> próxima para gerar Rádio-Raios.\n"
"\n"
"Emite os Rádio-Raios gerados na direção de sua escolha quando o limite de Rádio-Raios definido é "
"atingido.\n"
"\n"
"Rádio-Raios coletados irão decair gradualmente quando esta estrutura estiver desativada."

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.LOGIC_PORT"
msgid "Do not emit Radbolts"
msgstr "Não emitir Rádio-Raios"

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Emit Radbolts"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Emite Rádio-Raios"

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Do not emit Radbolts"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Não emite Rádio-Raios"

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.NAME"
msgid "<link=\"HIGHENERGYPARTICLESPAWNER\">Radbolt Generator</link>"
msgstr "<link=\"HIGHENERGYPARTICLESPAWNER\">Gerador de Rádio-Raios</link>"

#. STRINGS.BUILDINGS.PREFABS.HIGHWATTAGEWIRE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHWATTAGEWIRE.DESC"
msgid "Higher wattage wire is used to avoid power overloads, particularly for strong generators."
msgstr ""
"Fiação de alta potência é utilizada para evitar sobrecargas de energia, principalmente para "
"geradores potentes."

#. STRINGS.BUILDINGS.PREFABS.HIGHWATTAGEWIRE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHWATTAGEWIRE.EFFECT"
msgid ""
"Carries more <link=\"POWER\">Wattage</link> than regular <link=\"WIRE\">Wire</link> without "
"overloading.\n"
"\n"
"Cannot be run through wall and floor tile."
msgstr ""
"Carrega mais <link=\"POWER\">Potência</link> do que <link=\"WIRE\">Fios</link> normais sem "
"sobrecarregar.\n"
"\n"
"Não pode passar por blocos."

#. STRINGS.BUILDINGS.PREFABS.HIGHWATTAGEWIRE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHWATTAGEWIRE.NAME"
msgid "<link=\"HIGHWATTAGEWIRE\">Heavi-Watt Wire</link>"
msgstr "<link=\"HIGHWATTAGEWIRE\">Fio de Alta Potência</link>"

#. STRINGS.BUILDINGS.PREFABS.HIJACKEDHEADQUARTERS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HIJACKEDHEADQUARTERS.DESC"
msgid "The access code required to reboot it for testing is located somewhere on this world."
msgstr ""
"O código de acesso necessário para reiniciá-la para testes está localizado em algum lugar deste "
"mundo."

#. STRINGS.BUILDINGS.PREFABS.HIJACKEDHEADQUARTERS.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HIJACKEDHEADQUARTERS.EFFECT"
msgid ""
"An unsanctioned bioprinter that runs on power siphoned from the <link=\"HEADQUARTERS\">Printing "
"Pod</link>."
msgstr ""
"Uma bioimpressora não autorizada que funciona com energia desviada de uma "
"<link=\"HEADQUARTERS\">Duplicadora</link>."

#. STRINGS.BUILDINGS.PREFABS.HIJACKEDHEADQUARTERS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HIJACKEDHEADQUARTERS.NAME"
msgid "<link=\"HIJACKEDHEADQUARTERS\">Printerceptor</link>"
msgstr "<link=\"HIJACKEDHEADQUARTERS\">Imprimerceptador</link>"

#. STRINGS.BUILDINGS.PREFABS.HIJACKEDHEADQUARTERS_COMPLETED.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HIJACKEDHEADQUARTERS_COMPLETED.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.HIJACKEDHEADQUARTERS_COMPLETED.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HIJACKEDHEADQUARTERS_COMPLETED.EFFECT"
msgid ""
"Intercepts and stores <link=\"POWER\">Power</link> charges from the <link=\"HEADQUARTERS\">Printing "
"Pod</link>.\n"
"\n"
"Converts stored charges and <link=\"DATABANK\">Data Banks</link> into <link=\"CREATURES\">Seeds</"
"link> and <link=\"CREATURES\">Eggs</link>."
msgstr ""
"Intercepta e armazena cargas de <link=\"POWER\">Energia</link> da "
"<link=\"HEADQUARTERS\">Duplicadora</link>.\n"
"\n"
"Converte cargas armazenadas e <link=\"DATABANK\">Bancos de Dados</link> em "
"<link=\"CREATURES\">Sementes</link> e <link=\"CREATURES\">Ovos</link>."

#. STRINGS.BUILDINGS.PREFABS.HIJACKEDHEADQUARTERS_COMPLETED.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HIJACKEDHEADQUARTERS_COMPLETED.NAME"
msgid "<link=\"HIJACKEDHEADQUARTERS\">Printerceptor</link>"
msgstr "<link=\"HIJACKEDHEADQUARTERS\">Imprimerceptador</link>"

#. STRINGS.BUILDINGS.PREFABS.HOTTUB.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HOTTUB.DESC"
msgid "Relaxes Duplicants with massaging jets of heated liquid."
msgstr "Relaxa Duplicantes com jatos massageadores de líquido aquecido."

#. STRINGS.BUILDINGS.PREFABS.HOTTUB.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HOTTUB.EFFECT"
msgid ""
"Requires <link=\"LIQUIDPIPING\">Pipes</link> to and from tub and <link=\"POWER\">Power</link> to "
"run the jets.\n"
"\n"
"Water must be a comfortable temperature and will cool rapidly.\n"
"\n"
"Increases Duplicant <link=\"MORALE\">Morale</link> and leaves them feeling deliciously warm."
msgstr ""
"Requer <link=\"LIQUIDPIPING\">Canos</link> para dentro e para fora da banheira e "
"<link=\"POWER\">Energia</link> para ligar os jatos.\n"
"\n"
"A água precisa estar em uma temperatura confortável e esfriará rapidamente.\n"
"\n"
"Aumenta a <link=\"MORALE\">Moral</link> dos Duplicantes e deixa eles se sentindo deliciosamente "
"aquecidos."

#. STRINGS.BUILDINGS.PREFABS.HOTTUB.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HOTTUB.NAME"
msgid "<link=\"HOTTUB\">Hot Tub</link>"
msgstr "<link=\"HOTTUB\">Banheira de Hidromassagem</link>"

#. STRINGS.BUILDINGS.PREFABS.HOTTUB.TEMPERATURE_REQUIREMENT
msgctxt "STRINGS.BUILDINGS.PREFABS.HOTTUB.TEMPERATURE_REQUIREMENT"
msgid "Minimum {element} Temperature: {temperature}"
msgstr "Temperatura Mínima da {element}: {temperature}"

#. STRINGS.BUILDINGS.PREFABS.HOTTUB.TEMPERATURE_REQUIREMENT_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.HOTTUB.TEMPERATURE_REQUIREMENT_TOOLTIP"
msgid ""
"The Hot Tub will only be usable if supplied with {temperature} {element}. If the {element} gets too "
"cold, the Hot Tub will drain and require refilling with {element}."
msgstr ""
"A Banheira de Hidromassagem só poderá ser utilizada quando for suprida com {element} à "
"{temperature}. Se a {element} ficar muito fria, a Banheira de Hidromassagem se esvaziará e "
"precisará reencher com {element}."

#. STRINGS.BUILDINGS.PREFABS.HOTTUB.WATER_REQUIREMENT
msgctxt "STRINGS.BUILDINGS.PREFABS.HOTTUB.WATER_REQUIREMENT"
msgid "{element}: {amount}"
msgstr "{element}: {amount}"

#. STRINGS.BUILDINGS.PREFABS.HOTTUB.WATER_REQUIREMENT_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.HOTTUB.WATER_REQUIREMENT_TOOLTIP"
msgid "This building must be filled with {amount} {element} in order to function."
msgstr "Esta estrutura precisa ser enchida com {amount} {element} para funcionar."

#. STRINGS.BUILDINGS.PREFABS.HYDROGENENGINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROGENENGINE.DESC"
msgid "Hydrogen engines can propel rockets further than steam or petroleum engines."
msgstr "Motores à Hidrogênio podem propelir foguetes mais longe do que motores à petróleo ou à vapor."

#. STRINGS.BUILDINGS.PREFABS.HYDROGENENGINE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROGENENGINE.EFFECT"
msgid ""
"Burns <link=\"LIQUIDHYDROGEN\">Liquid Hydrogen</link> to propel rockets for long-range space "
"exploration.\n"
"\n"
"Hydrogen Engines have the same generous height restrictions as <link=\"KEROSENEENGINE\">Petroleum "
"Engines</link> but are slightly faster.\n"
"\n"
"The engine must be built first before more rocket modules can be added."
msgstr ""
"Queima <link=\"LIQUIDHYDROGEN\">Hidrogênio Líquido</link> para propelir foguetes em exploração "
"espacial de longo alcance.\n"
"\n"
"Motores à Hidrogênio possuem as mesmas restrições generosas de altura dos "
"<link=\"KEROSENEENGINE\">Motores à Petróleo</link> mas são ligeiramente mais rápidos\n"
"\n"
"O motor de um foguete precisa ser construído primeiro antes de mais módulos serem adicionados."

#. STRINGS.BUILDINGS.PREFABS.HYDROGENENGINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROGENENGINE.NAME"
msgid "<link=\"HYDROGENENGINE\">Hydrogen Engine</link>"
msgstr "<link=\"HYDROGENENGINE\">Motor à Hidrogênio</link>"

#. STRINGS.BUILDINGS.PREFABS.HYDROGENENGINECLUSTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROGENENGINECLUSTER.DESC"
msgid "Hydrogen engines can propel rockets further than steam or petroleum engines."
msgstr "Motores à Hidrogênio podem propelir foguetes mais longe do que motores à petróleo ou à vapor."

#. STRINGS.BUILDINGS.PREFABS.HYDROGENENGINECLUSTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROGENENGINECLUSTER.EFFECT"
msgid ""
"Burns <link=\"LIQUIDHYDROGEN\">Liquid Hydrogen</link> to propel rockets for long-range space "
"exploration.\n"
"\n"
"Hydrogen Engines have the same generous height restrictions as <link=\"KEROSENEENGINE\">Petroleum "
"Engines</link> but are slightly faster.\n"
"\n"
"Engine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>, and requires an oxidizer "
"tank.\n"
"\n"
"Once the engine has been built, more rocket modules can be added."
msgstr ""
"Queima <link=\"LIQUIDHYDROGEN\">Hidrogênio Líquido</link> para propelir foguetes em exploração "
"espacial de longo alcance.\n"
"\n"
"Motores à Hidrogênio possuem as mesmas restrições generosas de altura dos "
"<link=\"KEROSENEENGINE\">Motores à Petróleo</link> mas são ligeiramente mais rápidos\n"
"\n"
"O motor de um foguete precisa ser construído pela <link=\"LAUNCHPAD\">Plataforma de Foguetes</"
"link>, e requer um tanque de oxidante.\n"
"\n"
"Assim que o motor for construído, mais módulos podem ser adicionados."

#. STRINGS.BUILDINGS.PREFABS.HYDROGENENGINECLUSTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROGENENGINECLUSTER.NAME"
msgid "<link=\"HYDROGENENGINECLUSTER\">Hydrogen Engine</link>"
msgstr "<link=\"HYDROGENENGINECLUSTER\">Motor à Hidrogênio</link>"

#. STRINGS.BUILDINGS.PREFABS.HYDROGENGENERATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROGENGENERATOR.DESC"
msgid "Hydrogen generators are extremely efficient, emitting next to no waste."
msgstr "Geradores à Hidrogênio são excepcionalmente eficientes, emitindo praticamente nenhum resíduo."

#. STRINGS.BUILDINGS.PREFABS.HYDROGENGENERATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROGENGENERATOR.EFFECT"
msgid "Converts <link=\"HYDROGEN\">Hydrogen Gas</link> into electrical <link=\"POWER\">Power</link>."
msgstr "Converte <link=\"HYDROGEN\">Gás Hidrogênio</link> em <link=\"POWER\">Energia</link> elétrica."

#. STRINGS.BUILDINGS.PREFABS.HYDROGENGENERATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROGENGENERATOR.NAME"
msgid "<link=\"HYDROGENGENERATOR\">Hydrogen Generator</link>"
msgstr "<link=\"HYDROGENGENERATOR\">Gerador à Hidrogênio</link>"

#. STRINGS.BUILDINGS.PREFABS.HYDROPONICFARM.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROPONICFARM.DESC"
msgid "Hydroponic farms reduce Duplicant traffic by automating irrigating crops."
msgstr "Hortas Hidropônicas reduzem o tráfego de Duplicantes por automatizar a irrigação."

#. STRINGS.BUILDINGS.PREFABS.HYDROPONICFARM.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROPONICFARM.EFFECT"
msgid ""
"Grows one <link=\"PLANTS\">Plant</link> from a <link=\"PLANTS\">Seed</link>.\n"
"\n"
"Can be used as floor tile and rotated before construction.\n"
"\n"
"Must be irrigated through <link=\"LIQUIDPIPING\">Liquid Piping</link>."
msgstr ""
"Germina uma <link=\"PLANTS\">Planta</link> a partir de uma <link=\"PLANTS\">Semente</link>.\n"
"\n"
"Pode ser usada como bloco e rodada antes da construção.\n"
"\n"
"Precisa ser irrigada usando <link=\"LIQUIDPIPING\">Encanamento</link>."

#. STRINGS.BUILDINGS.PREFABS.HYDROPONICFARM.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROPONICFARM.NAME"
msgid "<link=\"HYDROPONICFARM\">Hydroponic Farm</link>"
msgstr "<link=\"HYDROPONICFARM\">Horta Hidropônica</link>"

#. STRINGS.BUILDINGS.PREFABS.ICECOOLEDFAN.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ICECOOLEDFAN.DESC"
msgid "A Duplicant can work an Ice-E fan to temporarily cool small areas as needed."
msgstr ""
"Um Duplicante pode operar um Vengelador para esfriar temporariamente pequenas áreas conforme "
"necessário."

#. STRINGS.BUILDINGS.PREFABS.ICECOOLEDFAN.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ICECOOLEDFAN.EFFECT"
msgid ""
"Uses <link=\"ICEORE\">Ice</link> to dissipate a small amount of the <link=\"HEAT\">Heat</link>."
msgstr ""
"Usa <link=\"ICEORE\">Gelo</link> para dissipar uma pequena parte do <link=\"HEAT\">Calor</link>."

#. STRINGS.BUILDINGS.PREFABS.ICECOOLEDFAN.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICECOOLEDFAN.NAME"
msgid "<link=\"ICECOOLEDFAN\">Ice-E Fan</link>"
msgstr "<link=\"ICECOOLEDFAN\">Vengelador</link>"

#. STRINGS.BUILDINGS.PREFABS.ICEKETTLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ICEKETTLE.DESC"
msgid "The water never gets hot enough to burn the tongue."
msgstr "A água nunca fica quente o bastante para queimar a língua."

#. STRINGS.BUILDINGS.PREFABS.ICEKETTLE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ICEKETTLE.EFFECT"
msgid ""
"Consumes <link=\"WOOD\">Wood</link> to melt <link=\"ICE\">Ice</link> into <link=\"WATER\">Water</"
"link>, which can be bottled for transport."
msgstr ""
"Consome <link=\"WOOD\">Madeira</link> para derreter <link=\"ICE\">Gelo</link> em "
"<link=\"WATER\">Água</link>, que pode ser engarrafada para transporte."

#. STRINGS.BUILDINGS.PREFABS.ICEKETTLE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICEKETTLE.NAME"
msgid "<link=\"ICEKETTLE\">Ice Liquefier</link>"
msgstr "<link=\"ICEKETTLE\">Liquefator de Gelo</link>"

#. STRINGS.BUILDINGS.PREFABS.ICEMACHINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ICEMACHINE.DESC"
msgid "Ice makers can be used as a small renewable source of ice and snow."
msgstr "As máquinas de gelo podem ser usadas como uma pequena fonte renovável de gelo e neve."

#. STRINGS.BUILDINGS.PREFABS.ICEMACHINE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ICEMACHINE.EFFECT"
msgid ""
"Converts <link=\"WATER\">Water</link> into <link=\"ICE\">Ice</link> or <link=\"SNOW\">Snow</link>."
msgstr ""
"Converte <link=\"WATER\">Água</link> em <link=\"ICE\">Gelo</link> ou <link=\"SNOW\">Neve</link>."

#. STRINGS.BUILDINGS.PREFABS.ICEMACHINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICEMACHINE.NAME"
msgid "<link=\"ICEMACHINE\">Ice Maker</link>"
msgstr "<link=\"ICEMACHINE\">Máquina de Gelo</link>"

#. STRINGS.BUILDINGS.PREFABS.ICEMACHINE.OPTION_TOOLTIPS.ICE
msgctxt "STRINGS.BUILDINGS.PREFABS.ICEMACHINE.OPTION_TOOLTIPS.ICE"
msgid "Convert <link=\"WATER\">Water</link> into <link=\"ICE\">Ice</link>"
msgstr "Converte <link=\"WATER\">Água</link> em <link=\"ICE\">Gelo</link>"

#. STRINGS.BUILDINGS.PREFABS.ICEMACHINE.OPTION_TOOLTIPS.SNOW
msgctxt "STRINGS.BUILDINGS.PREFABS.ICEMACHINE.OPTION_TOOLTIPS.SNOW"
msgid "Convert <link=\"WATER\">Water</link> into <link=\"SNOW\">Snow</link>"
msgstr "Converte <link=\"WATER\">Água</link> em <link=\"SNOW\">Neve</link>"

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.AVERAGEQUALITYNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.AVERAGEQUALITYNAME"
msgid "Mediocre Ice Sculpture"
msgstr "Escultura de Gelo Medíocre"

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.DESC"
msgid "Prone to melting."
msgstr "Propensa a derreter."

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.EFFECT"
msgid ""
"Majorly increases <link=\"DECOR\">Decor</link>, contributing to <link=\"MORALE\">Morale</link>.\n"
"\n"
"Must be sculpted by a Duplicant."
msgstr ""
"Aumenta bastante a <link=\"DECOR\">Decoração</link>, contribuindo para a <link=\"MORALE\">Moral</"
"link>.\n"
"\n"
"Precisa ser esculpida por um Duplicante."

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.EXCELLENTQUALITYNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.EXCELLENTQUALITYNAME"
msgid "Genius Ice Sculpture"
msgstr "Escultura de Gelo Genial"

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_1.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_1.DESC"
msgid "These incisors are the stuff of dental legend."
msgstr "Esses incisivos são coisa de lendas dentárias."

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_1.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_1.NAME"
msgid "<link=\"ICESCULPTUREAMAZING1\">Exquisite Chompers</link>"
msgstr "<link=\"ICESCULPTUREAMAZING1\">Devoradores Exóticos</link>"

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_2.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_2.DESC"
msgid "A charming depiction of the mighty Pokeshell in mid-rampage."
msgstr "Uma maravilhosa representação do poderoso Socasco no meio da fúria."

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_2.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_2.NAME"
msgid "<link=\"ICESCULPTUREAMAZING2\">Frosty Crustacean</link>"
msgstr "<link=\"ICESCULPTUREAMAZING2\">Crustáceo Congelado</link>"

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_3.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_3.DESC"
msgid "Some aquarists posit that Pacus are the original creators of the game now known as \"Tag.\""
msgstr ""
"Alguns aquaristas postulam que Pacus são os criadores originais do jogo agora conhecido como \"Pega-"
"Pega\"."

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_3.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_3.NAME"
msgid "<link=\"ICESCULPTUREAMAZING3\">The Chase</link>"
msgstr "<link=\"SCULPTUREAMAZING1\">A Caçada</link>"

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_CRAP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_CRAP.DESC"
msgid "It's structurally unsound, but otherwise not entirely terrible."
msgstr "É estruturalmente instável, mas fora isso não é inteiramente ruim."

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_CRAP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_CRAP.NAME"
msgid "<link=\"ICESCULPTURECRAP\">Cubi I</link>"
msgstr "<link=\"ICESCULPTURECRAP\">Cubi I</link>"

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.NAME"
msgid "<link=\"ICESCULPTURE\">Ice Block</link>"
msgstr "<link=\"ICESCULPTURE\">Bloco de Gelo</link>"

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.POORQUALITYNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.POORQUALITYNAME"
msgid "\"Abstract\" Ice Sculpture"
msgstr "Escultura de Gelo \"Abstrata\""

#. STRINGS.BUILDINGS.PREFABS.INSULATEDDOOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDDOOR.DESC"
msgid "A slow-moving door that works best when it's closed."
msgstr "Uma porta que se move lentamente e funciona melhor quando fechada."

#. STRINGS.BUILDINGS.PREFABS.INSULATEDDOOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDDOOR.EFFECT"
msgid ""
"Significantly reduces <link=\"HEAT\">Temperature</link> exchange between climate-controlled rooms."
msgstr ""
"Reduz significativamente a mudança de <link=\"HEAT\">Temperatura</link> entre salas climatizadas."

#. STRINGS.BUILDINGS.PREFABS.INSULATEDDOOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDDOOR.NAME"
msgid "<link=\"INSULATEDDOOR\">Insulated Door</link>"
msgstr "<link=\"INSULATEDDOOR\">Porta Isolante</link>"

#. STRINGS.BUILDINGS.PREFABS.INSULATEDGASCONDUIT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDGASCONDUIT.DESC"
msgid "Pipe insulation prevents gas contents from significantly changing temperature in transit."
msgstr ""
"Tubos de Gás Isolantes previnem que os gases em trânsito sofram mudança de temperatura "
"significativa."

#. STRINGS.BUILDINGS.PREFABS.INSULATEDGASCONDUIT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDGASCONDUIT.EFFECT"
msgid ""
"Carries <link=\"ELEMENTSGAS\">Gas</link> with minimal change in <link=\"HEAT\">Temperature</link>.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"Transporta <link=\"ELEMENTSGAS\">Gases</link> com uma mínima mudança na <link=\"HEAT\">Temperatura</"
"link>.\n"
"\n"
"Pode passar pelos blocos."

#. STRINGS.BUILDINGS.PREFABS.INSULATEDGASCONDUIT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDGASCONDUIT.NAME"
msgid "<link=\"INSULATEDGASCONDUIT\">Insulated Gas Pipe</link>"
msgstr "<link=\"INSULATEDGASCONDUIT\">Tubo de Gás Isolante</link>"

#. STRINGS.BUILDINGS.PREFABS.INSULATEDLIQUIDCONDUIT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDLIQUIDCONDUIT.DESC"
msgid "Pipe insulation prevents liquid contents from significantly changing temperature in transit."
msgstr ""
"Canos de Líquidos Isolantes previne que os líquidos em trânsito sofram mudança de temperatura "
"significativa."

#. STRINGS.BUILDINGS.PREFABS.INSULATEDLIQUIDCONDUIT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDLIQUIDCONDUIT.EFFECT"
msgid ""
"Carries <link=\"ELEMENTSLIQUID\">Liquid</link> with minimal change in <link=\"HEAT\">Temperature</"
"link>.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"Transporta <link=\"ELEMENTSLIQUID\">Líquidos</link> com uma mínima mudança na "
"<link=\"HEAT\">Temperatura</link>.\n"
"\n"
"Pode passar pelos blocos."

#. STRINGS.BUILDINGS.PREFABS.INSULATEDLIQUIDCONDUIT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDLIQUIDCONDUIT.NAME"
msgid "<link=\"INSULATEDLIQUIDCONDUIT\">Insulated Liquid Pipe</link>"
msgstr "<link=\"INSULATEDLIQUIDCONDUIT\">Cano de Líquido Isolante</link>"

#. STRINGS.BUILDINGS.PREFABS.INSULATEDWIRE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDWIRE.DESC"
msgid "This stuff won't go melting if things get heated."
msgstr "Esta coisa não vai derreter se as coisas esquentarem."

#. STRINGS.BUILDINGS.PREFABS.INSULATEDWIRE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDWIRE.EFFECT"
msgid ""
"Connects buildings to <link=\"POWER\">Power</link> sources in extreme <link=\"HEAT\">Heat</link>.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"Conecta estruturas à fontes de <link=\"POWER\">Energia</link> em <link=\"HEAT\">Calor</link> "
"extremo.\n"
"\n"
"Pode passar pelos blocos."

#. STRINGS.BUILDINGS.PREFABS.INSULATEDWIRE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDWIRE.NAME"
msgid "<link=\"INSULATEDWIRE\">Insulated Wire</link>"
msgstr "<link=\"INSULATEDWIRE\">Fio Isolado</link>"

#. STRINGS.BUILDINGS.PREFABS.INSULATIONTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATIONTILE.DESC"
msgid "The low thermal conductivity of insulated tiles slows any heat passing through them."
msgstr "A baixa condutividade térmica de blocos isolantes diminuem a passagem de calor por eles."

#. STRINGS.BUILDINGS.PREFABS.INSULATIONTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATIONTILE.EFFECT"
msgid ""
"Used to build the walls and floors of rooms.\n"
"\n"
"Reduces <link=\"HEAT\">Heat</link> transfer between walls, retaining ambient heat in an area."
msgstr ""
"Usado como bloco de piso ou parede para construir quartos.\n"
"\n"
"Reduz a troca de <link=\"HEAT\">Calor</link> entre paredes, retendo calor em uma área."

#. STRINGS.BUILDINGS.PREFABS.INSULATIONTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATIONTILE.NAME"
msgid "<link=\"INSULATIONTILE\">Insulated Tile</link>"
msgstr "<link=\"INSULATIONTILE\">Bloco Isolante</link>"

#. STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.DESC"
msgid "Perception can be drastically changed by a bit of thoughtful presentation."
msgstr "A percepção pode mudar drasticamente com uma apresentação bem pensada."

#. STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.DISPLAYED_ITEM_FMT
msgctxt "STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.DISPLAYED_ITEM_FMT"
msgid "Displayed {0}"
msgstr "Mostrando {0}"

#. STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.EFFECT"
msgid ""
"Displays a single object, doubling its <link=\"DECOR\">Decor</link> value.\n"
"\n"
"Objects with negative Decor will gain some positive Decor when displayed."
msgstr ""
"Exibe um único objeto, duplicando seu valor de <link=\"DECOR\">Decoração</link>.\n"
"\n"
"Objetos com Decoração negativa ganharão um pouco de Decoração positiva enquanto em exibição."

#. STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.FACADES.DEFAULT_ITEMPEDESTAL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.FACADES.DEFAULT_ITEMPEDESTAL.DESC"
msgid "Perception can be drastically changed by a bit of thoughtful presentation."
msgstr "A percepção pode mudar drasticamente com uma apresentação bem pensada."

#. STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.FACADES.DEFAULT_ITEMPEDESTAL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.FACADES.DEFAULT_ITEMPEDESTAL.NAME"
msgid "<link=\"ITEMPEDESTAL\">Pedestal</link>"
msgstr "<link=\"ITEMPEDESTAL\">Pedestal</link>"

#. STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.FACADES.HAND.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.FACADES.HAND.DESC"
msgid "This pedestal cradles precious objects in the palm of its hand."
msgstr "Este pedestal segura objetos preciosos na palma de sua mão."

#. STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.FACADES.HAND.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.FACADES.HAND.NAME"
msgid "<link=\"ITEMPEDESTAL\">Hand of Dupe Pedestal</link>"
msgstr "<link=\"ITEMPEDESTAL\">Pedestal de Mão de Duplicante</link>"

#. STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.NAME"
msgid "<link=\"ITEMPEDESTAL\">Pedestal</link>"
msgstr "<link=\"ITEMPEDESTAL\">Pedestal</link>"

#. STRINGS.BUILDINGS.PREFABS.JETSUITLOCKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.JETSUITLOCKER.DESC"
msgid "Jet suit docks can refill jet suits with air and fuel, or empty them of waste."
msgstr ""
"Estações de trajes à jato podem recarregar trajes à jato com ar e combustível ou limpá-los de "
"resíduos."

#. STRINGS.BUILDINGS.PREFABS.JETSUITLOCKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.JETSUITLOCKER.EFFECT"
msgid ""
"Stores <link=\"JETSUIT\">Jet Suits</link> and refuels them with <link=\"OXYGEN\">Oxygen</link> and "
"<link=\"COMBUSTIBLELIQUID\">Combustible Liquid</link>.\n"
"\n"
"Empties suits of <link=\"DIRTYWATER\">Polluted Water</link>.\n"
"\n"
"Build next to a <link=\"JETSUITMARKER\">Jet Suit Checkpoint</link> to make Duplicants change into "
"suits when passing by."
msgstr ""
"Armazena <link=\"JETSUIT\">Trajes à Jato</link> e os recarrega com <link=\"OXYGEN\">Oxigênio</link> "
"e <link=\"COMBUSTIBLELIQUID\">Combustível Líquido</link>.\n"
"\n"
"Esvazia os trajes de <link=\"DIRTYWATER\">Água Poluída</link>.\n"
"\n"
"Construa próximo a um <link=\"JETSUITMARKER\">Ponto de Checagem de Trajes à Jato</link> para fazer "
"os Duplicantes vestirem os trajes quando passarem."

#. STRINGS.BUILDINGS.PREFABS.JETSUITLOCKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.JETSUITLOCKER.NAME"
msgid "<link=\"JETSUITLOCKER\">Jet Suit Dock</link>"
msgstr "<link=\"JETSUITLOCKER\">Estação de Traje à Jato</link>"

#. STRINGS.BUILDINGS.PREFABS.JETSUITMARKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.JETSUITMARKER.DESC"
msgid "A checkpoint must have a correlating dock built on the opposite side its arrow faces."
msgstr ""
"Um ponto de checagem precisa ter uma estação correspondente construída ao lado oposto ao qual sua "
"seta aponta."

#. STRINGS.BUILDINGS.PREFABS.JETSUITMARKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.JETSUITMARKER.EFFECT"
msgid ""
"Marks a threshold where Duplicants must change into or out of <link=\"JETSUIT\">Jet Suits</link>.\n"
"\n"
"Must be built next to a <link=\"JETSUITLOCKER\">Jet Suit Dock</link>.\n"
"\n"
"Can be rotated before construction."
msgstr ""
"Marca um limite onde os Duplicantes devem tirar ou colocar o <link=\"JETSUIT\">Traje à Jato</"
"link>.\n"
"\n"
"Precisa ser construída ao lado de uma <link=\"JETSUITLOCKER\">Estação de Traje à Jato</link>.\n"
"\n"
"Pode ser rotacionada antes da construção."

#. STRINGS.BUILDINGS.PREFABS.JETSUITMARKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.JETSUITMARKER.NAME"
msgid "<link=\"JETSUITMARKER\">Jet Suit Checkpoint</link>"
msgstr "<link=\"JETSUITMARKER\">Ponto de Checagem de Traje à Jato</link>"

#. STRINGS.BUILDINGS.PREFABS.JUICER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.JUICER.DESC"
msgid "Fruity juice can really brighten a Duplicant's breaktime"
msgstr "Um suco frutado pode realmente animar o intervalo de um Duplicante"

#. STRINGS.BUILDINGS.PREFABS.JUICER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.JUICER.EFFECT"
msgid ""
"Provides refreshment for Duplicants on their breaks.\n"
"\n"
"Drinking juice increases Duplicant <link=\"MORALE\">Morale</link>."
msgstr ""
"Fornece bebidas refrescantes aos Duplicantes durante seus intervalos.\n"
"\n"
"Beber suco aumenta a <link=\"MORALE\">Moral</link> dos Duplicantes."

#. STRINGS.BUILDINGS.PREFABS.JUICER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.JUICER.NAME"
msgid "<link=\"JUICER\">Juicer</link>"
msgstr "<link=\"JUICER\">Espremedor</link>"

#. STRINGS.BUILDINGS.PREFABS.KEROSENEENGINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.KEROSENEENGINE.DESC"
msgid "Rockets can be used to send Duplicants into space and retrieve rare resources."
msgstr "Foguetes podem ser usados para enviar Duplicantes ao espaço e para coletar recursos raros."

#. STRINGS.BUILDINGS.PREFABS.KEROSENEENGINE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.KEROSENEENGINE.EFFECT"
msgid ""
"Burns <link=\"PETROLEUM\">Petroleum</link> to propel rockets for mid-range space exploration.\n"
"\n"
"Petroleum Engines have generous height restrictions, ideal for hauling many modules.\n"
"\n"
"The engine must be built first before more rocket modules can be added."
msgstr ""
"Queima <link=\"PETROLEUM\">Petróleo</link> para propelir os foguetes em exploração espacial de "
"médio alcance.\n"
"\n"
"Motores à Petróleo possuem restrições de altura generosas, ideal para instalação de vários "
"módulos.\n"
"\n"
"O motor de um foguete precisa ser construído primeiro para que outros módulos possam ser "
"adicionados.."

#. STRINGS.BUILDINGS.PREFABS.KEROSENEENGINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.KEROSENEENGINE.NAME"
msgid "<link=\"KEROSENEENGINE\">Petroleum Engine</link>"
msgstr "<link=\"KEROSENEENGINE\">Motor à Petróleo</link>"

#. STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTER.DESC"
msgid "More powerful rocket engines can propel heavier burdens."
msgstr "Motores de foguete mais potentes podem propelir cargas mais pesadas."

#. STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTER.EFFECT"
msgid ""
"Burns <link=\"PETROLEUM\">Petroleum</link> to propel rockets for mid-range space exploration.\n"
"\n"
"Petroleum Engines have generous height restrictions, ideal for hauling many modules.\n"
"\n"
"Engine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>, and requires an oxidizer "
"tank. \n"
"\n"
"Once the engine has been built, more rocket modules can be added."
msgstr ""
"Queima <link=\"PETROLEUM\">Petróleo</link> para propelir os foguetes em exploração espacial de "
"médio alcance.\n"
"\n"
"Motores à Petróleo possuem restrições de altura generosas, ideal para instalação de vários "
"módulos.\n"
"\n"
"O motor de um foguete precisa ser construído pela <link=\"LAUNCHPAD\">Plataforma de Foguetes</"
"link>, e requer um tanque de oxidante.\n"
"\n"
"Assim que o motor for construído, mais módulos podem ser adicionados."

#. STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTER.NAME"
msgid "<link=\"KEROSENEENGINECLUSTER\">Petroleum Engine</link>"
msgstr "<link=\"KEROSENEENGINECLUSTER\">Motor à Petróleo</link>"

#. STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTERSMALL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTERSMALL.DESC"
msgid "Rockets can be used to send Duplicants into space and retrieve rare resources."
msgstr "Foguetes podem ser usados para enviar Duplicantes ao espaço e coletar recursos raros."

#. STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTERSMALL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTERSMALL.EFFECT"
msgid ""
"Burns <link=\"PETROLEUM\">Petroleum</link> to propel rockets for mid-range space exploration.\n"
"\n"
"Small Petroleum Engines possess the same speed as a <link=\"KEROSENEENGINE\">Petroleum Engines</"
"link> but have smaller height restrictions.\n"
"\n"
"Engine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>, and requires an oxidizer "
"tank.\n"
"\n"
"Once the engine has been built, more rocket modules can be added."
msgstr ""
"Queima <link=\"PETROLEUM\">Petróleo</link> para impulsionar os foguetes em exploração espacial de "
"médio alcance.\n"
"\n"
"Pequenos Motores à Petróleo possuem a mesma velocidade que um <link=\"KEROSENEENGINE\">Motor à "
"Petróleo</link> mas possui maiores restrições de altura.\n"
"\n"
"O motor de um foguete precisa ser construído pela <link=\"LAUNCHPAD\">Plataforma de Foguetes</"
"link>, e requer um tanque de oxidante.\n"
"\n"
"Assim que o motor for construído, mais módulos podem ser adicionados."

#. STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTERSMALL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTERSMALL.NAME"
msgid "<link=\"KEROSENEENGINECLUSTERSMALL\">Small Petroleum Engine</link>"
msgstr "<link=\"KEROSENEENGINECLUSTERSMALL\">Pequeno Motor à Petróleo</link>"

#. STRINGS.BUILDINGS.PREFABS.KILN.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.KILN.DESC"
msgid "It gets quite hot."
msgstr "Isso fica bem quente."

#. STRINGS.BUILDINGS.PREFABS.KILN.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.KILN.EFFECT"
msgid ""
"Fires <link=\"CLAY\">Clay</link> to produce <link=\"CERAMIC\">Ceramic</link>, and "
"<link=\"CARBON\">Coal</link> or <link=\"WOOD\">Wood</link> to produce "
"<link=\"REFINEDCARBON\">Refined Carbon</link>.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"Queima <link=\"CLAY\">Argila</link> para produzir <link=\"CERAMIC\">Cerâmica</link>, e "
"<link=\"CARBON\">Carvão</link> ou <link=\"WOOD\">Madeira</link> para produzir "
"<link=\"REFINEDCARBON\">Carvão Refinado</link>.\n"
"\n"
"Duplicantes não irão fabricar enquanto receitas não forem colocadas na fila."

#. STRINGS.BUILDINGS.PREFABS.KILN.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.KILN.NAME"
msgid "<link=\"KILN\">Kiln</link>"
msgstr "<link=\"KILN\">Forno</link>"

#. STRINGS.BUILDINGS.PREFABS.LADDER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LADDER.DESC"
msgid "(That means they climb it.)"
msgstr "(Significa que podem subir nela.)"

#. STRINGS.BUILDINGS.PREFABS.LADDER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LADDER.EFFECT"
msgid "Enables vertical mobility for Duplicants."
msgstr "Permite mobilidade vertical para os Duplicantes."

#. STRINGS.BUILDINGS.PREFABS.LADDER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LADDER.NAME"
msgid "<link=\"LADDER\">Ladder</link>"
msgstr "<link=\"LADDER\">Escada</link>"

#. STRINGS.BUILDINGS.PREFABS.LADDERBED.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LADDERBED.DESC"
msgid "Duplicant's sleep will be interrupted if another Duplicant uses the ladder."
msgstr "O sono do Duplicante pode ser interrompido se outro Duplicante usar a escada."

#. STRINGS.BUILDINGS.PREFABS.LADDERBED.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LADDERBED.EFFECT"
msgid ""
"Provides a sleeping area for one Duplicant and also functions as a ladder.\n"
"\n"
"Duplicants will automatically sleep in their assigned beds at night."
msgstr ""
"Oferece um local de descanso para um Duplicante e também funciona como escada.\n"
"\n"
"Duplicantes irão automaticamente dormir nas camas quando for de noite."

#. STRINGS.BUILDINGS.PREFABS.LADDERBED.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LADDERBED.NAME"
msgid "<link=\"LADDERBED\">Ladder Bed</link>"
msgstr "<link=\"LADDERBED\">Cama-Escada</link>"

#. STRINGS.BUILDINGS.PREFABS.LADDERFAST.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LADDERFAST.DESC"
msgid "Plastic ladders are mildly antiseptic and can help limit the spread of germs in a colony."
msgstr ""
"Escadas de plástico são um pouco antissépticas e podem ajudar a limitar a propagação de germes em "
"uma colônia."

#. STRINGS.BUILDINGS.PREFABS.LADDERFAST.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LADDERFAST.EFFECT"
msgid "Increases Duplicant climbing speed."
msgstr "Aumenta a velocidade de escalada dos Duplicantes."

#. STRINGS.BUILDINGS.PREFABS.LADDERFAST.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LADDERFAST.NAME"
msgid "<link=\"LADDERFAST\">Plastic Ladder</link>"
msgstr "<link=\"LADDERFAST\">Escada de Plástico</link>"

#. STRINGS.BUILDINGS.PREFABS.LANDING_POD.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LANDING_POD.DESC"
msgid "Geronimo!"
msgstr "Gerônimo!"

#. STRINGS.BUILDINGS.PREFABS.LANDING_POD.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LANDING_POD.EFFECT"
msgid ""
"Contains a Duplicant deployed from orbit.\n"
"\n"
"Pod will disintegrate on arrival."
msgstr ""
"Contém um Duplicante enviado da órbita.\n"
"\n"
"A cápsula se desintegrará na aterrissagem."

#. STRINGS.BUILDINGS.PREFABS.LANDING_POD.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LANDING_POD.NAME"
msgid "Spacefarer Deploy Pod"
msgstr "Cápsula de Desembarque Espacial"

#. STRINGS.BUILDINGS.PREFABS.LANDINGBEACON.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LANDINGBEACON.DESC"
msgid ""
"Microtarget where your <link=\"RAILGUNPAYLOAD\">Interplanetary Payload</link> lands on a Planetoid "
"surface."
msgstr ""
"Guia onde seu <link=\"RAILGUNPAYLOAD\">Pacote Interplanetário</link> aterrissa na superfície de um "
"Planetoide."

#. STRINGS.BUILDINGS.PREFABS.LANDINGBEACON.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LANDINGBEACON.EFFECT"
msgid ""
"Guides <link=\"RAILGUNPAYLOAD\">Interplanetary Payloads</link> and "
"<link=\"ORBITALCARGOMODULE\">Orbital Cargo Modules</link> to land nearby.\n"
"\n"
"<link=\"RAILGUNPAYLOAD\">Interplanetary Payloads</link> must be launched from a "
"<link=\"RAILGUN\">Interplanetary Launcher</link>."
msgstr ""
"Guia <link=\"RAILGUNPAYLOAD\">Pacotes Interplanetários</link> e "
"<link=\"ORBITALCARGOMODULE\">Módulos de Carga Orbital</link> para aterrissarem por perto.\n"
"\n"
"<link=\"RAILGUNPAYLOAD\">Pacotes Interplanetários</link> precisam ser lançados por um "
"<link=\"RAILGUN\">Lançador Interplanetário</link>."

#. STRINGS.BUILDINGS.PREFABS.LANDINGBEACON.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LANDINGBEACON.NAME"
msgid "<link=\"LANDINGBEACON\">Targeting Beacon</link>"
msgstr "<link=\"LANDINGBEACON\">Farol-Alvo</link>"

#. STRINGS.BUILDINGS.PREFABS.LARGEBACKWALLFARM.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LARGEBACKWALLFARM.DESC"
msgid "Vertical farming makes oversized organisms more accessible in limited spaces."
msgstr "Agricultura vertical faz organismos enormes serem mais acessíveis em espaços limitados."

#. STRINGS.BUILDINGS.PREFABS.LARGEBACKWALLFARM.EFFECT
#| msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.EFFECT"
#| msgid "Grows one <link=\"PLANTS\">Plant</link> from a <link=\"PLANTS\">Seed</link>."
msgctxt "STRINGS.BUILDINGS.PREFABS.LARGEBACKWALLFARM.EFFECT"
msgid ""
"Grows one extra-large aquatic <link=\"PLANTS\">Plant</link> from a <link=\"PLANTS\">Seed</link>.\n"
"\n"
"It also doubles as a wall tile."
msgstr ""
"Cultiva uma <link=\"PLANTS\">Planta</link> extragrande de uma <link=\"PLANTS\">Semente</link>.\n"
"\n"
"Também vale como um bloco de parede."

#. STRINGS.BUILDINGS.PREFABS.LARGEBACKWALLFARM.NAME
#| msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASEWALL.FACADES.DEFAULT_FLOWERVASEWALL.NAME"
#| msgid "<link=\"FLOWERVASEWALL\">Wall Pot</link>"
msgctxt "STRINGS.BUILDINGS.PREFABS.LARGEBACKWALLFARM.NAME"
msgid "<link=\"LARGEBACKWALLFARM\">Wall Planter</link>"
msgstr "<link=\"LARGEBACKWALLFARM\">Jardineira de Parede</link>"

#. STRINGS.BUILDINGS.PREFABS.LARGEELECTROBANKDISCHARGER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LARGEELECTROBANKDISCHARGER.DESC"
msgid "It's basically its own power grid."
msgstr "É basicamente sua própria rede de energia."

#. STRINGS.BUILDINGS.PREFABS.LARGEELECTROBANKDISCHARGER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LARGEELECTROBANKDISCHARGER.EFFECT"
msgid ""
"Efficiently converts stored energy from <link=\"ELECTROBANK\">Power Banks</link> into power for "
"connected buildings."
msgstr ""
"Converte de forma eficiente a energia armazenada das <link=\"ELECTROBANK\">Baterias Portáteis</"
"link> em energia para as estruturas conectadas."

#. STRINGS.BUILDINGS.PREFABS.LARGEELECTROBANKDISCHARGER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LARGEELECTROBANKDISCHARGER.NAME"
msgid "<link=\"LARGEELECTROBANKDISCHARGER\">Large Discharger</link>"
msgstr "<link=\"LARGEELECTROBANKDISCHARGER\">Grande Descarregador</link>"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.DESC"
msgid "A platform from which rockets can be launched and on which they can land."
msgstr "Uma plataforma do qual foguetes podem ser lançados e onde irão aterrissar."

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.EFFECT"
msgid ""
"Precursor to construction of all other Rocket modules.\n"
"\n"
"Allows Rockets to launch from or land on the host Planetoid.\n"
"\n"
"Automatically links up to <link=\"MODULARLAUNCHPADPORTSOLID\">Rocket Port</"
"link><link=\"MODULARLAUNCHPADPORTSOLID\">s</link> built to either side of the platform."
msgstr ""
"Precursor da construção de todos os outros módulos de foguete.\n"
"\n"
"Permite que Foguetes decolem ou aterrissem no Planetoide em que foi construído.\n"
"\n"
"Conecta automaticamente às <link=\"MODULARLAUNCHPADPORTSOLID\">Portas de Foguete</link> construídas "
"em ambos os lados da plataforma."

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LANDED_ROCKET
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LANDED_ROCKET"
msgid "Landed Rocket"
msgstr "Foguete Aterrissado"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LANDED_ROCKET_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LANDED_ROCKET_ACTIVE"
msgid "Sends a Green Signal when its rocket is on the <link=\"LAUNCHPAD\">Rocket Platform</link>"
msgstr ""
"Envia um Sinal Verde quando o foguete estiver na <link=\"LAUNCHPAD\">Plataforma de Foguetes</link>"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LANDED_ROCKET_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LANDED_ROCKET_INACTIVE"
msgid "Otherwise, sends a Red Signal"
msgstr "Senão, envia um Sinal Vermelho"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LAUNCH
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LAUNCH"
msgid "Launch Rocket"
msgstr "Lançar Foguete"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LAUNCH_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LAUNCH_ACTIVE"
msgid "Green Signal: Launch rocket"
msgstr "Sinal Verde: Lançar foguete"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LAUNCH_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LAUNCH_INACTIVE"
msgid "Red Signal: Cancel launch"
msgstr "Sinal Vermelho: Cancelar lançamento"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_READY
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_READY"
msgid "Rocket Checklist"
msgstr "Lista de Checagem do Foguete"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_READY_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_READY_ACTIVE"
msgid "Sends a Green Signal when its rocket is ready for flight"
msgstr "Envia um sinal verde quando seu foguete está pronto para voar"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_READY_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_READY_INACTIVE"
msgid "Otherwise, sends a Red Signal"
msgstr "Senão, envia um Sinal Vermelho"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.NAME"
msgid "<link=\"LAUNCHPAD\">Rocket Platform</link>"
msgstr "<link=\"LAUNCHPAD\">Plataforma de Foguetes</link>"

#. STRINGS.BUILDINGS.PREFABS.LEADSUITLOCKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LEADSUITLOCKER.DESC"
msgid "Lead suit docks can refill lead suits with air and empty them of waste."
msgstr ""
"Estações de trajes de chumbo podem recarregar trajes de chumbo com ar e limpá-los de resíduos."

#. STRINGS.BUILDINGS.PREFABS.LEADSUITLOCKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LEADSUITLOCKER.EFFECT"
msgid ""
"Stores <link=\"LEADSUIT\">Lead Suits</link> and refuels them with <link=\"OXYGEN\">Oxygen</link>.\n"
"\n"
"Empties suits of <link=\"DIRTYWATER\">Polluted Water</link>.\n"
"\n"
"Build next to a <link=\"LEADSUITMARKER\">Lead Suit Checkpoint</link> to make Duplicants change into "
"suits when passing by."
msgstr ""
"Armazena <link=\"LEADSUIT\">Trajes de Chumbo</link> e os recarrega com <link=\"OXYGEN\">Oxigênio</"
"link>.\n"
"\n"
"Esvazia os trajes de <link=\"DIRTYWATER\">Água Poluída</link>.\n"
"\n"
"Construa ao lado de um <link=\"LEADSUITMARKER\">Ponto de Checagem de Trajes de Chumbo</link> para "
"fazer os Duplicantes trocarem de trajes quando passarem."

#. STRINGS.BUILDINGS.PREFABS.LEADSUITLOCKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LEADSUITLOCKER.NAME"
msgid "<link=\"LEADSUITLOCKER\">Lead Suit Dock</link>"
msgstr "<link=\"LEADSUITLOCKER\">Estação de Traje de Chumbo</link>"

#. STRINGS.BUILDINGS.PREFABS.LEADSUITMARKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LEADSUITMARKER.DESC"
msgid "A checkpoint must have a correlating dock built on the opposite side its arrow faces."
msgstr ""
"Um ponto de checagem precisa ter uma estação correspondente construída ao lado oposto ao qual sua "
"seta aponta."

#. STRINGS.BUILDINGS.PREFABS.LEADSUITMARKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LEADSUITMARKER.EFFECT"
msgid ""
"Marks a threshold where Duplicants must change into or out of <link=\"LEADSUIT\">Lead Suits</"
"link>.\n"
"\n"
"Must be built next to a <link=\"LEADSUITLOCKER\">Lead Suit Dock</link>\n"
"\n"
"Can be rotated before construction."
msgstr ""
"Marca um limite onde os Duplicantes devem tirar ou colocar o <link=\"LEADSUIT\">Traje de Chumbo</"
"link>.\n"
"\n"
"Precisa ser construída ao lado de uma <link=\"LEADSUITLOCKER\">Estação de Traje de Chumbo</link>.\n"
"\n"
"Pode ser rotacionada antes da construção."

#. STRINGS.BUILDINGS.PREFABS.LEADSUITMARKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LEADSUITMARKER.NAME"
msgid "<link=\"LEADSUITMARKER\">Lead Suit Checkpoint</link>"
msgstr "<link=\"LEADSUITMARKER\">Ponto de Checagem de Traje de Chumbo</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDBOTTLER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDBOTTLER.DESC"
msgid "Bottle fillers allow Duplicants to manually deliver liquids from place to place."
msgstr ""
"Os engarrafadores permitem que os duplicadores entreguem manualmente os líquidos de um lugar para "
"outro."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDBOTTLER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDBOTTLER.EFFECT"
msgid ""
"Automatically stores piped <link=\"ELEMENTSLIQUID\">Liquids</link> into bottles for manual "
"transport."
msgstr ""
"Armazena automaticamente os <link=\"ELEMENTSLIQUID\">Líquidos</link> encanados em garrafas para "
"transporte manual."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDBOTTLER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDBOTTLER.NAME"
msgid "<link=\"LIQUIDBOTTLER\">Bottle Filler</link>"
msgstr "<link=\"LIQUIDBOTTLER\">Engarrafador</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAY.DESC"
msgid "Duplicants will fill cargo bays with any resources they find during space missions."
msgstr ""
"Duplicantes encherão as baías de carga com qualquer recurso que eles encontrarem durante as missões "
"espaciais."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAY.EFFECT"
msgid ""
"Allows Duplicants to store any <link=\"ELEMENTSLIQUID\">Liquid</link> resources found during space "
"missions.\n"
"\n"
"Stored resources become available to the colony upon the rocket's return."
msgstr ""
"Permite os Duplicantes armazenarem qualquer <link=\"ELEMENTSLIQUID\">Recurso Líquido</link> "
"encontrado durante as missões espaciais.\n"
"\n"
"Recursos armazenados ficam disponíveis na colônia quando o foguete retornar."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAY.NAME"
msgid "<link=\"LIQUIDCARGOBAY\">Liquid Cargo Tank</link>"
msgstr "<link=\"LIQUIDCARGOBAY\">Tanque de Carga de Líquidos</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYCLUSTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYCLUSTER.DESC"
msgid "Holds more than a regular cargo tank."
msgstr "Carrega mais carga do que um tanque de carga comum."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYCLUSTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYCLUSTER.EFFECT"
msgid ""
"Allows Duplicants to store most of the <link=\"ELEMENTSLIQUID\">Liquid</link> resources found "
"during space missions.\n"
"\n"
"Stored resources become available to the colony upon the rocket's return.\n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr ""
"Permite os Duplicantes armazenarem a maior parte dos <link=\"ELEMENTSLIQUID\">Líquidos</link> "
"encontrados durante as missões espaciais.\n"
"\n"
"Recursos armazenados ficam disponíveis na colônia quando o foguete retornar.\n"
"\n"
"Precisa ser construído pela <link=\"LAUNCHPAD\">Plataforma de Foguetes</link>."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYCLUSTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYCLUSTER.NAME"
msgid "<link=\"LIQUIDCARGOBAYCLUSTER\">Large Liquid Cargo Tank</link>"
msgstr "<link=\"LIQUIDCARGOBAYCLUSTER\">Grande Tanque de Carga de Líquidos</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYSMALL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYSMALL.DESC"
msgid "Duplicants will fill cargo tanks with whatever resources they find during space missions."
msgstr ""
"Duplicantes irão encher os tanques de carga com qualquer recurso que eles encontrarem durante as "
"missões espaciais."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYSMALL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYSMALL.EFFECT"
msgid ""
"Allows Duplicants to store some of the <link=\"ELEMENTSLIQUID\">Liquid</link> resources found "
"during space missions.\n"
"\n"
"Stored resources become available to the colony upon the rocket's return. \n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr ""
"Permite os Duplicantes armazenarem um pouco de <link=\"ELEMENTSLIQUID\">Recursos Líquidos</link> "
"encontrado durante as missões espaciais.\n"
"\n"
"Recursos armazenados ficam disponíveis na colônia quando o foguete retornar.\n"
"\n"
"Precisa ser construído pela <link=\"LAUNCHPAD\">Plataforma de Foguetes</link>."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYSMALL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYSMALL.NAME"
msgid "<link=\"LIQUIDCARGOBAYSMALL\">Liquid Cargo Tank</link>"
msgstr "<link=\"LIQUIDCARGOBAYSMALL\">Pequeno Tanque de Carga de Líquidos</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDITIONER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDITIONER.DESC"
msgid "A thermo aquatuner cools liquid and outputs the heat elsewhere."
msgstr "Um resfriador térmico que resfria líquidos e libera o calor em outro lugar."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDITIONER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDITIONER.EFFECT"
msgid ""
"Cools the <link=\"ELEMENTSLIQUID\">Liquid</link> piped through it, but outputs <link=\"HEAT\">Heat</"
"link> in its immediate vicinity."
msgstr ""
"Resfria o <link=\"ELEMENTSLIQUID\">Líquido</link> que passa por ele, mas libera "
"<link=\"HEAT\">Calor</link> em sua proximidade imediata."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDITIONER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDITIONER.NAME"
msgid "<link=\"LIQUIDCONDITIONER\">Thermo Aquatuner</link>"
msgstr "<link=\"LIQUIDCONDITIONER\">Resfriador Térmico</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUIT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUIT.DESC"
msgid "Liquid pipes are used to connect the inputs and outputs of plumbed buildings."
msgstr "Encanamentos são usados para conectar entradas e saídas de estruturas encanadas."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUIT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUIT.EFFECT"
msgid ""
"Carries <link=\"ELEMENTSLIQUID\">Liquid</link> between <link=\"LIQUIDPIPING\">Outputs</link> and "
"<link=\"LIQUIDPIPING\">Intakes</link>.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"Transporta <link=\"ELEMENTSLIQUID\">Líquidos</link> entre <link=\"LIQUIDPIPING\">Saídas</link> e "
"<link=\"LIQUIDPIPING\">Entradas</link>.\n"
"\n"
"Pode passar pelos blocos."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUIT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUIT.NAME"
msgid "<link=\"LIQUIDCONDUIT\">Liquid Pipe</link>"
msgstr "<link=\"LIQUIDCONDUIT\">Cano de Líquido</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITBRIDGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITBRIDGE.DESC"
msgid "Separate pipe systems help prevent building damage caused by mingled pipe contents."
msgstr ""
"Separam encanamentos ajudando a prevenir dano às estruturas causado por mistura de conteúdo de "
"canos."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITBRIDGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITBRIDGE.EFFECT"
msgid ""
"Runs one <link=\"LIQUIDPIPING\">Liquid Pipe</link> section over another without joining them.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"Permite que uma seção de <link=\"LIQUIDPIPING\">Cano de Líquidos</link> passe pela outra sem as "
"unir.\n"
"\n"
"Pode passar pelos blocos."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITBRIDGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITBRIDGE.NAME"
msgid "<link=\"LIQUIDCONDUITBRIDGE\">Liquid Bridge</link>"
msgstr "<link=\"LIQUIDCONDUITBRIDGE\">Ponte de Líquido</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.DESC"
msgid "Germ sensors can help control automation behavior in the presence of germs."
msgstr ""
"Sensores de germes podem ajudar a controlar o comportamento da automação na presença de germes."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> based on the internal <link=\"DISEASE\">Germ</link> count of the pipe."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> dependendo da quantidade de <link=\"DISEASE\">Germes</link> dentro do cano."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.LOGIC_PORT"
msgid "Internal <link=\"DISEASE\">Germ</link> Count"
msgstr "Quantidade Interna de <link=\"DISEASE\">Germes</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if the number of Germs in the pipe is "
"within the selected range"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se o número de Germes no tubo estiver "
"dentro da faixa selecionada"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.NAME"
msgid "<link=\"LIQUIDCONDUITDISEASESENSOR\">Liquid Pipe Germ Sensor</link>"
msgstr "<link=\"LIQUIDCONDUITDISEASESENSOR\">Sensor de Germes de Canos</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.DESC"
msgid "Element sensors can be used to detect the presence of a specific liquid in a pipe."
msgstr ""
"Sensores de elemento podem ser usados para detectar a presença de um líquido específico em um cano."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> when the selected "
"<link=\"ELEMENTSLIQUID\">Liquid</link> is detected within a pipe."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> quando o <link=\"ELEMENTSLIQUID\">Líquido</"
"link> escolhido é detectado dentro do cano."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.LOGIC_PORT"
msgid "Internal <link=\"ELEMENTSLIQUID\">Liquid</link> Presence"
msgstr "Presença do <link=\"ELEMENTSLIQUID\">Líquido</link> Interno"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if the configured Liquid is detected within "
"the pipe"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> enquanto o Líquido configurado é detectado "
"dentro do cano"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.NAME"
msgid "<link=\"LIQUIDCONDUITELEMENTSENSOR\">Liquid Pipe Element Sensor</link>"
msgstr "<link=\"LIQUIDCONDUITELEMENTSENSOR\">Sensor de Elemento de Canos</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITOVERFLOW.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITOVERFLOW.DESC"
msgid ""
"Overflow valves can be used to prioritize which buildings should receive precious resources first."
msgstr ""
"Válvulas de Excesso podem ser usadas para priorizar quais estruturas devem receber recursos "
"preciosos primeiro."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITOVERFLOW.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITOVERFLOW.EFFECT"
msgid ""
"Fills a secondary<link=\"ELEMENTSLIQUID\">Liquid</link> output only when its primary output is "
"blocked."
msgstr ""
"Enche uma saída de <link=\"ELEMENTSLIQUID\">Líquido</link> secundária somente quando a saída "
"primária estiver bloqueada."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITOVERFLOW.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITOVERFLOW.NAME"
msgid "<link=\"LIQUIDCONDUITOVERFLOW\">Liquid Overflow Valve</link>"
msgstr "<link=\"LIQUIDCONDUITOVERFLOW\">Válvula de Excesso de Líquido</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITPREFERENTIALFLOW.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITPREFERENTIALFLOW.DESC"
msgid ""
"Priority flows ensure important buildings are filled first when on a system with other buildings."
msgstr ""
"Fluxos prioritários garantem que estruturas importantes sejam preenchidas primeiro em um sistema "
"com outras estruturas."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITPREFERENTIALFLOW.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITPREFERENTIALFLOW.EFFECT"
msgid ""
"Diverts <link=\"ELEMENTSLIQUID\">Liquid</link> to a secondary input when its primary input "
"overflows."
msgstr ""
"Desvia <link=\"ELEMENTSLIQUID\">Líquidos</link> para uma entrada secundária quando sua entrada "
"primária sobrecarrega."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITPREFERENTIALFLOW.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITPREFERENTIALFLOW.NAME"
msgid "<link=\"LIQUIDCONDUITPREFERENTIALFLOW\">Priority Liquid Flow</link>"
msgstr "<link=\"LIQUIDCONDUITPREFERENTIALFLOW\">Fluxo de Líquido Prioritário</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITRADIANT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITRADIANT.DESC"
msgid "Radiant pipes pumping cold liquid can be run through hot areas to help cool them down."
msgstr ""
"Canos radiantes bombeando líquido frio podem ser passados em áreas quentes para ajudar a resfriá-"
"las."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITRADIANT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITRADIANT.EFFECT"
msgid ""
"Carries <link=\"ELEMENTSLIQUID\">Liquid</link>, allowing extreme <link=\"HEAT\">Temperature</link> "
"exchange with the surrounding environment.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"Transporta <link=\"ELEMENTSLIQUID\">Líquido</link>, permitindo trocas extremas de "
"<link=\"HEAT\">Temperatura</link> com o ambiente.\n"
"\n"
"Pode passar pelos blocos."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITRADIANT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITRADIANT.NAME"
msgid "<link=\"LIQUIDCONDUITRADIANT\">Radiant Liquid Pipe</link>"
msgstr "<link=\"LIQUIDCONDUITRADIANT\">Cano de Líquido Radiante</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.DESC"
msgid "Thermo sensors disable buildings when their pipe contents reach a certain temperature."
msgstr "Sensores térmicos podem desativar estruturas quando seu conteúdo atinge certa temperatura."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> when pipe contents enter the chosen <link=\"HEAT\">Temperature</link> range."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> quando a <link=\"HEAT\">Temperatura</link> do conteúdo do cano entra no "
"intervalo escolhido."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.LOGIC_PORT"
msgid "Internal <link=\"ELEMENTSLIQUID\">Liquid</link> <link=\"HEAT\">Temperature</link>"
msgstr "<link=\"HEAT\">Temperatura</link> Interna do <link=\"ELEMENTSLIQUID\">Líquido</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if the contained Liquid is within the "
"selected Temperature range"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se o Líquido contido estiver dentro da "
"faixa de Temperatura selecionada"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.NAME"
msgid "<link=\"LIQUIDCONDUITTEMPERATURESENSOR\">Liquid Pipe Thermo Sensor</link>"
msgstr "<link=\"LIQUIDCONDUITTEMPERATURESENSOR\">Sensor Térmico de Canos</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCOOLEDFAN.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCOOLEDFAN.DESC"
msgid "A Duplicant can work a hydrofan to temporarily cool small areas as needed."
msgstr "Um Duplicante pode operar um hidroventilador para esfriar pequenas áreas conforme necessário."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCOOLEDFAN.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCOOLEDFAN.EFFECT"
msgid "Dissipates a small amount of the <link=\"HEAT\">Heat</link>."
msgstr "Dissipa uma pequena parte do <link=\"HEAT\">Calor</link>."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCOOLEDFAN.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCOOLEDFAN.NAME"
msgid "<link=\"LIQUIDCOOLEDFAN\">Hydrofan</link>"
msgstr "<link=\"LIQUIDCOOLEDFAN\">Hidroventilador</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDFILTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDFILTER.DESC"
msgid "All liquids are sent into the building's output pipe, except the liquid chosen for filtering."
msgstr "Todos os líquidos são enviados para o cano de saída da estrutura, exceto o líquido filtrado."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDFILTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDFILTER.EFFECT"
msgid ""
"Sieves one <link=\"ELEMENTSLIQUID\">Liquid</link> out of a mix, sending it into a dedicated "
"<link=\"LIQUIDPIPING\">Filtered Output Pipe</link>.\n"
"\n"
"Can only filter one liquid type at a time."
msgstr ""
"Separa um <link=\"ELEMENTSLIQUID\">Líquido</link> de uma mistura, enviando-o para um "
"<link=\"LIQUIDPIPING\">Cano de Saída Filtrado</link>.\n"
"\n"
"Só pode filtrar um tipo de líquido de cada vez."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDFILTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDFILTER.NAME"
msgid "<link=\"LIQUIDFILTER\">Liquid Filter</link>"
msgstr "<link=\"LIQUIDFILTER\">Filtro de Líquidos</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANK.DESC"
msgid "Storing additional fuel increases the distance a rocket can travel before returning."
msgstr ""
"Armazenar combustível adicional aumenta a distância que um foguete pode viajar antes de retornar."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANK.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANK.EFFECT"
msgid ""
"Stores the <link=\"ELEMENTSLIQUID\">Liquid</link> fuel piped into it to supply rocket engines.\n"
"\n"
"The stored fuel type is determined by the rocket engine it is built upon."
msgstr ""
"Armazena combustível <link=\"ELEMENTSLIQUID\">Líquido</link> encanado a ele para suprir motores de "
"foguete.\n"
"\n"
"O tipo de combustível armazenado é determinado pelo tipo de motor onde ele é construído."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANK.NAME"
msgid "<link=\"LIQUIDFUELTANK\">Liquid Fuel Tank</link>"
msgstr "<link=\"LIQUIDFUELTANK\">Tanque de Combustível Líquido</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANKCLUSTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANKCLUSTER.DESC"
msgid "Storing additional fuel increases the distance a rocket can travel before returning."
msgstr ""
"Armazenar combustível adicional aumenta a distância que um foguete pode viajar antes de retornar."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANKCLUSTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANKCLUSTER.EFFECT"
msgid ""
"Stores the <link=\"ELEMENTSLIQUID\">Liquid</link> fuel piped into it to supply rocket engines.\n"
"\n"
"The stored fuel type is determined by the rocket engine it is built upon. \n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr ""
"Armazena combustível <link=\"ELEMENTSLIQUID\">Líquido</link> encanado a ele para suprir motores de "
"foguete.\n"
"\n"
"O tipo de combustível armazenado é determinado pelo tipo de motor onde ele é construído.\n"
"\n"
"Precisa ser construído pela <link=\"LAUNCHPAD\">Plataforma de Foguetes</link>."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANKCLUSTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANKCLUSTER.NAME"
msgid "<link=\"LIQUIDFUELTANKCLUSTER\">Large Liquid Fuel Tank</link>"
msgstr "<link=\"LIQUIDFUELTANKCLUSTER\">Grande Tanque de Combustível Líquido</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDHEATER.DESC
#| msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDHEATER.DESC"
#| msgid "Tepidizers heat liquid which can kill waterborne germs."
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDHEATER.DESC"
msgid "Tepidizers heat liquid, which can kill waterborne germs."
msgstr "Aquecedores aquecem líquidos, o que pode matar germes que vivem na água."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDHEATER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDHEATER.EFFECT"
msgid ""
"Warms large bodies of <link=\"ELEMENTSLIQUID\">Liquid</link>.\n"
"\n"
"Must be fully submerged."
msgstr ""
"Aquece grandes quantidades de <link=\"ELEMENTSLIQUID\">Líquidos</link>.\n"
"\n"
"Deve estar completamente submerso."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDHEATER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDHEATER.NAME"
msgid "<link=\"LIQUIDHEATER\">Liquid Tepidizer</link>"
msgstr "<link=\"LIQUIDHEATER\">Aquecedor Submerso</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.DESC"
msgid "Meter Valves let an exact amount of liquid pass through before shutting off."
msgstr "Válvulas Medidoras deixam passar uma quantidade exata de líquido antes de desligar."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.EFFECT"
msgid ""
"Connects to an <link=\"LOGIC\">Automation</link> grid to automatically turn "
"<link=\"ELEMENTSLIQUID\">Liquid</link> flow off when the specified amount has passed through it."
msgstr ""
"Conecta-se a um circuito de <link=\"LOGIC\">Automação</link> para ligar ou desligar o fluxo do "
"<link=\"ELEMENTSLIQUID\">Líquido</link> automaticamente quando a quantidade especificada tiver "
"passado por ela."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.LOGIC_PORT_OUTPUT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.LOGIC_PORT_OUTPUT"
msgid "Limit Reached"
msgstr "Limite Atingido"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.LOGIC_PORT_RESET
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.LOGIC_PORT_RESET"
msgid "Reset Meter"
msgstr "Redefinir Medidor"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.NAME"
msgid "<link=\"LIQUIDLIMITVALVE\">Liquid Meter Valve</link>"
msgstr "<link=\"LIQUIDLIMITVALVE\">Válvula Medidora de Líquidos</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.OUTPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.OUTPUT_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if limit has been reached"
msgstr "Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se o limite for atingido"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.OUTPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.OUTPUT_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.RESET_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.RESET_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Reset the amount"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Redefine a quantidade"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.RESET_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.RESET_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Nothing"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Sem Efeito"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.DESC"
msgid "Automated piping saves power and time by removing the need for Duplicant input."
msgstr ""
"Encanamentos automatizados poupam energia e tempo por remover a necessidade de gerenciamento por "
"Duplicantes."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.EFFECT"
msgid ""
"Connects to an <link=\"LOGIC\">Automation</link> grid to automatically turn "
"<link=\"ELEMENTSLIQUID\">Liquid</link> flow on or off."
msgstr ""
"Conecta-se a um circuito de <link=\"LOGIC\">Automação</link> para ligar ou desligar o fluxo do "
"<link=\"ELEMENTSLIQUID\">Líquido</link> automaticamente."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.LOGIC_PORT"
msgid "Open/Close"
msgstr "Abrir/Fechar"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Allow Liquid flow"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Permite o fluxo de Líquido"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Prevent Liquid flow"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Impede o fluxo de Líquido"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.NAME"
msgid "<link=\"LIQUIDLOGICVALVE\">Liquid Shutoff</link>"
msgstr "<link=\"LIQUIDLOGICVALVE\">Válvula de Corte de Líquidos</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDMINIPUMP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDMINIPUMP.DESC"
msgid "Mini pumps are useful for moving small quantities of liquid with minimum power."
msgstr "Mini-bombas são úteis para mover pequenas quantidades de líquido utilizando pouca energia."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDMINIPUMP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDMINIPUMP.EFFECT"
msgid ""
"Draws in a small amount of <link=\"ELEMENTSLIQUID\">Liquid</link> and runs it through "
"<link=\"LIQUIDPIPING\">Pipes</link>.\n"
"\n"
"Must be submerged in <link=\"ELEMENTSLIQUID\">Liquid</link>."
msgstr ""
"Bombeia uma pequena quantidade de <link=\"ELEMENTSLIQUID\">Líquido</link> para dentro dos "
"<link=\"LIQUIDPIPING\">Canos</link>.\n"
"\n"
"Deve estar submerso em <link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDMINIPUMP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDMINIPUMP.NAME"
msgid "<link=\"LIQUIDMINIPUMP\">Mini Liquid Pump</link>"
msgstr "<link=\"LIQUIDMINIPUMP\">Mini-Bomba de Líquidos</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDPUMP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDPUMP.DESC"
msgid "Piping a pump's output to a building's intake will send liquid to that building."
msgstr ""
"Conectar a saída de uma bomba com a entrada de uma estrutura iniciará o envio de líquido para a "
"mesma."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDPUMP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDPUMP.EFFECT"
msgid ""
"Draws in <link=\"ELEMENTSLIQUID\">Liquid</link> and runs it through <link=\"LIQUIDPIPING\">Pipes</"
"link>.\n"
"\n"
"Must be submerged in <link=\"ELEMENTSLIQUID\">Liquid</link>."
msgstr ""
"Bombeia <link=\"ELEMENTSLIQUID\">Líquido</link> para dentro dos <link=\"LIQUIDPIPING\">Canos</"
"link>.\n"
"\n"
"Deve estar submerso em <link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDPUMP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDPUMP.NAME"
msgid "<link=\"LIQUIDPUMP\">Liquid Pump</link>"
msgstr "<link=\"LIQUIDPUMP\">Bomba de Líquidos</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDPUMPINGSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDPUMPINGSTATION.DESC"
msgid "Pitcher pumps allow Duplicants to bottle and deliver liquids from place to place."
msgstr "Bombas de líquidos permitem os Duplicantes transportarem líquidos de um lugar para o outro."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDPUMPINGSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDPUMPINGSTATION.EFFECT"
msgid ""
"Manually pumps <link=\"ELEMENTSLIQUID\">Liquid</link> into bottles for transport.\n"
"\n"
"Duplicants can only carry liquids that are bottled."
msgstr ""
"Bombeia manualmente <link=\"ELEMENTSLIQUID\">Líquidos</link> em garrafas para o transporte.\n"
"\n"
"Duplicantes só carregam líquidos que estão engarrafados."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDPUMPINGSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDPUMPINGSTATION.NAME"
msgid "<link=\"LIQUIDPUMPINGSTATION\">Pitcher Pump</link>"
msgstr "<link=\"LIQUIDPUMPINGSTATION\">Bomba Manual</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDRESERVOIR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDRESERVOIR.DESC"
msgid "Reservoirs cannot receive manually delivered resources."
msgstr "Reservatórios não podem receber recursos manualmente."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDRESERVOIR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDRESERVOIR.EFFECT"
msgid "Stores any <link=\"ELEMENTSLIQUID\">Liquid</link> resources piped into it."
msgstr "Armazena qualquer <link=\"ELEMENTSLIQUID\">Líquido</link> enviado a ele."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDRESERVOIR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDRESERVOIR.NAME"
msgid "<link=\"LIQUIDRESERVOIR\">Liquid Reservoir</link>"
msgstr "<link=\"LIQUIDRESERVOIR\">Reservatório de Líquidos</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDVALVE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDVALVE.DESC"
msgid "Valves control the amount of liquid that moves through pipes, preventing waste."
msgstr ""
"Válvulas controlam a quantidade de líquido que se move pelo encanamento, prevenindo desperdício."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDVALVE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDVALVE.EFFECT"
msgid ""
"Controls the <link=\"ELEMENTSLIQUID\">Liquid</link> volume permitted through "
"<link=\"LIQUIDPIPING\">Pipes</link>."
msgstr ""
"Controla o volume de <link=\"ELEMENTSLIQUID\">Líquido</link> permitido nos "
"<link=\"LIQUIDPIPING\">Canos</link>."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDVALVE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDVALVE.NAME"
msgid "<link=\"LIQUIDVALVE\">Liquid Valve</link>"
msgstr "<link=\"LIQUIDVALVE\">Válvula de Líquidos</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDVENT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDVENT.DESC"
msgid "Vents are an exit point for liquids from plumbing systems."
msgstr "Saídas de líquido são um ponto de saída de líquidos dos encanamentos."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDVENT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDVENT.EFFECT"
msgid ""
"Releases <link=\"ELEMENTSLIQUID\">Liquid</link> from <link=\"LIQUIDPIPING\">Liquid Pipes</link>."
msgstr ""
"Liberam <link=\"ELEMENTSLIQUID\">Líquidos</link> de <link=\"LIQUIDPIPING\">Canos de Líquidos</link>."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDVENT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDVENT.NAME"
msgid "<link=\"LIQUIDVENT\">Liquid Vent</link>"
msgstr "<link=\"LIQUIDVENT\">Saída de Líquidos</link>"

#. STRINGS.BUILDINGS.PREFABS.LITTERBOX.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LITTERBOX.DESC"
msgid "Retrieving the stored contents is unpleasant, but ultimately rewarding."
msgstr "Pegar os itens armazenados pode ser desagradável, mas no final, compensa."

#. STRINGS.BUILDINGS.PREFABS.LITTERBOX.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LITTERBOX.EFFECT"
msgid ""
"Provides a place for <link=\"CREATURES\">Critters</link> to expel their digestive system's "
"byproducts.\n"
"\n"
"Must be scooped by a Duplicant in order to obtain deposited resources."
msgstr ""
"Fornece um lugar para que as <link=\"CREATURES\">Criaturas</link> liberem os 'produtos' de seu "
"sistema digestivo.\n"
"\n"
"Deve ser limpo por um Duplicante para que se obtenha os recursos depositados."

#. STRINGS.BUILDINGS.PREFABS.LITTERBOX.NAME
#| msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.DEFAULT_PLANTERBOX.NAME"
#| msgid "<link=\"PLANTERBOX\">Planter Box</link>"
msgctxt "STRINGS.BUILDINGS.PREFABS.LITTERBOX.NAME"
msgid "<link=\"LITTERBOX\">Litter Box</link>"
msgstr "<link=\"LITTERBOX\">Caixinha de Areia</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICALARM.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICALARM.DESC"
msgid "Sends a notification when it receives a <b><style=\"logic_on\">Green Signal</style></b>."
msgstr "Envia uma notificação quando ele recebe um <b><style=\"logic_on\">Sinal Verde</style></b>."

#. STRINGS.BUILDINGS.PREFABS.LOGICALARM.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICALARM.EFFECT"
msgid ""
"Attach to sensors to send a notification when certain conditions are met.\n"
"\n"
"Notifications can be customized."
msgstr ""
"Conecte à sensores para enviar uma notificação quando certas condições forem satisfeitas.\n"
"\n"
"Notificações podem ser customizadas."

#. STRINGS.BUILDINGS.PREFABS.LOGICALARM.INPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICALARM.INPUT_NAME"
msgid "INPUT"
msgstr "ENTRADA"

#. STRINGS.BUILDINGS.PREFABS.LOGICALARM.INPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICALARM.INPUT_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Push notification"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Dispara notificação"

#. STRINGS.BUILDINGS.PREFABS.LOGICALARM.INPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICALARM.INPUT_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Nothing"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Sem Efeito"

#. STRINGS.BUILDINGS.PREFABS.LOGICALARM.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICALARM.LOGIC_PORT"
msgid "Notification"
msgstr "Notificação"

#. STRINGS.BUILDINGS.PREFABS.LOGICALARM.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICALARM.NAME"
msgid "<link=\"LOGICALARM\">Automated Notifier</link>"
msgstr "<link=\"LOGICALARM\">Notificador Automatizado</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.DESC"
msgid "Starmap Location sensors can signal when a spacecraft is at a certain location"
msgstr "Sensores de Localização Estelar podem sinalizar quando um foguete está em um certo local"

#. STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.EFFECT"
msgid ""
"Send <b><style=\"logic_on\">Green Signals</style></b> at the chosen Starmap locations and "
"<b><style=\"logic_off\">Red Signals</style></b> everywhere else."
msgstr ""
"Enviará <b><style=\"logic_on\">Sinais Verdes</style></b> no local escolhido do Mapa Estelar e "
"<b><style=\"logic_off\">Sinais Vermelhos</style></b> em qualquer outro lugar."

#. STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.LOGIC_PORT"
msgid "Starmap Location Sensor"
msgstr "Sensor de Localização do Mapa Estelar"

#. STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b>when a spacecraft is at the chosen Starmap "
"locations"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> quando uma nave está no lugar escolhido do "
"Mapa Estelar"

#. STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.NAME"
msgid "<link=\"LOGICCLUSTERLOCATIONSENSOR\">Starmap Location Sensor</link>"
msgstr "<link=\"LOGICCLUSTERLOCATIONSENSOR\">Sensor de Localização Estelar</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.DESC"
msgid "For numbers higher than ten connect multiple counters together."
msgstr "Para números maiores que dez, conecte múltiplos contadores juntos."

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.EFFECT"
msgid ""
"Counts how many times a <b><style=\"logic_on\">Green Signal</style></b> has been received up to a "
"chosen number.\n"
"\n"
"When the chosen number is reached it sends a <b><style=\"logic_on\">Green Signal</style></b> until "
"it receives another <b><style=\"logic_on\">Green Signal</style></b>, when it resets automatically "
"and begins counting again."
msgstr ""
"Conta quantas vezes um <b><style=\"logic_on\">Sinal Verde</style></b> foi recebido até chegar em um "
"número escolhido.\n"
"\n"
"Quando o número escolhido é atingido, ele envia um <b><style=\"logic_on\">Sinal Verde</style></b> "
"até receber um outro <b><style=\"logic_on\">Sinal Verde</style></b> para reiniciar a contagem."

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.INPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.INPUT_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Increase counter by one"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Aumenta o contador em um"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.INPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.INPUT_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Nothing"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Sem Efeito"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.LOGIC_PORT"
msgid "Internal Counter Value"
msgstr "Valor de Contagem Interno"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.LOGIC_PORT_OUTPUT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.LOGIC_PORT_OUTPUT"
msgid "Number Reached"
msgstr "Número Atingido"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.LOGIC_PORT_RESET
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.LOGIC_PORT_RESET"
msgid "Reset Counter"
msgstr "Redefinir Contador"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.NAME"
msgid "<link=\"LOGICCOUNTER\">Signal Counter</link>"
msgstr "<link=\"LOGICCONTROL\">Contador de Sinal</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.OUTPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.OUTPUT_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> when the counter matches the selected value"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> quando o contador atinge o valor selecionado"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.OUTPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.OUTPUT_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.RESET_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.RESET_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Reset counter"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Redefine contador"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.RESET_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.RESET_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Nothing"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Sem Efeito"

#. STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.COUNT_CRITTER_LABEL
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.COUNT_CRITTER_LABEL"
msgid "Count Critters"
msgstr "Contar Criaturas"

#. STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.COUNT_EGG_LABEL
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.COUNT_EGG_LABEL"
msgid "Count Eggs"
msgstr "Contar Ovos"

#. STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.DESC"
msgid "Detecting critter populations can help adjust their automated feeding and care regimens."
msgstr ""
"Detectar populações de criaturas pode ajudar a ajustar o regime de alimentação e cuidados "
"automáticos."

#. STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> based on the number of eggs and critters in a room."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> baseado na quantidade de ovos e criaturas em um quarto."

#. STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.LOGIC_PORT"
msgid "Critter Count"
msgstr "Quantidade de Criaturas"

#. STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if the number of Critters and Eggs in the "
"Room is greater than the selected threshold."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> enquanto o número de Criaturas e Ovos na "
"quarto estiverem dentro da faixa selecionada."

#. STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.NAME"
msgid "<link=\"LOGICCRITTERCOUNTSENSOR\">Critter Sensor</link>"
msgstr "<link=\"LOGICCRITTERCOUNTSENSOR\">Sensor de Criaturas</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.SIDESCREEN_TITLE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.SIDESCREEN_TITLE"
msgid "Critter Sensor"
msgstr "Sensor de Criaturas"

#. STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.DESC"
msgid "Detecting germ populations can help block off or clean up dangerous areas."
msgstr "Detectar populações de germes pode ajudar a bloquear ou limpar áreas perigosas."

#. STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> based on quantity of surrounding <link=\"DISEASE\">Germs</link>."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> dependendo da quantidade de <link=\"DISEASE\">Germes</link> ao redor."

#. STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.LOGIC_PORT"
msgid "<link=\"DISEASE\">Germ</link> Count"
msgstr "Quantidade de <link=\"DISEASE\">Germes</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if the number of Germs is within the "
"selected range"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se o número de germes estiver dentro da "
"faixa selecionada"

#. STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.NAME"
msgid "<link=\"LOGICDISEASESENSOR\">Germ Sensor</link>"
msgstr "<link=\"LOGICDISEASESENSOR\">Sensor de Germes</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.DESC"
msgid "Motion sensors save power by only enabling buildings when Duplicants are nearby."
msgstr ""
"Sensores de movimento poupam energia ao ativar estruturas somente quando Duplicantes estão por "
"perto."

#. STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> based on whether a Duplicant is in the sensor's range."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> baseado na proximidade de um Duplicante ao sensor."

#. STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.LOGIC_PORT"
msgid "Duplicant Motion Sensor"
msgstr "Sensor de Movimento de Duplicante"

#. STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> while a Duplicant is in the sensor's tile "
"range"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> enquanto um Duplicante estiver na faixa de "
"alcance do sensor"

#. STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.NAME"
msgid "<link=\"LOGICDUPLICANTSENSOR\">Duplicant Motion Sensor</link>"
msgstr "<link=\"LOGICDUPLICANTSENSOR\">Sensor de Movimento de Duplicante</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.DESC"
msgid "These sensors can detect the presence of a specific gas and alter systems accordingly."
msgstr ""
"Estes sensores podem detectar a presença de um gás específico e alterar sistemas conforme "
"programado."

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> when the selected "
"<link=\"ELEMENTSGAS\">Gas</link> is detected on this sensor's tile.\n"
"\n"
"Sends a <b><style=\"logic_off\">Red Signal</style></b> when the selected <link=\"ELEMENTSGAS\">Gas</"
"link> is not present."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> quando o <link=\"ELEMENTSGAS\">Gás</link> "
"selecionado é detectado no bloco do sensor.\n"
"\n"
"Envia um <b><style=\"logic_off\">Sinal Vermelho</style></b> quando o <link=\"ELEMENTSGAS\">Gás</"
"link> selecionado não está presente."

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.LOGIC_PORT"
msgid "Specific <link=\"ELEMENTSGAS\">Gas</link> Presence"
msgstr "Presença do <link=\"ELEMENTSGAS\">Gás</link> Específico"

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if the selected Gas is detected"
msgstr "Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se o Gás selecionado for detectado"

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.NAME"
msgid "<link=\"LOGICELEMENTSENSORGAS\">Gas Element Sensor</link>"
msgstr "<link=\"LOGICELEMENTSENSORGAS\">Sensor de Elemento Gasoso</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.DESC"
msgid "These sensors can detect the presence of a specific liquid and alter systems accordingly."
msgstr ""
"Estes sensores podem detectar a presença de um líquido específico e alterar sistemas conforme "
"programado."

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> when the selected "
"<link=\"ELEMENTSLIQUID\">Liquid</link> is detected on this sensor's tile.\n"
"\n"
"Sends a <b><style=\"logic_off\">Red Signal</style></b> when the selected "
"<link=\"ELEMENTSLIQUID\">Liquid</link> is not present."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> quando o <link=\"ELEMENTSLIQUID\">Líquido</"
"link> selecionado é detectado no bloco do sensor.\n"
"\n"
"Envia um <b><style=\"logic_off\">Sinal Vermelho</style></b> quando o "
"<link=\"ELEMENTSLIQUID\">Líquido</link> selecionado não está presente."

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.LOGIC_PORT"
msgid "Specific <link=\"ELEMENTSLIQUID\">Liquid</link> Presence"
msgstr "Presença de <link=\"ELEMENTSLIQUID\">Líquido</link> Específico"

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if the selected Liquid is detected"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se o Líquido selecionado for detectado"

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.NAME"
msgid "<link=\"LOGICELEMENTSENSORLIQUID\">Liquid Element Sensor</link>"
msgstr "<link=\"LOGICELEMENTSENSORLIQUID\">Sensor de Elemento Líquido</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.DESC"
msgid ""
"This gate outputs a Green Signal when both its inputs are receiving Green Signals at the same time."
msgstr ""
"Este portão envia um Sinal Verde quando ambas as entradas estiverem recebendo Sinais Verdes ao "
"mesmo tempo."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.EFFECT"
msgid ""
"Outputs a <b><style=\"logic_on\">Green Signal</style></b> when both Input A <b>AND</b> Input B are "
"receiving <b><style=\"logic_on\">Green</style></b>.\n"
"\n"
"Outputs a <b><style=\"logic_off\">Red Signal</style></b> when even one Input is receiving "
"<b><style=\"logic_off\">Red</style></b>."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> quando ambas Entradas A <b>E</b> B "
"estiverem recebendo <b><style=\"logic_on\">Verde</style></b>.\n"
"\n"
"Envia um <b><style=\"logic_off\">Sinal Vermelho</style></b> mesmo quando só uma Entrada estiver "
"recebendo <b><style=\"logic_off\">Vermelho</style></b>."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.NAME"
msgid "<link=\"LOGICGATEAND\">AND Gate</link>"
msgstr "<link=\"LOGICGATEAND\">Porta \"E\"</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.OUTPUT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.OUTPUT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if both Inputs are receiving "
"<b><style=\"logic_on\">Green</style></b>"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se ambas Entradas estiverem recebendo "
"<b><style=\"logic_on\">Verde</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.OUTPUT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.OUTPUT_INACTIVE"
msgid ""
"Sends a <b><style=\"logic_off\">Red Signal</style></b> if any Input is receiving "
"<b><style=\"logic_off\">Red</style></b>"
msgstr ""
"Envia um <b><style=\"logic_off\">Sinal Vermelho</style></b> se alguma entrada estiver recebendo "
"<b><style=\"logic_off\">Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.OUTPUT_NAME"
msgid "OUTPUT"
msgstr "SAÍDA"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.DESC"
msgid ""
"This gate continues outputting a Green Signal for a short time after the gate stops receiving a "
"Green Signal."
msgstr ""
"Este portão continua enviando um Sinal Verde por um curto período de tempo após sua entrada parar "
"de receber um Sinal Verde."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.EFFECT"
msgid ""
"Outputs a <b><style=\"logic_on\">Green Signal</style></b> if the Input is receiving a "
"<b><style=\"logic_on\">Green Signal</style></b>.\n"
"\n"
"Continues sending a <b><style=\"logic_on\">Green Signal</style></b> for an amount of buffer time "
"after the Input receives a <b><style=\"logic_off\">Red Signal</style></b>."
msgstr ""
"Envia <b><style=\"logic_on\">Sinal Verde</style></b> se uma Entrada estiver recebendo um "
"<b><style=\"logic_on\">Sinal Verde</style></b>.\n"
"\n"
"Continua enviando um <b><style=\"logic_on\">Sinal Verde</style></b> por uma quantidade de tempo "
"depois que a Entrada recebe um <b><style=\"logic_off\">Sinal Vermelho</style></b>."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.NAME"
msgid "<link=\"LOGICGATEBUFFER\">BUFFER Gate</link>"
msgstr "<link=\"LOGICGATEBUFFER\">Porta \"BUFFER\"</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.OUTPUT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.OUTPUT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> while receiving "
"<b><style=\"logic_on\">Green</style></b>. After receiving <b><style=\"logic_off\">Red</style></b>, "
"will continue sending <b><style=\"logic_on\">Green</style></b> until the timer has expired"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> enquanto receber "
"<b><style=\"logic_on\">Verde</style></b>. Depois de receber <b><style=\"logic_off\">Vermelho</"
"style></b>, continuará enviando <b><style=\"logic_on\">Verde</style></b> até o temporizador expirar"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.OUTPUT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.OUTPUT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>."
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.OUTPUT_NAME"
msgid "OUTPUT"
msgstr "SAÍDA"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.DESC"
msgid ""
"Signal Distributors can be used to choose which circuit should receive a given automation signal."
msgstr ""
"Distribuidores de Sinais podem ser usados para escolher quais circuitos devem receber um "
"determinado sinal de automação."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.EFFECT"
msgid ""
"Route a single Input signal out one of four possible Outputs, based on the selection made by the "
"Control Inputs.\n"
"\n"
"Send a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> to the two Control Inputs to determine which Output is selected."
msgstr ""
"Direcione um único sinal de Entrada para uma das quatros possíveis Saídas, baseado na seleção feita "
"pelas Entradas de Controle.\n"
"\n"
"Envie um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> para as duas Entradas de Controle para determinar qual Saída será selecionada."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.NAME"
msgid "<link=\"LOGICGATEDEMULTIPLEXER\">Signal Distributor</link>"
msgstr "<link=\"LOGICGATEDEMULTIPLEXER\">Distribuidor de Sinal</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.OUTPUT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.OUTPUT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green</style></b> or <b><style=\"logic_off\">Red</style></b> signal "
"to the selected output"
msgstr ""
"Envia um sinal <b><style=\"logic_on\">Verde</style></b> ou <b><style=\"logic_off\">Vermelho</"
"style></b> para a saída selecionada"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.OUTPUT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.OUTPUT_INACTIVE"
msgid "Nothing"
msgstr "Sem Efeito"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.OUTPUT_NAME"
msgid "OUTPUT"
msgstr "SAÍDA"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.DESC"
msgid ""
"This gate only lets a Green Signal through if its Input has received a Green Signal that lasted "
"longer than the selected filter time."
msgstr ""
"Este portão só envia um Sinal Verde quando sua Entrada receber um Sinal Verde que durou mais que o "
"tempo de filtro selecionado."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.EFFECT"
msgid ""
"Only lets a <b><style=\"logic_on\">Green Signal</style></b> through if the Input has received a "
"<b><style=\"logic_on\">Green Signal</style></b> for longer than the selected filter time.\n"
"\n"
"Will continue outputting a <b><style=\"logic_off\">Red Signal</style></b> if the "
"<b><style=\"logic_on\">Green Signal</style></b> did not last long enough."
msgstr ""
"Só envia um <b><style=\"logic_on\">Sinal Verde</style></b> se a Entrada receber um "
"<b><style=\"logic_on\">Sinal Verde</style></b> por um tempo maior que o tempo de filtro "
"selecionado.\n"
"\n"
"Continuará enviando um <b><style=\"logic_off\">Sinal Vermelho</style></b> se o "
"<b><style=\"logic_on\">Sinal Verde</style></b> não durar tempo suficiente."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.NAME"
msgid "<link=\"LOGICGATEFILTER\">FILTER Gate</link>"
msgstr "<link=\"LOGICGATEFILTER\">Porta \"FILTRO\"</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.OUTPUT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.OUTPUT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> after receiving "
"<b><style=\"logic_on\">Green</style></b> for longer than the selected filter timer"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> após receber <b><style=\"logic_on\">Verde</"
"style></b> por um tempo maior que o tempo de filtro selecionado"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.OUTPUT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.OUTPUT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>."
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.OUTPUT_NAME"
msgid "OUTPUT"
msgstr "SAÍDA"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.DESC"
msgid ""
"Signal Selectors can be used to select which automation signal is relevant to pass through to a "
"given circuit"
msgstr ""
"Seletores de Sinal podem ser usados para selecionar qual sinal de automação é relevante para passar "
"em um determinado circuito"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.EFFECT"
msgid ""
"Select which one of four Input signals should be sent out the Output, using Control Inputs.\n"
"\n"
"Send a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> to the two Control Inputs to determine which Input is selected."
msgstr ""
"Seleciona um dos quatros sinais de Entrada que podem ser enviados para a Saída, usando Entradas de "
"Controle.\n"
"\n"
"Envie um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> para as duas Entradas de Controle para determinar qual Entrada será "
"selecionada."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.NAME"
msgid "<link=\"LOGICGATEMULTIPLEXER\">Signal Selector</link>"
msgstr "<link=\"LOGICGATEMULTIPLEXER\">Seletor de Sinal</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.OUTPUT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.OUTPUT_ACTIVE"
msgid ""
"Receives a <b><style=\"logic_on\">Green</style></b> or <b><style=\"logic_off\">Red</style></b> "
"signal from the selected input"
msgstr ""
"Recebe um sinal <b><style=\"logic_on\">Verde</style></b> ou <b><style=\"logic_off\">Vermelho</"
"style></b> da entrada selecionada"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.OUTPUT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.OUTPUT_INACTIVE"
msgid "Nothing"
msgstr "Sem Efeito"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.OUTPUT_NAME"
msgid "OUTPUT"
msgstr "SAÍDA"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.DESC"
msgid ""
"This gate reverses automation signals, turning a Green Signal into a Red Signal and vice versa."
msgstr ""
"Esse portão inverte os sinais de automação, transformando um Sinal Verde em um Sinal Vermelho e "
"vice versa."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.EFFECT"
msgid ""
"Outputs a <b><style=\"logic_on\">Green Signal</style></b> if the Input is receiving a "
"<b><style=\"logic_off\">Red Signal</style></b>.\n"
"\n"
"Outputs a <b><style=\"logic_off\">Red Signal</style></b> when its Input is receiving a "
"<b><style=\"logic_on\">Green Signal</style></b>."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se a Entrada estiver recebendo um "
"<b><style=\"logic_off\">Sinal Vermelho</style></b>.\n"
"\n"
"Envia um <b><style=\"logic_off\">Sinal Vermelho</style></b> quando sua Entrada estiver recebendo um "
"<b><style=\"logic_on\">Sinal Verde</style></b>."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.NAME"
msgid "<link=\"LOGICGATENOT\">NOT Gate</link>"
msgstr "<link=\"LOGICGATENOT\">Porta \"NÃO\"</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.OUTPUT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.OUTPUT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if receiving <b><style=\"logic_off\">Red</"
"style></b>"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se estiver recebendo "
"<b><style=\"logic_off\">Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.OUTPUT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.OUTPUT_INACTIVE"
msgid ""
"Sends a <b><style=\"logic_off\">Red Signal</style></b> if receiving <b><style=\"logic_on\">Green</"
"style></b>"
msgstr ""
"Envia um <b><style=\"logic_off\">Sinal Vermelho</style></b> se estiver recebendo "
"<b><style=\"logic_on\">Verde</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.OUTPUT_NAME"
msgid "OUTPUT"
msgstr "SAÍDA"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.DESC"
msgid "This gate outputs a Green Signal if receiving one or more Green Signals."
msgstr "Este portão envia um Sinal Verde se estiver recebendo um ou mais Sinais Verdes."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.EFFECT"
msgid ""
"Outputs a <b><style=\"logic_on\">Green Signal</style></b> if at least one of Input A <b>OR</b> "
"Input B is receiving <b><style=\"logic_on\">Green</style></b>.\n"
"\n"
"Outputs a <b><style=\"logic_off\">Red Signal</style></b> when neither Input A or Input B are "
"receiving <b><style=\"logic_on\">Green</style></b>."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se pelo menos uma das Entradas A <b>OU</b> "
"B estiver recebendo <b><style=\"logic_on\">Verde</style></b>.\n"
"\n"
"Envia um <b><style=\"logic_off\">Sinal Vermelho</style></b> quando nenhuma Entrada estiver "
"recebendo <b><style=\"logic_on\">Verde</style></b>."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.NAME"
msgid "<link=\"LOGICGATEOR\">OR Gate</link>"
msgstr "<link=\"LOGICGATEOR\">Porta \"OU\"</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.OUTPUT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.OUTPUT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if any Input is receiving "
"<b><style=\"logic_on\">Green</style></b>"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se alguma Entrada estiver recebendo "
"<b><style=\"logic_on\">Verde</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.OUTPUT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.OUTPUT_INACTIVE"
msgid ""
"Sends a <b><style=\"logic_off\">Red Signal</style></b> if both Inputs are receiving "
"<b><style=\"logic_off\">Red</style></b>"
msgstr ""
"Envia um <b><style=\"logic_off\">Sinal Vermelho</style></b> se ambas as entradas estiverem "
"recebendo <b><style=\"logic_off\">Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.OUTPUT_NAME"
msgid "OUTPUT"
msgstr "SAÍDA"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.DESC"
msgid "This gate outputs a Green Signal if exactly one of its Inputs is receiving a Green Signal."
msgstr ""
"Este portão envia um Sinal Verde se somente uma das suas Entradas estiver recebendo um Sinal Verde."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.EFFECT"
msgid ""
"Outputs a <b><style=\"logic_on\">Green Signal</style></b> if exactly one of its Inputs is receiving "
"<b><style=\"logic_on\">Green</style></b>.\n"
"\n"
"Outputs a <b><style=\"logic_off\">Red Signal</style></b> if both or neither Inputs are receiving a "
"<b><style=\"logic_on\">Green Signal</style></b>."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se SOMENTE uma das Entradas estiver "
"recebendo <b><style=\"logic_on\">Verde</style></b>.\n"
"\n"
"Envia um <b><style=\"logic_off\">Sinal Vermelho</style></b> se ambas ou nenhuma das Entradas "
"estiver recebendo um <b><style=\"logic_on\">Sinal Verde</style></b>."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.NAME"
msgid "<link=\"LOGICGATEXOR\">XOR Gate</link>"
msgstr "<link=\"LOGICGATEXOR\">Porta \"OU-EXCLUSIVO\"</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.OUTPUT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.OUTPUT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if exactly one of its Inputs is receiving "
"<b><style=\"logic_on\">Green</style></b>"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se somente uma das entradas estiver "
"recebendo <b><style=\"logic_on\">Verde</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.OUTPUT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.OUTPUT_INACTIVE"
msgid "Sends a <b><style=\"logic_off\">Red Signal</style></b> if both Input signals match (any color)"
msgstr ""
"Envia um <b><style=\"logic_off\">Sinal Vermelho</style></b> se ambas as Entradas combinarem "
"(qualquer cor)"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.OUTPUT_NAME"
msgid "OUTPUT"
msgstr "SAÍDA"

#. STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.DESC"
msgid "The hammer makes neat sounds when it strikes buildings."
msgstr "O martelo faz sons legais quando bate em estruturas."

#. STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.EFFECT"
msgid ""
"In its default orientation, the hammer strikes the building to the left when it receives a "
"<b><style=\"logic_on\">Green Signal</style></b>.\n"
"\n"
"Each building has a unique sound when struck by the hammer.\n"
"\n"
"The hammer does no damage when it strikes."
msgstr ""
"Em sua orientação padrão, o martelo bate na estrutura a sua esquerda quando recebe um "
"<b><style=\"logic_on\">Sinal Verde</style></b>.\n"
"\n"
"Cada estrutura possui um som único quando acertado pelo martelo. \n"
"\n"
"O martelo não causa dano quando bate."

#. STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.INPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.INPUT_NAME"
msgid "INPUT"
msgstr "ENTRADA"

#. STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.INPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.INPUT_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Hammer strikes once"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Martelo bate uma vez"

#. STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.INPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.INPUT_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Nothing"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Sem Efeito"

#. STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.LOGIC_PORT"
msgid "Resonating Buildings"
msgstr "Ressoar Estruturas"

#. STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.NAME"
msgid "<link=\"LOGICHAMMER\">Hammer</link>"
msgstr "<link=\"LOGICHAMMER\">Martelo</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.DESC"
msgid "Radbolt sensors can send a signal when a Radbolt passes over them."
msgstr "Sensores de Rádio-Raios podem enviar um sinal quando um Rádio-Raio passar por ele."

#. STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> when Radbolts detected enters the chosen range."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> quando Rádio-Raios forem detectados na faixa escolhida."

#. STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.LOGIC_PORT"
msgid "Detected Radbolts"
msgstr "Rádio-Raios Detectados"

#. STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if detected Radbolts are within the "
"selected range"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se Rádio-Raios forem detectados dentro da "
"faixa selecionada"

#. STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.NAME"
msgid "<link=\"LOGICHEPSENSOR\">Radbolt Sensor</link>"
msgstr "<link=\"LOGICHEPSENSOR\">Sensor de Rádio-Raio</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.DESC"
msgid "Receives automation signals from space."
msgstr "Recebe sinais de automação do espaço."

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.EFFECT"
msgid ""
"Receives a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> from an <link=\"LOGICINTERASTEROIDSENDER\">Automation Broadcaster</link> over vast "
"distances in space.\n"
"\n"
"Both the Automation Receiver and the Automation Broadcaster must be exposed to space to function."
msgstr ""
"Recebe um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> de um <link=\"LOGICINTERASTEROIDSENDER\">Transmissor de Automação</link> de "
"algum lugar do espaço.\n"
"\n"
"Ambos os Receptores e os Transmissores de Automação precisam estar expostos ao espaço para "
"funcionar."

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.LOGIC_PORT"
msgid "Receiving Signal"
msgstr "Recebendo Sinal"

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.LOGIC_PORT_ACTIVE"
msgid "Receiving: <b><style=\"logic_on\">Green Signal</style></b>"
msgstr "Recebendo: <b><style=\"logic_on\">Sinal Verde</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.LOGIC_PORT_INACTIVE"
msgid "Receiving: <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Recebendo: <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.NAME"
msgid "<link=\"LOGICINTERASTEROIDRECEIVER\">Automation Receiver</link>"
msgstr "<link=\"LOGICINTERASTEROIDRECEIVER\">Receptor de Automação</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.DEFAULTNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.DEFAULTNAME"
msgid "Unnamed Broadcaster"
msgstr "Transmissor Sem Nome"

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.DESC"
msgid "Sends automation signals into space."
msgstr "Envia sinais de automação para o espaço."

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> to an <link=\"LOGICINTERASTEROIDRECEIVER\">Automation Receiver</link> over vast "
"distances in space.\n"
"\n"
"Both the Automation Broadcaster and the Automation Receiver must be exposed to space to function."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> para um <link=\"LOGICINTERASTEROIDRECEIVER\">Receptor de Automação</link> por "
"vastas distancias pelo espaço.\n"
"\n"
"Ambos os Receptores e Transmissores de Automação precisam ser expostos ao espaço para funcionar."

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.LOGIC_PORT"
msgid "Broadcasting Signal"
msgstr "Transmitindo Sinal"

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.LOGIC_PORT_ACTIVE"
msgid "Broadcasting: <b><style=\"logic_on\">Green Signal</style></b>"
msgstr "Transmitindo: <b><style=\"logic_on\">Sinal Verde</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.LOGIC_PORT_INACTIVE"
msgid "Broadcasting: <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Transmitindo: <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.NAME"
msgid "<link=\"LOGICINTERASTEROIDSENDER\">Automation Broadcaster</link>"
msgstr "<link=\"LOGICINTERASTEROIDSENDER\">Transmissor de Automação</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.DESC"
msgid ""
"Light sensors can tell surface bunker doors above solar panels to open or close based on solar "
"light levels."
msgstr ""
"Sensores de luz podem dizer às portas do bunker de superfície acima de painéis solares para abrir "
"ou fechar com base nos níveis de luz solar."

#. STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> when ambient <link=\"LIGHT\">Brightness</link> enters the chosen range."
msgstr ""
"Envia um <b><style=\"logic_on\">sinal verde</style></b> ou um <b><style=\"logic_off\">sinal "
"vermelho</style></b> quando o <link=\" LIGHT\">Brilho</link> ambiente entra na faixa escolhida."

#. STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.LOGIC_PORT"
msgid "Ambient <link=\"LIGHT\">Brightness</link>"
msgstr "<link=\"LIGHT\">Brilho</link> do Ambiente"

#. STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if ambient <link=\"LIGHT\">Brightness</"
"link> is within the selected range"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se o <link=\"LIGHT\">Brilho</link> do "
"ambiente estiver dentro da faixa selecionada"

#. STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Caso contrário, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.NAME"
msgid "<link=\"LOGICLIGHTSENSOR\">Light Sensor</link>"
msgstr "<link=\"LOGICLIGHTSENSOR\">Sensor de Luz</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.DESC"
msgid ""
"A Memory stores a Green Signal received in the Set Port (S) until the Reset Port (R) receives a "
"Green Signal."
msgstr ""
"A Memória armazena um Sinal Verde recebido na Porta Sinal (S) até que a Porta Redefinir (R) receba "
"um Sinal Verde."

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.EFFECT"
msgid ""
"Contains an internal Memory, and will output whatever signal is stored in that Memory.\n"
"\n"
"Signals sent to the Inputs <i>only</i> affect the Memory, and do not pass through to the Output. \n"
"\n"
"Sending a <b><style=\"logic_on\">Green Signal</style></b> to the Set Port (S) will set the memory "
"to <b><style=\"logic_on\">Green</style></b>. \n"
"\n"
"Sending a <b><style=\"logic_on\">Green Signal</style></b> to the Reset Port (R) will reset the "
"memory back to <b><style=\"logic_off\">Red</style></b>."
msgstr ""
"Contém uma Memória interna, e enviará qualquer sinal que estiver armazenado naquela Memória.\n"
"\n"
"Sinais enviados as Entradas <i>somente</i> afetarão a Memória, e não passarão para a Saída. \n"
"\n"
"Enviando um <b><style=\"logic_on\">Sinal Verde</style></b> para a Porta Sinal (S) definirá a "
"memória como <b><style=\"logic_on\">Verde</style></b>. \n"
"\n"
"Enviando um <b><style=\"logic_on\">Sinal Verde</style></b> para a Porta Redefinir (R) redefinirá a "
"memória para <b><style=\"logic_off\">Vermelho</style></b>."

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.NAME"
msgid "<link=\"LOGICMEMORY\">Memory Toggle</link>"
msgstr "<link=\"LOGICMEMORY\">Memória Flip-Flop</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.READ_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.READ_PORT"
msgid "MEMORY OUTPUT"
msgstr "SAÍDA DA MEMÓRIA"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.READ_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.READ_PORT_ACTIVE"
msgid ""
"Outputs a <b><style=\"logic_on\">Green Signal</style></b> if the internal Memory is set to "
"<b><style=\"logic_on\">Green</style></b>"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se a Memória interna estiver definida como "
"<b><style=\"logic_on\">Verde</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.READ_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.READ_PORT_INACTIVE"
msgid ""
"Outputs a <b><style=\"logic_off\">Red Signal</style></b> if the internal Memory is set to "
"<b><style=\"logic_off\">Red</style></b>"
msgstr ""
"Envia um <b><style=\"logic_off\">Sinal Vermelho</style></b> se a Memória interna estiver definida "
"como <b><style=\"logic_off\">Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.RESET_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.RESET_PORT"
msgid "RESET PORT (R)"
msgstr "PORTA REDEFINIR (R)"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.RESET_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.RESET_PORT_ACTIVE"
msgid ""
"<b><style=\"logic_on\">Green Signal</style></b>: Reset the internal Memory to "
"<b><style=\"logic_off\">Red</style></b>"
msgstr ""
"<b><style=\"logic_on\">Sinal Verde</style></b>: Redefine a Memória interna como "
"<b><style=\"logic_off\">Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.RESET_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.RESET_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: No effect"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Sem Efeito"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.SET_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.SET_PORT"
msgid "SET PORT (S)"
msgstr "PORTA SINAL (S)"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.SET_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.SET_PORT_ACTIVE"
msgid ""
"<b><style=\"logic_on\">Green Signal</style></b>: Set the internal Memory to "
"<b><style=\"logic_on\">Green</style></b>"
msgstr ""
"<b><style=\"logic_on\">Sinal Verde</style></b>: Define a Memória interna como "
"<b><style=\"logic_on\">Verde</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.SET_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.SET_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: No effect"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Sem efeito"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.STATUS_ITEM_VALUE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.STATUS_ITEM_VALUE"
msgid "Current Value: {0}"
msgstr "Valor Atual: {0}"

#. STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.DESC"
msgid "Automated systems save power and time by removing the need for Duplicant input."
msgstr ""
"Sistemas de automação poupam energia e tempo por remover a necessidade de gerenciamento por "
"Duplicantes."

#. STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.EFFECT"
msgid ""
"Connects to an <link=\"LOGIC\">Automation</link> grid to automatically turn <link=\"POWER\">Power</"
"link> on or off.\n"
"\n"
"Does not affect circuitry preceding the switch."
msgstr ""
"Conecta-se a um circuito de <link=\"LOGIC\">Automação</link> para ligar e desligar a "
"<link=\"POWER\">Energia</link> automaticamente.\n"
"\n"
"Não afeta circuitos anteriores antes da válvula."

#. STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.LOGIC_PORT"
msgid "Kill Power"
msgstr "Cortar Energia"

#. STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.LOGIC_PORT_ACTIVE"
msgid ""
"<b><style=\"logic_on\">Green Signal</style></b>: Allow <style=\"KKeyword\">Power</style> through "
"connected circuits"
msgstr ""
"<b><style=\"logic_on\">Sinal Verde</style></b>: Permite a <style=\"KKeyword\">Energia</style> "
"passar para circuitos conectados"

#. STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.LOGIC_PORT_INACTIVE"
msgid ""
"<b><style=\"logic_off\">Red Signal</style></b>: Prevent <style=\"KKeyword\">Power</style> from "
"flowing through connected circuits"
msgstr ""
"<b><style=\"logic_off\">Sinal Vermelho</style></b>: Impede a <style=\"KKeyword\">Energia</style> de "
"passar para circuitos conectados"

#. STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.NAME"
msgid "<link=\"LOGICPOWERRELAY\">Power Shutoff</link>"
msgstr "<link=\"LOGICPOWERRELAY\">Chave de Corte de Energia</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.DESC"
msgid "Atmo sensors can be used to prevent excess oxygen production and overpressurization."
msgstr ""
"Sensores atmosféricos podem ser usados para prevenir excesso de produção de oxigênio e "
"sobrepressurização."

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> when <link=\"ELEMENTSGAS\">Gas</link> pressure enters the chosen range."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> quando a pressão do <link=\"ELEMENTSGAS\">Gás</link> entra no intervalo "
"escolhido."

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.LOGIC_PORT"
msgid "<link=\"ELEMENTSGAS\">Gas</link> Pressure"
msgstr "Pressão do <link=\"ELEMENTSGAS\">Gás</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if Gas pressure is within the selected range"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se a pressão de Gás estiver dentro da faixa "
"selecionada"

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.NAME"
msgid "<link=\"LOGICPRESSURESENSORGAS\">Atmo Sensor</link>"
msgstr "<link=\"LOGICPRESSURESENSORGAS\">Sensor Atmosférico</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.DESC"
msgid "A hydro sensor can tell a pump to refill its basin as soon as it contains too little liquid."
msgstr ""
"Um sensor hidráulico pode sinalizar a uma bomba para reencher seu reservatório quando ele tiver "
"pouco líquido."

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> when <link=\"ELEMENTSLIQUID\">Liquid</link> pressure enters the chosen range.\n"
"\n"
"Must be submerged in <link=\"ELEMENTSLIQUID\">Liquid</link>."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> quando a pressão do <link=\"ELEMENTSLIQUID\">Líquido</link> entra no intervalo "
"escolhido.\n"
"\n"
"Precisa estar submerso em <link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.LOGIC_PORT"
msgid "<link=\"ELEMENTSLIQUID\">Liquid</link> Pressure"
msgstr "Pressão do <link=\"ELEMENTSLIQUID\">Líquido</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if Liquid pressure is within the selected "
"range"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se a pressão de Líquido estiver dentro da "
"faixa selecionada"

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.NAME"
msgid "<link=\"LOGICPRESSURESENSORLIQUID\">Hydro Sensor</link>"
msgstr "<link=\"LOGICPRESSURESENSORLIQUID\">Sensor Hidráulico</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.DESC"
msgid "Radiation sensors can disable buildings when they detect dangerous levels of radiation."
msgstr "Sensores de radiação podem desativar estruturas quando detectam perigosos níveis de radiação."

#. STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> when ambient <link=\"RADIATION\">Radiation</link> enters the chosen range."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> quando a <link=\"RADIATION\">Radiação</link> do ambiente entra no intervalo "
"escolhido."

#. STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.LOGIC_PORT"
msgid "Ambient <link=\"RADIATION\">Radiation</link>"
msgstr "<link=\"RADIATION\">Radiação</link> Ambiente"

#. STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if ambient <link=\"RADIATION\">Radiation</"
"link> is within the selected range"
msgstr ""
"Envia um sinal <b><style=\"logic_on\">Sinal Verde</style></b> se a <link=\"RADIATION\">Radiação</"
"link> estiver no intervalo escolhido"

#. STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.NAME"
msgid "<link=\"LOGICRADIATIONSENSOR\">Radiation Sensor</link>"
msgstr "<link=\"LOGICRADIATIONSENSOR\">Sensor de Radiação</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBON.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBON.DESC"
msgid "Logic ribbons use significantly less space to carry multiple automation signals."
msgstr ""
"Fitas de lógica usam um espaço significativamente menor para carregar múltiplos sinais de automação."

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBON.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBON.EFFECT"
msgid ""
"A 4-Bit <link=\"LOGICWIRE\">Automation Wire</link> which can carry up to four automation signals.\n"
"\n"
"Use a <link=\"LOGICRIBBONWRITER\">Ribbon Writer</link> to output to multiple Bits, and a "
"<link=\"LOGICRIBBONREADER\">Ribbon Reader</link> to input from multiple Bits."
msgstr ""
"Um <link=\"LOGICWIRE\">Cabo de Automação</link> de 4-Bits que pode carregar até quatro sinais de "
"automação.\n"
"\n"
"Use um <link=\"LOGICRIBBONWRITER\">Gravador de Fita</link> para enviar múltiplos Bits, e um "
"<link=\"LOGICRIBBONREADER\">Leitor de Fita</link> para receber múltiplos Bits."

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBON.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBON.NAME"
msgid "<link=\"LOGICRIBBON\">Automation Ribbon</link>"
msgstr "<link=\"LOGICRIBBON\">Fita de Automação</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.DESC"
msgid "Wire bridges allow multiple automation grids to exist in a small area without connecting."
msgstr ""
"Pontes de cabo permitem que múltiplos circuitos de automação existam em uma pequena área sem se "
"conectarem."

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.EFFECT"
msgid ""
"Runs one <link=\"LOGICRIBBON\">Automation Ribbon</link> section over another without joining them.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"Faz uma seção de <link=\"LOGICRIBBON\">Fita de Automação</link> passar pela outra sem uni-las.\n"
"\n"
"Pode passar pelos blocos de piso e parede."

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.LOGIC_PORT"
msgid "Transmit Signal"
msgstr "Transmite Sinal"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.LOGIC_PORT_ACTIVE"
msgid ""
"<b><style=\"logic_on\">Green Signal</style></b>: Pass through the <b><style=\"logic_on\">Green "
"Signal</style></b>"
msgstr ""
"<b><style=\"logic_on\">Sinal Verde</style></b>: Passa pelo <b><style=\"logic_on\">Sinal Verde</"
"style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.LOGIC_PORT_INACTIVE"
msgid ""
"<b><style=\"logic_off\">Red Signal</style></b>: Pass through the <b><style=\"logic_off\">Red "
"Signal</style></b>"
msgstr ""
"<b><style=\"logic_off\">Sinal Vermelho</style></b>: Passa pelo <b><style=\"logic_off\">Sinal "
"Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.NAME"
msgid "<link=\"LOGICRIBBONBRIDGE\">Automation Ribbon Bridge</link>"
msgstr "<link=\"LOGICRIBBONBRIDGE\">Ponte de Fita de Automação</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.DESC"
msgid ""
"Inputs the signal from a single Bit in an <link=\"LOGICRIBBON\">Automation Ribbon</link> into an "
"<link=\"LOGICWIRE\">Automation Wire</link>."
msgstr ""
"Envia o sinal de um único Bit de uma <link=\"LOGICRIBBON\">Fita de Automação</link> para um "
"<link=\"LOGICWIRE\">Cabo de Automação</link>."

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.EFFECT"
msgid ""
"Reads a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> from the specified Bit of an <link=\"LOGICRIBBON\">Automation Ribbon</link> onto an "
"<link=\"LOGICWIRE\">Automation Wire</link>."
msgstr ""
"Lê um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal Vermelho</"
"style></b> do Bit especificado de uma <link=\"LOGICRIBBON\">Fita de Automação</link> para um "
"<link=\"LOGICWIRE\">Cabo de Automação</link>."

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.INPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.INPUT_NAME"
msgid "RIBBON INPUT"
msgstr "ENTRADA DE FITA"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.INPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.INPUT_PORT_ACTIVE"
msgid ""
"<b><style=\"logic_on\">Green Signal</style></b>: Reads a <b><style=\"logic_on\">Green Signal</"
"style></b> from selected Bit"
msgstr ""
"<b><style=\"logic_on\">Sinal Verde</style></b>: Lê um <b><style=\"logic_on\">Sinal Verde</style></"
"b> do Bit selecionado"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.INPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.INPUT_PORT_INACTIVE"
msgid ""
"<b><style=\"logic_off\">Red Signal</style></b>: Reads a <b><style=\"logic_off\">Red Signal</style></"
"b> from selected Bit"
msgstr ""
"<b><style=\"logic_off\">Sinal Vermelho</style></b>: Lê um <b><style=\"logic_off\">Sinal Vermelho</"
"style></b> do Bit selecionado"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.LOGIC_PORT"
msgid "4-Bit Input"
msgstr "Entrada 4-Bit"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.LOGIC_PORT_OUTPUT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.LOGIC_PORT_OUTPUT"
msgid "Bit Reading"
msgstr "Leitura de Bit"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.NAME"
msgid "<link=\"LOGICRIBBONREADER\">Ribbon Reader</link>"
msgstr "<link=\"LOGICRIBBONREADER\">Leitor de Fita</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.OUTPUT_NAME"
msgid "OUTPUT"
msgstr "SAÍDA"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.OUTPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.OUTPUT_PORT_ACTIVE"
msgid ""
"<b><style=\"logic_on\">Green Signal</style></b>: Sends a <b><style=\"logic_on\">Green Signal</"
"style></b> to attached <link=\"LOGICWIRE\">Automation Wire</link>"
msgstr ""
"<b><style=\"logic_on\">Sinal Verde</style></b>: Envia um <b><style=\"logic_on\">Sinal Verde</"
"style></b> para o <link=\"LOGICWIRE\">Cabo de Automação</link> conectado"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.OUTPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.OUTPUT_PORT_INACTIVE"
msgid ""
"<b><style=\"logic_off\">Red Signal</style></b>: Sends a <b><style=\"logic_off\">Red Signal</style></"
"b> to attached <link=\"LOGICWIRE\">Automation Wire</link>"
msgstr ""
"<b><style=\"logic_off\">Sinal Vermelho</style></b>: Envia um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> para o <link=\"LOGICWIRE\">Cabo de Automação</link> conectado"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.DESC"
msgid ""
"Translates the signal from an <link=\"LOGICWIRE\">Automation Wire</link> to a single Bit in an "
"<link=\"LOGICRIBBON\">Automation Ribbon</link>"
msgstr ""
"Traduz o sinal de um <link=\"LOGICWIRE\">Cabo de Automação</link> em um único Bit de uma "
"<link=\"LOGICRIBBON\">Fita de Automação</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.EFFECT"
msgid ""
"Writes a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> to the specified Bit of an <link=\"LOGICRIBBON\">Automation Ribbon</link>\n"
"\n"
"<link=\"LOGICRIBBON\">Automation Ribbon</link> must be used as the output wire to avoid overloading."
msgstr ""
"Grava um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> no Bit especificado de uma <link=\"LOGICRIBBON\">Fita de Automação</link>\n"
"\n"
"<link=\"LOGICRIBBON\">Fita de Automação</link> precisa ser usada como cabo de saída para evitar "
"sobrecarga."

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.INPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.INPUT_NAME"
msgid "INPUT"
msgstr "ENTRADA"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.INPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.INPUT_PORT_ACTIVE"
msgid ""
"<b><style=\"logic_on\">Green Signal</style></b>: Receives <b><style=\"logic_on\">Green Signal</"
"style></b> to be written to selected Bit"
msgstr ""
"<b><style=\"logic_on\">Sinal Verde</style></b>: Recebe <b><style=\"logic_on\">Sinal Verde</style></"
"b> para ser gravado no Bit selecionado"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.INPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.INPUT_PORT_INACTIVE"
msgid ""
"<b><style=\"logic_off\">Red Signal</style></b>: Receives <b><style=\"logic_off\">Red Signal</"
"style></b> to to be written selected Bit"
msgstr ""
"<b><style=\"logic_off\">Sinal Vermelho</style></b>: Recebe <b><style=\"logic_off\">Sinal Vermelho</"
"style></b> para ser gravado no Bit selecionado"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.LOGIC_PORT"
msgid "1-Bit Input"
msgstr "Entrada 1-Bit"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.LOGIC_PORT_OUTPUT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.LOGIC_PORT_OUTPUT"
msgid "Bit Writing"
msgstr "Gravação de Bit"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.NAME"
msgid "<link=\"LOGICRIBBONWRITER\">Ribbon Writer</link>"
msgstr "<link=\"LOGICRIBBONWRITER\">Gravador de Fita</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.OUTPUT_NAME"
msgid "RIBBON OUTPUT"
msgstr "SAÍDA DE FITA"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.OUTPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.OUTPUT_PORT_ACTIVE"
msgid ""
"<b><style=\"logic_on\">Green Signal</style></b>: Writes a <b><style=\"logic_on\">Green Signal</"
"style></b> to selected Bit of an <link=\"LOGICRIBBON\">Automation Ribbon</link>"
msgstr ""
"<b><style=\"logic_on\">Sinal Verde</style></b>: Grava um <b><style=\"logic_on\">Sinal Verde</"
"style></b> no Bit selecionado da <link=\"LOGICRIBBON\">Fita de Automação</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.OUTPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.OUTPUT_PORT_INACTIVE"
msgid ""
"<b><style=\"logic_off\">Red Signal</style></b>: Writes a <b><style=\"logic_off\">Red Signal</"
"style></b> to selected Bit of an <link=\"LOGICRIBBON\">Automation Ribbon</link>"
msgstr ""
"<b><style=\"logic_off\">Sinal Vermelho</style></b>: Grava um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> no Bit selecionado da <link=\"LOGICRIBBON\">Fita de Automação</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.DESC"
msgid "Signal switches don't turn grids on and off like power switches, but add an extra signal."
msgstr ""
"Chaves de sinal não interferem no circuito elétrico como as chaves de energia, mas produzem um "
"sinal adicional."

#. STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> on an <link=\"LOGIC\">Automation</link> grid."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> em um circuito de <link=\"LOGIC\">Automação</link>."

#. STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.LOGIC_PORT"
msgid "Signal Toggle"
msgstr "Chave de Sinal"

#. STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if toggled ON"
msgstr "Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se ATIVADO"

#. STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.LOGIC_PORT_INACTIVE"
msgid "Sends a <b><style=\"logic_off\">Red Signal</style></b> if toggled OFF"
msgstr "Envia um <b><style=\"logic_off\">Sinal Vermelho</style></b> se DESATIVADO"

#. STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.NAME"
msgid "<link=\"LOGICSWITCH\">Signal Switch</link>"
msgstr "<link=\"LOGICSWITCH\">Chave de Sinal</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.SIDESCREEN_TITLE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.SIDESCREEN_TITLE"
msgid "Signal Switch"
msgstr "Chave de Sinal"

#. STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.DESC"
msgid "Thermo sensors can disable buildings when they approach dangerous temperatures."
msgstr "Sensores térmicos podem desativar estruturas quando se aproximam de temperaturas perigosas."

#. STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> when ambient <link=\"HEAT\">Temperature</link> enters the chosen range."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> quando a <link=\"HEAT\">Temperatura</link> do ambiente entra no intervalo "
"escolhido."

#. STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.LOGIC_PORT"
msgid "Ambient <link=\"HEAT\">Temperature</link>"
msgstr "<link=\"HEAT\">Temperatura</link> Ambiente"

#. STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if ambient <link=\"HEAT\">Temperature</"
"link> is within the selected range"
msgstr ""
"Envia um sinal <b><style=\"logic_on\">Sinal Verde</style></b> quando a <link=\"HEAT\">Temperatura</"
"link> do ambiente entra no intervalo escolhido"

#. STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.NAME"
msgid "<link=\"LOGICTEMPERATURESENSOR\">Thermo Sensor</link>"
msgstr "<link=\"LOGICTEMPERATURESENSOR\">Sensor Térmico</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.DESC"
msgid "Cycle sensors ensure systems always turn on at the same time, day or night, every cycle."
msgstr ""
"Sensores de ciclo garantem que os sistemas sempre irão ligar na mesma hora do dia ou da noite, a "
"cada ciclo."

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.EFFECT"
msgid ""
"Sets an automatic <b><style=\"logic_on\">Green Signal</style></b> and <b><style=\"logic_off\">Red "
"Signal</style></b> schedule within one day-night cycle."
msgstr ""
"Define uma programação automática de <b><style=\"logic_on\">Sinal Verde</style></b> e "
"<b><style=\"logic_off\">Sinal Vermelho</style></b> dentro de um ciclo de dia e noite."

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.LOGIC_PORT"
msgid "Cycle Time"
msgstr "Tempo do Ciclo"

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if current time is within the selected "
"<b><style=\"logic_on\">Green</style></b> range"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> se o tempo atual estiver dentro da faixa "
"<b><style=\"logic_on\">Verde</style></b> selecionada"

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.NAME"
msgid "<link=\"LOGICTIMEOFDAYSENSOR\">Cycle Sensor</link>"
msgstr "<link=\"LOGICTIMEOFDAYSENSOR\">Sensor de Ciclo</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.DESC"
msgid "Timer sensors create automation schedules for very short or very long periods of time."
msgstr ""
"Sensores Temporizadores criam programações automatizadas para períodos muito curtos ou muito longos "
"de tempo."

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.EFFECT"
msgid ""
"Creates a timer to send <b><style=\"logic_on\">Green Signals</style></b> and "
"<b><style=\"logic_off\">Red Signals</style></b> for specific amounts of time."
msgstr ""
"Cria um temporizador para enviar <b><style=\"logic_on\">Sinais Verdes</style></b> e "
"<b><style=\"logic_off\">Sinais Vermelhos</style></b> por quantidades específicas de tempo."

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.LOGIC_PORT"
msgid "Timer Schedule"
msgstr "Programação do Temporizador"

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> for the selected amount of Green time"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> pela quantidade selecionada de tempo Verde"

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.LOGIC_PORT_INACTIVE"
msgid ""
"Then, sends a <b><style=\"logic_off\">Red Signal</style></b> for the selected amount of Red time"
msgstr ""
"Depois, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b> pela quantidade selecionada de "
"tempo Vermelho"

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.NAME"
msgid "<link=\"LOGICTIMERSENSOR\">Timer Sensor</link>"
msgstr "<link=\"LOGICTIMERSENSOR\">Sensor Temporizador</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.DESC"
msgid "Wattage sensors can send a signal when a building has switched on or off."
msgstr "Sensores de Potência podem enviar um sinal quando uma estrutura foi ligado ou desligada."

#. STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</"
"style></b> when <link=\"POWER\">Wattage</link> consumed enters the chosen range."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> quando a <link=\"POWER\">Potência</link> consumida entra na faixa escolhida."

#. STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.LOGIC_PORT"
msgid "Consumed <link=\"POWER\">Wattage</link>"
msgstr "<link=\"POWER\">Potência</link> Consumida"

#. STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if current <link=\"POWER\">Wattage</link> "
"is within the selected range"
msgstr ""
"Envia um sinal <b><style=\"logic_on\">Sinal Verde</style></b> quando a <link=\"POWER\">Potência</"
"link> atual estiver dentro da faixa selecionada"

#. STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.NAME"
msgid "<link=\"LOGICWATTAGESENSOR\">Wattage Sensor</link>"
msgstr "<link=\"LOGICWATTAGESENSOR\">Sensor de Potência</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICWIRE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWIRE.DESC"
msgid "Automation wire is used to connect building ports to automation gates."
msgstr "Cabos de automação são usados para conectar portas de estruturas aos portões de automação."

#. STRINGS.BUILDINGS.PREFABS.LOGICWIRE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWIRE.EFFECT"
msgid ""
"Connects buildings to <link=\"LOGIC\">Sensors</link>.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"Conecta estruturas à <link=\"LOGIC\">Sensores</link>.\n"
"\n"
"Pode passar pelos blocos de piso e parede."

#. STRINGS.BUILDINGS.PREFABS.LOGICWIRE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWIRE.NAME"
msgid "<link=\"LOGICWIRE\">Automation Wire</link>"
msgstr "<link=\"LOGICWIRE\">Cabo de Automação</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.DESC"
msgid "Wire bridges allow multiple automation grids to exist in a small area without connecting."
msgstr ""
"Pontes de cabo permitem que múltiplos circuitos de automação existiam em uma pequena área sem se "
"conectarem."

#. STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.EFFECT"
msgid ""
"Runs one <link=\"LOGICWIRE\">Automation Wire</link> section over another without joining them.\n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"Faz uma seção de <link=\"LOGICWIRE\">Cabo de Automação</link> passar pela outra sem uni-las.\n"
"\n"
"Pode passar pelos blocos de piso e parede."

#. STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.LOGIC_PORT"
msgid "Transmit Signal"
msgstr "Transmite Sinal"

#. STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.LOGIC_PORT_ACTIVE"
msgid ""
"<b><style=\"logic_on\">Green Signal</style></b>: Pass through the <b><style=\"logic_on\">Green "
"Signal</style></b>"
msgstr ""
"<b><style=\"logic_on\">Sinal Verde</style></b>: Passa pelo <b><style=\"logic_on\">Sinal Verde</"
"style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.LOGIC_PORT_INACTIVE"
msgid ""
"<b><style=\"logic_off\">Red Signal</style></b>: Pass through the <b><style=\"logic_off\">Red "
"Signal</style></b>"
msgstr ""
"<b><style=\"logic_off\">Sinal Vermelho</style></b>: Passa pelo <b><style=\"logic_off\">Sinal "
"Vermelho</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.NAME"
msgid "<link=\"LOGICWIREBRIDGE\">Automation Wire Bridge</link>"
msgstr "<link=\"LOGICWIREBRIDGE\">Ponte de Cabo de Automação</link>"

#. STRINGS.BUILDINGS.PREFABS.LONELYMAILBOX.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LONELYMAILBOX.DESC"
msgid "There's nothing quite like receiving homemade gifts in the mail."
msgstr "Não há nada como receber presentes caseiros pelo correio."

#. STRINGS.BUILDINGS.PREFABS.LONELYMAILBOX.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LONELYMAILBOX.EFFECT"
msgid "Displays a single edible object."
msgstr "Exibe um único objeto comestível."

#. STRINGS.BUILDINGS.PREFABS.LONELYMAILBOX.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LONELYMAILBOX.NAME"
msgid "Mailbox"
msgstr "Caixa de Correio"

#. STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE.DESC"
msgid "Its occupant has been alone for so long, he's forgotten what friendship feels like."
msgstr "Seu ocupante esteve sozinho por tanto tempo que esqueceu o que é sentir a amizade."

#. STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE.EFFECT"
msgid ""
"A large transport unit from the facility's sub-sub-basement.\n"
"\n"
"It has been modified into a crude yet functional temporary shelter."
msgstr ""
"Uma grande unidade de transporte do sub-subsolo do instituto.\n"
"\n"
"Ele foi modificado em um abrigo temporário rústico, mas funcional."

#. STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE.NAME"
msgid "<link=\"STORYTRAITLONELYMINION\">Gravitas Shipping Container</link>"
msgstr "<link=\"STORYTRAITLONELYMINION\">Contêiner de Logística Gravitas</link>"

#. STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE_COMPLETE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE_COMPLETE.DESC"
msgid "Someone lived inside it for a while."
msgstr "Alguém viveu dentro dele por um tempo."

#. STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE_COMPLETE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE_COMPLETE.EFFECT"
msgid ""
"A super-spacious container for the <link=\"ELEMENTSSOLID\">Solid Materials</link> of your choosing."
msgstr ""
"Um contêiner super espaçoso parar armazenar os <link=\"ELEMENTSSOLID\">Materiais Sólidos</link> de "
"sua escolha."

#. STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE_COMPLETE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE_COMPLETE.NAME"
msgid "<link=\"STORYTRAITLONELYMINION\">Gravitas Shipping Container</link>"
msgstr "<link=\"STORYTRAITLONELYMINION\">Contêiner de Logística Gravitas</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.DESC"
msgid "Duplicants prefer comfy beds to cots and wake up more rested after sleeping in them."
msgstr ""
"Duplicantes preferem camas confortáveis do que camas comuns e acordarão mais dispostos depois de "
"dormir nelas."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.EFFECT"
msgid ""
"Provides a sleeping area for one Duplicant and restores additional stamina.\n"
"\n"
"Duplicants will automatically sleep in their assigned beds at night."
msgstr ""
"Fornece um local de descanso para um Duplicante e recupera mais Energia.\n"
"\n"
"Duplicantes dormirão automaticamente nas suas camas à noite."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.BOAT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.BOAT.DESC"
msgid "Ahoy! Set sail for zzzzz's."
msgstr "Ahoy! Içar velas para os zzzzzs."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.BOAT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.BOAT.NAME"
msgid "<link=\"LUXURYBED\">Dreamboat Bed</link>"
msgstr "<link=\"LUXURYBED\">Cama Navio dos Sonhos</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.BOUNCY_BED.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.BOUNCY_BED.DESC"
msgid "An inflatable party prop makes a surprisingly good bed."
msgstr "Um objeto inflável de festa dá uma cama surpreendentemente boa."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.BOUNCY_BED.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.BOUNCY_BED.NAME"
msgid "<link=\"LUXURYBED\">Bouncy Castle Bed</link>"
msgstr "<link=\"LUXURYBED\">Cama Castelo Inflável</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.DEFAULT_LUXURYBED.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.DEFAULT_LUXURYBED.DESC"
msgid "Much comfier than a cot."
msgstr "Mais confortável que uma cama comum."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.DEFAULT_LUXURYBED.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.DEFAULT_LUXURYBED.NAME"
msgid "<link=\"LUXURYBED\">Comfy Bed</link>"
msgstr "<link=\"LUXURYBED\">Cama Confortável</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.GRANDPRIX.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.GRANDPRIX.DESC"
msgid "Where every Duplicant wakes up a winner."
msgstr "Onde cada Duplicante acorda como um vencedor."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.GRANDPRIX.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.GRANDPRIX.NAME"
msgid "<link=\"LUXURYBED\">Grand Prix Bed</link>"
msgstr "<link=\"LUXURYBED\">Cama Grande Prêmio</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.GREEN_MUSH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.GREEN_MUSH.DESC"
msgid "The mattress is so soft, it's almost impossible to climb out of."
msgstr "O colchão é tão macio, que é quase impossível sair dele."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.GREEN_MUSH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.GREEN_MUSH.NAME"
msgid "<link=\"LUXURYBED\">Comfy Mush Bed</link>"
msgstr "<link=\"LUXURYBED\">Cama Confortável de Lama</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.HAND.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.HAND.DESC"
msgid "It's so nice to be held."
msgstr "É tão bom ser segurado."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.HAND.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.HAND.NAME"
msgid "<link=\"LUXURYBED\">Cradled Bed</link>"
msgstr "<link=\"LUXURYBED\">Cama Acolhedora</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.PUFT_BED.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.PUFT_BED.DESC"
msgid "A comfy, if somewhat 'fragrant', place to sleep."
msgstr "Um lugar confortável, e até \"cheiroso\", de se dormir."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.PUFT_BED.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.PUFT_BED.NAME"
msgid "<link=\"LUXURYBED\">Puft Bed</link>"
msgstr "<link=\"LUXURYBED\">Cama Bolha</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.PURPLE_BRAINFAT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.PURPLE_BRAINFAT.DESC"
msgid "A soft landing spot for swooners."
msgstr "Um local macio para quem desmaia."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.PURPLE_BRAINFAT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.PURPLE_BRAINFAT.NAME"
msgid "<link=\"LUXURYBED\">Comfy Fainting Bed</link>"
