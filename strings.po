msgid "<link=\"GOLDBELLY\">Regal Bammoth</link>"
msgstr "<link=\"GOLDBELLY\">Bamute Real</link>"

#. STRINGS.CREATURES.SPECIES.ICECAVESFORAGEPLANTPLANTED.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICECAVESFORAGEPLANTPLANTED.DESC"
msgid ""
"Sherberries are incapable of propagating, but can be harvested for a single <link=\"FOOD\">Food</"
"link> serving."
msgstr ""
"Frutaçaís são incapazes de se propagar, mas podem ser colhidas para uma única porção de "
"<link=\"FOOD\">Alimento</link>."

#. STRINGS.CREATURES.SPECIES.ICECAVESFORAGEPLANTPLANTED.NAME
