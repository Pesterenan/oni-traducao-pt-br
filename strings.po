msgid "<link=\"SALTYSTICKSPLANT\">Sodicane</link>"
msgstr ""

#. STRINGS.CREATURES.SPECIES.SAPTREE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SAPTREE.DESC"
msgid ""
"A <link=\"RESIN\">Sap</link>-producing cybernetic tree that shows signs of sentience.\n"
"\n"
"It is rooted firmly in place, and is waiting for some brave soul to bring it food."
msgstr ""
"Uma árvore cibernética produtora de <link=\"RESIN\">Resina Líquida</link> que mostra sinais de "
"sensibilidade.\n"
"\n"
"Ela está firmemente enraizada no lugar e espera que alguma alma corajosa lhe traga alimento."

#. STRINGS.CREATURES.SPECIES.SAPTREE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SAPTREE.NAME"
msgid "<link=\"SAPTREE\">Experiment 52B</link>"
msgstr "<link=\"SAPTREE\">Experimento 52B</link>"

#. STRINGS.CREATURES.SPECIES.SEAFAIRY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAFAIRY.DESC"
msgid ""
"Kelpoles are non-hostile aquatic critters that spawn along <link=\"SEATREE\">Tower Kelp</link> "
"stalks.\n"
"\n"
"They can be harvested for <link=\"NORI\">Nori</link>."
msgstr ""

