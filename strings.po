msgid "Mess Hall"
msgstr "Refeitório"

#. STRINGS.ROOMS.TYPES.MESSHALL.TOOLTIP
msgctxt "STRINGS.ROOMS.TYPES.MESSHALL.TOOLTIP"
msgid "Eating at a Mess Table in a Mess Hall will improve Duplicants' Morale"
msgstr "Comer em uma Mesa de Jantar em um Refeitório aumentará o Moral dos Duplicantes"

#. STRINGS.ROOMS.TYPES.NATURERESERVE.DESCRIPTION
msgctxt "STRINGS.ROOMS.TYPES.NATURERESERVE.DESCRIPTION"
msgid ""
"A lot of greenery goes an even longer way.\n"
"\n"
"Passing through a Nature Reserve will grant higher Morale bonuses to Duplicants than a Park."
msgstr ""
"Bastante vegetação que trás ainda mais vida.\n"
"\n"
"Uma Reserva Natural dará mais pontos de Moral aos Duplicantes do que um Parque."

