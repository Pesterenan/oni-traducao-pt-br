msgstr ""

#. STRINGS.ELEMENTS.GLASS.DESC
msgctxt "STRINGS.ELEMENTS.GLASS.DESC"
msgid ""
"Glass is a brittle, transparent substance formed from <link=\"SAND\">Sand</link> fired at high "
"temperatures."
msgstr ""
"Vidro é uma substância frágil e transparente formada a partir da <link=\"SAND\">Areia</link> "
"aquecida a altas temperaturas."

#. STRINGS.ELEMENTS.GLASS.NAME
msgctxt "STRINGS.ELEMENTS.GLASS.NAME"
