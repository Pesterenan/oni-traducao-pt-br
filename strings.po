#| msgid ""
#| "Ring Rosebushes are <link=\"DECOR\">Decorative</link> <link=\"PLANTS\">Plants</link> that add a "
#| "touch of whimsy wherever they are planted."
msgctxt "STRINGS.CREATURES.SPECIES.FILAMENTPLANT.DESC"
msgid ""
"Petta Poufs are <link=\"DECOR\">Decorative</link> aquatic <link=\"PLANTS\">Plants</link>.\n"
"\n"
"The gentle touch of their blooms soothes passing Duplicants' nerves."
msgstr ""

