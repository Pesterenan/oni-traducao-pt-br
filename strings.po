#. STRINGS.CREATURES.SPECIES.URCHINPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.URCHINPLANT.DESC"
msgid ""
"Pinpokets produce <link=\"URCHIN\">Pinpoki</link>, which can be processed into "
"<link=\"URCHINMEAT\">Uni</link> or <link=\"DIAMOND\">Diamond</link>."
msgstr ""
"Aglomeriços produzem <link=\"URCHIN\">Agulhiços</link>, que podem ser processados em "
"<link=\"URCHINMEAT\">Uni</link> ou <link=\"DIAMOND\">Diamante</link>."

