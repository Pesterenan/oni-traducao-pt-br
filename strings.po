msgctxt "STRINGS.BUILDINGS.PREFABS.ADVANCEDAPOTHECARY.DESC"
msgid "Some medications help prevent diseases, while others aim to alleviate existing illness."
msgstr "Alguns medicamentos ajudam a prevenir doenças, enquanto outros aliviam doenças existentes."

#. STRINGS.BUILDINGS.PREFABS.ADVANCEDAPOTHECARY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ADVANCEDAPOTHECARY.EFFECT"
msgid ""
"Produces <link=\"MEDICINE\">Medicine</link> to cure most basic <link=\"DISEASE\">Diseases</link>.\n"
"\n"
"Duplicants must possess the Medicine Compounding <link=\"ROLES\">Skill</link> to fabricate "
"medicines.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"Produz <link=\"MEDICINE\">Medicamentos</link> para curar as <link=\"DISEASE\">Doenças</link> mais "
"básicas.\n"
"\n"
"Duplicantes precisam ter a <link=\"ROLES\">Habilidade</link> de Manipulação de Medicamentos para "
"fabricar medicamentos.\n"
"\n"
"Duplicantes não irão fabricar enquanto receitas não forem colocadas na fila."

#. STRINGS.BUILDINGS.PREFABS.ADVANCEDAPOTHECARY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ADVANCEDAPOTHECARY.NAME"
msgid "<link=\"ADVANCEDAPOTHECARY\">Nuclear Apothecary</link>"
msgstr "<link=\"ADVANCEDAPOTHECARY\">Farmácia Nuclear</link>"

#. STRINGS.BUILDINGS.PREFABS.ADVANCEDCRAFTINGTABLE.BIONIC_COMPONENT_RECIPE_DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ADVANCEDCRAFTINGTABLE.BIONIC_COMPONENT_RECIPE_DESC"
msgid "Converts {0} to {1}"
msgstr "Converte {0} em {1}"

#. STRINGS.BUILDINGS.PREFABS.ADVANCEDCRAFTINGTABLE.BIONIC_OVERCLOCK_RECIPE_DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ADVANCEDCRAFTINGTABLE.BIONIC_OVERCLOCK_RECIPE_DESC"
msgid ""
"Converts {0} to {1}\n"
"\n"
"<b>!! WARNING: SYSTEM DAMAGE RISK !!</b>"
msgstr ""
"Converte {0} para {1}\n"
"\n"
"<b>!! AVISO: RISCO DE DANOS AO SISTEMA !!</b>"

#. STRINGS.BUILDINGS.PREFABS.ADVANCEDCRAFTINGTABLE.COLONY_HAS_BOOSTER_ASSIGNED_COUNT
msgctxt "STRINGS.BUILDINGS.PREFABS.ADVANCEDCRAFTINGTABLE.COLONY_HAS_BOOSTER_ASSIGNED_COUNT"
msgid "My colony has {0} Bionic Duplicant(s) with this booster assigned"
msgstr "Minha colônia tem {0} Duplicantes Biônicos com esse reforço atribuído"

#. STRINGS.BUILDINGS.PREFABS.ADVANCEDCRAFTINGTABLE.COLONY_HAS_BOOSTER_ASSIGNED_NONE
msgctxt "STRINGS.BUILDINGS.PREFABS.ADVANCEDCRAFTINGTABLE.COLONY_HAS_BOOSTER_ASSIGNED_NONE"
msgid "My colony has no Bionic Duplicants with this booster assigned"
msgstr "Minha colônia não tem Duplicantes Biônicos com esse reforço atribuído"

#. STRINGS.BUILDINGS.PREFABS.ADVANCEDCRAFTINGTABLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ADVANCEDCRAFTINGTABLE.DESC"
msgid "Soldering stations allow Duplicants to build helpful Flydo retriever bots."
msgstr ""
"As estações de solda permitem que os Duplicantes construam robôs recuperadores Corvoados úteis."

#. STRINGS.BUILDINGS.PREFABS.ADVANCEDCRAFTINGTABLE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ADVANCEDCRAFTINGTABLE.EFFECT"
msgid ""
"Produces advanced electronics and bionic <link=\"BIONICUPGRADE\">Boosters</link>.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"Produz eletrônicos avançados e <link=\"BIONICUPGRADE\">Cartuchos de Reforço</link> biônicos.\n"
"\n"
"Duplicantes não fabricarão itens a menos que as receitas estejam na fila."

#. STRINGS.BUILDINGS.PREFABS.ADVANCEDCRAFTINGTABLE.GENERIC_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.ADVANCEDCRAFTINGTABLE.GENERIC_RECIPE_DESCRIPTION"
msgid "Converts {0} to {1}"
msgstr "Converte {0} em {1}"

#. STRINGS.BUILDINGS.PREFABS.ADVANCEDCRAFTINGTABLE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ADVANCEDCRAFTINGTABLE.NAME"
msgid "<link=\"ADVANCEDCRAFTINGTABLE\">Soldering Station</link>"
msgstr "<link=\"ADVANCEDCRAFTINGTABLE\">Estação de Solda</link>"

#. STRINGS.BUILDINGS.PREFABS.ADVANCEDDOCTORSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ADVANCEDDOCTORSTATION.DESC"
msgid "Disease clinics require power, but treat more serious illnesses than sick bays alone."
msgstr ""
"Clínicas de Doenças precisam de energia, mas tratam doenças mais sérias do que as macas sozinhas."

#. STRINGS.BUILDINGS.PREFABS.ADVANCEDDOCTORSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ADVANCEDDOCTORSTATION.EFFECT"
msgid ""
"Allows Duplicants to administer powerful treatments to sick Duplicants.\n"
"\n"
"Duplicants must possess the Advanced Medical Care <link=\"ROLES\">Skill</link> to treat peers."
msgstr ""
"Permite que Duplicantes administrem tratamentos poderosos aos Duplicantes doentes.\n"
"\n"
"Duplicantes precisam ter a <link=\"ROLES\">Habilidade</link> de Cuidado Médico Avançado para cuidar "
"de seus amigos."

#. STRINGS.BUILDINGS.PREFABS.ADVANCEDDOCTORSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ADVANCEDDOCTORSTATION.NAME"
msgid "<link=\"ADVANCEDDOCTORSTATION\">Disease Clinic</link>"
msgstr "<link=\"ADVANCEDDOCTORSTATION\">Clínica de Doenças</link>"

#. STRINGS.BUILDINGS.PREFABS.ADVANCEDRESEARCHCENTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ADVANCEDRESEARCHCENTER.DESC"
msgid "Super computers unlock higher technology tiers than research stations alone."
msgstr ""
"Super computadores desbloqueiam níveis tecnológicos mais altos do que estações de pesquisa sozinhas."

#. STRINGS.BUILDINGS.PREFABS.ADVANCEDRESEARCHCENTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ADVANCEDRESEARCHCENTER.EFFECT"
msgid ""
"Conducts <link=\"RESEARCH\">Advanced Research</link> to unlock new technologies.\n"
"\n"
"Consumes <link=\"WATER\">Water</link>.\n"
"\n"
"Assigned Duplicants must possess the <link=\"RESEARCHING1\">Advanced Research</link> skill."
msgstr ""
"Conduz <link=\"RESEARCH\">Pesquisa Avançada</link> para desbloquear novas tecnologias.\n"
"\n"
"Consome <link=\"WATER\">Água</link>.\n"
"\n"
"Duplicantes atribuídos precisam ter a habilidade <link=\"RESEARCHING1\">Pesquisa Avançada</link>."

#. STRINGS.BUILDINGS.PREFABS.ADVANCEDRESEARCHCENTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ADVANCEDRESEARCHCENTER.NAME"
msgid "<link=\"ADVANCEDRESEARCHCENTER\">Super Computer</link>"
msgstr "<link=\"ADVANCEDRESEARCHCENTER\">Super Computador</link>"

#. STRINGS.BUILDINGS.PREFABS.AIRBORNECREATURELURE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.AIRBORNECREATURELURE.DESC"
msgid "Lures can relocate Pufts or Shine Bugs to specific locations in my colony."
msgstr ""
"Iscas podem ser usadas para realocar Bolhas ou Vagalumes para locais específicos na minha colônia."

#. STRINGS.BUILDINGS.PREFABS.AIRBORNECREATURELURE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.AIRBORNECREATURELURE.EFFECT"
msgid ""
"Attracts one type of airborne critter at a time.\n"
"\n"
"Must be baited with <link=\"SLIMEMOLD\">Slime</link> or <link=\"PHOSPHORITE\">Phosphorite</link>."
msgstr ""
"Atrai um tipo de criatura aérea de cada vez.\n"
"\n"
"Precisa ser armada com <link=\"SLIMEMOLD\">Limo</link> ou <link=\"PHOSPHORITE\">Fosforito</link>."

#. STRINGS.BUILDINGS.PREFABS.AIRBORNECREATURELURE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.AIRBORNECREATURELURE.NAME"
msgid "<link=\"AIRBORNECREATURELURE\">Airborne Critter Lure</link>"
msgstr "<link=\"AIRBORNECREATURELURE\">Isca de Criatura Aérea</link>"

#. STRINGS.BUILDINGS.PREFABS.AIRBORNECRITTERCONDO.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.AIRBORNECRITTERCONDO.DESC"
msgid "Triggers natural nesting instincts and improves critters' moods."
msgstr "Aciona os instintos naturais de nidificação e melhora o humor das criaturas."

#. STRINGS.BUILDINGS.PREFABS.AIRBORNECRITTERCONDO.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.AIRBORNECRITTERCONDO.EFFECT"
msgid ""
"A hanging respite area for adult <link=\"PUFT\">Pufts</link>, <link=\"MOOSPECIES\">Moos</link> and "
"<link=\"LIGHTBUG\">Shine Bugs</link>."
msgstr ""
"Uma área de descanso suspensa para <link=\"PUFT\">Bolhas</link>, <link=\"MOOSPECIES\">Muus Gasosas</"
"link> e <link=\"LIGHTBUG\">Vagalumes</link> adultos."

#. STRINGS.BUILDINGS.PREFABS.AIRBORNECRITTERCONDO.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.AIRBORNECRITTERCONDO.NAME"
msgid "<link=\"AIRBORNECRITTERCONDO\">Airborne Critter Condo</link>"
msgstr "<link=\"AIRBORNECRITTERCONDO\">Cômodo de Criatura Aérea</link>"

#. STRINGS.BUILDINGS.PREFABS.AIRCONDITIONER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.AIRCONDITIONER.DESC"
msgid "A thermo regulator doesn't remove heat, but relocates it to a new area."
msgstr "Um termo regulador não remove calor, apenas transfere ele para uma nova área."

#. STRINGS.BUILDINGS.PREFABS.AIRCONDITIONER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.AIRCONDITIONER.EFFECT"
msgid ""
"Cools the <link=\"ELEMENTSGAS\">Gas</link> piped through it, but outputs <link=\"HEAT\">Heat</link> "
"in its immediate vicinity."
msgstr ""
"Esfria o <link=\"ELEMENTSGAS\">Gás</link> bombeado por ele, mas produz <link=\"HEAT\">Calor</link> "
"em volta."

#. STRINGS.BUILDINGS.PREFABS.AIRCONDITIONER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.AIRCONDITIONER.NAME"
msgid "<link=\"AIRCONDITIONER\">Thermo Regulator</link>"
msgstr "<link=\"AIRCONDITIONER\">Termo Regulador</link>"

#. STRINGS.BUILDINGS.PREFABS.AIRFILTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.AIRFILTER.DESC"
msgid "Oh! Citrus scented!"
msgstr "Hum! Cheirinho de limão!"

#. STRINGS.BUILDINGS.PREFABS.AIRFILTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.AIRFILTER.EFFECT"
msgid ""
"Uses <link=\"SAND\">Sand</link> to filter <link=\"CONTAMINATEDOXYGEN\">Polluted Oxygen</link> from "
"the air, reducing <link=\"DISEASE\">Disease</link> spread."
msgstr ""
"Usa <link=\"SAND\">Areia</link> para filtrar <link=\"CONTAMINATEDOXYGEN\">Oxigênio Poluído</link> "
"do ar, reduzindo a propagação de <link=\"DISEASE\">Doenças</link>."

#. STRINGS.BUILDINGS.PREFABS.AIRFILTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.AIRFILTER.NAME"
msgid "<link=\"AIRFILTER\">Deodorizer</link>"
msgstr "<link=\"AIRFILTER\">Desodorizador</link>"

#. STRINGS.BUILDINGS.PREFABS.ALGAEDISTILLERY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ALGAEDISTILLERY.DESC"
msgid "Algae distillers convert disease-causing slime into algae for oxygen production."
msgstr "Destiladores de alga convertem o limo causador de doenças em alga para produção de oxigênio."

#. STRINGS.BUILDINGS.PREFABS.ALGAEDISTILLERY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ALGAEDISTILLERY.EFFECT"
msgid "Refines <link=\"SLIMEMOLD\">Slime</link> into <link=\"ALGAE\">Algae</link>."
msgstr "Refina <link=\"SLIMEMOLD\">Limo</link> em <link=\"ALGAE\">Alga</link>."

#. STRINGS.BUILDINGS.PREFABS.ALGAEDISTILLERY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ALGAEDISTILLERY.NAME"
msgid "<link=\"ALGAEDISTILLERY\">Algae Distiller</link>"
msgstr "<link=\"ALGAEDISTILLERY\">Destilador de Algas</link>"

#. STRINGS.BUILDINGS.PREFABS.ALGAEHABITAT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ALGAEHABITAT.DESC"
msgid "Algae colony, Duplicant colony... we're more alike than we are different."
msgstr "Colônia de algas, Colônia de Duplicantes... nós somos mais similares do que diferentes."

#. STRINGS.BUILDINGS.PREFABS.ALGAEHABITAT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ALGAEHABITAT.EFFECT"
msgid ""
"Consumes <link=\"ALGAE\">Algae</link> to produce <link=\"OXYGEN\">Oxygen</link> and remove some "
"<link=\"CARBONDIOXIDE\">Carbon Dioxide</link>.\n"
"\n"
"Gains a 10% efficiency boost in direct <link=\"LIGHT\">Light</link>."
msgstr ""
"Consome <link=\"ALGAE\">Alga</link> para produzir <link=\"OXYGEN\">Oxigênio</link> e remove um "
"pouco de <link=\"CARBONDIOXIDE\">Dióxido de Carbono</link>.\n"
"\n"
"Ganha 10% de eficiência se estiver sobre <link=\"LIGHT\">Luz</link> direta."

#. STRINGS.BUILDINGS.PREFABS.ALGAEHABITAT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ALGAEHABITAT.NAME"
msgid "<link=\"ALGAEHABITAT\">Algae Terrarium</link>"
msgstr "<link=\"ALGAEHABITAT\">Terrário de Algas</link>"

#. STRINGS.BUILDINGS.PREFABS.ALGAEHABITAT.SIDESCREEN_TITLE
msgctxt "STRINGS.BUILDINGS.PREFABS.ALGAEHABITAT.SIDESCREEN_TITLE"
msgid "Empty <link=\"DIRTYWATER\">Polluted Water</link> Threshold"
msgstr "Limite para Esvaziamento de <link=\"DIRTYWATER\">Água Poluída</link>"

#. STRINGS.BUILDINGS.PREFABS.APOTHECARY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.APOTHECARY.DESC"
msgid "Some medications help prevent diseases, while others aim to alleviate existing illness."
msgstr "Alguns medicamentos ajudam a prevenir doenças, enquanto outros aliviam doenças existentes."

#. STRINGS.BUILDINGS.PREFABS.APOTHECARY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.APOTHECARY.EFFECT"
msgid ""
"Produces <link=\"MEDICINE\">Medicine</link> to cure most basic <link=\"DISEASE\">Diseases</link>.\n"
"\n"
"Duplicants must possess the Medicine Compounding <link=\"ROLES\">Skill</link> to fabricate "
"medicines.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"Produz <link=\"MEDICINE\">Medicamentos</link> para curar as <link=\"DISEASE\">Doenças</link> mais "
"básicas.\n"
"\n"
"Duplicantes precisam possuir a <link=\"ROLES\">Habilidade</link> de Manipulação de Medicamentos "
"para fabricar medicamentos.\n"
"\n"
"Duplicantes não irão fabricar enquanto as receitas não forem colocadas na fila."

#. STRINGS.BUILDINGS.PREFABS.APOTHECARY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.APOTHECARY.NAME"
msgid "<link=\"APOTHECARY\">Apothecary</link>"
msgstr "<link=\"APOTHECARY\">Farmácia</link>"

#. STRINGS.BUILDINGS.PREFABS.ARCADEMACHINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ARCADEMACHINE.DESC"
msgid ""
"Komet Kablam-O!\n"
"For up to two players."
msgstr ""
"Kometa Kabum!\n"
"Para até dois jogadores."

#. STRINGS.BUILDINGS.PREFABS.ARCADEMACHINE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ARCADEMACHINE.EFFECT"
msgid ""
"Allows Duplicants to play video games on their breaks.\n"
"\n"
"Increases Duplicant <link=\"MORALE\">Morale</link>."
msgstr ""
"Permite que os Duplicantes joguem videogames durante os seus intervalos.\n"
"\n"
"Aumenta a <link=\"MORALE\">Moral</link> do Duplicante."

#. STRINGS.BUILDINGS.PREFABS.ARCADEMACHINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ARCADEMACHINE.NAME"
msgid "<link=\"ARCADEMACHINE\">Arcade Cabinet</link>"
msgstr "<link=\"ARCADEMACHINE\">Cabine de Fliperama</link>"

#. STRINGS.BUILDINGS.PREFABS.ARTIFACTANALYSISSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ARTIFACTANALYSISSTATION.DESC"
msgid "Discover the mysteries of the past."
msgstr "Descubra os mistérios do passado."

#. STRINGS.BUILDINGS.PREFABS.ARTIFACTANALYSISSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ARTIFACTANALYSISSTATION.EFFECT"
msgid "Analyses and extracts <link=\"UNOBTANIUM\">Neutronium</link> from artifacts of interest."
msgstr "Analisa e extrai <link=\"UNOBTANIUM\">Neutrônio</link> de artefatos de seu interesse."

#. STRINGS.BUILDINGS.PREFABS.ARTIFACTANALYSISSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ARTIFACTANALYSISSTATION.NAME"
msgid "<link=\"ARTIFACTANALYSISSTATION\">Artifact Analysis Station</link>"
msgstr "<link=\"ARTIFACTANALYSISSTATION\">Estação de Análise de Artefatos</link>"

#. STRINGS.BUILDINGS.PREFABS.ARTIFACTANALYSISSTATION.PAYLOAD_DROP_RATE
msgctxt "STRINGS.BUILDINGS.PREFABS.ARTIFACTANALYSISSTATION.PAYLOAD_DROP_RATE"
msgid "Vacillator Recharge drop chance: {chance}"
msgstr "Chance de gerar Recarga de Vacilador: {chance}"

#. STRINGS.BUILDINGS.PREFABS.ARTIFACTANALYSISSTATION.PAYLOAD_DROP_RATE_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.ARTIFACTANALYSISSTATION.PAYLOAD_DROP_RATE_TOOLTIP"
msgid ""
"This artifact has a {chance} to drop a Vacillator Recharge when analyzed at the "
"<link=\"ARTIFACTANALYSISSTATION\">Artifact Analysis Station</link>"
msgstr ""
"Este artefato tem {chance} de criar uma Recarga de Vacilador quando for analisado na "
"<link=\"ARTIFACTANALYSISSTATION\">Estação de Análise de Artefatos</link>"

#. STRINGS.BUILDINGS.PREFABS.ARTIFACTCARGOBAY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ARTIFACTCARGOBAY.DESC"
msgid "Holds artifacts found in space."
msgstr "Guarda artefatos encontrados no espaço."

#. STRINGS.BUILDINGS.PREFABS.ARTIFACTCARGOBAY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ARTIFACTCARGOBAY.EFFECT"
msgid ""
"Allows Duplicants to store any artifacts they uncover during space missions.\n"
"\n"
"Artifacts become available to the colony upon the rocket's return. \n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr ""
"Permite que os Duplicantes armazenem qualquer artefato encontrado durante missões espaciais.\n"
"\n"
"Artefatos ficam disponíveis na colônia quando o foguete retornar.\n"
"\n"
"Precisa ser construído pela <link=\"LAUNCHPAD\">Plataforma de Foguetes</link>."

#. STRINGS.BUILDINGS.PREFABS.ARTIFACTCARGOBAY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ARTIFACTCARGOBAY.NAME"
msgid "<link=\"ARTIFACTCARGOBAY\">Artifact Transport Module</link>"
msgstr "<link=\"ARTIFACTCARGOBAY\">Módulo de Transporte de Artefatos</link>"

#. STRINGS.BUILDINGS.PREFABS.ASTRONAUTTRAININGCENTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ASTRONAUTTRAININGCENTER.DESC"
msgid "Duplicants must complete astronaut training in order to pilot space rockets."
msgstr "Duplicantes precisam completar o treinamento de astronauta para poderem pilotar espaçonaves."

#. STRINGS.BUILDINGS.PREFABS.ASTRONAUTTRAININGCENTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ASTRONAUTTRAININGCENTER.EFFECT"
msgid ""
"Trains Duplicants to become <link=\"ROCKETPILOTING1\">Astronaut</link>.\n"
"\n"
"Duplicants must possess the <link=\"ROCKETPILOTING1\">Astronaut</link> trait to receive training."
msgstr ""
"Treina Duplicantes para se tornarem <link=\"ROCKETPILOTING1\">Astronautas</link>.\n"
"\n"
"Duplicantes precisam possuir o traço de <link=\"ROCKETPILOTING1\">Astronauta-em-Treinamento</link> "
"para receber treinamento."

#. STRINGS.BUILDINGS.PREFABS.ASTRONAUTTRAININGCENTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ASTRONAUTTRAININGCENTER.NAME"
msgid "<link=\"ASTRONAUTTRAININGCENTER\">Space Cadet Centrifuge</link>"
msgstr "<link=\"ASTRONAUTTRAININGCENTER\">Centrífuga de Cadetes Espaciais</link>"

#. STRINGS.BUILDINGS.PREFABS.AUTOMINER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.AUTOMINER.DESC"
msgid "A robo-miner's range can be viewed at any time by selecting the building."
msgstr ""
"O alcance de um robô minerador pode ser visualizado a qualquer momento ao clicar na estrutura."

#. STRINGS.BUILDINGS.PREFABS.AUTOMINER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.AUTOMINER.EFFECT"
msgid "Automatically digs out all materials in a set range."
msgstr "Escava automaticamente todos os materiais em uma área determinada."

#. STRINGS.BUILDINGS.PREFABS.AUTOMINER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.AUTOMINER.NAME"
msgid "<link=\"AUTOMINER\">Robo-Miner</link>"
msgstr "<link=\"AUTOMINER\">Robô Minerador</link>"

#. STRINGS.BUILDINGS.PREFABS.BATTERY.CHARGE_LOSS
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERY.CHARGE_LOSS"
msgid "{Battery} charge loss"
msgstr "Perda de carga em {Battery}"

#. STRINGS.BUILDINGS.PREFABS.BATTERY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERY.DESC"
msgid "Batteries allow power from generators to be stored for later."
msgstr "Baterias permitem armazenar a energia dos geradores para uso posterior."

#. STRINGS.BUILDINGS.PREFABS.BATTERY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERY.EFFECT"
msgid ""
"Stores <link=\"POWER\">Power</link> from generators, then provides that power to buildings.\n"
"\n"
"Loses charge over time."
msgstr ""
"Armazena a <link=\"POWER\">Energia</link> dos geradores, e então fornece essa energia para as "
"estruturas.\n"
"\n"
"Perde carga com o tempo."

#. STRINGS.BUILDINGS.PREFABS.BATTERY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERY.NAME"
msgid "<link=\"BATTERY\">Battery</link>"
msgstr "<link=\"BATTERY\">Bateria</link>"

#. STRINGS.BUILDINGS.PREFABS.BATTERYMEDIUM.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERYMEDIUM.DESC"
msgid "Larger batteries hold more power and keep systems running longer before recharging."
msgstr ""
"Baterias maiores armazenam mais energia e mantém os sistemas funcionando por mais tempo antes de "
"recarregar."

#. STRINGS.BUILDINGS.PREFABS.BATTERYMEDIUM.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERYMEDIUM.EFFECT"
msgid ""
"Stores <link=\"POWER\">Power</link> from generators, then provides that power to buildings.\n"
"\n"
"Slightly loses charge over time."
msgstr ""
"Armazena a <link=\"POWER\">Energia</link> dos geradores, e então fornece essa energia para as "
"estruturas.\n"
"\n"
"Perde um pouco da carga com o tempo."

#. STRINGS.BUILDINGS.PREFABS.BATTERYMEDIUM.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERYMEDIUM.NAME"
msgid "<link=\"BATTERYMEDIUM\">Jumbo Battery</link>"
msgstr "<link=\"BATTERYMEDIUM\">Bateria Jumbo</link>"

#. STRINGS.BUILDINGS.PREFABS.BATTERYMODULE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERYMODULE.DESC"
msgid "Charging a battery module before takeoff makes it easier to power buildings during flight."
msgstr ""
"Carregar um módulo de bateria antes da decolagem torna mais fácil alimentar as estruturas durante o "
"voo."

#. STRINGS.BUILDINGS.PREFABS.BATTERYMODULE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERYMODULE.EFFECT"
msgid ""
"Stores the excess <link=\"POWER\">Power</link> generated by a Rocket Engine or "
"<link=\"LAUNCHPAD\">Rocket Platform</link>.\n"
"\n"
"Provides stored power to <link=\"ROCKETINTERIORPOWERPLUG\">Interior Rocket Outlets</link>.\n"
"\n"
"Loses charge over time. \n"
"\n"
"Must be built via Rocket Platform."
msgstr ""
"Armazena a <link=\"POWER\">Energia</link> em excesso gerada por um Motor de Foguete ou da "
"<link=\"LAUNCHPAD\">Plataforma de Foguetes</link>.\n"
"\n"
"Fornece a energia armazenada para as <link=\"ROCKETINTERIORPOWERPLUG\">Tomadas Interiores de "
"Foguete</link>.\n"
"\n"
"Perde carga com o tempo.\n"
"\n"
"Precisa ser construída pela Plataforma de Foguetes."

#. STRINGS.BUILDINGS.PREFABS.BATTERYMODULE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERYMODULE.NAME"
msgid "<link=\"BATTERYMODULE\">Battery Module</link>"
msgstr "<link=\"BATTERYMODULE\">Módulo de Bateria</link>"

#. STRINGS.BUILDINGS.PREFABS.BATTERYSMART.ACTIVATE_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERYSMART.ACTIVATE_TOOLTIP"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> when battery is less than <b>{0}%</b> "
"charged, until it is <b>{1}% (High Threshold)</b> charged"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> quando a carga da bateria estiver menor que "
"<b>{0}%</b>, até a carga chegar em <b>{1}% (Limite Alto)</b>"

#. STRINGS.BUILDINGS.PREFABS.BATTERYSMART.DEACTIVATE_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERYSMART.DEACTIVATE_TOOLTIP"
msgid ""
"Sends a <b><style=\"logic_off\">Red Signal</style></b> when battery is <b>{0}%</b> charged, until "
"it is less than <b>{1}% (Low Threshold)</b> charged"
msgstr ""
"Envia um <b><style=\"logic_off\">Sinal Vermelho</style></b> quando a bateria estiver <b>{0}%</b> "
"carregada, até a carga ficar menor que <b>{1}% (Limite Baixo)</b>"

#. STRINGS.BUILDINGS.PREFABS.BATTERYSMART.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERYSMART.DESC"
msgid ""
"Smart batteries send a <b><style=\"logic_on\">Green Signal</style></b> when they require charging."
msgstr ""
"Baterias inteligentes enviam um <b><style=\"logic_on\">Sinal Verde</style></b> quando precisam de "
"recarga."

#. STRINGS.BUILDINGS.PREFABS.BATTERYSMART.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERYSMART.EFFECT"
msgid ""
"Stores <link=\"POWER\">Power</link> from generators, then provides that power to buildings.\n"
"\n"
"Sends a <b><style=\"logic_on\">Green Signal</style></b> or <b><style=\"logic_off\">Red Signal</"
"style></b> based on the configuration of the Logic Activation Parameters.\n"
"\n"
"Very slightly loses charge over time."
msgstr ""
"Armazena a <link=\"POWER\">Energia</link> dos geradores, e então fornece essa energia para as "
"estruturas.\n"
"\n"
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> ou um <b><style=\"logic_off\">Sinal "
"Vermelho</style></b> baseado na configuração dos Parâmetros de Ativação Lógica.\n"
"\n"
"Perde pouquíssima energia com o tempo."

#. STRINGS.BUILDINGS.PREFABS.BATTERYSMART.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERYSMART.LOGIC_PORT"
msgid "Charge Parameters"
msgstr "Parâmetros de Recarga"

#. STRINGS.BUILDINGS.PREFABS.BATTERYSMART.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERYSMART.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> when battery is less than <b>Low Threshold</"
"b> charged, until <b>High Threshold</b> is reached again"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> quando a bateria estiver com carga menor "
"que o <b>Limite Baixo</b>, até que o <b>Limite Alto</b> seja atingido novamente"

#. STRINGS.BUILDINGS.PREFABS.BATTERYSMART.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERYSMART.LOGIC_PORT_INACTIVE"
msgid ""
"Sends a <b><style=\"logic_off\">Red Signal</style></b> when the battery is more than <b>High "
"Threshold</b> charged, until <b>Low Threshold</b> is reached again"
msgstr ""
"Envia um <b><style=\"logic_off\">Sinal Vermelho</style></b> quando a bateria está mais carregada "
"que o <b>Limite Alto</b>, até que o <b>Limite Baixo</b> seja atingido novamente"

#. STRINGS.BUILDINGS.PREFABS.BATTERYSMART.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERYSMART.NAME"
msgid "<link=\"BATTERYSMART\">Smart Battery</link>"
msgstr "<link=\"BATTERYSMART\">Bateria Inteligente</link>"

#. STRINGS.BUILDINGS.PREFABS.BATTERYSMART.SIDESCREEN_ACTIVATE
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERYSMART.SIDESCREEN_ACTIVATE"
msgid "Low Threshold:"
msgstr "Limite Baixo:"

#. STRINGS.BUILDINGS.PREFABS.BATTERYSMART.SIDESCREEN_DEACTIVATE
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERYSMART.SIDESCREEN_DEACTIVATE"
msgid "High Threshold:"
msgstr "Limite Alto:"

#. STRINGS.BUILDINGS.PREFABS.BATTERYSMART.SIDESCREEN_TITLE
msgctxt "STRINGS.BUILDINGS.PREFABS.BATTERYSMART.SIDESCREEN_TITLE"
msgid "Logic Activation Parameters"
msgstr "Parâmetros de Ativação Lógica"

#. STRINGS.BUILDINGS.PREFABS.BEACHCHAIR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BEACHCHAIR.DESC"
msgid "Soak up some relaxing sun rays."
msgstr "Sugue um pouco de raios solares relaxantes."

#. STRINGS.BUILDINGS.PREFABS.BEACHCHAIR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.BEACHCHAIR.EFFECT"
msgid ""
"Duplicants can relax by lounging in <link=\"LIGHT\">Sunlight</link>.\n"
"\n"
"Increases Duplicant <link=\"MORALE\">Morale</link>."
msgstr ""
"Duplicantes podem relaxar ao descansarem na <link=\"LIGHT\">Luz do Sol</link>.\n"
"\n"
"Aumenta a <link=\"MORALE\">Moral</link> dos Duplicantes."

#. STRINGS.BUILDINGS.PREFABS.BEACHCHAIR.LIGHTEFFECT_HIGH
msgctxt "STRINGS.BUILDINGS.PREFABS.BEACHCHAIR.LIGHTEFFECT_HIGH"
msgid "{attrib}: {amount} (Bright Light)"
msgstr "{attrib}: {amount} (Luz Forte)"

#. STRINGS.BUILDINGS.PREFABS.BEACHCHAIR.LIGHTEFFECT_HIGH_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.BEACHCHAIR.LIGHTEFFECT_HIGH_TOOLTIP"
msgid "Duplicants will gain {amount} {attrib} if this building is in at least {lux} light."
msgstr ""
"Duplicantes ganharão {amount} {attrib} se esta estrutura estiver numa iluminação de pelo menos "
"{lux}."

#. STRINGS.BUILDINGS.PREFABS.BEACHCHAIR.LIGHTEFFECT_LOW
msgctxt "STRINGS.BUILDINGS.PREFABS.BEACHCHAIR.LIGHTEFFECT_LOW"
msgid "{attrib}: {amount} (Dim Light)"
msgstr "{attrib}: {amount} (Luz Fraca)"

#. STRINGS.BUILDINGS.PREFABS.BEACHCHAIR.LIGHTEFFECT_LOW_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.BEACHCHAIR.LIGHTEFFECT_LOW_TOOLTIP"
msgid "Duplicants will gain {amount} {attrib} if this building is in light dimmer than {lux}."
msgstr ""
"Duplicantes ganharão {amount} {attrib} se esta estrutura estiver numa iluminação mais fraca que "
"{lux}."

#. STRINGS.BUILDINGS.PREFABS.BEACHCHAIR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BEACHCHAIR.NAME"
msgid "<link=\"BEACHCHAIR\">Beach Chair</link>"
msgstr "<link=\"BEACHCHAIR\">Cadeira de Praia</link>"

#. STRINGS.BUILDINGS.PREFABS.BED.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BED.DESC"
msgid "Duplicants without a bed will develop sore backs from sleeping on the floor."
msgstr "Duplicantes sem uma cama vão desenvolver dor nas costas por dormirem no chão."

#. STRINGS.BUILDINGS.PREFABS.BED.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.BED.EFFECT"
msgid ""
"Gives one Duplicant a place to sleep.\n"
"\n"
"Duplicants will automatically return to their cots to sleep at night."
msgstr ""
"Dá a um Duplicante um local para dormir.\n"
"\n"
"Duplicantes irão automaticamente voltar às suas camas para dormir à noite."

#. STRINGS.BUILDINGS.PREFABS.BED.FACADES.CREAKY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BED.FACADES.CREAKY.DESC"
msgid "It's sturdier than it looks."
msgstr "É mais resistente do que parece."

#. STRINGS.BUILDINGS.PREFABS.BED.FACADES.CREAKY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BED.FACADES.CREAKY.NAME"
msgid "<link=\"BED\">Camping Cot</link>"
msgstr "<link=\"BED\">Cama de Acampamento</link>"

#. STRINGS.BUILDINGS.PREFABS.BED.FACADES.DEFAULT_BED.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BED.FACADES.DEFAULT_BED.DESC"
msgid "A safe place to sleep."
msgstr "Um lugar seguro para dormir."

#. STRINGS.BUILDINGS.PREFABS.BED.FACADES.DEFAULT_BED.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BED.FACADES.DEFAULT_BED.NAME"
msgid "<link=\"BED\">Cot</link>"
msgstr "<link=\"BED\">Cama</link>"

#. STRINGS.BUILDINGS.PREFABS.BED.FACADES.SCIENCELAB.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BED.FACADES.SCIENCELAB.DESC"
msgid "For the Duplicant who dreams of scientific discoveries."
msgstr "Para o Duplicante que sonha com descobertas científicas."

#. STRINGS.BUILDINGS.PREFABS.BED.FACADES.SCIENCELAB.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BED.FACADES.SCIENCELAB.NAME"
msgid "<link=\"BED\">Lab Cot</link>"
msgstr "<link=\"BED\">Cama de Laboratório</link>"

#. STRINGS.BUILDINGS.PREFABS.BED.FACADES.STARCURTAIN.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BED.FACADES.STARCURTAIN.DESC"
msgid "Now Duplicants can sleep beneath the stars without wearing an Atmo Suit to bed."
msgstr "Agora os Duplicantes podem dormir sob as estrelas sem precisar dormir com um Atmo-Traje."

#. STRINGS.BUILDINGS.PREFABS.BED.FACADES.STARCURTAIN.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BED.FACADES.STARCURTAIN.NAME"
msgid "<link=\"BED\">Stargazer Cot</link>"
msgstr "<link=\"BED\">Cama de Astrônomo</link>"

#. STRINGS.BUILDINGS.PREFABS.BED.FACADES.STAYCATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BED.FACADES.STAYCATION.DESC"
msgid "Like a weekend away, except... not."
msgstr "Como passar um fim de semana fora... só que não."

#. STRINGS.BUILDINGS.PREFABS.BED.FACADES.STAYCATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BED.FACADES.STAYCATION.NAME"
msgid "<link=\"BED\">Staycation Cot</link>"
msgstr "<link=\"BED\">Cama de Férias Permanentes</link>"

#. STRINGS.BUILDINGS.PREFABS.BED.FACADES.STRINGLIGHTS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BED.FACADES.STRINGLIGHTS.DESC"
msgid "Wrapped in shiny gold stars, to help sleepy Duplicants feel accomplished."
msgstr ""
"Envolto em estrelas douradas brilhantes, para ajudar os Duplicantes sonolentos a se sentirem "
"realizados."

#. STRINGS.BUILDINGS.PREFABS.BED.FACADES.STRINGLIGHTS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BED.FACADES.STRINGLIGHTS.NAME"
msgid "Good Job Cot"
msgstr "Cama de Bom Trabalho"

#. STRINGS.BUILDINGS.PREFABS.BED.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BED.NAME"
msgid "<link=\"BED\">Cot</link>"
msgstr "<link=\"BED\">Cama</link>"

#. STRINGS.BUILDINGS.PREFABS.BEEHIVE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BEEHIVE.DESC"
msgid ""
"A moderately <link=\"RADIATION\">Radioactive</link> nest made by <link=\"BEE\">Beetas</link>.\n"
"\n"
"Converts <link=\"URANIUMORE\">Uranium Ore</link> into <link=\"ENRICHEDURANIUM\">Enriched Uranium</"
"link> when worked by a Beeta.\n"
"Will not function if ground below has been destroyed."
msgstr ""
"Um ninho moderadamente <link=\"RADIATION\">Radioativo</link> feito por <link=\"BEE\">Abetas</"
"link>.\n"
"\n"
"Converte <link=\"URANIUMORE\">Minério de Urânio</link> em <link=\"ENRICHEDURANIUM\">Urânio "
"Enriquecido</link> quando trabalhado por uma Abeta.\n"
"Não irá funcionar se o solo abaixo for destruído."

#. STRINGS.BUILDINGS.PREFABS.BEEHIVE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.BEEHIVE.EFFECT"
msgid "The cozy home of a Beeta."
msgstr "O lar confortável de uma Abeta."

#. STRINGS.BUILDINGS.PREFABS.BEEHIVE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BEEHIVE.NAME"
msgid "<link=\"BEEHIVE\">Beeta Hive</link>"
msgstr "<link=\"BEEHIVE\">Ninho de Abeta</link>"

#. STRINGS.BUILDINGS.PREFABS.BIODIESELENGINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BIODIESELENGINE.DESC"
msgid "Rockets can be used to send Duplicants into space and retrieve rare resources."
msgstr "Foguetes podem ser usados para enviar Duplicantes ao espaço e coletar recursos raros."

#. STRINGS.BUILDINGS.PREFABS.BIODIESELENGINE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.BIODIESELENGINE.EFFECT"
msgid ""
"Burns <link=\"REFINEDLIPID\">Biodiesel</link> to propel rockets for mid-range space exploration.\n"
"\n"
"Biodiesel Engines have generous height restrictions, ideal for hauling a larger number of modules.\n"
"\n"
"Once the engine has been built, more rocket modules can be added."
msgstr ""
"Queima <link=\"REFINEDLIPID\">Biodiesel</link> para propelir os foguetes em exploração espacial de "
"médio alcance.\n"
"\n"
"Motores à Biodiesel possuem restrições de altura generosas, ideal para instalação de vários "
"módulos.\n"
"\n"
"O motor de um foguete precisa ser construído primeiro para que outros módulos possam ser "
"adicionados.."

#. STRINGS.BUILDINGS.PREFABS.BIODIESELENGINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BIODIESELENGINE.NAME"
msgid "<link=\"BIODIESELENGINE\">Biodiesel Engine</link>"
msgstr "<link=\"BIODIESELENGINE\">Motor à Biodiesel</link>"

#. STRINGS.BUILDINGS.PREFABS.BIODIESELENGINECLUSTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BIODIESELENGINECLUSTER.DESC"
msgid "More powerful rocket engines can propel heavier burdens."
msgstr "Motores de foguete mais potentes podem propelir cargas mais pesadas."

#. STRINGS.BUILDINGS.PREFABS.BIODIESELENGINECLUSTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.BIODIESELENGINECLUSTER.EFFECT"
msgid ""
"Burns <link=\"REFINEDLIPID\">Biodiesel</link> to propel rockets for mid-range space exploration.\n"
"\n"
"Biodiesel Engines have generous height restrictions, ideal for hauling many modules.\n"
"\n"
"Engine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>, and requires an oxidizer "
"tank.\n"
"\n"
"Once the engine has been built, more rocket modules can be added."
msgstr ""
"Queima <link=\"PETROLEUM\">Biodiesel</link> para propelir os foguetes em exploração espacial de "
"médio alcance.\n"
"\n"
"Motores à Biodiesel possuem restrições de altura generosas, ideal para instalação de vários "
"módulos.\n"
"\n"
"O motor de um foguete precisa ser construído pela <link=\"LAUNCHPAD\">Plataforma de Foguetes</"
"link>, e requer um tanque de oxidante.\n"
"\n"
"Uma vez que o motor for construído, mais módulos poderão ser adicionados."

#. STRINGS.BUILDINGS.PREFABS.BIODIESELENGINECLUSTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BIODIESELENGINECLUSTER.NAME"
msgid "<link=\"BIODIESELENGINECLUSTER\">Biodiesel Engine</link>"
msgstr "<link=\"BIODIESELENGINECLUSTER\">Motor à Biodiesel</link>"

#. STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIER.DESC"
msgid "A bottle emptier's Element Filter can be used to designate areas for specific liquid storage."
msgstr ""
"O Filtro de Elementos de um esvaziador de garrafas pode ser usado para designar áreas específicas "
"para armazenamento de líquidos."

#. STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIER.EFFECT"
msgid "Empties bottled <link=\"ELEMENTSLIQUID\">Liquids</link> back into the world."
msgstr "Esvazia as garrafas liberando os <link=\"ELEMENTSLIQUID\">Líquidos</link> de volta ao mundo."

#. STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIER.NAME"
msgid "<link=\"BOTTLEEMPTIER\">Bottle Emptier</link>"
msgstr "<link=\"BOTTLEEMPTIER\">Esvaziador de Garrafas</link>"

#. STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIERCONDUITGAS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIERCONDUITGAS.DESC"
msgid "A canister drainer's Element Filter can designate areas for specific gas storage."
msgstr ""
"O Filtro de Elementos de um extrator de botijões pode designar áreas específicas para armazenamento "
"de gás."

#. STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIERCONDUITGAS.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIERCONDUITGAS.EFFECT"
msgid "Drains <link=\"ELEMENTSGAS\">Gas</link> canisters into <link=\"GASCONDUIT\">Gas Pipes</link>."
msgstr ""
"Extrai os <link=\"ELEMENTSGAS\">Gases</link> dos botijões diretamente em <link=\"GASCONDUIT\">Tubos "
"de Gás</link>."

#. STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIERCONDUITGAS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIERCONDUITGAS.NAME"
msgid "<link=\"BOTTLEEMPTIERCONDUITGAS\">Canister Drainer</link>"
msgstr "<link=\"BOTTLEEMPTIERCONDUITGAS\">Extrator de Botijões</link>"

#. STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIERCONDUITLIQUID.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIERCONDUITLIQUID.DESC"
msgid "A bottle drainer's Element Filter can be used to designate areas for specific liquid storage."
msgstr ""
"O Filtro de Elementos de um extrator de garrafas pode ser usado para designar áreas específicas "
"para armazenamento de líquidos."

#. STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIERCONDUITLIQUID.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIERCONDUITLIQUID.EFFECT"
msgid ""
"Drains bottled <link=\"ELEMENTSLIQUID\">Liquids</link> into <link=\"LIQUIDCONDUIT\">Liquid Pipes</"
"link>."
msgstr ""
"Extrai os <link=\"ELEMENTSLIQUID\">Líquidos</link> engarrafados diretamente em "
"<link=\"LIQUIDCONDUIT\">Tubos de Líquido</link>."

#. STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIERCONDUITLIQUID.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIERCONDUITLIQUID.NAME"
msgid "<link=\"BOTTLEEMPTIERCONDUITLIQUID\">Bottle Drainer</link>"
msgstr "<link=\"BOTTLEEMPTIERCONDUITLIQUID\">Extrator de Garrafas</link>"

#. STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIERGAS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIERGAS.DESC"
msgid "A canister emptier's Element Filter can designate areas for specific gas storage."
msgstr ""
"O Filtro de Elementos de um esvaziador de botijões pode designar áreas específicas para "
"armazenamento de gás."

#. STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIERGAS.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIERGAS.EFFECT"
msgid "Empties <link=\"ELEMENTSGAS\">Gas</link> canisters back into the world."
msgstr "Esvazia os botijões liberando os <link=\"ELEMENTSGAS\">Gases</link> de volta ao mundo."

#. STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIERGAS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BOTTLEEMPTIERGAS.NAME"
msgid "<link=\"BOTTLEEMPTIERGAS\">Canister Emptier</link>"
msgstr "<link=\"BOTTLEEMPTIERGAS\">Esvaziador de Botijões</link>"

#. STRINGS.BUILDINGS.PREFABS.BUNKERDOOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BUNKERDOOR.DESC"
msgid "A massive, slow-moving door which is nearly indestructible."
msgstr "Uma porta massiva, que se move lentamente e que é praticamente indestrutível."

#. STRINGS.BUILDINGS.PREFABS.BUNKERDOOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.BUNKERDOOR.EFFECT"
msgid ""
"Blocks <link=\"ELEMENTSLIQUID\">Liquid</link> and <link=\"ELEMENTSGAS\">Gas</link> flow, "
"maintaining pressure between areas.\n"
"\n"
"Can withstand extremely high pressures and impacts."
msgstr ""
"Bloqueia o fluxo de <link=\"ELEMENTSLIQUID\">Líquido</link> e <link=\"ELEMENTSGAS\">Gás</link>, "
"mantendo a pressão entre as áreas.\n"
"\n"
"Consegue resistir à pressões extremamente altas e impactos."

#. STRINGS.BUILDINGS.PREFABS.BUNKERDOOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BUNKERDOOR.NAME"
msgid "<link=\"BUNKERDOOR\">Bunker Door</link>"
msgstr "<link=\"BUNKERDOOR\">Porta Reforçada</link>"

#. STRINGS.BUILDINGS.PREFABS.BUNKERTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.BUNKERTILE.DESC"
msgid "Bunker tile can build strong shelters in otherwise dangerous environments."
msgstr "Blocos reforçados podem construir abrigos fortes em ambientes outrora perigosos."

#. STRINGS.BUILDINGS.PREFABS.BUNKERTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.BUNKERTILE.EFFECT"
msgid ""
"Used to build the walls and floors of rooms.\n"
"\n"
"Can withstand extreme pressures and impacts."
msgstr ""
"Usado para construir as paredes e pisos das salas.\n"
"\n"
"Consegue resistir a pressões extremas e impactos."

#. STRINGS.BUILDINGS.PREFABS.BUNKERTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.BUNKERTILE.NAME"
msgid "<link=\"BUNKERTILE\">Bunker Tile</link>"
msgstr "<link=\"BUNKERTILE\">Bloco Reforçado</link>"

#. STRINGS.BUILDINGS.PREFABS.CAMPFIRE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CAMPFIRE.DESC"
msgid "Wood heaters dry out soggy feet and help Duplicants forget how cold they are."
msgstr ""
