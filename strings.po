msgstr "Este mundo possui cavernas de minério de metal"

#. STRINGS.WORLD_TRAITS.METAL_CAVES.NAME
msgctxt "STRINGS.WORLD_TRAITS.METAL_CAVES.NAME"
msgid "Metallic Caves"
msgstr "Cavernas Metálicas"

#. STRINGS.WORLD_TRAITS.METAL_POOR.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.METAL_POOR.DESCRIPTION"
msgid ""
"There is a reduced amount of <style=\"KKeyword\">Metal Ore</style> on this world, proceed with "
"caution!"
msgstr ""
"Existe uma quantidade reduzida de <style=\"KKeyword\">Metais Brutos</style> neste mundo, prossiga "
"com cuidado!"

#. STRINGS.WORLD_TRAITS.METAL_POOR.NAME
msgctxt "STRINGS.WORLD_TRAITS.METAL_POOR.NAME"
