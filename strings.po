msgctxt "STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.FOOD_FIGHT.UNDERWAY_TOOLTIP"
msgid "There is a food fight happening now"
msgstr "Tem uma guerra de comida ocorrendo agora"

