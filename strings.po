msgid "<link=\"FILAMENTPLANT\">Petta Pouf</link>"
msgstr ""

#. STRINGS.CREATURES.SPECIES.FILTERPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.FILTERPLANT.DESC"
msgid ""
"Hydrocacti act as natural <link=\"WATER\">Water</link> filters when given access to "
"<link=\"SAND\">Sand</link>."
msgstr ""
"Hidrocactos funcionam como um filtro natural de <link=\"WATER\">Água</link> quando têm acesso à "
"<link=\"SAND\">Areia</link>."

#. STRINGS.CREATURES.SPECIES.FILTERPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.FILTERPLANT.DOMESTICATEDDESC"
msgid ""
"This plant uses <link=\"SAND\">Sand</link> to convert <link=\"DIRTYWATER\">Polluted Water</link> "
"into <link=\"WATER\">Water</link>."
msgstr ""
"Esta planta usa <link=\"SAND\">Areia</link> para converter <link=\"DIRTYWATER\">Água Poluída</link> "
"em <link=\"WATER\">Água</link>."

#. STRINGS.CREATURES.SPECIES.FILTERPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.FILTERPLANT.NAME"
msgid "<link=\"FILTERPLANT\">Hydrocactus</link>"
msgstr "<link=\"FILTERPLANT\">Hidrocacto</link>"

#. STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.DESC"
msgid ""
"Lura plants are carnivorous plants that trap flying critters, such as <link=\"MOSQUITO\">Gnits</"
"link>.\n"
"\n"
"Their digestive processes produce harvestable <link=\"AMBER\">Amber</link>."
msgstr ""
"Plantiscas são plantas carnívoras que prendem criaturas aéreas, como os <link=\"MOSQUITO\">Kitos</"
"link>.\n"
"\n"
"Seu processo digestivo produz <link=\"AMBER\">Âmbar</link> coletável."

#. STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.DOMESTICATEDDESC"
msgid "This plant produces <link=\"NATURALRESIN\">Resin</link>."
msgstr "Esta planta produz <link=\"NATURALRESIN\">Resina</link>."

#. STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.HUNGRY
msgctxt "STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.HUNGRY"
msgid "Hungry"
msgstr "Faminta"

#. STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.NAME"
msgid "<link=\"FLYTRAPPLANT\">Lura Plant</link>"
msgstr "<link=\"FLYTRAPPLANT\">Plantisca</link>"

#. STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.PLANT_HUNGER_REQUIREMENT
msgctxt "STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.PLANT_HUNGER_REQUIREMENT"
msgid "Carnivorous Diet"
msgstr "Dieta Carnívora"

#. STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.VICTIM_IDENTIFIER
msgctxt "STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.VICTIM_IDENTIFIER"
msgid "Airborne Critters"
msgstr "Criaturas Aéreas"

#. STRINGS.CREATURES.SPECIES.FORESTFORAGEPLANTPLANTED.DESC
msgctxt "STRINGS.CREATURES.SPECIES.FORESTFORAGEPLANTPLANTED.DESC"
msgid ""
"Hexalents are incapable of propagating but can be harvested for a single, calorie dense "
"<link=\"FOOD\">Food</link> serving."
msgstr ""
"Hexalentes são incapazes de reproduzir mas podem ser colhidas como uma única porção de "
"<link=\"FOOD\">Alimento</link>."

#. STRINGS.CREATURES.SPECIES.FORESTFORAGEPLANTPLANTED.NAME
msgctxt "STRINGS.CREATURES.SPECIES.FORESTFORAGEPLANTPLANTED.NAME"
msgid "<link=\"FORESTFORAGEPLANTPLANTED\">Hexalent</link>"
msgstr "<link=\"FORESTFORAGEPLANTPLANTED\">Hexalente</link>"

#. STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.DESC"
msgid ""
"Ring Rosebushes are <link=\"DECOR\">Decorative</link> <link=\"PLANTS\">Plants</link> that add a "
"touch of whimsy wherever they are planted."
msgstr ""
"Roseiras Anelares são <link=\"PLANTS\">Plantas</link> <link=\"DECOR\">Decorativas</link> que dão um "
"toque de capricho onde quer que sejam plantadas."

#. STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "Esta planta melhora a <link=\"DECOR\">Decoração</link> do ambiente."

#. STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "Bônus de Crescimento"

#. STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.NAME"
msgid "<link=\"GARDENDECORPLANT\">Ring Rosebush</link>"
msgstr "<link=\"GARDENDECORPLANT\">Roseira Anelar</link>"

#. STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "Penalidade por Murchar"

#. STRINGS.CREATURES.SPECIES.GARDENFOODPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GARDENFOODPLANT.DESC"
msgid ""
"Sweatcorn Stalks produce <link=\"GARDENFOODPLANTFOOD\">Sweatcorn</link>, a crisp vegetable that can "
"be harvested for <link=\"FOOD\">Food</link>."
msgstr ""
"Pés de Milhossuado produzem <link=\"GARDENFOODPLANTFOOD\">Milhossuado</link>, um vegetal crocante "
"que pode ser colhido como <link=\"FOOD\">Alimento</link>."

#. STRINGS.CREATURES.SPECIES.GARDENFOODPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.GARDENFOODPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"GARDENFOODPLANTFOOD\">Sweatcorn</link>s."
msgstr "Esta planta produz <link=\"GARDENFOODPLANTFOOD\">Milhossuados</link> comestíveis."

#. STRINGS.CREATURES.SPECIES.GARDENFOODPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GARDENFOODPLANT.NAME"
msgid "<link=\"GARDENFOODPLANT\">Sweatcorn Stalk</link>"
msgstr "<link=\"GARDENFOODPLANT\">Pé de Milhossuado</link>"

#. STRINGS.CREATURES.SPECIES.GARDENFORAGEPLANTPLANTED.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GARDENFORAGEPLANTPLANTED.DESC"
msgid ""
"Snacti are incapable of propagating but can be harvested for a single <link=\"FOOD\">Food</link> "
"serving."
msgstr ""
"Lanchactus são incapazes de se propagar mas podem ser colhidos para uma única porção de "
"<link=\"FOOD\">Alimento</link>."

#. STRINGS.CREATURES.SPECIES.GARDENFORAGEPLANTPLANTED.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GARDENFORAGEPLANTPLANTED.NAME"
msgid "<link=\"GARDENFORAGEPLANTPLANTED\">Snactus</link>"
msgstr "<link=\"GARDENFORAGEPLANTPLANTED\">Lanchactus</link>"

#. STRINGS.CREATURES.SPECIES.GASGRASS.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GASGRASS.DESC"
msgid ""
"Gas Grass is an alien lifeform tentatively categorized as a \"plant.\"\n"
"\n"
"It can be harvested for <link=\"PLANTFIBER\">Plant Husk</link> or eaten as-is by "
"<link=\"MOOSPECIES\">Moos</link>."
msgstr ""
"Grama Gasosa é uma forma de vida alienígena classificada provisoriamente como uma \"planta\".\n"
"\n"
"Ela pode ser colhida para se obter <link=\"PLANTFIBER\">Cascas de Planta</link> ou comida como está "
"por <link=\"MOOSPECIES\">Muus</link>."

#. STRINGS.CREATURES.SPECIES.GASGRASS.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.GASGRASS.DOMESTICATEDDESC"
msgid "An alien grass variety that is eaten by <link=\"MOO\">Gassy Moos</link>."
msgstr "Uma variação de grama alienígena que é comida por <link=\"MOO\">Muus Gasosos</link>."

#. STRINGS.CREATURES.SPECIES.GASGRASS.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GASGRASS.NAME"
msgid "<link=\"GASGRASS\">Gas Grass</link>"
msgstr "<link=\"GASGRASS\">Grama Gasosa</link>"

#. STRINGS.CREATURES.SPECIES.GEYSER.BIG_VOLCANO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.BIG_VOLCANO.DESC"
msgid "A massive volcano that periodically erupts with molten <link=\"MAGMA\">Magma</link>."
msgstr "Um vulcão gigantesco que irrompe periodicamente liberando <link=\"MAGMA\">Magma</link>."

#. STRINGS.CREATURES.SPECIES.GEYSER.BIG_VOLCANO.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.BIG_VOLCANO.NAME"
msgid "<link=\"GEYSERGENERICBIGVOLCANO\">Volcano</link>"
msgstr "<link=\"GEYSERGENERICBIGVOLCANO\">Vulcão</link>"

#. STRINGS.CREATURES.SPECIES.GEYSER.CHLORINE_GAS.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.CHLORINE_GAS.DESC"
msgid ""
"A highly pressurized vent that periodically erupts with warm <link=\"CHLORINEGAS\">Chlorine Gas</"
"link>."
msgstr ""
"Uma fumarola altamente pressurizada que irrompe periodicamente liberando <link=\"CHLORINEGAS\">Gás "
"Cloro</link> quente."

#. STRINGS.CREATURES.SPECIES.GEYSER.CHLORINE_GAS.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.CHLORINE_GAS.NAME"
msgid "<link=\"GEYSERGENERICCHLORINEGAS\">Chlorine Gas Vent</link>"
msgstr "<link=\"GEYSERGENERICCHLORINEGAS\">Fumarola de Gás Cloro</link>"

#. STRINGS.CREATURES.SPECIES.GEYSER.CHLORINE_GAS_COOL.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.CHLORINE_GAS_COOL.DESC"
msgid ""
"A highly pressurized vent that periodically erupts with cool <link=\"CHLORINEGAS\">Chlorine Gas</"
"link>."
msgstr ""
"Uma fumarola altamente pressurizada que irrompe periodicamente liberando <link=\"CHLORINEGAS\">Gás "
"Cloro</link> quente."

#. STRINGS.CREATURES.SPECIES.GEYSER.CHLORINE_GAS_COOL.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.CHLORINE_GAS_COOL.NAME"
msgid "<link=\"GEYSERGENERICCHLORINEGASCOOL\">Cool Chlorine Gas Vent</link>"
msgstr "<link=\"GEYSERGENERICCHLORINEGAS\">Fumarola de Gás Cloro</link>"

#. STRINGS.CREATURES.SPECIES.GEYSER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.DESC"
msgid ""
"A highly pressurized geyser that periodically erupts, spraying <link=\"STEAM\">Steam</link> and "
"boiling hot <link=\"WATER\">Water</link>."
msgstr ""
"Um gêiser altamente pressurizado que periodicamente irrompe espirrando <link=\"STEAM\">Vapor</link> "
"e <link=\"WATER\">Água</link> fervente."

#. STRINGS.CREATURES.SPECIES.GEYSER.FILTHY_WATER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.FILTHY_WATER.DESC"
msgid ""
"A highly pressurized vent that periodically erupts with boiling <link=\"DIRTYWATER\">Polluted "
"Water</link>."
msgstr ""
"Um gêiser altamente pressurizado que irrompe periodicamente liberando <link=\"DIRTYWATER\">Água "
"Poluída</link> fervente."

#. STRINGS.CREATURES.SPECIES.GEYSER.FILTHY_WATER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.FILTHY_WATER.NAME"
msgid "<link=\"GEYSERGENERICFILTHYWATER\">Polluted Water Vent</link>"
msgstr "<link=\"GEYSERGENERICFILTHYWATER\">Gêiser de Água Poluída</link>"

#. STRINGS.CREATURES.SPECIES.GEYSER.HOT_CO2.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.HOT_CO2.DESC"
msgid ""
"A highly pressurized vent that periodically erupts with hot <link=\"CARBONDIOXIDE\">Carbon Dioxide</"
"link>."
msgstr ""
"Uma fumarola altamente pressurizada que irrompe periodicamente liberando "
"<link=\"CARBONDIOXIDE\">Dióxido de Carbono</link>."

#. STRINGS.CREATURES.SPECIES.GEYSER.HOT_CO2.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.HOT_CO2.NAME"
msgid "<link=\"GEYSERGENERICHOTCO2\">Carbon Dioxide Vent</link>"
msgstr "<link=\"GEYSERGENERICHOTCO2\">Fumarola de Dióxido de Carbono</link>"

#. STRINGS.CREATURES.SPECIES.GEYSER.HOT_HYDROGEN.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.HOT_HYDROGEN.DESC"
msgid ""
"A highly pressurized vent that periodically erupts with hot gaseous <link=\"HYDROGEN\">Hydrogen</"
"link>."
msgstr ""
"Uma fumarola altamente pressurizada que irrompe periodicamente liberando "
"<link=\"HYDROGEN\">Hidrogênio</link> gasoso e quente."

#. STRINGS.CREATURES.SPECIES.GEYSER.HOT_HYDROGEN.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.HOT_HYDROGEN.NAME"
msgid "<link=\"GEYSERGENERICHOTHYDROGEN\">Hydrogen Vent</link>"
msgstr "<link=\"GEYSERGENERICHOTHYDROGEN\">Fumarola de Hidrogênio</link>"

#. STRINGS.CREATURES.SPECIES.GEYSER.HOT_PO2.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.HOT_PO2.DESC"
msgid ""
"A highly pressurized vent that periodically erupts with hot <link=\"CONTAMINATEDOXYGEN\">Polluted "
"Oxygen</link>."
msgstr ""
