msgctxt "STRINGS.ELEMENTS.SANDCEMENT.NAME"
msgid "<link=\"SANDCEMENT\">Sand Cement</link>"
msgstr "<link=\"SANDCEMENT\">Cimento de Areia</link>"

#. STRINGS.ELEMENTS.SANDSTONE.DESC
msgctxt "STRINGS.ELEMENTS.SANDSTONE.DESC"
msgid ""
"Sandstone is a composite of relatively soft sedimentary rock.\n"
"\n"
"It is useful as a <b>Construction Material</b>."
msgstr ""
"Arenito é um composto relativamente macio de rocha sedimentar.\n"
"\n"
"É útil como <b>Material de Construção</b>."

#. STRINGS.ELEMENTS.SANDSTONE.NAME
msgctxt "STRINGS.ELEMENTS.SANDSTONE.NAME"
msgid "<link=\"SANDSTONE\">Sandstone</link>"
msgstr "<link=\"SANDSTONE\">Arenito</link>"

#. STRINGS.ELEMENTS.SEDIMENTARYROCK.DESC
msgctxt "STRINGS.ELEMENTS.SEDIMENTARYROCK.DESC"
msgid ""
"Sedimentary Rock is a hardened composite of sediment layers.\n"
"\n"
"It is useful as a <b>Construction Material</b>."
msgstr ""
"Rocha Sedimentar é um composto reforçado de camadas sedimentares.\n"
"\n"
"É útil como um <b>Material de Construção</b>."

#. STRINGS.ELEMENTS.SEDIMENTARYROCK.NAME
msgctxt "STRINGS.ELEMENTS.SEDIMENTARYROCK.NAME"
msgid "<link=\"SEDIMENTARYROCK\">Sedimentary Rock</link>"
msgstr "<link=\"SEDIMENTARYROCK\">Rocha Sedimentar</link>"

#. STRINGS.ELEMENTS.SHALE.DESC
msgctxt "STRINGS.ELEMENTS.SHALE.DESC"
msgid ""
"Shale is a brittle composite of sediment layers.\n"
"\n"
"It is useful as a <b>Construction Material</b>."
msgstr ""
"Xisto é um composto quebradiço de camadas sedimentares.\n"
"\n"
"É útil como um <b>Material de Construção</b>."

#. STRINGS.ELEMENTS.SHALE.NAME
msgctxt "STRINGS.ELEMENTS.SHALE.NAME"
msgid "<link=\"SHALE\">Shale</link>"
msgstr "<link=\"SHALE\">Xisto</link>"

#. STRINGS.ELEMENTS.SILTSTONE.DESC
#| msgctxt "STRINGS.ELEMENTS.SANDSTONE.DESC"
