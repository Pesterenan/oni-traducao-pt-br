msgctxt "STRINGS.EQUIPMENT.PREFABS.HOLIDAY_2023_CRATE.DESC"
msgid ""
"An unaddressed package has been discovered near the Printing Pod. It exudes seasonal cheer, and "
"trace amounts of Neutronium have been detected."
msgstr ""
"Um pacote sem endereço foi descoberto perto da duplicadora. Ele exala alegria sazonal e vestígios "
"de neutrônio foram detectados."

