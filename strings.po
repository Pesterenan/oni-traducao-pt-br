#. STRINGS.CREATURES.SPECIES.WOOD_TREE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.WOOD_TREE.DESC"
msgid ""
"Arbor Trees grow <link=\"FORESTTREE\">Arbor Tree Branches</link> and can be harvested for "
"<link=\"WOOD\">Wood</link>."
msgstr ""
"Árvores Arbórea criam <link=\"FORESTTREE\">Galhos de Árvore Arbórea</link> que podem ser colhidos "
"para conseguir madeira."

#. STRINGS.CREATURES.SPECIES.WOOD_TREE.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.WOOD_TREE.DOMESTICATEDDESC"
msgid ""
"This plant produces <link=\"FORESTTREE\">Arbor Tree Branches</link> that can be harvested for "
"<link=\"WOOD\">Wood</link>."
msgstr ""
"Esta planta produz <link=\"FORESTTREE\">Galhos de Árvore Arbórea</link> que podem ser colhidos para "
"conseguir madeira."

#. STRINGS.CREATURES.SPECIES.WOOD_TREE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.WOOD_TREE.NAME"
