#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.DESC"
msgid "Because breathing underwater is better than... not."
msgstr "Porque respirar debaixo d'água é melhor que... não respirar."

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.EFFECT
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.EFFECT"
msgid ""
"Supplies Duplicants with <style=\"oxygen\">Oxygen</style> in underwater environments.\n"
"\n"
"Must be refilled with <link=\"OXYGEN\">Oxygen</link> at an <link=\"SUITLOCKER\">Atmo Suit Dock</"
"link> when depleted."
msgstr ""
"Fornece <style=\"oxygen\">Oxigênio</style> aos Duplicantes em ambientes aquáticos.\n"
"\n"
"Precisa ser recarregado com <link=\"OXYGEN\">Oxigênio</link> em uma <link=\"SUITLOCKER\">Estação de "
"Atmo-Traje</link> quando esvaziado."

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.NAME"
msgid "<link=\"AQUASUIT\">Aqua Suit</link>"
msgstr "<link=\"AQUASUIT\">Aqua-Traje</link>"

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.RECIPE_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.RECIPE_DESC"
msgid "Supplies Duplicants with <style=\"oxygen\">Oxygen</style> in underwater environments."
msgstr "Fornece <style=\"oxygen\">Oxigênio</style> aos Duplicantes em ambiente aquáticos."

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.WORN_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.WORN_DESC"
msgid ""
"A worn out <link=\"AQUASUIT\">Aqua Suit</link>.\n"
"\n"
"Suits can be repaired at a <link=\"CRAFTINGTABLE\">Crafting Station</link>."
msgstr ""
"Um <link=\"AQUASUIT\">Aqua-Traje</link> desgastado .\n"
"\n"
"Trajes podem ser reparados em uma <link=\"CRAFTINGTABLE\">Mesa de Fabricação</link>."

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.WORN_NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.WORN_NAME"
msgid "<link=\"AQUASUIT\">Worn Lead Suit</link>"
msgstr "<link=\"AQUASUIT\">Traje de Chumbo Desgastado</link>"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.DESC"
msgid "Ensures my Duplicants can breathe easy, anytime, anywhere."
msgstr "Garante que meus Duplicantes respirarão facilmente em qualquer momento, em qualquer lugar."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.EFFECT
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.EFFECT"
msgid ""
"Supplies Duplicants with <link=\"OXYGEN\">Oxygen</link> in toxic and low breathability "
"environments, and protects against extreme temperatures.\n"
"\n"
"Must be refilled with oxygen at an <link=\"SUITLOCKER\">Atmo Suit Dock</link> when depleted."
msgstr ""
"Fornece aos Duplicantes <link=\"OXYGEN\">Oxigênio</link> em ambientes tóxicos e de baixa "
"respirabilidade, e protege contra temperaturas extremas.\n"
"\n"
"Deve ser reabastecido com oxigênio em uma <link=\"SUITLOCKER\">Estação de Atmo-Traje</link> quando "
"estiver esgotado."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.GENERICNAME
