msgid ""
"Director, this was sent to the general inbox.\n"
"\n"
"-----------------------------------------------------------------------------------------------------\n"
"<indent=35%>~ * ~</indent>\n"
"\n"
"<indent=12%>Col. Josephine Carnot & Dr. Alan Stern</indent>\n"
