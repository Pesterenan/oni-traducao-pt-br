#. STRINGS.CREATURES.SPECIES.VINEBRANCH.DESC
msgctxt "STRINGS.CREATURES.SPECIES.VINEBRANCH.DESC"
msgid ""
"Ovagro Vines are plants that produce edible <link=\"VINEFRUIT\">Ovagro Fig</link>.\n"
"\n"
"If a vine is cut off from its <link=\"VINEMOTHER\">Ovagro Node</link>, it will perish."
msgstr ""
"Vinhas de Figocaxi são plantas invasivas que produzem <link=\"VINEFRUIT\">Fruto de Figocaxi</link> "
"comestível.\n"
"\n"
"Se uma vinha for cortada de seu <link=\"VINEMOTHER\">Figocaxi</link>, ela perecerá."

#. STRINGS.CREATURES.SPECIES.VINEBRANCH.NAME
msgctxt "STRINGS.CREATURES.SPECIES.VINEBRANCH.NAME"
msgid "<link=\"VINEMOTHER\">Ovagro Vine</link>"
msgstr "<link=\"VINEMOTHER\">Vinha de Figocaxi</link>"

#. STRINGS.CREATURES.SPECIES.VINEMOTHER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.VINEMOTHER.DESC"
msgid ""
"Ovagro Nodes are trellis plants that spread onto nearby available surfaces.\n"
"\n"
"A single <link=\"VINEMOTHER\">Ovagro Node</link> can support several <link=\"VINEMOTHER\">Ovagro "
"Vines</link> without any increase in its <link=\"WATER\">Water</link> requirements."
msgstr ""
"Figocaxis são plantas trepadeiras que se espalham em superfícies próximas disponíveis.\n"
"\n"
"Um único <link=\"VINEMOTHER\">Figocaxi</link> pode suportar várias <link=\"VINEBRANCH\">Vinhas de "
"Figocaxi</link> sem qualquer aumento em seu requerimento de <link=\"WATER\">Água</link>."

#. STRINGS.CREATURES.SPECIES.VINEMOTHER.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.VINEMOTHER.DOMESTICATEDDESC"
msgid "This plant produces <link=\"VINEFRUIT\">Ovagro Fig</link>."
msgstr "Essa planta produz <link=\"VINEFRUIT\">Fruto de Figocaxi</link>."

#. STRINGS.CREATURES.SPECIES.VINEMOTHER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.VINEMOTHER.NAME"
msgid "<link=\"VINEMOTHER\">Ovagro Node</link>"
msgstr "<link=\"VINEMOTHER\">Figocaxi</link>"

