msgstr "<link=\"FORESTTREE\">Árvore Arbórea</link>"

#. STRINGS.CREATURES.SPECIES.WOOD_TREE_BRANCH.DESC
msgctxt "STRINGS.CREATURES.SPECIES.WOOD_TREE_BRANCH.DESC"
msgid "Arbor Trees Branches can be harvested for <link=\"WOOD\">Wood</link>."
msgstr "Galhos de Árvores Arbóreas podem ser colhidos para <link=\"WOOD\">Madeira</link>."

#. STRINGS.CREATURES.SPECIES.WOOD_TREE_BRANCH.NAME
msgctxt "STRINGS.CREATURES.SPECIES.WOOD_TREE_BRANCH.NAME"
msgid "<link=\"FORESTTREE\">Arbor Tree Branch</link>"
msgstr "<link=\"FORESTTREE\">Galho de Árvore Arbórea</link>"

#. STRINGS.CREATURES.SPECIES.WOODDEER.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.WOODDEER.BABY.DESC"
msgid ""
"A little yipping Flox Fawn.\n"
"\n"
"In time it will mature into a fully grown <link=\"WOODDEER\">Flox</link>."
msgstr ""
"Uma pequena Raposinha.\n"
"\n"
"Com o tempo, ela amadurecerá e se tornará uma <link=\"WOODDEER\">Raposa das Neves</link> totalmente "
"crescida."

#. STRINGS.CREATURES.SPECIES.WOODDEER.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.WOODDEER.BABY.NAME"
msgid "<link=\"WOODDEER\">Flox Fawn</link>"
msgstr "<link=\"WOODDEER\">Raposinha</link>"

#. STRINGS.CREATURES.SPECIES.WOODDEER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.WOODDEER.DESC"
msgid ""
"Floxes are nonhostile critters that graze on <link=\"PRICKLEFLOWER\">Bristle Blossoms</link> and "
"<link=\"HARDSKINBERRY\">Pikeapples</link>.\n"
"\n"
"When Flox antlers are fully grown, they harden into shearable <link=\"WOOD\">Wood</link>."
msgstr ""
"Raposa das Neves são criaturas não hostis que pastam em <link=\"PRICKLEFLOWER\">Espinhorosas</link> "
"e <link=\"HARDSKINBERRY\">Rambutão</link>.\n"
"\n"
"Quando os chifres da Raposa estão totalmente crescidos, eles endurecem e se transformam em "
"<link=\"WOOD\">Madeira</link>."

#. STRINGS.CREATURES.SPECIES.WOODDEER.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.WOODDEER.EGG_NAME"
msgid "<link=\"WOODDEER\">Flox Egg</link>"
msgstr "<link=\"WOODDEER\">Ovo de Raposa das Neves</link>"

#. STRINGS.CREATURES.SPECIES.WOODDEER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.WOODDEER.NAME"
msgid "<link=\"WOODDEER\">Flox</link>"
msgstr "<link=\"WOODDEER\">Raposa das Neves</link>"

#. STRINGS.CREATURES.SPECIES.WORMPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.WORMPLANT.DESC"
msgid ""
"Spindly Grubfruit Plants produce <link=\"WORMBASICFRUIT\">Spindly Grubfruit</link> for "
"<link=\"FOOD\">Food</link>.\n"
"\n"
"If it is tended by a <link=\"DIVERGENTSPECIES\">Divergent</link> critter, it will produce high "
"quality fruits instead."
msgstr ""
"Pés de Larvofruta Magrela produzem <link=\"WORMBASICFRUIT\">Larvofruta Magrela</link> como "
"<link=\"FOOD\">Alimento</link>.\n"
"\n"
"Se for cuidada por uma criatura <link=\"DIVERGENTSPECIES\">Divergente</link>, ela produzirá frutos "
"de alta qualidade."

#. STRINGS.CREATURES.SPECIES.WORMPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.WORMPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"WORMBASICFRUIT\">Spindly Grubfruit</link>."
msgstr "Esta planta produz <link=\"WORMBASICFRUIT\">Larvofruta Magrela</link>."

#. STRINGS.CREATURES.SPECIES.WORMPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.WORMPLANT.NAME"
msgid "<link=\"WORMPLANT\">Spindly Grubfruit Plant</link>"
msgstr "<link=\"WORMPLANT\">Pé de Larvofruta Magrela</link>"

