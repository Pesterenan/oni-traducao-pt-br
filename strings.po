#. STRINGS.CREATURES.SPECIES.MOLE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.DESC"
msgid ""
"Shove Voles are burrowing critters that eat the <link=\"REGOLITH\">Regolith</link> collected on "
"terrestrial surfaces.\n"
"\n"
"They cannot burrow through <link=\"REFINEDMETAL\">Refined Metals</link>."
msgstr ""
"Ratoupeiras são criaturas escavadoras que comem <link=\"REGOLITH\">Regolito</link> acumulado nas "
"superfícies terrestres.\n"
"\n"
"Elas não conseguem atravessar <link=\"REFINEDMETAL\">Metais Refinados</link>."

#. STRINGS.CREATURES.SPECIES.MOLE.EGG_NAME
