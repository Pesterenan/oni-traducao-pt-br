msgid ""
"Pincha Pepperplants produce flavorful <link=\"SPICENUT\">Pincha Peppernut</link> for spicing "
"<link=\"FOOD\">Food</link>."
msgstr ""
"Pimenteiras Pokinde produzem as saborosas <link=\"SPICENUT\">Pimentas Pokinde</link> para temperar "
"<link=\"FOOD\">Alimentos</link>."

