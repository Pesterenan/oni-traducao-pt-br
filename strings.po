msgid ""
"(H) Solid Hydrogen is the universe's most common element in a <link=\"ELEMENTSSOLID\">Solid</link> "
"state."
msgstr ""
"(H) Hidrogênio Sólido é o elemento mais comum do universo no estado <link=\"ELEMENTSSOLID\">Sólido</"
"link>."

#. STRINGS.ELEMENTS.SOLIDHYDROGEN.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDHYDROGEN.NAME"
