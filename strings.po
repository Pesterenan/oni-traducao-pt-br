#. STRINGS.BUILDINGS.PREFABS.DOCTORSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DOCTORSTATION.DESC"
msgid "Sick bays can be placed in hospital rooms to decrease the likelihood of disease spreading."
msgstr ""
"Enfermarias podem ser colocadas em quartos hospitalares para diminuir o alastramento de doenças."

#. STRINGS.BUILDINGS.PREFABS.DOCTORSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DOCTORSTATION.EFFECT"
msgid ""
"Allows Duplicants to administer basic treatments to sick Duplicants.\n"
"\n"
"Duplicants must possess the Bedside Manner <link=\"ROLES\">Skill</link> to treat peers."
msgstr ""
"Permite que Duplicantes administrem tratamentos básicos aos Duplicantes doentes.\n"
"\n"
"Duplicantes precisam possuir a <link=\"ROLES\">Habilidade</link> Jeitinho com Pacientes para cuidar "
"de seus amigos."

#. STRINGS.BUILDINGS.PREFABS.DOCTORSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DOCTORSTATION.NAME"
msgid "<link=\"DOCTORSTATION\">Sick Bay</link>"
msgstr "<link=\"DOCTORSTATION\">Enfermaria</link>"

#. STRINGS.BUILDINGS.PREFABS.DOOR.ABOVE
msgctxt "STRINGS.BUILDINGS.PREFABS.DOOR.ABOVE"
msgid "above"
msgstr "acima"

#. STRINGS.BUILDINGS.PREFABS.DOOR.BELOW
