#. STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.PARTY.DESCRIPTION
msgctxt "STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.PARTY.DESCRIPTION"
msgid ""
"THIS EVENT IS NOT WORKING\n"
"{host} is throwing a birthday party for {dupe}. Make sure there is an available Recreation Room for "
"the party.\n"
"\n"
"Social events are good for Duplicant morale. Rejecting this party will hurt {host} and {dupe}'s "
"fragile ego."
msgstr ""
"ESTE EVENTO NÃO ESTÁ FUNCIONANDO\n"
"{host} está dando uma festa de aniversário para {dupe}. Certifique-se de que existe uma Sala de "
"Recreação para a festa.\n"
"\n"
"Eventos sociais são bons para o moral dos Duplicantes. Rejeitar esta festa machucará o ego frágil "
"de {host} e {dupe}."

#. STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.PARTY.NAME
msgctxt "STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.PARTY.NAME"
msgid "Party"
msgstr "Festa"

