#. STRINGS.BUILDINGS.PREFABS.MORBROVERMAKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MORBROVERMAKER.DESC"
msgid "Allows a skilled Duplicant to manufacture a steady supply of icky yet effective bots."
msgstr ""
"Permite que um Duplicante habilidoso fabrique um suprimento constante de robôs nojentos, porém "
"eficazes."

#. STRINGS.BUILDINGS.PREFABS.MORBROVERMAKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MORBROVERMAKER.EFFECT"
msgid ""
"Uses <link=\"ZOMBIESPORES\">Zombie Spores</link> and <link=\"STEEL\">Steel</link> to craft "
"biofueled machines that can be sent into hostile environments.\n"
"\n"
"Defunct <link=\"STORYTRAITMORBROVER\">Biobots</link> drop harvestable <link=\"STEEL\">Steel</link>."
msgstr ""
"Usa <link=\"ZOMBIESPORES\">Esporos Zumbi</link> e <link=\"STEEL\">Aço</link> para fabricar máquinas "
"movidas a biocombustível que podem ser enviadas para ambientes hostis.\n"
"\n"
"<link=\"STORYTRAITMORBROVER\">Bio-bôs</link> extintos deixam cair <link=\"STEEL\">Aço</link> "
"coletável."

#. STRINGS.BUILDINGS.PREFABS.MORBROVERMAKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MORBROVERMAKER.NAME"
msgid "<link=\"STORYTRAITMORBROVER\">Biobot Builder</link>"
msgstr "<link=\"STORYTRAITMORBROVER\">Construtor de Bio-bôs</link>"

#. STRINGS.BUILDINGS.PREFABS.MOULDINGTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MOULDINGTILE.DESC"
msgid "Trimming is used as purely decorative lining for walls and structures."
msgstr "Blocos de Acabamento são usados puramente para fazer acabamentos de paredes e estruturas."

#. STRINGS.BUILDINGS.PREFABS.MOULDINGTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MOULDINGTILE.EFFECT"
msgid ""
"Used to build the walls and floors of rooms.\n"
"\n"
"Increases <link=\"DECOR\">Decor</link>, contributing to <link=\"MORALE\">Morale</link>."
msgstr ""
"Usado para construir paredes e pisos de salas.\n"
"\n"
"Aumenta a <link=\"DECOR\">Decoração</link>, contribuindo para o <link=\"MORALE\">Moral</link>."

#. STRINGS.BUILDINGS.PREFABS.MOULDINGTILE.NAME
