msgid "Age"
msgstr "Idade"

#. STRINGS.CREATURES.STATS.AGE.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.AGE.TOOLTIP"
msgid ""
"This critter will die when its <style=\"KKeyword\">Age</style> reaches its species' maximum lifespan"
msgstr ""
