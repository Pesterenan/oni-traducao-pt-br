#| msgid ""
#| "(Au) Gold Gas is a conductive precious <link=\"RAWMETAL\">Metal</link>, heated into a "
#| "<link=\"ELEMENTSGAS\">Gaseous</link> state."
msgctxt "STRINGS.ELEMENTS.GOLDGAS.DESC"
msgid ""
"(Au) Gold Gas is a conductive precious <link=\"REFINEDMETAL\">Metal</link>, heated into a "
"<link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr ""

#. STRINGS.ELEMENTS.GOLDGAS.NAME
msgctxt "STRINGS.ELEMENTS.GOLDGAS.NAME"
