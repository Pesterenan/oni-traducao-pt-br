#. STRINGS.ELEMENTS.SULFUR.DESC
msgctxt "STRINGS.ELEMENTS.SULFUR.DESC"
msgid ""
"(S) Sulfur is a common chemical element and byproduct of <link=\"METHANE\">Natural Gas</link> "
"production.\n"
"\n"
"This selection is in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr ""
"(S) O Enxofre é um elemento químico comum e subproduto da produção de <link=\"METHANE\">Gás "
"Natural</link>.\n"
"\n"
"Esta seleção está em estado <link=\"ELEMENTSSOLID\">Sólido</link>."

#. STRINGS.ELEMENTS.SULFUR.NAME
msgctxt "STRINGS.ELEMENTS.SULFUR.NAME"
msgid "<link=\"SULFUR\">Sulfur</link>"
msgstr "<link=\"SULFUR\">Enxofre</link>"

#. STRINGS.ELEMENTS.SULFURGAS.DESC
msgctxt "STRINGS.ELEMENTS.SULFURGAS.DESC"
msgid ""
"(S) Sulfur is a common chemical element and byproduct of <link=\"METHANE\">Natural Gas</link> "
"production.\n"
"\n"
"This selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr ""
"(S) Enxofre é um elemento químico comum e é um subproduto na produção de <link=\"METHANE\">Gás "
"Natural</link>.\n"
"\n"
"Esta seleção está no estado<link=\"ELEMENTSGAS\">Gasoso</link>."

#. STRINGS.ELEMENTS.SULFURGAS.NAME
msgctxt "STRINGS.ELEMENTS.SULFURGAS.NAME"
msgid "<link=\"SULFURGAS\">Sulfur Gas</link>"
msgstr "<link=\"SULFURGAS\">Gás de Enxofre</link>"

#. STRINGS.ELEMENTS.SUPERCOOLANT.DESC
msgctxt "STRINGS.ELEMENTS.SUPERCOOLANT.DESC"
msgid ""
"Super Coolant is an industrial-grade coolant that utilizes the unusual energy states of "
"<link=\"FULLERENE\">Fullerene</link>.\n"
"\n"
"This selection is in a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr ""
"Super Refrigerante é um fluído de refrigeração de nível industrial que utiliza os estados de "
"energia incomuns do <link=\"FULLERENE\">Fulereno</link>.\n"
"\n"
"Esta seleção está no estado <link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.SUPERCOOLANT.NAME
msgctxt "STRINGS.ELEMENTS.SUPERCOOLANT.NAME"
msgid "<link=\"SUPERCOOLANT\">Super Coolant</link>"
msgstr "<link=\"SUPERCOOLANT\">Super Refrigerante</link>"

#. STRINGS.ELEMENTS.SUPERCOOLANTGAS.DESC
msgctxt "STRINGS.ELEMENTS.SUPERCOOLANTGAS.DESC"
msgid ""
"Super Coolant is an industrial-grade <link=\"FULLERENE\">Fullerene</link> coolant.\n"
"\n"
"This selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr ""
"Super Refrigerante é um fluído de refrigeração de nível industrial feito com "
"<link=\"FULLERENE\">Fulereno</link>.\n"
"\n"
"Esta seleção está no estado <link=\"ELEMENTSGAS\">Estado Gasoso</link>."

#. STRINGS.ELEMENTS.SUPERCOOLANTGAS.NAME
msgctxt "STRINGS.ELEMENTS.SUPERCOOLANTGAS.NAME"
msgid "<link=\"SUPERCOOLANTGAS\">Super Coolant Gas</link>"
msgstr "<link=\"SUPERCOOLANTGAS\">Super Refrigerante Gasoso</link>"

#. STRINGS.ELEMENTS.SUPERINSULATOR.DESC
msgctxt "STRINGS.ELEMENTS.SUPERINSULATOR.DESC"
msgid ""
"Insulite reduces <link=\"HEAT\">Heat Transfer</link> and is composed of recrystallized "
"<link=\"KATAIRITE\">Abyssalite</link>."
msgstr ""
"Isolito reduz a <link=\"HEAT\">Transferência de Calor</link>e é composto de "
"<link=\"KATAIRITE\">Abissalito</link> recristalizado."

#. STRINGS.ELEMENTS.SUPERINSULATOR.NAME
msgctxt "STRINGS.ELEMENTS.SUPERINSULATOR.NAME"
msgid "<link=\"SUPERINSULATOR\">Insulite</link>"
msgstr "<link=\"SUPERINSULATOR\">Isolito</link>"

#. STRINGS.ELEMENTS.SYNGAS.DESC
msgctxt "STRINGS.ELEMENTS.SYNGAS.DESC"
msgid ""
"Synthesis Gas is an artificial, unbreathable <link=\"ELEMENTSGAS\">Gas</link>.\n"
"\n"
"It can be converted into an efficient fuel."
msgstr ""
"Gás Sintético é um <link=\"ELEMENTSGAS\">Gás</link> artificial e irrespirável.\n"
"\n"
"Pode ser transformado em um combustível eficiente."

#. STRINGS.ELEMENTS.SYNGAS.NAME
msgctxt "STRINGS.ELEMENTS.SYNGAS.NAME"
msgid "<link=\"SYNGAS\">Synthesis Gas</link>"
msgstr "<link=\"SYNGAS\">Gás Sintético</link>"

#. STRINGS.ELEMENTS.TALLOW.DESC
msgctxt "STRINGS.ELEMENTS.TALLOW.DESC"
msgid ""
"A chunk of raw grease that can be used in <link=\"FOOD\">Food</link> production or industrial "
"processes."
msgstr ""
"Um pedaço de gordura cru que pode ser usado na preparação de <link=\"FOOD\">Alimentos</link> ou em "
"processos industriais."

#. STRINGS.ELEMENTS.TALLOW.NAME
msgctxt "STRINGS.ELEMENTS.TALLOW.NAME"
msgid "<link=\"TALLOW\">Tallow</link>"
msgstr "<link=\"TALLOW\">Sebo</link>"

#. STRINGS.ELEMENTS.TEMPCONDUCTORSOLID.DESC
msgctxt "STRINGS.ELEMENTS.TEMPCONDUCTORSOLID.DESC"
msgid ""
"Thermium is an industrial metal alloy formulated to maximize <link=\"HEAT\">Heat Transfer</link> "
"and thermal dispersion."
msgstr ""
"Termion é uma liga metálica industrial formulada para maximizar a <link=\"HEAT\">Transferência de "
"Calor</link> e a dispersão térmica."

#. STRINGS.ELEMENTS.TEMPCONDUCTORSOLID.NAME
msgctxt "STRINGS.ELEMENTS.TEMPCONDUCTORSOLID.NAME"
msgid "<link=\"TEMPCONDUCTORSOLID\">Thermium</link>"
msgstr "<link=\"TEMPCONDUCTORSOLID\">Termion</link>"

#. STRINGS.ELEMENTS.TESTELEMENT.DESC
msgctxt "STRINGS.ELEMENTS.TESTELEMENT.DESC"
msgid ""
"((Fe,Mn)WO<sub>4</sub>) Wolframite is a dense Metallic element in a <link=\"ELEMENTSSOLID\">Solid</"
"link> state.\n"
"\n"
"It is a source of <link=\"TUNGSTEN\">Tungsten</link> and is suitable for building "
"<link=\"POWER\">Power</link> systems."
msgstr ""
"((Fe,Mn)WO<sub>4</sub>) Volframita é um elemento denso e Metálico no estado "
"<link=\"ELEMENTSSOLID\">Sólido</link>.\n"
"\n"
"É uma fonte de <link=\"TUNGSTEN\">Tungstênio</link> e é indicado para a construção de circuitos de "
"<link=\"POWER\">Energia</link>."

#. STRINGS.ELEMENTS.TESTELEMENT.NAME
msgctxt "STRINGS.ELEMENTS.TESTELEMENT.NAME"
msgid "<link=\"TESTELEMENT\">Test Element</link>"
msgstr "<link=\"TESTELEMENT\">Elemento Teste</link>"

#. STRINGS.ELEMENTS.THERMALPROPERTIES
msgctxt "STRINGS.ELEMENTS.THERMALPROPERTIES"
msgid ""
"\n"
"Specific Heat Capacity: {SPECIFIC_HEAT_CAPACITY}\n"
"Thermal Conductivity: {THERMAL_CONDUCTIVITY}"
msgstr ""
"\n"
"Calor Específico: {SPECIFIC_HEAT_CAPACITY}\n"
"Condutividade Térmica: {THERMAL_CONDUCTIVITY}"

#. STRINGS.ELEMENTS.TOXICMUD.DESC
msgctxt "STRINGS.ELEMENTS.TOXICMUD.DESC"
msgid ""
"A mixture of <link=\"TOXICSAND\">Polluted Dirt</link> and <link=\"DIRTYWATER\">Polluted Water</"
"link>.\n"
"\n"
"Can be separated into its base elements using a <link=\"SLUDGEPRESS\">Sludge Press</link>."
msgstr ""
"Uma mistura de <link=\"TOXICSAND\">Terra Poluída</link> e <link=\"DIRTYWATER\">Água Poluída</"
"link>.\n"
"\n"
"Pode ser separado em seus elementos base utilizando uma <link=\"SLUDGEPRESS\">Prensa de Lodo</link>."

#. STRINGS.ELEMENTS.TOXICMUD.NAME
msgctxt "STRINGS.ELEMENTS.TOXICMUD.NAME"
msgid "<link=\"TOXICMUD\">Polluted Mud</link>"
msgstr "<link=\"TOXICMUD\">Lama Poluída</link>"

#. STRINGS.ELEMENTS.TOXICSAND.DESC
msgctxt "STRINGS.ELEMENTS.TOXICSAND.DESC"
msgid ""
"Polluted Dirt is unprocessed biological waste.\n"
"\n"
"It emits <link=\"CONTAMINATEDOXYGEN\">Polluted Oxygen</link> over time."
msgstr ""
"Terra Poluída é um resíduo biológico não processado.\n"
"\n"
"Emite <link=\"CONTAMINATEDOXYGEN\">Oxigênio Poluído</link> com o tempo."

#. STRINGS.ELEMENTS.TOXICSAND.NAME
msgctxt "STRINGS.ELEMENTS.TOXICSAND.NAME"
msgid "<link=\"TOXICSAND\">Polluted Dirt</link>"
msgstr "<link=\"TOXICSAND\">Terra Poluída</link>"

