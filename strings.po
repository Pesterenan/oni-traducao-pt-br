msgstr "Criaturas Terrestres"

#. STRINGS.CREATURES.SPECIES.CYLINDRICA.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CYLINDRICA.DESC"
msgid ""
"Bliss Bursts release an explosion of <link=\"DECOR\">Decor</link> into otherwise dull environments."
msgstr ""
"Explosões de Euforia liberam uma explosão de <link=\"DECOR\">Decoração</link> em um ambiente antes "
"desanimador."

#. STRINGS.CREATURES.SPECIES.CYLINDRICA.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.CYLINDRICA.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "Esta planta melhora a <link=\"DECOR\">Decoração</link> do ambiente."

#. STRINGS.CREATURES.SPECIES.CYLINDRICA.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.CYLINDRICA.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "Bônus de Crescimento"

#. STRINGS.CREATURES.SPECIES.CYLINDRICA.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CYLINDRICA.NAME"
msgid "<link=\"CYLINDRICA\">Bliss Burst</link>"
msgstr "<link=\"CYLINDRICA\">Explosão de Euforia</link>"

#. STRINGS.CREATURES.SPECIES.CYLINDRICA.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.CYLINDRICA.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "Penalidade por Murchar"

#. STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.DESC"
msgid ""
"Dew Drippers produce <link=\"DEWDRIP\">Dewdrips</link> that can be crushed into "
"<link=\"MILK\">Brackene</link>."
msgstr ""
"Pingorvalhos produzem <link=\"DEWDRIP\">Gotas d'Orvalho</link> que podem ser trituradas em "
"<link=\"MILK\">Leite Muu</link> vegetal."

#. STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.DOMESTICATEDDESC"
msgid "This plant produces <link=\"MILK\">Brackene</link>."
msgstr "Essa planta produz <link=\"MILK\">Leite Muu</link> vegetal."

#. STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.NAME"
msgid "<link=\"DEWDRIPPERPLANT\">Dew Dripper</link>"
msgstr "<link=\"DEWDRIPPERPLANT\">Pingorvalho</link>"

#. STRINGS.CREATURES.SPECIES.DEWPALM.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DEWPALM.DESC"
msgid ""
"Gum Palms can be harvested for <link=\"PALMWOOD\">Gum Wood</link>, which can be processed into "
"<link=\"LATEX\">Latex</link> at the <link=\"MILKPRESS\">Plant Pulverizer</link>.\n"
"\n"
"Due to their size, they can only be planted in a <link=\"WIDEFARMTILE\">Wide Hydroponic Farm</link>."
msgstr ""

#. STRINGS.CREATURES.SPECIES.DEWPALM.DOMESTICATEDDESC
#| msgctxt "STRINGS.CREATURES.SPECIES.KELPPLANT.DOMESTICATEDDESC"
#| msgid "This plant produces <link=\"KELP\">Seakomb Leaf</link>."
msgctxt "STRINGS.CREATURES.SPECIES.DEWPALM.DOMESTICATEDDESC"
msgid "This plant produces <link=\"PALMWOOD\">Gum Wood</link>."
msgstr ""

#. STRINGS.CREATURES.SPECIES.DEWPALM.NAME
#| msgctxt "STRINGS.UI.CODEX.CATEGORYNAMES.EMAILS"
#| msgid "<link=\"EMAILS\">E-mail</link>"
msgctxt "STRINGS.CREATURES.SPECIES.DEWPALM.NAME"
msgid "<link=\"DEWPALM\">Gum Palm</link>"
msgstr ""

#. STRINGS.CREATURES.SPECIES.DIESELMOO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIESELMOO.DESC"
msgid ""
"Husky Moos are extraterrestrial critters that feed on <link=\"PLANTFIBER\">Plant Husk</link> and "
"<link=\"GASGRASS\">Gas Grass</link>, and excrete <link=\"CARBONDIOXIDE\">Carbon Dioxide</link>.\n"
"\n"
"When domesticated and fed, they can be milked for <link=\"REFINEDLIPID\">Biodiesel</link>."
msgstr ""
"Muus Cascosas são criaturas extraterrestres que se alimentam de <link=\"PLANTFIBER\">Cascas de "
"Plantas</link> e <link=\"GASGRASS\">Grama Gasosa</link>, e excretam <link=\"CARBONDIOXIDE\">Dióxido "
"de Carbono</link>.\n"
"\n"
"Quando domesticadas e alimentadas, eles podem ser ordenhadas para se obter "
"<link=\"REFINEDLIPID\">Biodiesel</link>."

#. STRINGS.CREATURES.SPECIES.DIESELMOO.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIESELMOO.NAME"
msgid "<link=\"DIESELMOO\">Husky Moo</link>"
msgstr "<link=\"DIESELMOO\">Muu Cascosa</link>"

#. STRINGS.CREATURES.SPECIES.DINOFERN.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DINOFERN.DESC"
msgid ""
"Megafronds produce <link=\"FERNFOOD\">Megafrond Grain</link>, an ancient grain that can be "
"processed into <link=\"FOOD\">Food</link>."
msgstr ""
"Megafrondosas produzem <link=\"FERNFOOD\">Grão de Megafrondosa</link>, um antigo grão que pode ser "
"processado em <link=\"FOOD\">Alimento</link>."

#. STRINGS.CREATURES.SPECIES.DINOFERN.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.DINOFERN.DOMESTICATEDDESC"
msgid "This plant produces <link=\"FERNFOOD\">Megafrond Grain</link>."
msgstr "Esta planta produz <link=\"FERNFOOD\">Grão de Megafrondosa</link>."

#. STRINGS.CREATURES.SPECIES.DINOFERN.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DINOFERN.NAME"
msgid "<link=\"DINOFERN\">Megafrond</link>"
msgstr "<link=\"DINOFERN\">Megafrondosa</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.BABY.DESC"
msgid ""
"A crawly little Sweetle Larva.\n"
"\n"
"In time, it will mature into an adult <link=\"DIVERGENTBEETLE\">Sweetle</link>."
msgstr ""
"Uma pequena e rastejante Larva de Doçouro.\n"
"\n"
"Com o tempo, ele vai formar um <link=\"DIVERGENTBEETLE\">Doçouro</link> adulto."

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.BABY.NAME"
msgid "<link=\"DIVERGENTBEETLE\">Sweetle Larva</link>"
msgstr "<link=\"DIVERGENTBEETLE\">Larva de Doçouro</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.DESC"
msgid ""
"Sweetles are nonhostile critters that excrete large amounts of <link=\"SUCROSE\">Sucrose</link>.\n"
"\n"
"They are closely related to the <link=\"DIVERGENTWORM\">Grubgrub</link> and exhibit similar, albeit "
"less effective farming behaviors."
msgstr ""
"Doçouros são criaturas não hostis que excretam grandes quantidades de <link=\"SUCROSE\">Sacarose</"
"link>.\n"
"\n"
"Eles são parentes próximos da <link=\"DIVERGENTWORM\">Lavralarva</link> e exibem similares, porém "
"menos efetivos, comportamentos de agricultura."

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.EGG_NAME"
msgid "<link=\"DIVERGENTBEETLE\">Sweetle Egg</link>"
msgstr "<link=\"DIVERGENTBEETLE\">Ovo de Doçouro</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.NAME"
msgid "<link=\"DIVERGENTBEETLE\">Sweetle</link>"
msgstr "<link=\"DIVERGENTBEETLE\">Doçouro</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.BABY.DESC"
msgid ""
"A squirmy little Grubgrub Wormling.\n"
"\n"
"In time, it will mature into an adult <link=\"WORM\">Grubgrub</link> and drastically grow in size."
msgstr ""
"Uma pequena e inocente Filhote de Lavralarva.\n"
"\n"
"Com o tempo, ela vai formar uma <link=\"WORM\">Lavralarva</link> adulta e aumentar drasticamente de "
"tamanho."

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.BABY.NAME"
msgid "<link=\"DIVERGENTWORM\">Grubgrub Wormling</link>"
msgstr "<link=\"DIVERGENTWORM\">Filhote de Lavralarva</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.DESC"
msgid ""
"Grubgrubs form symbiotic relationships with plants, especially <link=\"WORMPLANT\">Grubfruit "
"Plants</link>, and instinctually tend to them.\n"
"\n"
"Grubgrubs are closely related to <link=\"DIVERGENTBEETLE\">Sweetles</link>."
msgstr ""
"Lavralarvas fazem relações simbióticas com as plantas, em especial com os <link=\"WORMPLANT\">Pés "
"de Larvofruta</link>, e cuidam instintivamente deles.\n"
"\n"
"Lavralarvas são parentes próximos dos <link=\"DIVERGENTBEETLE\">Doçouros</link>."

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.EGG_NAME"
msgid "<link=\"DIVERGENTWORM\">Grubgrub Egg</link>"
msgstr "<link=\"DIVERGENTWORM\">Ovo de Lavralarva</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.NAME"
msgid "<link=\"DIVERGENTWORM\">Grubgrub</link>"
msgstr "<link=\"DIVERGENTWORM\">Lavralarva</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.BABY.DESC"
msgid ""
"A little, bug-eyed Drecklet.\n"
"\n"
"In time it will mature into a fully grown <link=\"DRECKO\">Drecko</link>."
msgstr ""
"Um pequeno Lagartequinho de olhos esbugalhados.\n"
"\n"
"Com o tempo ele vai crescer formando um <link=\"DRECKO\">Lagarteco</link>."

#. STRINGS.CREATURES.SPECIES.DRECKO.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.BABY.NAME"
msgid "<link=\"DRECKO\">Drecklet</link>"
msgstr "<link=\"DRECKO\">Lagartequinho</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.DESC"
msgid ""
"Dreckos are nonhostile critters that graze on <link=\"SPICEVINE\">Pincha Pepperplants</link>, "
"<link=\"SWAMPLILY\">Balm Lily</link> or <link=\"BASICSINGLEHARVESTPLANT\">Mealwood Plants</link>.\n"
"\n"
"Their backsides are covered in thick woolly fibers that only grow in <link=\"HYDROGEN\">Hydrogen</"
"link> climates."
msgstr ""
"Lagartecos são criaturas não hostis que sobrevivem pastando em <link=\"SPICEVINE\">Pimenteiras "
"Pokinde</link>, <link=\"SWAMPLILY\">Lírios de Bálsamo</link> ou "
"<link=\"BASICSINGLEHARVESTPLANT\">Lárvores</link>.\n"
"\n"
"As suas costas são cobertas de fibras lanosas que só crescem em ambientes com "
"<link=\"HYDROGEN\">Hidrogênio</link>."

#. STRINGS.CREATURES.SPECIES.DRECKO.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.EGG_NAME"
msgid "<link=\"DRECKO\">Drecko Egg</link>"
msgstr "<link=\"DRECKO\">Ovo de Lagartequinho</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.NAME"
msgid "<link=\"DRECKO\">Drecko</link>"
msgstr "<link=\"DRECKO\">Lagarteco</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.BABY.DESC"
msgid ""
"A bug-eyed little Glossy Drecklet.\n"
"\n"
"In time it will mature into an adult Drecko morph, the <link=\"DRECKOPLASTIC\">Glossy Drecko</link>."
msgstr ""
"Um pequeno Lagartequinho Lustroso.\n"
"\n"
"Com o tempo ele vai crescer formando uma das raças de Lagarteco adulta, o "
"<link=\"DRECKOPLASTIC\">Lagarteco Lustroso</link>."

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.BABY.NAME"
msgid "<link=\"DRECKOPLASTIC\">Glossy Drecklet</link>"
msgstr "<link=\"DRECKOPLASTIC\">Lagartequinho Lustroso</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.DESC"
msgid ""
"Glossy Dreckos are nonhostile critters that graze on live "
"<link=\"BASICSINGLEHARVESTPLANT\">Mealwood Plants</link> and <link=\"PRICKLEFLOWER\">Bristle "
"Blossoms</link>.\n"
"\n"
"Their backsides are covered in bioplastic scales that only grow in <link=\"HYDROGEN\">Hydrogen Gas</"
"link> climates."
msgstr ""
"Lagartecos Lustrosos são criaturas que sobrevivem pastando em "
"<link=\"BASICSINGLEHARVESTPLANT\">Lárvores</link> e <link=\"PRICKLEFLOWER\">Espinhorosas</link>.\n"
"\n"
"As suas costas são cobertas de escamas de bioplástico que só crescem em ambientes com "
"<link=\"HYDROGEN\">Gás Hidrogênio</link>."

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.EGG_NAME"
msgid "<link=\"DRECKOPLASTIC\">Glossy Drecko Egg</link>"
msgstr "<link=\"DRECKOPLASTIC\">Ovo de Lagartequinho Lustroso</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.NAME"
msgid "<link=\"DRECKOPLASTIC\">Glossy Drecko</link>"
msgstr "<link=\"DRECKOPLASTIC\">Lagarteco Lustroso</link>"

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.DESC"
msgid ""
"Sporechids have an eerily alluring appearance to mask the fact that they host particularly nasty "
"strain of brain fungus."
msgstr ""
"Orquíesporos possuem uma aparência estranhamente atraente que mascaram o fato de que elas são "
"hospedeiras de uma espécie de fungo cerebral."

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.DOMESTICATEDDESC"
msgid ""
"This plant improves ambient <link=\"DECOR\">Decor</link> but produces high quantities of "
"<link=\"ZOMBIESPORES\">Zombie Spores</link>."
msgstr ""
"Esta planta melhora a <link=\"DECOR\">Decoração</link> mas também produz grandes quantidades "
"<link=\"ZOMBIESPORES\">Esporos Zumbi</link>."

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "Bônus de Crescimento"

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.NAME"
msgid "<link=\"EVILFLOWER\">Sporechid</link>"
msgstr "<link=\"EVILFLOWER\">Orquíesporo</link>"

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "Penalidade por Murchar"

