#. STRINGS.ELEMENTS.ENRICHEDURANIUM.DESC
msgctxt "STRINGS.ELEMENTS.ENRICHEDURANIUM.DESC"
msgid ""
"(U) Enriched Uranium is a refined substance primarily used to <link=\"POWER\">Power</link> potent "
"research reactors.\n"
"\n"
"It becomes highly <link=\"RADIATION\">Radioactive</link> when consumed."
msgstr ""
"(U) Urânio Enriquecido é uma substância refinada primariamente usada para gerar "
"<link=\"POWER\">Energia</link> em potentes reatores de pesquisa.\n"
"\n"
"Se torna altamente <link=\"RADIATION\">Radioativo</link> quando consumido."

#. STRINGS.ELEMENTS.ENRICHEDURANIUM.NAME
msgctxt "STRINGS.ELEMENTS.ENRICHEDURANIUM.NAME"
msgid "<link=\"ENRICHEDURANIUM\">Enriched Uranium</link>"
msgstr "<link=\"ENRICHEDURANIUM\">Urânio Enriquecido</link>"

#. STRINGS.ELEMENTS.ETHANOL.DESC
msgctxt "STRINGS.ELEMENTS.ETHANOL.DESC"
msgid ""
"(C<sub>2</sub>H<sub>6</sub>O) Ethanol is an advanced chemical compound in a "
"<link=\"ELEMENTSLIQUID\">Liquid</link> state.\n"
"\n"
"It can be used as a highly effective fuel source when burned."
msgstr ""
"(C<sub>2</sub>H<sub>6</sub>O) O Etanol é um composto químico avançado em estado "
"<link=\"ELEMENTSLIQUID\">Líquido</link>.\n"
"\n"
"Pode ser usado como fonte de combustível altamente eficaz quando queimado."

#. STRINGS.ELEMENTS.ETHANOL.NAME
msgctxt "STRINGS.ELEMENTS.ETHANOL.NAME"
msgid "<link=\"ETHANOL\">Ethanol</link>"
msgstr "<link=\"ETHANOL\">Etanol</link>"

#. STRINGS.ELEMENTS.ETHANOLGAS.DESC
msgctxt "STRINGS.ELEMENTS.ETHANOLGAS.DESC"
msgid ""
"(C<sub>2</sub>H<sub>6</sub>O) Ethanol Gas is an advanced chemical compound heated into a "
"<link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr ""
"(C<sub>2</sub>H<sub>6</sub>O) Etanol é um composto químico avançado aquecido ao estado "
"<link=\"ELEMENTSGAS\">Gasoso</link>."

#. STRINGS.ELEMENTS.ETHANOLGAS.NAME
msgctxt "STRINGS.ELEMENTS.ETHANOLGAS.NAME"
msgid "<link=\"ETHANOLGAS\">Ethanol Gas</link>"
msgstr "<link=\"ETHANOLGAS\">Etanol Gasoso</link>"

#. STRINGS.ELEMENTS.FABRICATEDWOOD.DESC
msgctxt "STRINGS.ELEMENTS.FABRICATEDWOOD.DESC"
msgid ""
"Plywood is a good source of <link=\"HEAT\">Heat</link> and <link=\"POWER\">Power</link>.\n"
"\n"
"Its insulation properties make it a useful <b>Construction Material</b>."
msgstr ""
"O Compensado é uma boa fonte de <link=\"HEAT\">Calor</link> e <link=\"POWER\">Energia</link>.\n"
"\n"
"Suas propriedades de isolamento o tornam um <b>Material de Construção</b> útil."

#. STRINGS.ELEMENTS.FABRICATEDWOOD.NAME
msgctxt "STRINGS.ELEMENTS.FABRICATEDWOOD.NAME"
msgid "<link=\"FABRICATEDWOOD\">Plywood</link>"
msgstr "<link=\"FABRICATEDWOOD\">Compensado</link>"

#. STRINGS.ELEMENTS.FALLOUT.DESC
msgctxt "STRINGS.ELEMENTS.FALLOUT.DESC"
msgid ""
"Nuclear Fallout is a highly toxic gas full of <link=\"RADIATION\">Radioactive Contaminants</link>. "
"Condenses into <link=\"NUCLEARWASTE\">Liquid Nuclear Waste</link>."
msgstr ""
"Precipitação Nuclear é um gás altamente tóxico feito de <link=\"RADIATION\">Contaminantes "
"Radioativos</link>. Condensa em <link=\"NUCLEARWASTE\">Lixo Radioativo</link>."

#. STRINGS.ELEMENTS.FALLOUT.NAME
msgctxt "STRINGS.ELEMENTS.FALLOUT.NAME"
msgid "<link=\"FALLOUT\">Nuclear Fallout</link>"
msgstr "<link=\"FALLOUT\">Precipitação Nuclear</link>"

#. STRINGS.ELEMENTS.FERTILIZER.DESC
msgctxt "STRINGS.ELEMENTS.FERTILIZER.DESC"
msgid ""
"Fertilizer is a processed mixture of biological nutrients.\n"
"\n"
"It aids in the growth of certain <link=\"PLANTS\">Plants</link>."
msgstr ""
"Fertilizante é uma mistura processada de nutrientes biológicos.\n"
"\n"
"Ajuda no crescimento de certas <link=\"PLANTS\">Plantas</link>."

#. STRINGS.ELEMENTS.FERTILIZER.NAME
msgctxt "STRINGS.ELEMENTS.FERTILIZER.NAME"
msgid "<link=\"FERTILIZER\">Fertilizer</link>"
msgstr "<link=\"FERTILIZER\">Fertilizante</link>"

#. STRINGS.ELEMENTS.FISHMILK.DESC
#| msgctxt "STRINGS.ELEMENTS.NATURALRESIN.DESC"
#| msgid ""
#| "Resin is a viscous organic <link=\"ELEMENTSLIQUID\">Liquid</link>.\n"
#| "\n"
#| "It can be treated to become <link=\"POLYPROPYLENE\">Plastic</link> in the "
#| "<link=\"POLYMERIZER\">Polymer Press</link>."
msgctxt "STRINGS.ELEMENTS.FISHMILK.DESC"
msgid ""
"Ovolene is a protein-rich <link=\"ELEMENTSLIQUID\">Liquid</link> produced by aquatic critters.\n"
"\n"
"It can be processed into <link=\"CAVIAR\">Caviar</link> and <link=\"MUCUS\">Mucin</link>."
msgstr ""

#. STRINGS.ELEMENTS.FISHMILK.NAME
#| msgctxt "STRINGS.ELEMENTS.MILK.NAME"
#| msgid "<link=\"MILK\">Brackene</link>"
msgctxt "STRINGS.ELEMENTS.FISHMILK.NAME"
msgid "<link=\"FISHMILK\">Ovolene</link>"
msgstr ""

#. STRINGS.ELEMENTS.FISHMILKICE.DESC
#| msgctxt "STRINGS.ELEMENTS.MILKICE.DESC"
#| msgid ""
#| "Frozen Brackene is <link=\"MILK\">Brackene</link> frozen into a <link=\"ELEMENTSSOLID\">Solid</"
#| "link> state."
