#. STRINGS.CREATURES.SPECIES.SEAHORSE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAHORSE.DESC"
msgid ""
"Seaquines are aquatic critters that live in liquid pools.\n"
"\n"
"They feed on <link=\"PEARL\">Pearl</link> and produce <link=\"FISHMILK\">Ovolene</link> at the "
"<link=\"UNDERWATERMILKINGSTATION\">Aquatic Milking Station</link>."
msgstr ""
"Maréguas são criaturas aquáticas que vivem em piscinas de líquidos.\n"
"\n"
"Elas se alimentam de <link=\"PEARL\">Pérolas</link> e produzem <link=\"FISHMILK\">Ovolene</link> na "
"<link=\"UNDERWATERMILKINGSTATION\">Estação de Ordenha Aquática</link>."

