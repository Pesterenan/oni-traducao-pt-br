msgid ""
"Mellow Mallows heighten <link=\"DECOR\">Decor</link> and alleviate <link=\"STRESS\">Stress</link> "
"with their calming color and cradle shape."
msgstr ""
"Malvas Mansas melhoram a <link=\"DECOR\">Decoração</link> e aliviam o <link=\"STRESS\">Estresse</"
"link> com sua cor calmante e formato em cuia."

#. STRINGS.CREATURES.SPECIES.WINECUPS.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.WINECUPS.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
