msgid "<link=\"SILTSTONE\">Siltstone</link>"
msgstr ""

#. STRINGS.ELEMENTS.SLABS.DESC
msgctxt "STRINGS.ELEMENTS.SLABS.DESC"
msgid "Slabs are a refined mineral building block used for assembling advanced buildings."
msgstr ""
"Lajes são blocos de construção de mineral refinado usados para montagem de estruturas avançadas."

#. STRINGS.ELEMENTS.SLABS.NAME
msgctxt "STRINGS.ELEMENTS.SLABS.NAME"
msgid "<link=\"SLABS\">Building Slab</link>"
msgstr "<link=\"SLABS\">Laje de Construção</link>"

#. STRINGS.ELEMENTS.SLIMEMOLD.DESC
msgctxt "STRINGS.ELEMENTS.SLIMEMOLD.DESC"
msgid ""
"Slime is a thick biomixture of algae, fungi, and mucopolysaccharides.\n"
"\n"
"It can be distilled into <link=\"ALGAE\">Algae</link> and emits "
"<link=\"CONTAMINATEDOXYGEN\">Polluted Oxygen</link> once dug up."
msgstr ""
"Limo é uma biomistura de algas, fungos e mucopolissacarídeos.\n"
"\n"
"Podem ser destiladas produzindo <link=\"ALGAE\">Algas</link> e emitem "
"<link=\"CONTAMINATEDOXYGEN\">Oxigênio Poluído</link> uma vez escavado."

#. STRINGS.ELEMENTS.SLIMEMOLD.NAME
msgctxt "STRINGS.ELEMENTS.SLIMEMOLD.NAME"
msgid "<link=\"SLIMEMOLD\">Slime</link>"
msgstr "<link=\"SLIMEMOLD\">Limo</link>"

#. STRINGS.ELEMENTS.SNOW.DESC
msgctxt "STRINGS.ELEMENTS.SNOW.DESC"
msgid ""
"(H<sub>2</sub>O) Snow is a mass of loose, crystalline ice particles.\n"
"\n"
"It becomes <link=\"WATER\">Water</link> when melted."
msgstr ""
"(H<sub>2</sub>0) Neve é uma massa de partículas cristalinas de gelo.\n"
"\n"
"Torna-se <link=\"WATER\">Água</link> quando derretida."

#. STRINGS.ELEMENTS.SNOW.NAME
msgctxt "STRINGS.ELEMENTS.SNOW.NAME"
msgid "<link=\"SNOW\">Snow</link>"
msgstr "<link=\"SNOW\">Neve</link>"

#. STRINGS.ELEMENTS.SOLIDCARBONDIOXIDE.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDCARBONDIOXIDE.DESC"
msgid ""
"(CO<sub>2</sub>) Carbon Dioxide is an unbreathable compound in a <link=\"ELEMENTSSOLID\">Solid</"
"link> state."
msgstr ""
"(CO<sub>2</sub>) Dióxido de Carbono é um composto irrespirável no estado "
"<link=\"ELEMENTSSOLID\">Sólido</link>."

