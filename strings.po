msgid "<link=\"SOLIDSUPERCOOLANT\">Solid Super Coolant</link>"
msgstr "<link=\"SOLIDSUPERCOOLANT\">Super Refrigerante Sólido</link>"

#. STRINGS.ELEMENTS.SOLIDSYNGAS.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDSYNGAS.DESC"
msgid ""
"Solid Synthesis Gas is an artificial, unbreathable <link=\"ELEMENTSSOLID\">Solid</link>.\n"
"\n"
"It can be converted into an efficient fuel."
msgstr ""
"Gás Sintético Sólido é um <link=\"ELEMENTSSOLID\">Sólido</link> artificial e irrespirável.\n"
"\n"
"Pode ser transformado em um combustível eficiente."

#. STRINGS.ELEMENTS.SOLIDSYNGAS.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDSYNGAS.NAME"
msgid "<link=\"SYNGAS\">Solid Synthesis Gas</link>"
msgstr "<link=\"SYNGAS\">Gás Sintético Sólido</link>"

#. STRINGS.ELEMENTS.SOLIDVISCOGEL.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDVISCOGEL.DESC"
msgid ""
"Visco-Gel is a polymer that has high surface tension when in <link=\"ELEMENTSLIQUID\">Liquid</link> "
"form.\n"
"\n"
"This selection is in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr ""
"Visco-Gel é um polímero que tem alta tensão superficial quando está na forma "
"<link=\"ELEMENTSLIQUID\">Líquida</link>.\n"
"\n"
"Esta seleção está no estado <link=\"ELEMENTSSOLID\">Sólido</link>."

#. STRINGS.ELEMENTS.SOLIDVISCOGEL.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDVISCOGEL.NAME"
msgid "<link=\"SOLIDVISCOGEL\">Solid Visco-Gel</link>"
msgstr "<link=\"SOLIDVISCOGEL\">Visco-Gel Sólido</link>"

#. STRINGS.ELEMENTS.SOURGAS.DESC
msgctxt "STRINGS.ELEMENTS.SOURGAS.DESC"
msgid ""
"Sour Gas is a hydrocarbon <link=\"ELEMENTSGAS\">Gas</link> containing high concentrations of "
"hydrogen sulfide.\n"
"\n"
"It is a byproduct of highly heated <link=\"PETROLEUM\">Petroleum</link>."
msgstr ""
"Gás Ácido é um hidrocarboneto <link=\"ELEMENTSGAS\">Gasoso</link> carregando altas concentrações de "
"sulfeto de hidrogênio.\n"
"\n"
"É um subproduto de <link=\"PETROLEUM\">Petróleo</link> altamente aquecido."

#. STRINGS.ELEMENTS.SOURGAS.NAME
msgctxt "STRINGS.ELEMENTS.SOURGAS.NAME"
msgid "<link=\"SOURGAS\">Sour Gas</link>"
msgstr "<link=\"SOURGAS\">Gás Ácido</link>"

#. STRINGS.ELEMENTS.SOURGAS.NAME_TWO
