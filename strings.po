#| msgctxt "STRINGS.ELEMENTS.BRINEICE.NAME"
#| msgid "<link=\"BRINEICE\">Brine Ice</link>"
msgctxt "STRINGS.ELEMENTS.MURKYBRINEICE.NAME"
msgid "<link=\"MURKYBRINEICE\">Polluted Brine Ice</link>"
msgstr ""

#. STRINGS.ELEMENTS.NAPHTHA.DESC
msgctxt "STRINGS.ELEMENTS.NAPHTHA.DESC"
msgid ""
"Naphtha a distilled hydrocarbon mixture produced from the burning of "
"<link=\"POLYPROPYLENE\">Plastic</link>."
msgstr ""
"Nafta é uma mistura de hidrocarbonetos destilados produzidos a partir da queima de "
"<link=\"POLYPROPYLENE\">Plásticos</link>."

#. STRINGS.ELEMENTS.NAPHTHA.NAME
msgctxt "STRINGS.ELEMENTS.NAPHTHA.NAME"
msgid "<link=\"NAPHTHA\">Liquid Naphtha</link>"
msgstr "<link=\"NAPHTHA\">Nafta Líquida</link>"

#. STRINGS.ELEMENTS.NATURALRESIN.DESC
msgctxt "STRINGS.ELEMENTS.NATURALRESIN.DESC"
msgid ""
"Resin is a viscous organic <link=\"ELEMENTSLIQUID\">Liquid</link>.\n"
"\n"
"It can be treated to become <link=\"POLYPROPYLENE\">Plastic</link> in the "
"<link=\"POLYMERIZER\">Polymer Press</link>."
msgstr ""
"Resina é um <link=\"ELEMENTSLIQUID\">Líquido</link> orgânico viscoso.\n"
"\n"
"Pode ser tratado para se tornar <link=\"POLYPROPYLENE\">Plástico</link> na "
"<link=\"POLYMERIZER\">Prensa de Polímeros</link>."

#. STRINGS.ELEMENTS.NATURALRESIN.NAME
msgctxt "STRINGS.ELEMENTS.NATURALRESIN.NAME"
msgid "<link=\"NATURALRESIN\">Resin</link>"
msgstr "<link=\"NATURALRESIN\">Resina</link>"

#. STRINGS.ELEMENTS.NATURALSOLIDRESIN.DESC
msgctxt "STRINGS.ELEMENTS.NATURALSOLIDRESIN.DESC"
msgid ""
"Resin that has been cooled to a <link=\"ELEMENTSSOLID\">Solid</link> state.\n"
"\n"
"It can be treated to become <link=\"POLYPROPYLENE\">Plastic</link> in the "
"<link=\"POLYMERIZER\">Polymer Press</link>."
msgstr ""
"Resina que foi resfriada até um estado <link=\"ELEMENTSSOLID\">Sólido</link>.\n"
"\n"
"Pode ser tratado para se tornar <link=\"POLYPROPYLENE\">Plástico</link> na "
"<link=\"POLYMERIZER\">Prensa de Polímeros</link>."

#. STRINGS.ELEMENTS.NATURALSOLIDRESIN.NAME
msgctxt "STRINGS.ELEMENTS.NATURALSOLIDRESIN.NAME"
msgid "<link=\"NATURALSOLIDRESIN\">Solid Resin</link>"
msgstr "<link=\"NATURALSOLIDRESIN\">Resina Sólida</link>"

#. STRINGS.ELEMENTS.NICKEL.DESC
msgctxt "STRINGS.ELEMENTS.NICKEL.DESC"
msgid ""
"(Ni) Nickel is a conductive <link=\"METAL\">Metal</link>.\n"
"\n"
"It is suitable for building <link=\"POWER\">Power</link> systems."
msgstr ""
"(Ni) Nickel is a conductive <link=\"METAL\">Metal</link>.\n"
"\n"
"It is suitable for building <link=\"POWER\">Power</link> systems."

#. STRINGS.ELEMENTS.NICKEL.NAME
msgctxt "STRINGS.ELEMENTS.NICKEL.NAME"
msgid "<link=\"NICKEL\">Nickel</link>"
msgstr "<link=\"NICKEL\">Níquel</link>"

#. STRINGS.ELEMENTS.NICKELGAS.DESC
msgctxt "STRINGS.ELEMENTS.NICKELGAS.DESC"
msgid ""
"(Ni) Nickel Gas is a conductive <link=\"METAL\">Metal</link> heated into a "
"<link=\"ELEMENTSGAS\">Gas</link> state."
msgstr ""
"(Ni) Nickel Gas is a conductive <link=\"METAL\">Metal</link> heated into a "
"<link=\"ELEMENTSGAS\">Gas</link> state."

#. STRINGS.ELEMENTS.NICKELGAS.NAME
msgctxt "STRINGS.ELEMENTS.NICKELGAS.NAME"
msgid "<link=\"NICKELGAS\">Nickel Gas</link>"
msgstr "<link=\"NICKELGAS\">Gás Níquel</link>"

#. STRINGS.ELEMENTS.NICKELORE.DESC
#| msgctxt "STRINGS.ELEMENTS.NICKELORE.DESC"
#| msgid ""
#| "(Ni) Nickel Ore is a conductive <link=\"RAWMETAL\">Metal</link>.\n"
#| "\n"
#| "It can be refined into <link=\"NICKEL\">Nickel</link> and is suitable for building "
#| "<link=\"POWER\">Power</link> systems."
msgctxt "STRINGS.ELEMENTS.NICKELORE.DESC"
msgid ""
"(Ni) Nickel Ore is a conductive <link=\"METAL\">Metal</link>.\n"
"\n"
"It can be refined into <link=\"NICKEL\">Nickel</link> and is suitable for building "
"<link=\"POWER\">Power</link> systems."
msgstr ""

#. STRINGS.ELEMENTS.NICKELORE.NAME
msgctxt "STRINGS.ELEMENTS.NICKELORE.NAME"
msgid "<link=\"NICKELORE\">Nickel Ore</link>"
msgstr "<link=\"NICKELORE\">Minério de Níquel</link>"

#. STRINGS.ELEMENTS.NIOBIUM.DESC
msgctxt "STRINGS.ELEMENTS.NIOBIUM.DESC"
msgid ""
"(Nb) Niobium is a rare metal with many practical applications in metallurgy and superconductor "
"<link=\"RESEARCH\">Research</link>."
msgstr ""
"(Nb) O nióbio é um metal raro com muitas aplicações práticas em metalurgia e "
"<link=\"RESEARCH\">Pesquisa</link> em supercondutores."

#. STRINGS.ELEMENTS.NIOBIUM.NAME
msgctxt "STRINGS.ELEMENTS.NIOBIUM.NAME"
msgid "<link=\"NIOBIUM\">Niobium</link>"
msgstr "<link=\"NIOBIUM\">Nióbio</link>"

#. STRINGS.ELEMENTS.NIOBIUMGAS.DESC
msgctxt "STRINGS.ELEMENTS.NIOBIUMGAS.DESC"
msgid ""
"(Nb) Niobium Gas is a rare metal.\n"
"\n"
"This selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr ""
"(Nb) O gás nióbio é um metal raro.\n"
"\n"
"Esta seleção está em estado <link=\"ELEMENTSGAS\">Gasoso</link>."

#. STRINGS.ELEMENTS.NIOBIUMGAS.NAME
msgctxt "STRINGS.ELEMENTS.NIOBIUMGAS.NAME"
msgid "<link=\"NIOBIUMGAS\">Niobium Gas</link>"
msgstr "<link=\"NIOBIUMGAS\">Gás Nióbio</link>"

#. STRINGS.ELEMENTS.NUCLEARWASTE.DESC
msgctxt "STRINGS.ELEMENTS.NUCLEARWASTE.DESC"
msgid ""
"Highly toxic liquid full of <link=\"RADIATION\">Radioactive Contaminants</link> which emit "
"<link=\"RADIATION\">Radiation</link> that can be absorbed by "
"<link=\"HIGHENERGYPARTICLESPAWNER\">Radbolt Generators</link>."
msgstr ""
"Líquido altamente tóxico feito de <link=\"RADIATION\">Contaminantes Radioativos</link> que emitem "
"<link=\"RADIATION\">Radiação</link> que pode ser absorvida por "
"<link=\"HIGHENERGYPARTICLESPAWNER\">Geradores de Rádio-Raios</link>."

#. STRINGS.ELEMENTS.NUCLEARWASTE.NAME
msgctxt "STRINGS.ELEMENTS.NUCLEARWASTE.NAME"
msgid "<link=\"NUCLEARWASTE\">Liquid Nuclear Waste</link>"
msgstr "<link=\"NUCLEARWASTE\">Resíduos Líquido Nucleares</link>"

#. STRINGS.ELEMENTS.OBSIDIAN.DESC
msgctxt "STRINGS.ELEMENTS.OBSIDIAN.DESC"
msgid "Obsidian is a brittle composite of volcanic <link=\"GLASS\">Glass</link>."
msgstr "Obsidiana é um composto frágil de <link=\"GLASS\">Vidro</link> vulcânico."

#. STRINGS.ELEMENTS.OBSIDIAN.NAME
msgctxt "STRINGS.ELEMENTS.OBSIDIAN.NAME"
msgid "<link=\"OBSIDIAN\">Obsidian</link>"
msgstr "<link=\"OBSIDIAN\">Obsidiana</link>"

#. STRINGS.ELEMENTS.OXYGEN.DESC
msgctxt "STRINGS.ELEMENTS.OXYGEN.DESC"
msgid ""
"(O<sub>2</sub>) Oxygen is an atomically lightweight and breathable <link=\"ELEMENTSGAS\">Gas</"
"link>, necessary for sustaining life.\n"
"\n"
"It tends to rise above other gases."
msgstr ""
"(O<sub>2</sub>) Oxigênio é um <link=\"ELEMENTSGAS\">Gás</link> atomicamente leve e respirável, "
"necessário para sustentar a vida.\n"
"\n"
"Ele tende a ficar acima de outros gases."

#. STRINGS.ELEMENTS.OXYGEN.NAME
msgctxt "STRINGS.ELEMENTS.OXYGEN.NAME"
msgid "<link=\"OXYGEN\">Oxygen</link>"
msgstr "<link=\"OXYGEN\">Oxigênio</link>"

#. STRINGS.ELEMENTS.OXYROCK.DESC
msgctxt "STRINGS.ELEMENTS.OXYROCK.DESC"
msgid ""
"(Ir<sub>3</sub>O<sub>2</sub>) Oxylite is a chemical compound that slowly emits breathable "
"<link=\"OXYGEN\">Oxygen</link>.\n"
"\n"
"Excavating <link=\"OXYROCK\">Oxylite</link> increases its emission rate, but depletes the ore more "
"rapidly."
msgstr ""
"(Ir<sub>3</sub>O<sub>2</sub>) Oxilito é um composto químico que aos poucos libera "
"<link=\"OXYGEN\">Oxigênio</link>.\n"
"\n"
"Escavar <link=\"OXYROCK\">Oxilito</link> aumenta a emissão de oxigênio, mas o minério se esgota "
"mais rapidamente."

#. STRINGS.ELEMENTS.OXYROCK.NAME
msgctxt "STRINGS.ELEMENTS.OXYROCK.NAME"
msgid "<link=\"OXYROCK\">Oxylite</link>"
msgstr "<link=\"OXYROCK\">Oxilito</link>"

#. STRINGS.ELEMENTS.PALMWOOD.DESC
msgctxt "STRINGS.ELEMENTS.PALMWOOD.DESC"
msgid ""
"Gum Wood can be processed at the <link=\"MILKPRESS\">Plant Pulverizer</link> to yield "
"<link=\"LATEX\">Latex</link>, which is essential for <link=\"RUBBER\">Rubber</link> production.\n"
"\n"
"It can also be used for <link=\"HEAT\">Heat</link> and <link=\"POWER\">Power</link>, or as a "
"<b>Construction Material</b>."
msgstr ""

#. STRINGS.ELEMENTS.PALMWOOD.NAME
#| msgctxt "STRINGS.ELEMENTS.WOODLOG.NAME"
#| msgid "<link=\"WOOD\">Wood</link>"
msgctxt "STRINGS.ELEMENTS.PALMWOOD.NAME"
msgid "<link=\"PALMWOOD\">Gum Wood</link>"
msgstr ""

#. STRINGS.ELEMENTS.PEARL.DESC
msgctxt "STRINGS.ELEMENTS.PEARL.DESC"
msgid ""
"A perfectly smooth gem.\n"
"\n"
"It can be eaten by <link=\"SEAHORSESPECIES\">Seaquines</link> or used as an attractive "
"<b>Construction Material</b>."
msgstr ""
"Uma gema perfeitamente lisa.\n"
"\n"
"Ela pode ser comida por <link=\"SEAHORSESPECIES\">Maréguas</link> ou usada como um <b>Material de "
"Construção</b> atrativo."

#. STRINGS.ELEMENTS.PEARL.NAME
#| msgctxt "STRINGS.ELEMENTS.PEAT.NAME"
#| msgid "<link=\"PEAT\">Peat</link>"
msgctxt "STRINGS.ELEMENTS.PEARL.NAME"
msgid "<link=\"PEARL\">Pearl</link>"
msgstr "<link=\"PEARL\">Pérola</link>"

#. STRINGS.ELEMENTS.PEAT.DESC
msgctxt "STRINGS.ELEMENTS.PEAT.DESC"
msgid ""
"Peat is a densely packed material made up of partially decomposed organic matter.\n"
"\n"
"It is a combustible fuel, useful in <link=\"POWER\">Power</link> production."
msgstr ""
"Turfa é um material denso feito de matéria orgânica parcialmente decomposta.\n"
"\n"
"É um combustível, útil na produção de <link=\"POWER\">Energia</link>."

#. STRINGS.ELEMENTS.PEAT.NAME
msgctxt "STRINGS.ELEMENTS.PEAT.NAME"
msgid "<link=\"PEAT\">Peat</link>"
msgstr "<link=\"PEAT\">Turfa</link>"

#. STRINGS.ELEMENTS.PETROLEUM.DESC
msgctxt "STRINGS.ELEMENTS.PETROLEUM.DESC"
msgid ""
"Petroleum is a <link=\"POWER\">Power</link> source refined from <link=\"CRUDEOIL\">Crude Oil</"
"link>.\n"
"\n"
"It is also an essential ingredient in the production of <link=\"POLYPROPYLENE\">Plastic</link>."
msgstr ""
"Petróleo é uma fonte de <link=\"POWER\">Energia</link> refinada do <link=\"CRUDEOIL\">Petróleo "
"Bruto</link>.\n"
"\n"
"É também um ingrediente essencial na produção de <link=\"POLYPROPYLENE\">Plástico</link>."

#. STRINGS.ELEMENTS.PETROLEUM.NAME
msgctxt "STRINGS.ELEMENTS.PETROLEUM.NAME"
msgid "<link=\"PETROLEUM\">Petroleum</link>"
msgstr "<link=\"PETROLEUM\">Petróleo</link>"

#. STRINGS.ELEMENTS.PETROLEUM.NAME_TWO
msgctxt "STRINGS.ELEMENTS.PETROLEUM.NAME_TWO"
msgid "<link=\"PETROLEUM\">Petroleum</link>"
msgstr "<link=\"PETROLEUM\">Petróleo</link>"

#. STRINGS.ELEMENTS.PHOSPHATENODULES.DESC
msgctxt "STRINGS.ELEMENTS.PHOSPHATENODULES.DESC"
msgid ""
"(PO<sup>3-</sup><sub>4</sub>) Nodules of sedimentary rock containing high concentrations of "
"phosphate."
msgstr ""
"(PO<sup>3-</sup><sub>4</sub>) Nódulos de rocha sedimentar contendo altas concentrações de fosfato."

#. STRINGS.ELEMENTS.PHOSPHATENODULES.NAME
msgctxt "STRINGS.ELEMENTS.PHOSPHATENODULES.NAME"
msgid "<link=\"PHOSPHATENODULES\">Phosphate Nodules</link>"
msgstr "<link=\"PHOSPHATENODULES\">Nódulos de Fosfato</link>"

#. STRINGS.ELEMENTS.PHOSPHORITE.DESC
msgctxt "STRINGS.ELEMENTS.PHOSPHORITE.DESC"
msgid "Phosphorite is a composite of sedimentary rock, saturated with phosphate."
msgstr "Fosforito é um composto de rochas de sedimentares, rico em fosfato."

#. STRINGS.ELEMENTS.PHOSPHORITE.NAME
msgctxt "STRINGS.ELEMENTS.PHOSPHORITE.NAME"
msgid "<link=\"PHOSPHORITE\">Phosphorite</link>"
msgstr "<link=\"PHOSPHORITE\">Fosforito</link>"

#. STRINGS.ELEMENTS.PHOSPHORUS.DESC
msgctxt "STRINGS.ELEMENTS.PHOSPHORUS.DESC"
msgid ""
"(P) Refined Phosphorus is a chemical element in its <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "(P) Fósforo Refinado é um elemento químico no estado <link=\"ELEMENTSSOLID\">Sólido</link>."

#. STRINGS.ELEMENTS.PHOSPHORUS.NAME
msgctxt "STRINGS.ELEMENTS.PHOSPHORUS.NAME"
msgid "<link=\"PHOSPHORUS\">Refined Phosphorus</link>"
msgstr "<link=\"PHOSPHORUS\">Fósforo Refinado</link>"

#. STRINGS.ELEMENTS.PHOSPHORUSGAS.DESC
msgctxt "STRINGS.ELEMENTS.PHOSPHORUSGAS.DESC"
msgid ""
"(P) Phosphorus Gas is the <link=\"ELEMENTSGAS\">Gaseous</link> state of "
"<link=\"PHOSPHORUS\">Refined Phosphorus</link>."
msgstr ""
"(P) Gás de Fósforo é o estado <link=\"ELEMENTSGAS\">Gasoso</link> do <link=\"PHOSPHORUS\">Fósforo "
"Refinado</link>."

#. STRINGS.ELEMENTS.PHOSPHORUSGAS.NAME
msgctxt "STRINGS.ELEMENTS.PHOSPHORUSGAS.NAME"
msgid "<link=\"PHOSPHORUSGAS\">Phosphorus Gas</link>"
msgstr "<link=\"PHOSPHORUSGAS\">Gás de Fósforo</link>"

#. STRINGS.ELEMENTS.PHYTOOIL.DESC
msgctxt "STRINGS.ELEMENTS.PHYTOOIL.DESC"
msgid ""
"Phyto Oil is a thick, slippery <link=\"ELEMENTSLIQUID\">Liquid</link> extracted from pureed "
"<link=\"SLIME\">Slime</link>."
msgstr ""
"Óleo Fito é um <link=\"ELEMENTSLIQUID\">Líquido</link> espesso e escorregadio extraído do purê de "
"<link=\"SLIME\">Limo</link>."

#. STRINGS.ELEMENTS.PHYTOOIL.NAME
msgctxt "STRINGS.ELEMENTS.PHYTOOIL.NAME"
msgid "<link=\"PHYTOOIL\">Phyto Oil</link>"
msgstr "<link=\"PHYTOOIL\">Óleo Fito</link>"

#. STRINGS.ELEMENTS.POLYPROPYLENE.BUILD_DESC
msgctxt "STRINGS.ELEMENTS.POLYPROPYLENE.BUILD_DESC"
msgid "Buildings made of this <link=\"POLYPROPYLENE\">Plastic</link> have antiseptic properties"
msgstr ""
"Estruturas feitas deste <link=\"POLYPROPYLENE\">Plástico</link> tem propriedades antissépticas"

#. STRINGS.ELEMENTS.POLYPROPYLENE.DESC
msgctxt "STRINGS.ELEMENTS.POLYPROPYLENE.DESC"
msgid ""
"(C<sub>3</sub>H<sub>6</sub>)<sub>n</sub> <link=\"POLYPROPYLENE\">Plastic</link> is a thermoplastic "
"polymer.\n"
"\n"
"It is useful for constructing a variety of advanced buildings and equipment."
msgstr ""
"(C<sub>3</sub>H<sub>6</sub>)<sub>n</sub> <link=\"POLYPROPYLENE\">Plástico</link> é um polímero "
"termoplástico.\n"
"\n"
"É útil na construção de uma variedade de estruturas e equipamentos avançados."

#. STRINGS.ELEMENTS.POLYPROPYLENE.NAME
msgctxt "STRINGS.ELEMENTS.POLYPROPYLENE.NAME"
msgid "<link=\"POLYPROPYLENE\">Plastic</link>"
msgstr "<link=\"POLYPROPYLENE\">Plástico</link>"

#. STRINGS.ELEMENTS.PONDSCUM.DESC
msgctxt "STRINGS.ELEMENTS.PONDSCUM.DESC"
msgid ""
"Pondscum is a soft, naturally occurring composite of biological nutrients.\n"
"\n"
"It may be processed into <link=\"FERTILIZER\">Fertilizer</link> and aids in the growth of certain "
"<link=\"PLANTS\">Plants</link>."
msgstr ""
"Lodo é um composto natural macio de nutrientes biológicos.\n"
"\n"
"Ele pode ser processado em <link=\"FERTILIZER\">Fertilizante</link> e ajuda no crescimento de "
"certas <link=\"PLANTS\">Plantas</link>."

#. STRINGS.ELEMENTS.PONDSCUM.NAME
msgctxt "STRINGS.ELEMENTS.PONDSCUM.NAME"
msgid "<link=\"PONDSCUM\">Pondscum</link>"
msgstr "<link=\"PONDSCUM\">Lodo</link>"

#. STRINGS.ELEMENTS.PROPANE.DESC
msgctxt "STRINGS.ELEMENTS.PROPANE.DESC"
msgid ""
"(C<sub>3</sub>H<sub>8</sub>) Propane Gas is a natural alkane.\n"
"\n"
"This selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state.\n"
"\n"
"It is useful in <link=\"POWER\">Power</link> production."
msgstr ""
"(C<sub>3</sub>H<sub>8</sub>) O gás propano é um alcano natural.\n"
"\n"
"Esta seleção está em estado <link=\"ELEMENTSGAS\">Gasoso</link>.\n"
"\n"
"É útil na produção de <link=\"POWER\">Energia</link>."

#. STRINGS.ELEMENTS.PROPANE.NAME
msgctxt "STRINGS.ELEMENTS.PROPANE.NAME"
msgid "<link=\"PROPANE\">Propane Gas</link>"
msgstr "<link=\"PROPANE\">Gás Propano</link>"

#. STRINGS.ELEMENTS.RADIATIONPROPERTIES
msgctxt "STRINGS.ELEMENTS.RADIATIONPROPERTIES"
msgid ""
"Radiation Absorption Factor: {0}\n"
"Radiation Emission/1000kg: {1}"
msgstr ""
"Fator de Absorção de Radiação: {0}\n"
"Emissão de Radiação/1000kg: {1}"

#. STRINGS.ELEMENTS.RADIUM.DESC
msgctxt "STRINGS.ELEMENTS.RADIUM.DESC"
msgid ""
"(Ra) Radium is a <link=\"LIGHT\">Light</link> emitting radioactive substance.\n"
"\n"
"It is useful as a <link=\"POWER\">Power</link> source."
msgstr ""
"(Ra) Rádio é uma substância radioativa que emite <link=\"LIGHT\">Luz</link>.\n"
"\n"
"É uma útil fonte de <link=\"POWER\">Energia</link>."

#. STRINGS.ELEMENTS.RADIUM.NAME
msgctxt "STRINGS.ELEMENTS.RADIUM.NAME"
msgid "<link=\"RADIUM\">Radium</link>"
msgstr "<link=\"RADIUM\">Rádio</link>"

#. STRINGS.ELEMENTS.REFINEDCARBON.DESC
msgctxt "STRINGS.ELEMENTS.REFINEDCARBON.DESC"
msgid "(C) Refined carbon is solid element purified from raw <link=\"CARBON\">Coal</link>."
msgstr ""
"(C) Carbono refinado é um elemento sólido purificado a partir de <link=\"CARBON\">Carvão</link> "
"bruto."

#. STRINGS.ELEMENTS.REFINEDCARBON.NAME
msgctxt "STRINGS.ELEMENTS.REFINEDCARBON.NAME"
msgid "<link=\"REFINEDCARBON\">Refined Carbon</link>"
msgstr "<link=\"REFINEDCARBON\">Carbono Refinado</link>"

#. STRINGS.ELEMENTS.REFINEDLIPID.DESC
msgctxt "STRINGS.ELEMENTS.REFINEDLIPID.DESC"
msgid ""
"Biodiesel is a <link=\"ELEMENTSLIQUID\">Liquid</link> composed of highly processed fatty acids "
"derived from purified natural oils.\n"
"\n"
"Its <link=\"COMBUSTIBLELIQUID\">combustibility</link> makes it useful for <link=\"POWER\">Power</"
"link> production."
msgstr ""
"Biodiesel é um <link=\"ELEMENTSLIQUID\">Líquido</link> composto de ácidos graxos altamente "
"processados derivados de óleos naturais purificados.\n"
"\n"
"Sua <link=\"COMUSTIBLELIQUID\">combustibilidade</link< o torna útil para produção de "
"<link=\"POWER\">Energia</link>."

#. STRINGS.ELEMENTS.REFINEDLIPID.NAME
msgctxt "STRINGS.ELEMENTS.REFINEDLIPID.NAME"
msgid "<link=\"REFINEDLIPID\">Biodiesel</link>"
msgstr "<link=\"REFINEDLIPID\">Biodiesel</link>"

#. STRINGS.ELEMENTS.REGOLITH.DESC
msgctxt "STRINGS.ELEMENTS.REGOLITH.DESC"
msgid ""
"Regolith is a sandy substance composed of the various particles that collect atop terrestrial "
"objects.\n"
"\n"
"It is useful as a <link=\"FILTER\">Filtration Medium</link>."
msgstr ""
"Regolito é uma substância arenosa composta de diversas partículas que se acumulam no topo de "
"objetos terrestres.\n"
"\n"
"É útil como um <link=\"FILTER\">Meio de Filtração</link>."

#. STRINGS.ELEMENTS.REGOLITH.NAME
msgctxt "STRINGS.ELEMENTS.REGOLITH.NAME"
msgid "<link=\"REGOLITH\">Regolith</link>"
msgstr "<link=\"REGOLITH\">Regolito</link>"

#. STRINGS.ELEMENTS.RESIN.DESC
msgctxt "STRINGS.ELEMENTS.RESIN.DESC"
msgid ""
"Sticky goo harvested from a grumpy tree.\n"
"\n"
"It can be polymerized into <link=\"ISORESIN\">Isosap</link> by boiling away its excess moisture."
msgstr ""
"Gosma grudenta coletada de uma árvore ranzinza.\n"
"\n"
"Pode ser polimerizada em <link=\"ISORESIN\">Iso-Seiva</link> ao ferver sua umidade excessiva."

#. STRINGS.ELEMENTS.RESIN.NAME
msgctxt "STRINGS.ELEMENTS.RESIN.NAME"
msgid "<link=\"RESIN\">Sap</link>"
msgstr "<link=\"RESIN\">Seiva</link>"

#. STRINGS.ELEMENTS.ROCKGAS.DESC
msgctxt "STRINGS.ELEMENTS.ROCKGAS.DESC"
msgid "Rock Gas is rock that has been superheated into a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr ""
"Rocha Gasosa é uma pedra que foi superaquecida até atingir o estado <link=\"ELEMENTSGAS\">Gasoso</"
"link>."

#. STRINGS.ELEMENTS.ROCKGAS.NAME
msgctxt "STRINGS.ELEMENTS.ROCKGAS.NAME"
msgid "<link=\"ROCKGAS\">Rock Gas</link>"
msgstr "<link=\"ROCKGAS\">Rocha Gasosa</link>"

#. STRINGS.ELEMENTS.RUBBER.DESC
#| msgctxt "STRINGS.ELEMENTS.AMBER.DESC"
#| msgid ""
#| "Amber is a <link=\"ELEMENTSSOLID\">Solid</link> organic composite of "
#| "<link=\"NATURALRESIN\">Resin</link> and <link=\"FOSSIL\">Fossil</link>."
msgctxt "STRINGS.ELEMENTS.RUBBER.DESC"
msgid ""
"Rubber is a viscoelastic <link=\"ELEMENTSSOLID\">Solid</link> made from vulcanized "
"<link=\"LATEX\">Latex</link>.\n"
"\n"
"It can be used to make <link=\"BUILDINGGASKET\">Gaskets</link>."
msgstr ""

#. STRINGS.ELEMENTS.RUBBER.NAME
#| msgctxt "STRINGS.ELEMENTS.AMBER.NAME"
#| msgid "<link=\"AMBER\">Amber</link>"
msgctxt "STRINGS.ELEMENTS.RUBBER.NAME"
msgid "<link=\"RUBBER\">Rubber</link>"
msgstr ""

#. STRINGS.ELEMENTS.RUST.DESC
msgctxt "STRINGS.ELEMENTS.RUST.DESC"
msgid ""
"Rust is an iron oxide that forms from the breakdown of <link=\"IRON\">Iron</link>.\n"
"\n"
"It is useful in some <link=\"OXYGEN\">Oxygen</link> production processes."
msgstr ""
"Ferrugem é um óxido de ferro que se forma na decomposição de <link=\"IRON\">Ferro</link>.\n"
"\n"
"É útil em alguns processos de produção de <link=\"OXYGEN\">Oxigênio</link>."

#. STRINGS.ELEMENTS.RUST.NAME
msgctxt "STRINGS.ELEMENTS.RUST.NAME"
msgid "<link=\"RUST\">Rust</link>"
msgstr "<link=\"RUST\">Ferrugem</link>"

#. STRINGS.ELEMENTS.SALT.DESC
msgctxt "STRINGS.ELEMENTS.SALT.DESC"
msgid ""
"(NaCl) Salt, also known as sodium chloride, is an edible chemical compound.\n"
"\n"
"When refined, it can be eaten with meals to increase Duplicant <link=\"MORALE\">Morale</link>."
msgstr ""
"(NaCl) Sal, também conhecido com cloreto de sódio, é um composto químico.\n"
"\n"
"Quando refinado, pode ser ingerido com alimentos para aumentar o <link=\"MORALE\">Moral</link> dos "
"Duplicantes."

#. STRINGS.ELEMENTS.SALT.NAME
msgctxt "STRINGS.ELEMENTS.SALT.NAME"
msgid "<link=\"SALT\">Salt</link>"
msgstr "<link=\"SALT\">Sal</link>"

#. STRINGS.ELEMENTS.SALTGAS.DESC
msgctxt "STRINGS.ELEMENTS.SALTGAS.DESC"
msgid ""
"(NaCl) Salt Gas is an edible chemical compound that has been superheated into a "
"<link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr ""
"(NaCl) Sal Gasoso é um composto químico comestível que foi aquecido ao estado "
"<link=\"ELEMENTSLIQUID\">Gasoso</link>."

#. STRINGS.ELEMENTS.SALTGAS.NAME
msgctxt "STRINGS.ELEMENTS.SALTGAS.NAME"
msgid "<link=\"SALTGAS\">Salt Gas</link>"
msgstr "<link=\"SALTGAS\">Gás Sal</link>"

#. STRINGS.ELEMENTS.SALTWATER.DESC
msgctxt "STRINGS.ELEMENTS.SALTWATER.DESC"
msgid ""
"Salt Water is a natural, lightly concentrated solution of <link=\"SALT\">Salt</link> dissolved in "
"<link=\"WATER\">Water</link>.\n"
"\n"
"It can be used in desalination processes, separating out usable salt."
msgstr ""
"Água Salgada é uma solução natural com pequenas concentrações de <link=\"SALT\">Sal</link> "
"dissolvidos em <link=\"WATER\">Água</link>.\n"
"\n"
"Pode ser usada em processos de dessalinização, separando sal utilizável."

#. STRINGS.ELEMENTS.SALTWATER.NAME
msgctxt "STRINGS.ELEMENTS.SALTWATER.NAME"
msgid "<link=\"SALTWATER\">Salt Water</link>"
msgstr "<link=\"SALTWATER\">Água Salgada</link>"

#. STRINGS.ELEMENTS.SAND.DESC
msgctxt "STRINGS.ELEMENTS.SAND.DESC"
msgid ""
"Sand is a composite of granular rock.\n"
"\n"
"It is useful as a <link=\"FILTER\">Filtration Medium</link>."
msgstr ""
"Areia é um composto de rochas sedimentares.\n"
"\n"
"É útil como um <link=\"FILTER\">Meio de Filtração</link>."

#. STRINGS.ELEMENTS.SAND.NAME
msgctxt "STRINGS.ELEMENTS.SAND.NAME"
msgid "<link=\"SAND\">Sand</link>"
msgstr "<link=\"SAND\">Areia</link>"

