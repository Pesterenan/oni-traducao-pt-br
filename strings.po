#. STRINGS.WORLDS.SWAMPMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.SWAMPMOONLET.DESCRIPTION"
msgid ""
"A large, polluted swamp world.\n"
"\n"
"<smallcaps>Quagmiris Asteroids are a great mass of frozen slush and wasteland. With a short "
"distance to the surface, inter-world travel can be achieved quickly.</smallcaps>"
msgstr ""
"Um mundo pantanoso gigantesco.\n"
"\n"
"<smallcaps>Asteroides Quagmires são uma grande massa de lama congelada. Com uma pequena distância "
"para a superfície, a viagem interplanetária pode ser conquistada rapidamente.</smallcaps>"

#. STRINGS.WORLDS.SWAMPMOONLET.NAME
msgctxt "STRINGS.WORLDS.SWAMPMOONLET.NAME"
msgid "Quagmiris Asteroid"
msgstr "Asteroide Quagmires"

#. STRINGS.WORLDS.SWAMPYLANDINGSITE.DESCRIPTION
msgctxt "STRINGS.WORLDS.SWAMPYLANDINGSITE.DESCRIPTION"
msgid ""
"A small swampy world with a radioactive core.\n"
"\n"
"<smallcaps>Irradiated Swamps have a high concentration of rare swampy and radioactive resources but "
"are also chocked full of dangers.</smallcaps>"
msgstr ""
"Um pequeno mundo pantanoso com um núcleo radioativo.\n"
"\n"
"<smallcaps>Pântanos Irradiados possuem uma alta concentração de recursos radioativos e pantanosos "
"raros mas são também altamente cheios de perigos.</smallcaps>"

#. STRINGS.WORLDS.SWAMPYLANDINGSITE.NAME
msgctxt "STRINGS.WORLDS.SWAMPYLANDINGSITE.NAME"
msgid "Irradiated Swampy Asteroid"
msgstr "Asteroide de Pântano Irradiado"

#. STRINGS.WORLDS.TERRAMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.TERRAMOONLET.DESCRIPTION"
msgid ""
"A balanced variety of resources on a smaller sandstone world.\n"
"\n"
"<smallcaps>Terrania Asteroids have everything needed to start a colony in a compact area. With a "
"short distance to the surface, inter-world travel can be achieved quickly.</smallcaps>"
msgstr ""
"Uma variedade balanceada de recursos em um mundo de arenito menor.\n"
"\n"
"<smallcaps>Asteroides Terrania possuem tudo que é necessário para iniciar uma colônia em uma área "
"compacta. Com uma distância menor para a superfície, a viagem interplanetária pode ser conquistada "
"rapidamente.</smallcaps>"

#. STRINGS.WORLDS.TERRAMOONLET.NAME
msgctxt "STRINGS.WORLDS.TERRAMOONLET.NAME"
msgid "Terrania Asteroid"
msgstr "Asteroide Terrania"

#. STRINGS.WORLDS.THE_ROCK.DESCRIPTION
msgctxt "STRINGS.WORLDS.THE_ROCK.DESCRIPTION"
msgid ""
"This place really rocks.\n"
"\n"
"<smallcaps></smallcaps>\n"
"\n"
msgstr "Este lugar tem <smallcaps>muita</smallcaps> pedra.\n"

#. STRINGS.WORLDS.THE_ROCK.NAME
msgctxt "STRINGS.WORLDS.THE_ROCK.NAME"
msgid "The Rock"
msgstr "A Rocha"

#. STRINGS.WORLDS.TINYEMPTY.DESCRIPTION
msgctxt "STRINGS.WORLDS.TINYEMPTY.DESCRIPTION"
msgid "A fun-sized 'fixer upper', perfect for game devs."
msgstr "Um 'conserta e vende' de tamanho divertido, perfeito para desenvolvedores de jogos."

#. STRINGS.WORLDS.TINYEMPTY.NAME
msgctxt "STRINGS.WORLDS.TINYEMPTY.NAME"
msgid "Tiny Empty FOR DEVS"
msgstr "Pequeno Vazio PARA DEVS"

#. STRINGS.WORLDS.TINYFOREST.DESCRIPTION
msgctxt "STRINGS.WORLDS.TINYFOREST.DESCRIPTION"
msgid "A petite forest world for nature loving devs."
msgstr "Uma floresta pequena para devs amantes de natureza."

#. STRINGS.WORLDS.TINYFOREST.NAME
msgctxt "STRINGS.WORLDS.TINYFOREST.NAME"
msgid "Tiny Forest FOR DEVS"
msgstr "Floresta Pequena PARA DEVS"

#. STRINGS.WORLDS.TINYICE.DESCRIPTION
msgctxt "STRINGS.WORLDS.TINYICE.DESCRIPTION"
msgid "A tiny ice cold world for dev snow forts."
msgstr "Um mundo pequeno de gelo para fortes de neve de devs."

#. STRINGS.WORLDS.TINYICE.NAME
msgctxt "STRINGS.WORLDS.TINYICE.NAME"
msgid "Tiny Ice FOR DEVS"
msgstr "Pequeno Gelo PARA DEVS"

#. STRINGS.WORLDS.TINYMAGMA.DESCRIPTION
msgctxt "STRINGS.WORLDS.TINYMAGMA.DESCRIPTION"
msgid "A small hellscape just for devs."
msgstr "Uma pequena paisagem infernal feita para devs."

#. STRINGS.WORLDS.TINYMAGMA.NAME
msgctxt "STRINGS.WORLDS.TINYMAGMA.NAME"
msgid "Tiny Magma FOR DEVS"
msgstr "Magma Pequeno PARA DEVS"

#. STRINGS.WORLDS.TINYSTART.DESCRIPTION
msgctxt "STRINGS.WORLDS.TINYSTART.DESCRIPTION"
msgid "A cozy little starter location, just for devs."
msgstr "Um pequeno local aconchegante para iniciantes, apenas para desenvolvedores."

#. STRINGS.WORLDS.TINYSTART.NAME
msgctxt "STRINGS.WORLDS.TINYSTART.NAME"
msgid "Tiny Start FOR DEVS"
msgstr "Pequeno Início PARA DEVS"

#. STRINGS.WORLDS.TINYSURFACE.DESCRIPTION
msgctxt "STRINGS.WORLDS.TINYSURFACE.DESCRIPTION"
msgid "A cute little Dev location, with scenic space views."
msgstr "Um localização pequena, com visões para o espaço."

#. STRINGS.WORLDS.TINYSURFACE.NAME
msgctxt "STRINGS.WORLDS.TINYSURFACE.NAME"
msgid "Tiny Surface FOR DEVS"
msgstr "Superfície Pequena PARA DEVS"

#. STRINGS.WORLDS.TUNDRAMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.TUNDRAMOONLET.DESCRIPTION"
msgid ""
"A small frozen planetoid with sub-zero temperatures.\n"
"\n"
"<smallcaps>Duplicants that travel to Tundra Asteroids will need to wear protective gear due to its "
"harsh environment.</smallcaps>"
msgstr ""
"Um planetoide congelado com temperaturas abaixo de zero.\n"
"\n"
"<smallcaps>Duplicantes que viajarem para os Asteroides Tundra precisarão vestir equipamento de "
"proteção devido ao seu ambiente perigoso.</smallcaps>"

#. STRINGS.WORLDS.TUNDRAMOONLET.NAME
msgctxt "STRINGS.WORLDS.TUNDRAMOONLET.NAME"
msgid "Tundra Asteroid"
msgstr "Asteroide Tundra"

#. STRINGS.WORLDS.TWINMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.TWINMOONLET.DESCRIPTION"
msgid "Two small dev worlds for the price of one."
msgstr "Dois mundos pequenos de dev pelo preço de um."

#. STRINGS.WORLDS.TWINMOONLET.NAME
msgctxt "STRINGS.WORLDS.TWINMOONLET.NAME"
msgid "Tiny Twin Asteroid FOR DEVS"
msgstr "Pequeno Asteroide Gêmeo PARA DEVS"

#. STRINGS.WORLDS.VANILLAARBORIA.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLAARBORIA.DESCRIPTION"
msgid ""
"A location with a natural abundance of trees.\n"
"\n"
"<smallcaps>Colonizing Arboria will require careful planning right from the start. Because of its "
"lack of metals, finding biological solutions to problems is a must.</smallcaps>"
msgstr ""
"Um destino com abundância natural de árvores.\n"
"\n"
"<smallcaps>Para colonizar Arbórea será necessário planejamento cuidadoso desde o início. Devido a "
"sua falta de metais, soluções biológicas para os problemas devem ser utilizadas.</smallcaps>"

#. STRINGS.WORLDS.VANILLAARBORIA.NAME
msgctxt "STRINGS.WORLDS.VANILLAARBORIA.NAME"
msgid "Arboria Asteroid"
msgstr "Asteroide Arbórea"

#. STRINGS.WORLDS.VANILLAARIDIO.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLAARIDIO.DESCRIPTION"
msgid ""
"A location with oppressively hot temperatures.\n"
"\n"
"<smallcaps>Temperatures on Aridio are much higher than expected. While resources are abundant, "
"maintaining food and infrastructure could be difficult as our colony warms.</smallcaps>"
msgstr ""
"Um destino com temperaturas opressivamente quentes.\n"
"\n"
"<smallcaps>Temperaturas em Aridio são muito mais altas que o esperado. Enquanto os recursos são "
"abundantes, manter alimento e infraestruturas pode ser uma tarefa difícil enquanto a nossa colônia "
"esquenta.</smallcaps>"

#. STRINGS.WORLDS.VANILLAARIDIO.NAME
msgctxt "STRINGS.WORLDS.VANILLAARIDIO.NAME"
msgid "Aridio Asteroid"
msgstr "Asteroide Aridio"

#. STRINGS.WORLDS.VANILLABADLANDS.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLABADLANDS.DESCRIPTION"
msgid ""
"A barren location with an overabundance of mineral resources.\n"
"\n"
"<smallcaps>The rocky terrain of The Badlands poses no immediate threats, but sparse resource "
"availability will make expansion and technological progress challenging.</smallcaps>"
msgstr ""
"Um destino sem vida com abundância em recursos minerais.\n"
"\n"
"<smallcaps>O terreno rochoso das Terras Ruins não apresentam ameaças imediatas, mas recursos "
"esparsos farão a expansão e o progresso tecnológico desafiadores.</smallcaps>"

#. STRINGS.WORLDS.VANILLABADLANDS.NAME
msgctxt "STRINGS.WORLDS.VANILLABADLANDS.NAME"
msgid "The Badlands Asteroid"
msgstr "Asteroide Terras Ruins"

#. STRINGS.WORLDS.VANILLAFORESTDEFAULT.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLAFORESTDEFAULT.DESCRIPTION"
msgid ""
"A lush location rich in wildlife and life-sustaining resources.\n"
"\n"
"<smallcaps>Establishing a foothold on Verdante will be challenging due to reduced food and oxygen "
"options. However, abundant biological and mineral resources should afford excellent long-term "
"growth.</smallcaps>\n"
"\n"
msgstr ""
"Um destino exuberante, rico em vida selvagem e recursos que sustentam a vida.\n"
"\n"
"<smallcaps>Estabelecer uma colônia em Verdante poderá ser desafiador devido as opções reduzidas de "
"alimento e oxigênio. Porém, os recursos biológicos e minerais abundantes devem providenciar "
"crescimento excelente a longo prazo.</smallcaps>\n"

#. STRINGS.WORLDS.VANILLAFORESTDEFAULT.NAME
msgctxt "STRINGS.WORLDS.VANILLAFORESTDEFAULT.NAME"
msgid "Verdante Asteroid"
msgstr "Asteroide Verdante"

#. STRINGS.WORLDS.VANILLAOASIS.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLAOASIS.DESCRIPTION"
msgid ""
"A desolate location with a cache of life-sustaining water trapped beneath the surface.\n"
"\n"
"<smallcaps>A wide underground desert will pose temperature threats and strain the resources of a "
"colony on Oasisse. However, surviving the challenge should present great industrial opportunities.</"
"smallcaps>"
msgstr ""
"Um destino desolado com reservas de água presas debaixo da superfície.\n"
"\n"
"<smallcaps>Um grande deserto subterrâneo trará ameaças na temperatura e restringirá os recursos de "
"uma colônia em Oasis. Entretanto, sobreviver o desafio poderá dar um grande potencial industrial.</"
"smallcaps>"

#. STRINGS.WORLDS.VANILLAOASIS.NAME
msgctxt "STRINGS.WORLDS.VANILLAOASIS.NAME"
msgid "Oasisse Asteroid"
msgstr "Asteroide Oasis"

#. STRINGS.WORLDS.VANILLAOCEANIA.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLAOCEANIA.DESCRIPTION"
msgid ""
"A location with vast quantities of unpotable salt water.\n"
"\n"
"<smallcaps>Oceania is quite stable and resource rich, but the majority of the area is covered in a "
"saltwater ocean. Careful expansion and resource usage should lead to a successful colony.</"
"smallcaps>"
msgstr ""
"Um destino com vastas quantidades de água salgada não potável.\n"
"\n"
"<smallcaps>Oceania é bem estável e rica em recursos, mas a maior parte da área e coberta em oceano "
"de água salgada. Expansão e o uso de recursos com cautela podem levar a uma colônia bem sucedida.</"
"smallcaps>"

#. STRINGS.WORLDS.VANILLAOCEANIA.NAME
msgctxt "STRINGS.WORLDS.VANILLAOCEANIA.NAME"
msgid "Oceania Asteroid"
msgstr "Asteroide Oceania"

#. STRINGS.WORLDS.VANILLASANDSTONEDEFAULT.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLASANDSTONEDEFAULT.DESCRIPTION"
msgid ""
"A promising location with a balanced variety of resources.\n"
"\n"
"<smallcaps>Terra meets all the requirements for Duplicant life and holds no surprises. It's an "
"ideal location for a first attempt at establishing a colony.</smallcaps>\n"
"\n"
msgstr ""
"Um destino promissor com uma variedade balanceada de recursos.\n"
"\n"
"<smallcaps>Terra passa em todos os requisitos e não guarda nenhuma surpresa. É uma localização "
"ideal para a nossa primeira tentativa de estabelecer uma colônia.</smallcaps>\n"
"\n"

#. STRINGS.WORLDS.VANILLASANDSTONEDEFAULT.NAME
msgctxt "STRINGS.WORLDS.VANILLASANDSTONEDEFAULT.NAME"
msgid "Terra Asteroid"
msgstr "Asteroide Terra"

#. STRINGS.WORLDS.VANILLASANDSTONEFROZEN.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLASANDSTONEFROZEN.DESCRIPTION"
msgid ""
"A frigid location marked by inhospitably low temperatures throughout.\n"
"\n"
"<smallcaps>Rime's low temperatures will make finding water and establishing farms or ranches "
"problematic. However, the wide spectrum of minerals and cool environment could lead to thriving "
"industry.</smallcaps>"
msgstr ""
"Um destino frígido marcada por temperaturas inospitamente baixas.\n"
"\n"
"<smallcaps>As temperaturas baixas de Geada trarão problemas para as tarefas de encontrar água e "
"estabelecer plantações e ranchos. No entanto, o grande espectro de minerais e o ambiente frio podem "
"levar a uma indústria próspera.</smallcaps>"

#. STRINGS.WORLDS.VANILLASANDSTONEFROZEN.NAME
msgctxt "STRINGS.WORLDS.VANILLASANDSTONEFROZEN.NAME"
msgid "Rime Asteroid"
msgstr "Asteroide Geada"

#. STRINGS.WORLDS.VANILLASWAMPDEFAULT.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLASWAMPDEFAULT.DESCRIPTION"
msgid ""
"A large, polluted swamp world.\n"
"\n"
"<smallcaps>Squelchy Asteroids are a great mass of frozen slush and wasteland. With a short distance "
"to the surface, inter-world travel can be achieved quickly.</smallcaps>"
msgstr ""
"Um planetoide pantanoso gigantesco.\n"
"\n"
"<smallcaps>Asteroides Pantanosos são uma grande massa de lama congelada e deserto. Com uma pequena "
"distância para a superfície, a viagem interplanetária pode ser conquistada rapidamente.</smallcaps>"

#. STRINGS.WORLDS.VANILLASWAMPDEFAULT.NAME
msgctxt "STRINGS.WORLDS.VANILLASWAMPDEFAULT.NAME"
msgid "Squelchy Asteroid"
msgstr "Asteroide Enlameado"

#. STRINGS.WORLDS.VANILLAVOLCANIC.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLAVOLCANIC.DESCRIPTION"
msgid ""
"A location rife with molten lava pockets and intense heat.\n"
"\n"
"<smallcaps>Volcanea would be perfect if it wasn't for the volcanoes. Digging carefully and managing "
"the temperatures in our colony will be essential to success.</smallcaps>"
msgstr ""
"Um local cheio de depósitos de lava derretida e intenso calor.\n"
"\n"
"<smallcaps>Volcanea seria perfeita se não fosse pelos vulcões. Escavar cuidadosamente e gerenciar "
"as temperaturas da nossa colônia será essencial para o sucesso.</smallcaps>"

#. STRINGS.WORLDS.VANILLAVOLCANIC.NAME
msgctxt "STRINGS.WORLDS.VANILLAVOLCANIC.NAME"
msgid "Volcanea Asteroid"
msgstr "Asteroide Volcanea"

#. STRINGS.WORLDS.VOLCANIC.DESCRIPTION
msgctxt "STRINGS.WORLDS.VOLCANIC.DESCRIPTION"
msgid ""
"A location rife with molten lava pockets and intense heat.\n"
"\n"
"<smallcaps>Volcanea would be perfect if it wasn't for the volcanoes. Digging carefully and managing "
"the temperatures in our colony will be essential to success.</smallcaps>\n"
"\n"
msgstr ""
"Um local cheio de depósitos de lava derretida e intenso calor.\n"
"\n"
"<smallcaps>Volcanea seria perfeita se não fosse pelos vulcões. Escavar cuidadosamente e gerenciar "
"as temperaturas da nossa colônia será essencial para o sucesso.</smallcaps>\n"
"\n"

#. STRINGS.WORLDS.VOLCANIC.NAME
msgctxt "STRINGS.WORLDS.VOLCANIC.NAME"
msgid "Volcanea"
msgstr "Volcanea"

#. STRINGS.WORLDS.WARPOILYSANDYSWAMP.DESCRIPTION
msgctxt "STRINGS.WORLDS.WARPOILYSANDYSWAMP.DESCRIPTION"
msgid ""
"A mildly frozen world with an oily core.\n"
"\n"
"<smallcaps>While Oily Sandy Swamp Asteroids are largely swampy, they also contain a great deal of "
"wasteland.</smallcaps>"
msgstr ""
"Um mundo parcialmente congelado com um núcleo petrolífero.\n"
"\n"
"<smallcaps>Enquanto Asteroides Pântano Petrolífero são na maior parte pantanosos, eles também "
"contém uma grande quantidade de deserto.</smallcaps>"

#. STRINGS.WORLDS.WARPOILYSANDYSWAMP.NAME
msgctxt "STRINGS.WORLDS.WARPOILYSANDYSWAMP.NAME"
msgid "Oily Sandy Swamp Asteroid"
msgstr "Asteroide Pântano Petrolífero"

#. STRINGS.WORLDS.WARPOILYSWAMP.DESCRIPTION
msgctxt "STRINGS.WORLDS.WARPOILYSWAMP.DESCRIPTION"
msgid ""
"A partially frozen world with an oily core.\n"
"\n"
"<smallcaps>While Oily Swamp Asteroids are largely swampy, they also contain a great deal of rust.</"
"smallcaps>"
msgstr ""
"Um mundo parcialmente congelado com um núcleo petrolífero.\n"
"\n"
"<smallcaps>Enquanto Asteroides Pântano Petrolífero são na maior parte pantanosos, eles também "
"contém uma grande quantidade de ferrugem.</smallcaps>"

#. STRINGS.WORLDS.WARPOILYSWAMP.NAME
msgctxt "STRINGS.WORLDS.WARPOILYSWAMP.NAME"
msgid "Oily Swamp Asteroid"
msgstr "Asteroide Pântano Petrolífero"

#. STRINGS.WORLDS.WATERMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.WATERMOONLET.DESCRIPTION"
msgid ""
"A small, water-submerged world.\n"
"\n"
"<smallcaps>Water Asteroids possess a variety of liquid resources and are a natural source of "
"Graphite, but Duplicants should come prepared for a swim.</smallcaps>"
msgstr ""
"Um mundo pequeno e submerso em água.\n"
"\n"
"<smallcaps>Asteroides de Água possuem uma variedade de recursos líquidos e são uma fonte natural de "
"Grafite. No entanto, os Duplicantes devem vir preparados para nadar.</smallcaps>"

#. STRINGS.WORLDS.WATERMOONLET.NAME
msgctxt "STRINGS.WORLDS.WATERMOONLET.NAME"
msgid "Water Asteroid"
msgstr "Asteroide Água"

#~ msgctxt "STRINGS.BUILDINGS.PREFABS.CREATUREFEEDER.DESC"
#~ msgid "Critters tend to stay close to their food source and wander less when given a feeder."
#~ msgstr ""
#~ "Criaturas tendem a ficar perto da sua fonte de alimento e irão perambular menos quando receberem "
#~ "um alimentador."

#~ msgctxt "STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.EFFECT"
#~ msgid ""
#~ "Releases trapped <link=\"PACU\">Pacu</link> back into the world.\n"
#~ "\n"
#~ "Can be used multiple times."
#~ msgstr ""
#~ "Libera <link=\"PACU\">Pacus</link> capturados de volta ao mundo.\n"
#~ "\n"
#~ "Pode ser usado múltiplas vezes."

#~ msgctxt "STRINGS.BUILDINGS.PREFABS.MILKFEEDER.DESC"
#~ msgid "It's easier to tolerate overcrowding when you're all hopped up on brackene."
#~ msgstr "É mais fácil tolerar a superlotação quando você está todo empolgado com leite muu."

#~ msgctxt "STRINGS.BUILDINGS.PREFABS.RESEARCHCLUSTERMODULE.DESC"
#~ msgid "Unlocks the possibility of Gathering Databanks floating in space"
#~ msgstr "Desbloqueia a possibilidade de Coletar Bancos de Dados flutuando no espaço"

#~ msgctxt "STRINGS.BUILDINGS.PREFABS.RESEARCHCLUSTERMODULE.EFFECT"
#~ msgid ""
#~ "The Research module allows the rocket to gather Data banks that happen to be on the same hex "
#~ "cell than the rocket when it travels through the galaxy"
#~ msgstr ""
