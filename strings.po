msgstr "<link=\"UNOBTANIUM\">Neutrônio</link>"

#. STRINGS.ELEMENTS.URANIUMORE.DESC
msgctxt "STRINGS.ELEMENTS.URANIUMORE.DESC"
msgid ""
"(U) Uranium Ore is a highly <link=\"RADIATION\">Radioactive</link> substance.\n"
"\n"
"It can be refined into fuel for research reactors."
msgstr ""
"(U) Minério de Urânio é uma substância altamente <link=\"RADIATION\">Radioativa</link>.\n"
"\n"
"Pode ser refinada como combustível para reatores de pesquisa."

#. STRINGS.ELEMENTS.URANIUMORE.NAME
msgctxt "STRINGS.ELEMENTS.URANIUMORE.NAME"
msgid "<link=\"URANIUMORE\">Uranium Ore</link>"
msgstr "<link=\"URANIUMORE\">Minério de Urânio</link>"

#. STRINGS.ELEMENTS.VACUUM.DESC
msgctxt "STRINGS.ELEMENTS.VACUUM.DESC"
msgid "A vacuum is a space devoid of all matter."
msgstr "Um vácuo é um espaço desprovido de toda a matéria."

#. STRINGS.ELEMENTS.VACUUM.NAME
msgctxt "STRINGS.ELEMENTS.VACUUM.NAME"
msgid "<link=\"VACUUM\">Vacuum</link>"
msgstr "<link=\"VACUUM\">Vácuo</link>"

#. STRINGS.ELEMENTS.VISCOGEL.DESC
msgctxt "STRINGS.ELEMENTS.VISCOGEL.DESC"
msgid ""
"Visco-Gel Fluid is a <link=\"ELEMENTSLIQUID\">Liquid</link> polymer with high surface tension, "
"preventing typical liquid flow and allowing for unusual configurations."
msgstr ""
"Fluído Visco-Gel é um polímero <link=\"ELEMENTSLIQUID\">Líquido</link> com alta tensão superficial "
"que previne o fluxo típico dos líquidos e permitindo configurações incomuns."

#. STRINGS.ELEMENTS.VISCOGEL.NAME
msgctxt "STRINGS.ELEMENTS.VISCOGEL.NAME"
msgid "<link=\"VISCOGEL\">Visco-Gel Fluid</link>"
msgstr "<link=\"VISCOGEL\">Fluído Visco-Gel</link>"

#. STRINGS.ELEMENTS.VOID.DESC
msgctxt "STRINGS.ELEMENTS.VOID.DESC"
