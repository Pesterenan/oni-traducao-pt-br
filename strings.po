#. STRINGS.CREATURES.SPECIES.SEAL.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.BABY.DESC"
msgid ""
"A wobbly little Spigot Pup.\n"
"\n"
"In time, it will mature into an adult <link=\"SEAL\">Spigot Seal</link>."
msgstr ""
"uUma Unifoquinha trêmula.\n"
"\n"
"Com o tempo, ele amadurecerá e se tornará uma <link=\"SEAL\">Unifoca</link> adulta."

#. STRINGS.CREATURES.SPECIES.SEAL.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.BABY.NAME"
msgid "<link=\"SEAL\">Spigot Pup</link>"
msgstr "<link=\"SEAL\">Unifoquinha</link>"

#. STRINGS.CREATURES.SPECIES.SEAL.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.DESC"
msgid ""
"Spigot Seals are charismatic creatures who produce <link=\"ETHANOL\">Ethanol</link>.\n"
"\n"
"They eat <link=\"SUCROSE\">Sucrose</link>, and drink <link=\"SUGARWATER\">Nectar</link> straight "
"from the <link=\"SPACETREE\">Bonbon Tree</link>."
msgstr ""
"Unifocas são criaturas carismáticas que produzem <link=\"ETHANOL\">Etanol</link>.\n"
"\n"
"Eles comem <link=\"SUCROSE\">Sacarose</link> e bebem <link=\"SUGARWATER\">Néctar</link> direto da "
"<link=\"SPACETREE\">Árvore Bombom</link>."

#. STRINGS.CREATURES.SPECIES.SEAL.EGG_NAME
