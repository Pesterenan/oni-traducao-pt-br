msgstr "<link=\"PUFFERFISH\">Bóiaquinho</link>"

#. STRINGS.CREATURES.SPECIES.PUFFERFISH.DESC
#| msgctxt "STRINGS.ITEMS.FOOD.LETTUCE.DESC"
#| msgid "Crunchy, slightly salty leaves from a <link=\"SEALETTUCE\">Waterweed</link> plant."
msgctxt "STRINGS.CREATURES.SPECIES.PUFFERFISH.DESC"
msgid ""
"Blowters are aquatic critters who produce <link=\"OXYGEN\">Oxygen</link> after eating leaves from "
"<link=\"SEALETTUCE\">Waterweed</link> plants."
msgstr ""
"Bóiacus são criaturas aquáticas que produzem <link=\"OXYGEN\">Oxigênio</link> depois de comerem "
"folhas de <link=\"SEALETTUCE\">Alface do Mar</link>."

