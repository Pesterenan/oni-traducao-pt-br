msgstr "<link=\"STORAGELOCKER\">Armazenador Rosa-Púrpura</link>"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.STRIPES_RED_WHITE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKER.FACADES.STRIPES_RED_WHITE.DESC"
