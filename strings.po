msgid "This asteroid is an abundant source of <style=\"KKeyword\">Metal Ore</style>"
msgstr "Este asteroide é uma fonte abundante de <style=\"KKeyword\">Minérios de Metal</style>"

#. STRINGS.WORLD_TRAITS.METAL_RICH.NAME
msgctxt "STRINGS.WORLD_TRAITS.METAL_RICH.NAME"
msgid "Metal Rich"
msgstr "Rico em Metais"

#. STRINGS.WORLD_TRAITS.MISALIGNED_START.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.MISALIGNED_START.DESCRIPTION"
msgid ""
"The <link=\"HEADQUARTERS\">Printing Pod</link> didn't end up in the asteroid's exact center this "
"time... but it's still nowhere near the surface"
msgstr ""
"A <link=\"HEADQUARTERS\">Duplicadora</link> falhou em aterrissar no centro do asteroide desta "
"vez... mas ela está em algum lugar perto da superfície"

#. STRINGS.WORLD_TRAITS.MISALIGNED_START.NAME
msgctxt "STRINGS.WORLD_TRAITS.MISALIGNED_START.NAME"
msgid "Alternate Pod Location"
msgstr "Localização Alternativa da Duplicadora"

#. STRINGS.WORLD_TRAITS.MISSING_TRAIT
