msgstr "Nictofóbico"

#. STRINGS.DUPLICANTS.TRAITS.NIGHTLIGHT.SHORT_DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NIGHTLIGHT.SHORT_DESC"
