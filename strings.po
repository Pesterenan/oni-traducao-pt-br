msgstr "Fashionista"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.PREFERSCOOLER.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.PREFERSCOOLER.DESC"
msgid ""
"This Duplicant has some extra <style=\"KKeyword\">Insulation</style>, so the room "
"<style=\"KKeyword\">Temperature</style> affects them a little less"
msgstr ""
"Este Duplicante tem um <style=\"KKeyword\">Isolamento</style> extra, logo ele é menos afetado pela "
"<style=\"KKeyword\">Temperatura</style> da quarto"

