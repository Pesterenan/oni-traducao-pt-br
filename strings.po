#. STRINGS.CREATURES.SPECIES.SPACETREE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SPACETREE.DESC"
msgid ""
"Bonbon Tree branches synthesize <link=\"LIGHT\">Light</link> to produce "
"<link=\"SUGARWATER\">Nectar</link>.\n"
"\n"
"Branches can be harvested for <link=\"WOOD\">Wood</link>.\n"
"\n"
"Bonbon Trees can shed most environmental debris, and rarely become entombed."
msgstr ""
"Os galhos da Árvore Bombom sintetizam <link=\"LIGHT\">Luz</link> para produzir "
"<link=\"SUGARWATER\">Néctar</link>.\n"
"\n"
"Galhos podem ser colhidos para obter <link=\"WOOD\">Madeira</link>.\n"
"\n"
"As Árvores de Bombom podem se livrar da maior parte dos detritos ambientais e raramente ficam "
"enterradas."

#. STRINGS.CREATURES.SPECIES.SPACETREE.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SPACETREE.DOMESTICATEDDESC"
msgid "This plant produces <link=\"SUGARWATER\">Nectar</link> and <link=\"WOOD\">Wood</link>."
msgstr "Esta planta produz <link=\"SUGARWATER\">Néctar</link> e <link=\"WOOD\">Madeira</link>."

