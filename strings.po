msgstr ""
"(O<sub>2</sub>) O oxigênio sólido é um elemento respirável em estado "
"<link=\"ELEMENTSSOLID\">Sólido</link>."

#. STRINGS.ELEMENTS.SOLIDOXYGEN.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDOXYGEN.NAME"
