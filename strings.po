msgstr "Magrelo"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.SENSITIVEFEET.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.SENSITIVEFEET.DESC"
