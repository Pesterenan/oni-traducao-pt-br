msgstr "Deixe essa estrutura e seu ocupante sozinhos por enquanto"

#. STRINGS.CODEX.STORY_TRAITS.LONELYMINION.KNOCK_KNOCK.CANCELTEXT
msgctxt "STRINGS.CODEX.STORY_TRAITS.LONELYMINION.KNOCK_KNOCK.CANCELTEXT"
