msgid "<link=\"FROZENINK\">Frozen Squid Ink</link>"
msgstr ""

#. STRINGS.ELEMENTS.FROZENPHYTOOIL.DESC
msgctxt "STRINGS.ELEMENTS.FROZENPHYTOOIL.DESC"
msgid ""
"Frozen Phyto Oil is thick, slippery <link=\"SLIME\">Slime</link> extract, frozen into a "
"<link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr ""
"O Óleo Fito Congelado é um extrato de purê de <link=\"SLIME\">Limo</link> espesso e escorregadio "
"congelado em um estado <link=\"ELEMENTSSOLID\">Sólido</link>."

#. STRINGS.ELEMENTS.FROZENPHYTOOIL.NAME
msgctxt "STRINGS.ELEMENTS.FROZENPHYTOOIL.NAME"
msgid "<link=\"FROZENPHYTOOIL\">Frozen Phyto Oil</link>"
msgstr "<link=\"FROZENPHYTOOIL\">Óleo Fito Congelado</link>"

#. STRINGS.ELEMENTS.FULLERENE.DESC
msgctxt "STRINGS.ELEMENTS.FULLERENE.DESC"
msgid ""
"(C<sub>60</sub>) Fullerene is a form of <link=\"CARBON\">Coal</link> consisting of spherical "
"molecules."
msgstr ""
"(C<sub>60</sub>) Fulereno é uma forma do <link=\"CARBON\">Carvão</link> feita de moléculas "
"esféricas."

#. STRINGS.ELEMENTS.FULLERENE.NAME
msgctxt "STRINGS.ELEMENTS.FULLERENE.NAME"
