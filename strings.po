msgid ""
"(Au) Gold is a conductive precious <link=\"REFINEDMETAL\">Metal</link>.\n"
"\n"
"It is suitable for building <link=\"POWER\">Power</link> systems."
msgstr ""

#. STRINGS.ELEMENTS.GOLD.NAME
