msgid ""
"Frozen Ovolene is <link=\"FISHMILK\">Ovolene</link> frozen into a <link=\"ELEMENTSSOLID\">Solid</"
"link> state."
msgstr ""

#. STRINGS.ELEMENTS.FISHMILKICE.NAME
#| msgctxt "STRINGS.ELEMENTS.MILKICE.NAME"
