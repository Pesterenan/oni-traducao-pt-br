#. STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.PLANT_BLIGHT.DESCRIPTION
msgctxt "STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.PLANT_BLIGHT.DESCRIPTION"
msgid ""
"Our {plant} crops have been afflicted by a fungal sickness!\n"
"\n"
"I must get the Duplicants to uproot and compost the sick plants to save our farms."
msgstr ""
"Nossas {plant} estão sendo afetadas por uma doença fúngica!\n"
"\n"
"Eu preciso que meus Duplicantes desenraizem e compostem as plantas doentes para salvar nossas "
"hortas."

