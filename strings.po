msgctxt "STRINGS.BUILDINGS.PREFABS.MECHANICALSURFBOARD.LEAK_REQUIREMENT_TOOLTIP"
msgid ""
"This building will spill {amount} of its contents on to the floor during use, which must be "
"replenished."
msgstr ""
"Esta estrutura derramará {amount} dos seus conteúdos no chão durante o uso, o qual deve ser "
"constantemente reabastecido."

#. STRINGS.BUILDINGS.PREFABS.MECHANICALSURFBOARD.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MECHANICALSURFBOARD.NAME"
msgid "<link=\"MECHANICALSURFBOARD\">Mechanical Surfboard</link>"
msgstr "<link=\"MECHANICALSURFBOARD\">Prancha de Surfe Mecânica</link>"

