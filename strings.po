msgid ""
"Frozen Ink is <link=\"INK\">Squid Ink</link> cooled to a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr ""

#. STRINGS.ELEMENTS.FROZENINK.NAME
#| msgctxt "STRINGS.ELEMENTS.FROZENPHYTOOIL.NAME"
