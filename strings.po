msgstr "<link=\"STATERPILLAR\">Lesma Plugue</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.BABY.DESC"
msgid ""
"A tubby little Smog Sluglet.\n"
"\n"
"In time it will mature into a fully grown <link=\"STATERPILLAR\">Smog Slug</link>."
msgstr ""
"Uma Lesminha Poluidora pequena e gordinha.\n"
"\n"
"Com o tempo ele vai dar origem a uma <link=\"STATERPILLAR\">Lesma Poluidora</link>."

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.BABY.NAME"
msgid "<link=\"STATERPILLAR\">Smog Sluglet</link>"
msgstr "<link=\"STATERPILLAR\">Lesminha Poluidora</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.DESC"
msgid ""
"Smog Slugs are porous creatures that draw in unbreathable <link=\"ELEMENTSGAS\">Gases</link> during "
"the day.\n"
"\n"
"At night, they sleep near exposed <link=\"GASCONDUIT\">Gas Pipes,</link> where they deposit their "
"cache."
msgstr ""
"Lesmas Poluidoras são criaturas porosas que consomem <link=\"ELEMENTSGAS\">Gases</link> "
"irrespiráveis durante o dia.\n"
"\n"
"À noite, eles dormem perto de <link=\"GASCONDUIT\">Tubos de Gás</link> expostos, onde depositam o "
"que guardaram."

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.EGG_NAME"
msgid "<link=\"STATERPILLAR\">Smog Slug Egg</link>"
msgstr "<link=\"STATERPILLAR\">Ovo de Lesma Poluidora</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.NAME"
msgid "<link=\"STATERPILLAR\">Smog Slug</link>"
msgstr "<link=\"STATERPILLAR\">Lesma Poluidora</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.BABY.DESC"
msgid ""
"A chonky little Sponge Sluglet.\n"
"\n"
"In time it will mature into a fully grown <link=\"STATERPILLAR\">Sponge Slug</link>."
msgstr ""
"Uma Lesminha Esponja pequena e gordinha.\n"
"\n"
"Com o tempo ele vai dar origem a uma <link=\"STATERPILLAR\">Lesma Esponja</link>."

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.BABY.NAME"
msgid "<link=\"STATERPILLAR\">Sponge Sluglet</link>"
msgstr "<link=\"STATERPILLAR\">Lesminha Esponja</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.DESC"
msgid ""
"Sponge Slugs are thirsty creatures that soak up <link=\"ELEMENTSLIQUID\">Liquids</link> during the "
"day.\n"
"\n"
"They deposit their stored <link=\"ELEMENTSLIQUID\">Liquids</link> into the exposed "
"<link=\"LIQUIDCONDUIT\">Liquid Pipes</link> they sleep next to at night."
msgstr ""
"Lesmas Esponjas são criaturas sedentas que absorvem <link=\"ELEMENTSLIQUID\">Líquidos</link> "
"durante o dia.\n"
"\n"
"Eles depositam seus <link=\"ELEMENTSLIQUID\">Líquidos</link> armazenados nos "
"<link=\"LIQUIDCONDUIT\">Canos de Líquidos</link> expostos ao lado dos quais dormem à noite."

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.EGG_NAME"
msgid "<link=\"STATERPILLAR\">Sponge Slug Egg</link>"
msgstr "<link=\"STATERPILLAR\">Ovo de Lesma Esponja</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.NAME"
msgid "<link=\"STATERPILLAR\">Sponge Slug</link>"
msgstr "<link=\"STATERPILLAR\">Lesma Esponja</link>"

#. STRINGS.CREATURES.SPECIES.STEAMSPOUT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STEAMSPOUT.DESC"
msgid "A rocky vent that spouts <link=\"STEAM\">Steam</link>."
msgstr "Uma abertura de pedra que emite <link=\"STEAM\">Vapor</link>."

#. STRINGS.CREATURES.SPECIES.STEAMSPOUT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STEAMSPOUT.NAME"
msgid "<link=\"GEYSERS\">Steam Spout</link>"
msgstr "<link=\"GEYSERS\">Bica de Vapor</link>"

#. STRINGS.CREATURES.SPECIES.STEGO.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STEGO.BABY.DESC"
msgid ""
"A heavy-footed little Lumb baby.\n"
"\n"
"In time, it will grow into a stompy <link=\"STEGO\">Lumb</link>."
msgstr ""
"Um bebê Lomburrinho de pés pesados.\n"
"\n"
"Com o tempo, ele crescerá e se tornará um pisoteante <link=\"STEGO\">Lomburro</link>."

#. STRINGS.CREATURES.SPECIES.STEGO.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STEGO.BABY.NAME"
msgid "<link=\"STEGO\">Lumblet</link>"
msgstr "<link=\"STEGO\">Lomburrinho</link>"

#. STRINGS.CREATURES.SPECIES.STEGO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STEGO.DESC"
msgid ""
"Lumbs are non-hostile critters that subsist on <link=\"VINEMOTHER\">Ovagro</link> vines.\n"
"\n"
"When they stomp heavily near <link=\"PLANTS\">plants</link>, the commotion causes harvestable items "
"to fall to the ground."
msgstr ""
"Lomburros são criaturas não-hostis que se alimentam de vinhas de <link=\"VINEMOTHER\">Figocaxi</"
"link>.\n"
"\n"
"Quando batem seus pés fortemente no chão perto das <link=\"PLANTS\">plantas</link>, toda essa "
"comoção faz com que os itens coletáveis caiam no chão."

#. STRINGS.CREATURES.SPECIES.STEGO.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.STEGO.EGG_NAME"
msgid "<link=\"STEGO\">Lumb Egg</link>"
msgstr "<link=\"STEGO\">Ovo de Lomburro</link>"

#. STRINGS.CREATURES.SPECIES.STEGO.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STEGO.NAME"
msgid "<link=\"STEGO\">Lumb</link>"
msgstr "<link=\"STEGO\">Lomburro</link>"

#. STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.DESC"
msgid ""
"A Grubfruit Plant that has flourished after being tended by a <link=\"DIVERGENTSPECIES\">Divergent</"
"link> critter.\n"
"\n"
"It will produce high quality <link=\"WORMSUPERFRUIT\">Grubfruits</link>."
msgstr ""
"Um Pé de Larvofruta que floresceu após ter sido cuidada por uma criatura "
"<link=\"DIVERGENTSPECIES\">Divergente</link>.\n"
"\n"
"Ela produzirá <link=\"WORMSUPERFRUIT\">Larvofrutas</link> de alta qualidade."

#. STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"WORMSUPERFRUIT\">Grubfruit</link>."
msgstr "Esta planta produz <link=\"WORMSUPERFRUIT\">Larvofrutas</link> comestíveis."

#. STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.NAME"
msgid "<link=\"WORMPLANT\">Grubfruit Plant</link>"
msgstr "<link=\"WORMPLANT\">Pé de Larvofruta</link>"

#. STRINGS.CREATURES.SPECIES.SWAMPFORAGEPLANTPLANTED.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPFORAGEPLANTPLANTED.DESC"
msgid ""
"Swamp Chards are incapable of propagating but can be harvested for a single low quality and calorie "
"dense <link=\"FOOD\">Food</link> serving."
msgstr ""
"Acelgas Pantanosas são incapazes de reproduzir mas podem ser colhidos para dar uma única porção de "
"<link=\"FOOD\">Alimento</link> de baixa qualidade."

#. STRINGS.CREATURES.SPECIES.SWAMPFORAGEPLANTPLANTED.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPFORAGEPLANTPLANTED.NAME"
msgid "<link=\"SWAMPFORAGEPLANTPLANTED\">Swamp Chard</link>"
msgstr "<link=\"SWAMPFORAGEPLANTPLANTED\">Acelga Pantanosa</link>"

#. STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.DESC"
msgid ""
"Bog Buckets produce juicy, sweet <link=\"SWAMPFRUIT\">Bog Jellies</link> for <link=\"FOOD\">Food</"
"link>."
msgstr ""
"Baldes do Pântano produzem, suculentas e doces, <link=\"SWAMPFRUIT\">Geleias do Pântano</link> como "
"<link=\"FOOD\">Alimento</link>."

#. STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"SWAMPFRUIT\">Bog Jellies</link>."
msgstr "Esta planta produz <link=\"SWAMPFRUIT\">Geleias do Pântano</link>."

#. STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.NAME"
msgid "<link=\"SWAMPHARVESTPLANT\">Bog Bucket</link>"
msgstr "<link=\"SWAMPHARVESTPLANT\">Balde do Pântano</link>"

#. STRINGS.CREATURES.SPECIES.SWAMPLILY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPLILY.DESC"
msgid ""
"Balm Lilies produce <link=\"SWAMPLILYFLOWER\">Balm Lily Flower</link>, a lovely bloom with "
"medicinal properties."
msgstr ""
"Lírios Milagrosos produzem <link=\"SWAMPLILYFLOWER\">Flor de Lírio Milagroso</link>, uma flor com "
"propriedades medicinais."

#. STRINGS.CREATURES.SPECIES.SWAMPLILY.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPLILY.DOMESTICATEDDESC"
msgid "This plant produces medicinal <link=\"SWAMPLILYFLOWER\">Balm Lily Flower</link>."
msgstr "Esta planta produz <link=\"SWAMPLILYFLOWER\">Flor de Lírio Milagroso</link> medicinal."

#. STRINGS.CREATURES.SPECIES.SWAMPLILY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPLILY.NAME"
msgid "<link=\"SWAMPLILY\">Balm Lily</link>"
msgstr "<link=\"SWAMPLILY\">Lírio Milagroso</link>"

#. STRINGS.CREATURES.SPECIES.TOEPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.TOEPLANT.DESC"
msgid ""
"Tranquil Toes improve <link=\"DECOR\">Decor</link> by giving their surroundings the visual "
"equivalent of a foot rub."
msgstr ""
"Melhora bastante a <link=\"DECOR\">Decoração</link> por dar ao ambiente o equivalente visual de uma "
"massagem no pé."

#. STRINGS.CREATURES.SPECIES.TOEPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.TOEPLANT.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "Esta planta melhora a <link=\"DECOR\">Decoração</link> do ambiente."

