msgstr "<link=\"PUFTBLEACHSTONE\">Bolha Limpa</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.BABY.DESC"
msgid ""
"A stocky little Dense Puftlet.\n"
"\n"
"One day it will grow into an adult Puft morph, the <link=\"PUFTOXYLITE\">Dense Puft</link>."
msgstr ""
"Uma pequena e encorpada Bolhinha Densa.\n"
"\n"
"Com o tempo ela vai dar origem a uma das raças de Bolha adulta, a <link=\"PUFTOXYLITE\">Bolha "
"Densa</link>."

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.BABY.NAME"
msgid "<link=\"PUFTOXYLITE\">Dense Puftlet</link>"
msgstr "<link=\"PUFTOXYLITE\">Bolhinha Densa</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.DESC"
msgid ""
"Dense Pufts are non-aggressive critters that excrete condensed <link=\"OXYROCK\">Oxylite</link> "
"with each breath."
msgstr ""
"Bolhas Densas são criaturas não agressivas que excretam <link=\"OXYROCK\">Oxilito</link> condensado "
"a cada respirada."

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.EGG_NAME"
msgid "<link=\"PUFTOXYLITE\">Dense Puft Egg</link>"
msgstr "<link=\"PUFTOXYLITE\">Ovo de Bolhinha Densa</link>"

